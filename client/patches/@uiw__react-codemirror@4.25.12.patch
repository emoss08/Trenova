--- a/cjs/useCodeMirror.js
+++ b/cjs/useCodeMirror.js
@@ -177,6 +177,9 @@ function useCodeMirror(props) {
     if (value === undefined) {
       return;
     }
+    // The latest value supersedes one held back while typing: applying the older one
