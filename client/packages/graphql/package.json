{
  "name": "@trenova/graphql",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./generated": "./src/generated/index.ts",
    "./fragment-data": "./src/fragment-data.ts",
    "./generated/persisted-documents.json": "./src/generated/persisted-documents.json",
    "./generated/graphql": "./src/generated/graphql.ts",
    "./generated/documents/*": "./src/generated/documents/*.ts",
    "./generated/gql": "./src/generated/gql.ts",
    "./generated/fragment-masking": "./src/generated/fragment-masking.ts"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "codegen": "graphql-codegen --config codegen.ts",
    "dev": "bun scripts/watch.mjs",
    "enums": "bun scripts/generate-error-enums.mjs",
    "resources": "bun scripts/generate-permission-resources.mjs",
    "record-kinds": "bun scripts/generate-record-kinds.mjs",
    "tool-namespaces": "bun scripts/generate-tool-namespaces.mjs",
    "codegen:check": "bun run codegen && bun scripts/assert-codegen-clean.mjs",
    "test": "bun test scripts"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@trenova/config": "workspace:*",
    "graphql": "^17.0.2",
    "typescript": "~7.0.2"
  }
}
