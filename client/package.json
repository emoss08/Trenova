{
  "name": "trenova-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:design": "node scripts/check-design-tokens.mjs",
    "lint:skeletons": "node --test scripts/loading-skeletons.test.mjs && node scripts/check-loading-skeletons.mjs",
    "check:single-copies": "node scripts/check-single-copies.ts",
    "logos:fetch": "node scripts/fetch-brand-logo.mjs",
    "lint:fix": "turbo run lint:fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": "^26"
  },
  "packageManager": "pnpm@12.16.1"
}
