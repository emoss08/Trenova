{
  "name": "trenova-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "@base-ui/react": "^1.9.0",
      "@floating-ui/react-dom": "^2.1.9",
      "@tanstack/react-query": "^5.105.3",
      "@tanstack/react-table": "^9.3.1",
      "@tanstack/table-core": "9.3.1",
      "@tanstack/react-router": "^1.170.46",
      "react-hook-form": "^7.91.0",
      "react-error-boundary": "^6.1.6",
      "zustand": "^5.0.16",
      "motion": "^14.9.1",
      "zod": "^4.6.7",
      "@yusufceng1z/ding": "0.0.2",
      "@yusufceng1z/ding-react": "0.0.2"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:design": "bun scripts/check-design-tokens.mjs",
    "lint:skeletons": "bun test scripts/loading-skeletons.test.mjs && bun scripts/check-loading-skeletons.mjs",
    "check:single-copies": "bun scripts/check-single-copies.ts",
    "logos:fetch": "bun scripts/fetch-brand-logo.mjs",
    "lint:fix": "turbo run lint:fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.105.3",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.11.11"
  },
  "overrides": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "6.43.6",
    "@tanstack/query-core": "5.102.8",
    "@tanstack/table-core": "9.3.1"
  },
  "patchedDependencies": {
    "@uiw/react-codemirror@4.25.12": "patches/@uiw__react-codemirror@4.25.12.patch"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild"
  ]
}
