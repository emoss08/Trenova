+func driverCommentsQuery(
+	req *workerports.ListDriverShipmentCommentsRequest,
+) *keel.Query[*shipment.ShipmentComment] {
+	limit := min(req.Limit, workerports.MaxDriverCommentsPage+1)
+	if limit <= 0 {
+		limit = workerports.DefaultDriverCommentsPage
+	}
+
+	sc := shipmentdb.ShipmentComments
+	var before keel.Pred
+	if req.BeforeID.IsNotNil() {
+		before = keel.Tuple(sc.CreatedAt, sc.ID).
+			Lt(keel.Tuple(req.BeforeCreatedAt, req.BeforeID.String()))
+	}
+
+	return sc.Where(
+		sc.ShipmentID.Eq(req.ShipmentID),
+		sc.Visibility.Eq(shipment.CommentVisibilityDriver),
+		sc.DeletedAt.IsNull(),
+		before,
+	).
+		Load(sc.User()).
+		Order(sc.CreatedAt.Desc(), sc.ID.Desc()).
+		Limit(limit)
