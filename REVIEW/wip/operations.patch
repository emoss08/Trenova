+func (s *service) shipmentHasHazmat(
+	ctx context.Context,
+	tenantInfo pagination.TenantInfo,
+	shp *shipment.Shipment,
+) (bool, error) {
+	if shp == nil || len(shp.Commodities) == 0 {
+		return false, nil
+	}
+
+	commodityIDs := make([]pulid.ID, 0, len(shp.Commodities))
+	for _, sc := range shp.Commodities {
+		if sc != nil && !sc.CommodityID.IsNil() {
+			commodityIDs = append(commodityIDs, sc.CommodityID)
+		}
+	}
+	if len(commodityIDs) == 0 {
+		return false, nil
+	}
+
+	commodities, err := s.commodityRepo.GetByIDs(ctx, commodityports.GetCommoditiesByIDsRequest{
+		TenantInfo:   tenantInfo,
+		CommodityIDs: commodityIDs,
+	})
+	if err != nil {
+		return false, err
+	}
+
+	for _, c := range commodities {
+		if c != nil && c.HazardousMaterial != nil && !c.HazardousMaterial.ID.IsNil() {
+			return true, nil
+		}
+	}
+
+	return false, nil
+}
+
+type appliedOverride struct {
+	reason   string
+	findings []map[string]string
+}
+
+func (s *service) enforceCompliance(
+	ctx context.Context,
+	tenantInfo pagination.TenantInfo,
+	subject *complianceSubject,
+	override *shipmentports.ComplianceOverride,
+) (*appliedOverride, error) {
+	if !subject.control.ComplianceEnforcementLevel.ShouldBlock() {
+		return nil, nil //nolint:nilnil // no override is applied when the level does not block
+	}
+
+	result, err := s.evaluateCompliance(ctx, tenantInfo, subject)
+	if err != nil {
+		return nil, err
+	}
+	if !result.blocked() {
+		return nil, nil //nolint:nilnil // nothing blocked, so nothing was overridden
+	}
+	if override == nil {
+		return nil, result.multiError()
+	}
+
+	return &appliedOverride{
+		reason:   strings.TrimSpace(override.Reason),
+		findings: result.blockingFindings(),
+	}, nil
+}
+
+type overrideAudit struct {
+	tenantInfo pagination.TenantInfo
+	moveID     pulid.ID
+	assignment *shipment.Assignment
+	override   *appliedOverride
+}
+
+func (s *service) auditOverride(ctx context.Context, p *overrideAudit) {
+	if p.override == nil || p.assignment == nil {
+		return
+	}
+
+	err := s.auditService.LogAction(
+		&auditports.LogActionParams{
+			Resource:   permission.ResourceShipmentMove,
+			ResourceID: p.moveID.String(),
+			Operation:  permission.OpApprove,
+			CurrentState: map[string]any{
+				"assignmentId":      p.assignment.ID.String(),
+				"primaryWorkerId":   pulidString(p.assignment.PrimaryWorkerID),
+				"secondaryWorkerId": pulidString(p.assignment.SecondaryWorkerID),
+			},
+			UserID:         p.tenantInfo.UserID,
+			OrganizationID: p.tenantInfo.OrgID,
+			BusinessUnitID: p.tenantInfo.BuID,
+			Critical:       true,
+		},
+		auditservice.WithComment("Compliance override: "+p.override.reason),
+		auditservice.WithMetadata(map[string]any{
+			"complianceOverride": map[string]any{
+				"reason":   p.override.reason,
+				"findings": p.override.findings,
+			},
+		}),
+		auditservice.WithCritical(),
+		auditservice.WithRequest(ctx),
+	)
+	if err != nil {
+		s.l.Error("failed to audit a compliance override",
+			zap.String("moveId", p.moveID.String()),
+			zap.Error(err))
+	}
+}
+
+func pulidString(id *pulid.ID) string {
+	if id == nil {
+		return ""
+	}
+
+	return id.String()
 }
