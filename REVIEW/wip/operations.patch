+package telematicsresolver
+
+import (
+	"context"
+
+	"github.com/emoss08/trenova/internal/modules/identity/domain/permission"
+	"github.com/emoss08/trenova/internal/modules/workforce/domain/worker"
+	"github.com/emoss08/trenova/pkg/authctx"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/shared/pulid"
+)
+
+func (r *QueryResolver) requireWorkerInScope(
+	ctx context.Context,
+	rawWorkerID string,
+) (*authctx.AuthContext, pulid.ID, error) {
+	id, err := pulid.Parse(rawWorkerID)
+	if err != nil {
+		return nil, pulid.Nil, errortypes.NewValidationError(
+			"workerId",
+			errortypes.ErrInvalid,
+			"Worker ID is not a valid identifier",
+		)
+	}
+
+	authCtx, _, err := r.RequireTeamScope(
+		ctx,
+		permission.ResourceWorker,
+		permission.OpRead,
+		worker.ApprovalScopeAll,
+		id,
+	)
+	if err != nil {
+		return nil, pulid.Nil, err
+	}
+
+	return authCtx, id, nil
+}
