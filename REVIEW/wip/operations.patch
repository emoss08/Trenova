+func (s *service) complianceWorker(
+	ctx context.Context,
+	tenantInfo pagination.TenantInfo,
+	subject *complianceSubject,
+	workerID pulid.ID,
+) (*worker.Worker, error) {
+	if loaded, ok := subject.workers[workerID]; ok && loaded.Profile != nil {
+		return loaded, nil
+	}
+
+	return s.workerRepo.GetByID(ctx, workerports.GetWorkerByIDRequest{
+		ID:             workerID,
+		TenantInfo:     tenantInfo,
+		IncludeProfile: true,
+	})
+}
