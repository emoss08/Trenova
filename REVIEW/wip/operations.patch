@@ -0,0 +1,45 @@
+package driverportalrepository
+
+import (
+	"testing"
+
+	"github.com/emoss08/trenova/internal/modules/workforce/ports/workerports"
+	"github.com/emoss08/trenova/internal/testutil/keeltest"
+	"github.com/emoss08/trenova/shared/pulid"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestDriverCommentsQuery_IsAlwaysBounded(t *testing.T) {
+	t.Parallel()
+
+	for name, tc := range map[string]struct {
+		limit int
+		want  string
+	}{
+		"unset":     {limit: 0, want: "LIMIT 50"},
+		"requested": {limit: 21, want: "LIMIT 21"},
+		"too large": {limit: 10_000, want: "LIMIT 101"},
+	} {
+		sql, _ := keeltest.Render(t, driverCommentsQuery(&workerports.ListDriverShipmentCommentsRequest{
+			ShipmentID: pulid.ID("shp_1"),
+			Limit:      tc.limit,
+		}))
+		assert.Contains(t, sql, `DESC LIMIT`, name)
+		assert.Contains(t, sql, tc.want, name)
+	}
+}
+
+func TestDriverCommentsQuery_ReadsBeforeTheCursorInItsOrder(t *testing.T) {
+	t.Parallel()
+
+	sql, _ := keeltest.Render(t, driverCommentsQuery(&workerports.ListDriverShipmentCommentsRequest{
+		ShipmentID:      pulid.ID("shp_1"),
+		Limit:           10,
+		BeforeCreatedAt: 700,
+		BeforeID:        pulid.ID("shc_9"),
+	}))
+
+	assert.Contains(t, sql, `ROW(sc."created_at", sc."id") < ROW($`, sql)
+	assert.Contains(t, sql, `sc."deleted_at" IS NULL`, sql)
+	assert.Contains(t, sql, `ORDER BY sc."created_at" DESC, sc."id" DESC LIMIT 10`, sql)
+}
