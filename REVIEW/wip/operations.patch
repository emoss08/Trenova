+	driver.Profile.LicenseExpiry = time.Now().AddDate(2, 0, 0).Unix()
+	f := newComplianceFixture(t, complianceFixtureParams{
+		level:  dispatchcontrol.ComplianceEnforcementLevelBlock,
+		driver: driver,
+	})
+
+	_, err := f.svc.AssignToMove(t.Context(), f.assignRequest(&shipmentports.ComplianceOverride{
+		Reason: "Just in case",
+	}))
+
+	require.NoError(t, err)
+	assert.Equal(t, 1, f.created)
+	assert.Empty(t, f.audits.calls)
+}
+
+func TestAssignShipmentMoveRequest_AnOverrideNeedsAReason(t *testing.T) {
+	t.Parallel()
+
+	for name, reason := range map[string]string{
+		"empty":    "",
+		"blank":    "   ",
+		"too long": strings.Repeat("x", shipmentports.MaxComplianceOverrideReasonLength+1),
+	} {
+		req := &shipmentports.AssignShipmentMoveRequest{
+			TenantInfo: pagination.TenantInfo{
+				OrgID: pulid.MustNew("org_"),
+				BuID:  pulid.MustNew("bu_"),
+			},
+			ShipmentMoveID:     pulid.MustNew("sm_"),
+			PrimaryWorkerID:    pulid.MustNew("wrk_"),
+			TractorID:          pulid.MustNew("trac_"),
+			ComplianceOverride: &shipmentports.ComplianceOverride{Reason: reason},
+		}
+
+		multiErr := req.Validate()
+
+		require.NotNil(t, multiErr, name)
+		require.Len(t, multiErr.Errors, 1, name)
+		assert.Equal(t, "complianceOverride.reason", multiErr.Errors[0].Field, name)
+	}
+}
