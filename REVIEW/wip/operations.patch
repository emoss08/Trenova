+			DriveRemainingMs: int64(i+1) * 3_600_000,
+			RecordedAt:       1_700_000_000,
+			ReceivedAt:       1_700_000_000,
+		})
+		violations = append(violations, &telematics.WorkerHOSViolation{
+			OrganizationID:   f.tenantInfo.OrgID,
+			BusinessUnitID:   f.tenantInfo.BuID,
+			WorkerID:         id,
+			ViolationType:    "shiftDriving",
+			ViolationStartAt: 1_700_000_000 + int64(i),
+			DetectedAt:       1_700_000_100,
+		})
+	}
+	require.NoError(t, f.repo.UpsertWorkerHOSStates(f.ctx, states))
+	require.NoError(t, f.repo.UpsertWorkerHOSViolations(f.ctx, violations))
