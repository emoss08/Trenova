+func TestListDriverShipmentComments_PagesNewestFirstFromTheCursor(t *testing.T) {
+	ctx, admin, dsn, cleanup := seedtest.SetupTestDBWithDSN(t)
+	t.Cleanup(cleanup)
+
+	data := seedtest.SeedFullTestData(t, ctx, admin)
+	tenant := pagination.TenantInfo{
+		OrgID:  data.Organization.ID,
+		BuID:   data.BusinessUnit.ID,
+		UserID: data.User.ID,
+	}
+	fixture := testutil.SeedShipmentIntegrationFixture(t, ctx, admin, data, tenant)
+	graph := testutil.CreateShipmentGraph(t, ctx, admin, fixture, tenant, testutil.ShipmentGraphParams{
+		BOL:        "BOL-CHAT",
+		ProNumber:  "PRO-CHAT",
+		ShipmentID: pulid.MustNew("shp_"),
+	})
+	other := testutil.CreateShipmentGraph(t, ctx, admin, fixture, tenant, testutil.ShipmentGraphParams{
+		BOL:        "BOL-OTHER",
+		ProNumber:  "PRO-OTHER",
+		ShipmentID: pulid.MustNew("shp_"),
+	})
+
+	deletedAt := int64(1_700_000_900)
+	comment := func(
+		shipmentID pulid.ID,
+		id string,
+		at int64,
+		visibility shipment.CommentVisibility,
+		deleted *int64,
+	) {
+		require.NoError(t, shipmentdb.ShipmentComments.Create(data.Ctx(ctx), admin,
+			&shipment.ShipmentComment{
+				ID:             pulid.ID(id),
+				OrganizationID: tenant.OrgID,
+				BusinessUnitID: tenant.BuID,
+				ShipmentID:     shipmentID,
+				UserID:         tenant.UserID,
+				Comment:        id,
+				Visibility:     visibility,
+				DeletedAt:      deleted,
+				CreatedAt:      at,
+			}))
+	}
+	driver := shipment.CommentVisibilityDriver
+	comment(graph.Shipment.ID, "shc_a", 1_700_000_100, driver, nil)
+	comment(graph.Shipment.ID, "shc_b", 1_700_000_200, driver, nil)
+	comment(graph.Shipment.ID, "shc_c", 1_700_000_300, driver, nil)
+	comment(graph.Shipment.ID, "shc_d", 1_700_000_300, driver, nil)
+	comment(graph.Shipment.ID, "shc_e", 1_700_000_400, driver, nil)
+	comment(graph.Shipment.ID, "shc_internal", 1_700_000_350, shipment.CommentVisibilityInternal, nil)
+	comment(graph.Shipment.ID, "shc_deleted", 1_700_000_250, driver, &deletedAt)
+	comment(other.Shipment.ID, "shc_elsewhere", 1_700_000_380, driver, nil)
+
+	repo := New(Params{DB: dbtest.NewRLSConnection(t, admin, dsn), Logger: zap.NewNop()})
+	readCtx := dbscope.WithTenant(t.Context(), tenant.DBTenant())
+	ids := func(items []*shipment.ShipmentComment) []string {
+		out := make([]string, 0, len(items))
+		for _, item := range items {
+			out = append(out, item.ID.String())
+		}
+		return out
+	}
+
+	first, err := repo.ListDriverShipmentComments(readCtx, &workerports.ListDriverShipmentCommentsRequest{
+		TenantInfo: tenant,
+		ShipmentID: graph.Shipment.ID,
+		Limit:      2,
+	})
+	require.NoError(t, err)
+	assert.Equal(t, []string{"shc_e", "shc_d"}, ids(first))
+
+	second, err := repo.ListDriverShipmentComments(readCtx, &workerports.ListDriverShipmentCommentsRequest{
+		TenantInfo:      tenant,
+		ShipmentID:      graph.Shipment.ID,
+		Limit:           2,
+		BeforeCreatedAt: first[1].CreatedAt,
+		BeforeID:        first[1].ID,
+	})
+	require.NoError(t, err)
+	assert.Equal(t, []string{"shc_c", "shc_b"}, ids(second))
+
+	last, err := repo.ListDriverShipmentComments(readCtx, &workerports.ListDriverShipmentCommentsRequest{
+		TenantInfo:      tenant,
+		ShipmentID:      graph.Shipment.ID,
+		Limit:           2,
+		BeforeCreatedAt: second[1].CreatedAt,
+		BeforeID:        second[1].ID,
+	})
+	require.NoError(t, err)
+	assert.Equal(t, []string{"shc_a"}, ids(last))
+
+	capped, err := repo.ListDriverShipmentComments(readCtx, &workerports.ListDriverShipmentCommentsRequest{
+		TenantInfo: tenant,
+		ShipmentID: graph.Shipment.ID,
+		Limit:      10_000,
+	})
+	require.NoError(t, err)
+	assert.Equal(t, []string{"shc_e", "shc_d", "shc_c", "shc_b", "shc_a"}, ids(capped))
+}
