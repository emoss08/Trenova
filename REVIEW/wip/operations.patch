+func TestListWorkerHOSStates_NeverReadsMoreThanTheCap(t *testing.T) {
+	t.Parallel()
+
+	managers := []pulid.ID{pulid.MustNew("usr_")}
+	for name, tc := range map[string]struct {
+		limit int
+		want  int
+	}{
+		"unset":     {limit: 0, want: telematicsports.MaxWorkerHOSStates},
+		"requested": {limit: 25, want: 25},
+		"too large": {limit: 50_000, want: telematicsports.MaxWorkerHOSStates},
+	} {
+		repo := &hosReadRepo{}
+		svc := &Service{repo: repo}
+
+		_, err := svc.ListWorkerHOSStates(t.Context(), &telematicsports.ListWorkerHOSStatesRequest{
+			ManagerIDs: managers,
+			Limit:      tc.limit,
+		})
+
+		require.NoError(t, err, name)
+		require.Len(t, repo.states, 1, name)
+		assert.Equal(t, tc.want, repo.states[0].Limit, name)
+		assert.Equal(t, managers, repo.states[0].ManagerIDs, name)
+		assert.True(t, repo.states[0].IncludeWorker, name)
+	}
+}
+
+func TestListWorkerHOSStates_RefusesMoreDriversThanTheCap(t *testing.T) {
+	t.Parallel()
+
+	repo := &hosReadRepo{}
+	ids := make([]pulid.ID, telematicsports.MaxWorkerHOSStates+1)
+	for i := range ids {
+		ids[i] = pulid.MustNew("wrk_")
+	}
+
+	_, err := (&Service{repo: repo}).ListWorkerHOSStates(
+		t.Context(),
+		&telematicsports.ListWorkerHOSStatesRequest{WorkerIDs: ids},
+	)
+
+	require.Error(t, err)
+	assert.True(t, errortypes.IsError(err))
+	assert.Empty(t, repo.states)
+}
+
+func TestListWorkerHOSViolations_IsAlwaysPaged(t *testing.T) {
+	t.Parallel()
+
+	for name, tc := range map[string]struct {
+		limit int
+		want  int
+	}{
+		"unset":     {limit: 0, want: telematicsports.DefaultWorkerHOSViolationPage},
+		"requested": {limit: 10, want: 10},
+		"too large": {limit: 9_999, want: telematicsports.MaxWorkerHOSViolationPage},
+	} {
+		repo := &hosReadRepo{}
+
+		_, err := (&Service{repo: repo}).ListWorkerHOSViolations(
+			t.Context(),
+			&telematicsports.ListWorkerHOSViolationsRequest{Limit: tc.limit},
+		)
+
+		require.NoError(t, err, name)
+		require.Len(t, repo.violations, 1, name)
+		assert.Equal(t, tc.want, repo.violations[0].Limit, name)
+	}
+}
+
+func TestEvaluateDriverFeasibility_ReadsOnlyTheCallersTeamAndAtMostTheCap(t *testing.T) {
+	t.Parallel()
+
+	repo := &hosReadRepo{}
+	managers := []pulid.ID{pulid.MustNew("usr_")}
+
+	_, err := (&Service{repo: repo}).EvaluateDriverFeasibility(t.Context(), &FeasibilityRequest{
+		ManagerIDs: managers,
+	})
+
+	require.NoError(t, err)
+	require.Len(t, repo.states, 1)
+	assert.Equal(t, managers, repo.states[0].ManagerIDs)
+	assert.Equal(t, telematicsports.MaxWorkerHOSStates, repo.states[0].Limit)
+}
