index 78c5211a7..f0f54aa7f 100644
--- a/services/tms/internal/modules/workforce/app/timesheetservice/service.go
+++ b/services/tms/internal/modules/workforce/app/timesheetservice/service.go
@@ -33,7 +33,8 @@ const (
 	secondsPerMinute = int64(60)
 	// workingDaysInWeek turns a week's overtime threshold into one standard
 	// day, which is how a day of approved time off becomes minutes on a sheet.
-	workingDaysInWeek = 5
+	workingDaysInWeek     = 5
+	punchClockSkewSeconds = secondsPerMinute
 )
 
 // WorkerReader is the slice of the roster this service needs: who somebody is,
@@ -222,14 +223,8 @@ func (s *Service) ClockIn(
 	if at <= 0 {
 		at = timeutils.NowUnix()
 	}
-	// A punch dated into the future would sit on a week nobody can approve yet
-	// and would grow on its own until somebody closed it.
-	if at > timeutils.NowUnix()+secondsPerMinute {
-		return nil, errortypes.NewValidationError(
-			"clockedInAt",
-			errortypes.ErrInvalid,
-			"A punch cannot be dated in the future",
-		)
+	if err = refuseFuturePunch("clockedInAt", at); err != nil {
+		return nil, err
 	}
 
 	sheet, err := s.openSheetFor(ctx, req.TenantInfo, req.WorkerID, at)
@@ -305,6 +300,9 @@ func (s *Service) ClockOut(
 	if at <= 0 {
 		at = timeutils.NowUnix()
 	}
+	if err = refuseFuturePunch("clockedOutAt", at); err != nil {
+		return nil, err
+	}
 
 	previous := *open
 	open.ClockedOutAt = &at
@@ -373,6 +371,13 @@ func (s *Service) RecordEntry(
 		)
 	}
 
+	if err := refuseFuturePunch("clockedInAt", req.ClockedInAt); err != nil {
+		return nil, err
+	}
+	if err := refuseFuturePunch("clockedOutAt", req.ClockedOutAt); err != nil {
+		return nil, err
+	}
+
 	var (
 		entity   *worker.TimeClockEntry
 		previous *worker.TimeClockEntry
@@ -554,6 +559,18 @@ func (s *Service) DeleteEntry(ctx context.Context, req *DeleteEntryRequest) erro
 	return nil
 }
 
+func refuseFuturePunch(field string, at int64) error {
+	if at <= timeutils.NowUnix()+punchClockSkewSeconds {
+		return nil
+	}
+
+	return errortypes.NewValidationError(
+		field,
+		errortypes.ErrInvalid,
+		"A punch cannot be dated in the future",
+	)
+}
+
 func (s *Service) requireEditableSheet(
