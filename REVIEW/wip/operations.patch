+func requireComplianceRefusal(t *testing.T, err error) {
+	t.Helper()
+
+	require.Error(t, err)
+	multiErr, ok := err.(*errortypes.MultiError) //nolint:errorlint // the service returns it unwrapped
+	require.True(t, ok, "a refusal names each blocking finding: %v", err)
+	require.Len(t, multiErr.Errors, 1)
+	assert.Equal(t, "primaryWorker.licenseExpiry", multiErr.Errors[0].Field)
+	assert.Equal(t, errortypes.ErrComplianceViolation, multiErr.Errors[0].Code)
+	assert.Equal(
+		t,
+		"Commercial driver's license is expired (49 CFR 391.11(b)(5))",
+		multiErr.Errors[0].Message,
+	)
+}
