+func (f *stopReviewFixture) hosTeam(t *testing.T) hosTeam {
+	t.Helper()
+
+	w := workerdb.Workers
+	ids, err := keel.Into[pulid.ID](f.ctx, f.db, w.Pick(w.ID).Order(w.ID.Asc()).Limit(3))
+	require.NoError(t, err)
+	require.Len(t, ids, 3)
+
+	u := tenantdb.Users
+	managerID, err := keel.IntoOne[pulid.ID](f.ctx, f.db, u.AllTenants().Pick(u.ID).Order(u.ID.Asc()).Limit(1))
+	require.NoError(t, err)
+
+	_, err = w.Where(w.ID.In(ids...)).
+		Update(f.ctx, f.db, w.ManagerID.ToNull(), w.FleetCodeID.ToNull())
+	require.NoError(t, err)
+	_, err = w.Where(w.ID.Eq(ids[0])).Update(f.ctx, f.db, w.ManagerID.To(managerID))
+	require.NoError(t, err)
+
+	states := make([]*telematics.WorkerHOSState, 0, len(ids))
+	violations := make([]*telematics.WorkerHOSViolation, 0, len(ids))
+	for i, id := range ids {
+		states = append(states, &telematics.WorkerHOSState{
+			OrganizationID:   f.tenantInfo.OrgID,
+			BusinessUnitID:   f.tenantInfo.BuID,
+			WorkerID:         id,
+			Provider:         "Samsara",
