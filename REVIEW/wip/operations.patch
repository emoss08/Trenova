+	assert.Zero(t, f.updated)
+}
+
+func TestAssignToMove_AnOverrideAssignsTheDriverAndAuditsTheReason(t *testing.T) {
+	t.Parallel()
+
+	f := newComplianceFixture(t, complianceFixtureParams{
+		level:  dispatchcontrol.ComplianceEnforcementLevelBlock,
+		driver: expiredLicenseDriver(pulid.MustNew("wrk_")),
+	})
+
+	entity, err := f.svc.AssignToMove(t.Context(), f.assignRequest(&shipmentports.ComplianceOverride{
+		Reason: "  Renewed license seen at the counter; DMV record updates tomorrow ",
+	}))
+
+	require.NoError(t, err)
+	require.NotNil(t, entity)
+	assert.Equal(t, 1, f.created)
+	require.Len(t, f.audits.calls, 1)
+	call := f.audits.calls[0]
+	assert.Equal(t, permission.ResourceShipmentMove, call.params.Resource)
+	assert.Equal(t, permission.OpApprove, call.params.Operation)
+	assert.Equal(t, f.moveID.String(), call.params.ResourceID)
+	assert.Equal(t, f.tenantInfo.UserID, call.params.UserID)
+	assert.Equal(t, entity.ID.String(), call.params.CurrentState["assignmentId"])
+	assert.Equal(t, f.driverID.String(), call.params.CurrentState["primaryWorkerId"])
+	entry := call.entries[0]
+	assert.Equal(
+		t,
+		"Compliance override: Renewed license seen at the counter; DMV record updates tomorrow",
+		entry.Comment,
+	)
+	assert.True(t, entry.Critical)
+	override, ok := entry.Metadata["complianceOverride"].(map[string]any)
+	require.True(t, ok)
+	assert.Equal(
+		t,
+		"Renewed license seen at the counter; DMV record updates tomorrow",
+		override["reason"],
+	)
+	assert.Equal(t, []map[string]string{{
+		"worker":     "primaryWorker",
+		"code":       "driver.license_expired",
+		"message":    "Commercial driver's license is expired (49 CFR 391.11(b)(5))",
+		"regulation": "49 CFR 391.11(b)(5)",
+	}}, override["findings"])
+}
