 		cachedOrg, err := r.cache.GetByID(ctx, req.TenantInfo.OrgID)
-		if err == nil && cachedOrg.ID.IsNotNil() &&
-			cachedOrg.BusinessUnitID == req.TenantInfo.BuID {
+		if err == nil && cachedOrgVisible(ctx, req.TenantInfo, cachedOrg) {
 			needsRefresh := (req.IncludeState && cachedOrg.State == nil) ||
 				(req.IncludeBU && cachedOrg.BusinessUnit == nil)
 			if !needsRefresh {
@@ -108,6 +107,18 @@ func (r *repository) GetByID(
 	})
 }
 
+func cachedOrgVisible(
+	ctx context.Context,
+	requested pagination.TenantInfo,
+	cached *tenant.Organization,
+) bool {
+	if cached == nil || cached.ID.IsNil() || cached.BusinessUnitID != requested.BuID {
+		return false
+	}
+	scope, ok := dbscope.TenantFrom(ctx)
+	return ok && scope.OrganizationID == cached.ID && scope.BusinessUnitID == cached.BusinessUnitID
+}
