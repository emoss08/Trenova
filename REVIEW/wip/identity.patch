+func (r *repository) GetAssignment(
+	ctx context.Context,
+	req permissionports.GetRoleAssignmentRequest,
+) (*permission.UserRoleAssignment, error) {
+	return dbtx.Read(ctx, r.db, func(ctx context.Context) (*permission.UserRoleAssignment, error) {
+		ura := permissiondb.UserRoleAssignments
+		assignment, err := forTenant(
+			ctx,
+			ura.Query(),
+			ura.ID.Eq(req.AssignmentID),
+			ura.OrganizationID.Eq(req.OrganizationID),
+		).Load(ura.Role()).One(ctx, r.db.Keel(ctx))
+		if err != nil {
+			return nil, assignmentErrors.Map(err, req.AssignmentID.String())
+		}
+
+		return assignment, nil
+	})
+}
+
+func (r *repository) AdministeredOrganizations(
+	ctx context.Context,
+	req permissionports.AdministeredOrganizationsRequest,
+) ([]pulid.ID, error) {
+	ctx = dbscope.WithSystem(ctx, administratorsReason)
+	return dbtx.Read(ctx, r.db, func(ctx context.Context) ([]pulid.ID, error) {
+		organizations, err := keel.Into[pulid.ID](
+			ctx,
+			r.db.Keel(ctx),
+			administeredOrganizationsQuery(&req),
+		)
+		if err != nil {
+			r.l.Error("failed to find administered organizations", zap.Error(err))
+			return nil, err
+		}
+		if organizations == nil {
+			return []pulid.ID{}, nil
+		}
+
+		return organizations, nil
+	})
+}
+
+func administeredOrganizationsQuery(
+	req *permissionports.AdministeredOrganizationsRequest,
+) *keel.Query[*permission.UserRoleAssignment] {
+	ura := permissiondb.UserRoleAssignments
+	ro := permissiondb.Roles
+	u := tenantdb.Users
+
+	return ura.Query().
+		AllTenants().
+		Join(ro, ro.ID.EqCol(ura.RoleID), ro.OrganizationID.EqCol(ura.OrganizationID)).
+		Join(u, u.ID.EqCol(ura.UserID)).
+		Distinct().
+		Pick(ura.OrganizationID).
+		Where(
+			ro.BusinessUnitID.Eq(req.BusinessUnitID),
+			ro.IsSystem.Eq(true),
+			ro.Name.Eq(permission.AdministratorRoleName),
+			keel.Or(ura.ExpiresAt.IsNull(), ura.ExpiresAt.Gt(req.Now)),
+			u.Status.Eq(domaintypes.StatusActive),
+			u.IsLocked.Eq(false),
+			keel.When(len(req.OrganizationIDs) > 0, ura.OrganizationID.In(req.OrganizationIDs...)),
+			keel.When(len(req.HolderIDs) > 0, ura.UserID.In(req.HolderIDs...)),
+			keel.When(len(req.ExcludeUserIDs) > 0, keel.Not(ura.UserID.In(req.ExcludeUserIDs...))),
+			keel.When(
+				len(req.ExcludeAssignmentIDs) > 0,
+				keel.Not(ura.ID.In(req.ExcludeAssignmentIDs...)),
+			),
+		)
+}
