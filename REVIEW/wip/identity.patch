@@ -0,0 +1,130 @@
+package outrank
+
+import (
+	"context"
+
+	"github.com/emoss08/trenova/internal/modules/identity/domain/permission"
+	"github.com/emoss08/trenova/internal/modules/identity/ports/permissionports"
+	"github.com/emoss08/trenova/internal/modules/identity/ports/tenantports"
+	"github.com/emoss08/trenova/pkg/authctx"
+	"github.com/emoss08/trenova/pkg/dbscope"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/emoss08/trenova/shared/pulid"
+	"go.uber.org/fx"
+)
+
+type Params struct {
+	fx.In
+
+	Permissions permissionports.PermissionEngine
+	Users       tenantports.UserRepository
+}
+
+type Checker struct {
+	permissions permissionports.PermissionEngine
+	users       tenantports.UserRepository
+}
+
+func New(p Params) *Checker {
+	return &Checker{permissions: p.Permissions, users: p.Users}
+}
+
+func (c *Checker) RequireActorCoversTarget(
+	ctx context.Context,
+	actor pagination.TenantInfo,
+	targetID pulid.ID,
+) error {
+	if targetID.IsNil() || targetID == actor.UserID {
+		return nil
+	}
+
+	memberships, err := c.users.ListOrganizationMemberships(ctx, targetID, actor.BuID)
+	if err != nil {
+		return err
+	}
+	for _, membership := range memberships {
+		if membership == nil || membership.OrganizationID == actor.OrgID {
+			continue
+		}
+		allowed, checkErr := c.MayManageUsersIn(
+			ctx,
+			actor.UserID,
+			membership.OrganizationID,
+			membership.BusinessUnitID,
+		)
+		if checkErr != nil {
+			return checkErr
+		}
+		if !allowed {
+			return ErrTargetOutranksActor()
+		}
+	}
+
+	held, err := c.permissions.GetEffectivePermissions(ctx, actor.UserID, actor.OrgID)
+	if err != nil {
+		return err
+	}
+	theirs, err := c.permissions.GetEffectivePermissions(ctx, targetID, actor.OrgID)
+	if err != nil {
+		return err
+	}
+	if !held.MaxSensitivity.CanAccess(theirs.MaxSensitivity) {
+		return ErrTargetOutranksActor()
+	}
+	for resource, grant := range theirs.Resources {
+		if _, violated := held.DelegationViolation(
+			resource,
+			grant.Operations,
+			grant.DataScope,
+		); violated {
+			return ErrTargetOutranksActor()
+		}
+	}
+
+	return nil
+}
+
+func (c *Checker) MayManageUsersIn(
+	ctx context.Context,
+	actorID, orgID, buID pulid.ID,
+) (bool, error) {
+	return c.mayUsersIn(ctx, actorID, orgID, buID, permission.OpUpdate)
+}
+
+func (c *Checker) MayReadUsersIn(ctx context.Context, actorID, orgID, buID pulid.ID) (bool, error) {
+	return c.mayUsersIn(ctx, actorID, orgID, buID, permission.OpRead)
+}
+
+func (c *Checker) mayUsersIn(
+	ctx context.Context,
+	actorID, orgID, buID pulid.ID,
+	operation permission.Operation,
+) (bool, error) {
+	checkCtx := authctx.WithoutSessionRoleActivation(dbscope.WithTenant(ctx, dbscope.Tenant{
+		OrganizationID: orgID,
+		BusinessUnitID: buID,
+		UserID:         actorID,
+	}))
+
+	result, err := c.permissions.Check(checkCtx, &permissionports.PermissionCheckRequest{
+		PrincipalType:  permissionports.PrincipalTypeUser,
+		PrincipalID:    actorID,
+		UserID:         actorID,
+		BusinessUnitID: buID,
+		OrganizationID: orgID,
+		Resource:       permission.ResourceUser.String(),
+		Operation:      operation,
+	})
+	if err != nil {
+		return false, err
+	}
+
+	return result.Allowed, nil
+}
+
+func ErrTargetOutranksActor() error {
+	return errortypes.NewAuthorizationError(
+		"You can change another person's sign-in only when your own access covers everything theirs does",
+	)
+}
