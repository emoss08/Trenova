+//go:build integration
+
+package organizationrepository_test
+
+import (
+	"testing"
+
+	"github.com/emoss08/trenova/internal/modules/identity/adapters/postgres/organizationrepository"
+	"github.com/emoss08/trenova/internal/modules/identity/ports/tenantports"
+	"github.com/emoss08/trenova/internal/testutil/dbtest"
+	"github.com/emoss08/trenova/internal/testutil/mocks/tenantportsmock"
+	"github.com/emoss08/trenova/internal/testutil/seedtest"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/stretchr/testify/mock"
+	"go.uber.org/zap"
+)
+
+func TestGetByID_ServesACachedOrganizationOnlyToItsOwnTenant(t *testing.T) {
+	ctx, admin, dsn, cleanup := seedtest.SetupTestDBWithDSN(t)
+	t.Cleanup(cleanup)
+
+	tenantA := seedtest.SeedFullTestData(t, ctx, admin)
+	tenantB := seedtest.SeedAdditionalTenant(t, ctx, admin, "OCB")
+
+	cache := tenantportsmock.NewMockOrganizationCacheRepository(t)
+	cache.EXPECT().GetByID(mock.Anything, tenantB.Organization.ID).Return(tenantB.Organization, nil)
+	cache.EXPECT().GetByID(mock.Anything, tenantA.Organization.ID).Return(tenantA.Organization, nil)
+
+	repo := organizationrepository.New(organizationrepository.Params{
+		DB:     dbtest.NewRLSConnection(t, admin, dsn),
+		Logger: zap.NewNop(),
+		Cache:  cache,
+	})
+
+	t.Run("another tenant's cached organization is refused like the database refuses it", func(t *testing.T) {
+		org, err := repo.GetByID(tenantA.Ctx(ctx), tenantports.GetOrganizationByIDRequest{
+			TenantInfo: tenantB.Info(),
+		})
+		require.Error(t, err)
+		assert.True(t, errortypes.IsNotFoundError(err), "got %v", err)
+		assert.Nil(t, org)
+	})
+
+	t.Run("the tenant's own cached organization is served", func(t *testing.T) {
+		org, err := repo.GetByID(tenantA.Ctx(ctx), tenantports.GetOrganizationByIDRequest{
+			TenantInfo: tenantA.Info(),
+		})
+		require.NoError(t, err)
+		assert.Equal(t, tenantA.Organization.ID, org.ID)
+	})
+}
