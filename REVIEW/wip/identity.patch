+package reportaccess_test
+
+import (
+	"testing"
+
+	"github.com/emoss08/keel"
+	"github.com/emoss08/trenova/internal/modules/identity/domain/permission"
+	"github.com/emoss08/trenova/internal/modules/workspace/app/reporting/reportaccess"
+	"github.com/emoss08/trenova/internal/testutil/keeltest"
+	"github.com/emoss08/trenova/internal/testutil/permtest"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/emoss08/trenova/shared/pulid"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func (f *fixture) accessFor(t *testing.T, userID pulid.ID) *reportaccess.Access {
+	t.Helper()
+	access, err := f.resolver.For(t.Context(), pagination.TenantInfo{
+		OrgID:  keeltest.TestOrganizationID,
+		BuID:   keeltest.TestBusinessUnitID,
+		UserID: userID,
+	}, reportaccess.ModeRead)
+	require.NoError(t, err)
+	return access
+}
+
+func (f *fixture) renderRows(t *testing.T, access *reportaccess.Access, entity string) (string, []any) {
+	t.Helper()
+	e, ok := f.catalog.Entity(entity)
+	require.True(t, ok)
+	return keeltest.Render(t, keel.DynFrom(e.Table).Where(access.Rows(t.Context(), e)...))
+}
+
+func TestRows_AReportDefinitionIsVisibleToItsOwnerOrWhenShared(t *testing.T) {
+	t.Parallel()
+
+	f := newFixture(t, permission.AllFieldGroups())
+	viewer := pulid.MustNew("usr_")
+
+	sql, args := f.renderRows(t, f.accessFor(t, viewer), "report_definition")
+
+	assert.Contains(t, sql, `AND ((rd."owner_id" = $3) OR (rd."visibility" = 'shared'))`)
+	assert.Equal(t, []any{"bu_1", "org_1", viewer.String()}, args)
+}
+
+func TestRows_AnOwnScopeGrantNarrowsReportDefinitionsToTheOwner(t *testing.T) {
+	t.Parallel()
+
+	f := newFixture(t, permission.AllFieldGroups())
+	f.engine.Overrides[permission.ResourceReport.String()] = permtest.Grant{
+		Operations:     []permission.Operation{permission.OpRead},
+		DataScope:      permission.DataScopeOwn,
+		MaxSensitivity: permission.SensitivityConfidential,
+	}
+	viewer := pulid.MustNew("usr_")
+	access := f.accessFor(t, viewer)
+
+	definition, ok := f.catalog.Entity("report_definition")
+	require.True(t, ok)
+	assert.Len(t, access.Rows(t.Context(), definition), 2,
+		"the private-report rule and the own-scope rule both apply")
+}
+
+func TestRows_AReportRunIsVisibleOnlyToWhoeverRequestedIt(t *testing.T) {
+	t.Parallel()
+
+	f := newFixture(t, permission.AllFieldGroups())
+	viewer := pulid.MustNew("usr_")
+
+	sql, args := f.renderRows(t, f.accessFor(t, viewer), "report_run")
+
+	assert.Contains(t, sql, `."organization_id" = $2 AND `)
+	assert.Contains(t, sql, `."requested_by_id" = $3`)
+	assert.NotContains(t, sql, ` OR `)
+	assert.Equal(t, []any{"bu_1", "org_1", viewer.String()}, args)
+}
+
+func TestRows_AKindWithoutPrivateRecordsHasNoRowRuleAtOrganizationScope(t *testing.T) {
+	t.Parallel()
+
+	f := newFixture(t, permission.AllFieldGroups())
+	customer, ok := f.catalog.Entity("customer")
+	require.True(t, ok)
+
+	assert.Empty(t, f.accessFor(t, pulid.MustNew("usr_")).Rows(t.Context(), customer))
+}
