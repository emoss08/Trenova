+func (s *Service) splitVisibleMemberships(
+	ctx context.Context,
+	actor pagination.TenantInfo,
+	userID pulid.ID,
+	memberships []*tenant.OrganizationMembership,
+) (visible []*tenant.OrganizationMembership, hidden []pulid.ID, err error) {
+	if userID == actor.UserID {
+		return memberships, nil, nil
+	}
+
+	visible = make([]*tenant.OrganizationMembership, 0, len(memberships))
+	for _, membership := range memberships {
+		if membership == nil {
+			continue
+		}
+		readable := membership.OrganizationID == actor.OrgID
+		if !readable {
+			readable, err = s.outrank.MayReadUsersIn(
+				ctx,
+				actor.UserID,
+				membership.OrganizationID,
+				membership.BusinessUnitID,
+			)
+			if err != nil {
+				return nil, nil, err
+			}
+		}
+		if readable {
+			visible = append(visible, membership)
+			continue
+		}
+		hidden = append(hidden, membership.OrganizationID)
+	}
+
+	return visible, hidden, nil
+}
+
+func keepHiddenOrganizations(desired, hidden []pulid.ID) []pulid.ID {
+	kept := slices.Clone(desired)
+	for _, orgID := range hidden {
+		if !slices.Contains(kept, orgID) {
+			kept = append(kept, orgID)
+		}
+	}
+	return kept
+}
+
+func removedOrganizationIDs(
+	previous []*tenant.OrganizationMembership,
+	desired []pulid.ID,
+) []pulid.ID {
+	removed := make([]pulid.ID, 0, len(previous))
+	for _, membership := range previous {
+		if !slices.Contains(desired, membership.OrganizationID) {
+			removed = append(removed, membership.OrganizationID)
+		}
+	}
+	return removed
+}
+
+func (s *Service) guardMembershipRemoval(
+	ctx context.Context,
+	actor pagination.TenantInfo,
+	userID pulid.ID,
+	removed []pulid.ID,
+) error {
+	if len(removed) == 0 {
+		return nil
+	}
+	if err := s.outrank.RequireActorCoversTarget(ctx, actor, userID); err != nil {
+		return err
+	}
+
+	return s.admins.RequireAdministratorsRemainWithoutUsers(ctx, &adminguard.UsersRemoval{
+		BusinessUnitID:  actor.BuID,
+		OrganizationIDs: removed,
+		UserIDs:         []pulid.ID{userID},
+	})
+}
