+	assert.Empty(t, found.Items[0].SenderEmail)
+	assert.Empty(t, found.Items[0].ReplyToEmail)
+	assert.Empty(t, found.Items[0].SenderName)
+
+	assert.Empty(t, options("hidden-sender").Items)
