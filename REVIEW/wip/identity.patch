+package adminguard
+
+import (
+	"context"
+	"slices"
+
+	"github.com/emoss08/trenova/internal/modules/identity/ports/permissionports"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/shared/pulid"
+	"github.com/emoss08/trenova/shared/timeutils"
+	"go.uber.org/fx"
+)
+
+type Params struct {
+	fx.In
+
+	Roles permissionports.RoleRepository
+}
+
+type Guard struct {
+	roles permissionports.RoleRepository
+}
+
+func New(p Params) *Guard {
+	return &Guard{roles: p.Roles}
+}
+
+type UsersRemoval struct {
+	BusinessUnitID  pulid.ID
+	OrganizationIDs []pulid.ID
+	UserIDs         []pulid.ID
+}
+
+func (g *Guard) RequireAdministratorsRemainWithoutUsers(
+	ctx context.Context,
+	removal *UsersRemoval,
+) error {
+	if len(removal.UserIDs) == 0 {
+		return nil
+	}
+
+	now := timeutils.NowUnix()
+	administered, err := g.roles.AdministeredOrganizations(
+		ctx,
+		permissionports.AdministeredOrganizationsRequest{
+			BusinessUnitID:  removal.BusinessUnitID,
+			OrganizationIDs: removal.OrganizationIDs,
+			HolderIDs:       removal.UserIDs,
+			Now:             now,
+		},
+	)
+	if err != nil || len(administered) == 0 {
+		return err
+	}
+
+	remaining, err := g.roles.AdministeredOrganizations(
+		ctx,
+		permissionports.AdministeredOrganizationsRequest{
+			BusinessUnitID:  removal.BusinessUnitID,
+			OrganizationIDs: administered,
+			ExcludeUserIDs:  removal.UserIDs,
+			Now:             now,
+		},
+	)
+	if err != nil {
+		return err
+	}
+
+	return requireEveryOrganizationRemains(administered, remaining)
+}
+
+func (g *Guard) RequireAdministratorsRemainWithoutAssignment(
+	ctx context.Context,
+	businessUnitID, organizationID, assignmentID pulid.ID,
+) error {
+	now := timeutils.NowUnix()
+	administered, err := g.roles.AdministeredOrganizations(
+		ctx,
+		permissionports.AdministeredOrganizationsRequest{
+			BusinessUnitID:  businessUnitID,
+			OrganizationIDs: []pulid.ID{organizationID},
+			Now:             now,
+		},
+	)
+	if err != nil || len(administered) == 0 {
+		return err
+	}
+
+	remaining, err := g.roles.AdministeredOrganizations(
+		ctx,
+		permissionports.AdministeredOrganizationsRequest{
+			BusinessUnitID:       businessUnitID,
+			OrganizationIDs:      administered,
+			ExcludeAssignmentIDs: []pulid.ID{assignmentID},
+			Now:                  now,
+		},
+	)
+	if err != nil {
+		return err
+	}
+
+	return requireEveryOrganizationRemains(administered, remaining)
+}
+
+func requireEveryOrganizationRemains(before, after []pulid.ID) error {
+	for _, orgID := range before {
+		if !slices.Contains(after, orgID) {
+			return ErrLastAdministrator()
+		}
+	}
+
+	return nil
+}
+
+func ErrLastAdministrator() error {
+	return errortypes.NewBusinessError(
+		"This would leave an organization without an active administrator. Make someone else an Organization Administrator first.",
+	)
+}
