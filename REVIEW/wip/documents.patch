+
+func TestRequireReadable_HoldsADocumentToTheRecordItBelongsTo(t *testing.T) {
+	t.Parallel()
+
+	person := testutil.NewSessionActor(pulid.MustNew("usr_"), orgID, buID)
+	drugTest := &document.Document{
+		ID:           pulid.MustNew("doc_"),
+		ResourceType: "worker",
+		OriginalName: "dot-drug-test.pdf",
+	}
+	pod := &document.Document{ID: pulid.MustNew("doc_"), ResourceType: "Shipment"}
+
+	dispatcher := documentstest.Access(denying(permission.ResourceWorker), nil)
+	err := dispatcher.RequireReadable(t.Context(), person, []*document.Document{drugTest})
+	require.Error(t, err)
+	assert.True(t, errortypes.IsAuthorizationError(err))
+	var refused *errortypes.AuthorizationError
+	require.ErrorAs(t, err, &refused)
+	assert.Equal(t, "You do not have permission to read {0}", refused.Message)
+	assert.Equal(t, []any{"dot-drug-test.pdf"}, refused.Args)
+
+	err = dispatcher.RequireReadable(t.Context(), person, []*document.Document{pod, drugTest})
+	require.Error(t, err, "one unreadable document refuses the whole read")
+
+	require.NoError(t, dispatcher.RequireReadable(t.Context(), person, []*document.Document{pod}))
+
+	noDocuments := documentstest.Access(denying(permission.ResourceDocument), nil)
+	err = noDocuments.RequireReadable(t.Context(), person, []*document.Document{pod})
+	require.Error(t, err)
+	assert.True(t, errortypes.IsAuthorizationError(err))
+
+	err = dispatcher.RequireReadable(t.Context(), nil, []*document.Document{pod})
+	require.Error(t, err)
+	assert.True(t, errortypes.IsAuthorizationError(err))
+}
+
+func TestRequireReadable_KeepsAConversationsFilesToItsOwner(t *testing.T) {
+	t.Parallel()
+
+	owner := testutil.NewSessionActor(pulid.MustNew("usr_"), orgID, buID)
+	colleague := testutil.NewSessionActor(pulid.MustNew("usr_"), orgID, buID)
+	integration := testutil.NewAPIKeyActor(pulid.MustNew("apk_"), orgID, buID)
+	thread := pulid.MustNew("athr_")
+	attached := &document.Document{
+		ID:           pulid.MustNew("doc_"),
+		ResourceType: document.ConversationResourceType,
+		ResourceID:   thread.String(),
+		OriginalName: "leave-request.pdf",
+	}
+	access := documentstest.Access(
+		denying(),
+		documentstest.ConversationOwners{thread: owner.UserID},
+	)
+
+	require.NoError(t, access.RequireReadable(t.Context(), owner, []*document.Document{attached}))
+
+	err := access.RequireReadable(t.Context(), colleague, []*document.Document{attached})
+	require.Error(t, err)
+	assert.True(t, errortypes.IsAuthorizationError(err))
+
+	err = access.RequireReadable(t.Context(), integration, []*document.Document{attached})
+	require.Error(t, err, "an API key is no one's conversation")
+
+	require.NoError(t, access.RequireResourceReadable(
+		t.Context(), owner, document.ConversationResourceType, thread.String(),
+	))
+	err = access.RequireResourceReadable(
+		t.Context(), colleague, document.ConversationResourceType, thread.String(),
+	)
+	require.Error(t, err)
+	assert.True(t, errortypes.IsAuthorizationError(err))
+}
+
+func TestRequireResourceReadable_HoldsARecordsDocumentsToTheRecord(t *testing.T) {
+	t.Parallel()
+
+	person := testutil.NewSessionActor(pulid.MustNew("usr_"), orgID, buID)
+	access := documentstest.Access(denying(permission.ResourceWorker), nil)
+
+	err := access.RequireResourceReadable(t.Context(), person, "worker", "wrk_1")
+	require.Error(t, err)
+	assert.True(t, errortypes.IsAuthorizationError(err))
+
+	err = access.RequireResourceReadable(t.Context(), person, "Worker", "wrk_1")
+	require.Error(t, err, "the resource type is read the way documents store it")
+
+	require.NoError(t, access.RequireResourceReadable(t.Context(), person, "shipment", "shp_1"))
+
+	err = access.RequireResourceReadable(t.Context(), person, "", "")
+	require.Error(t, err, "a record without a type is no record")
+}
+
+func TestReadableOwners_IsWhatThePersonMayReadWithoutConversations(t *testing.T) {
+	t.Parallel()
+
+	person := testutil.NewSessionActor(pulid.MustNew("usr_"), orgID, buID)
+	access := documentstest.Access(denying(permission.ResourceWorker), nil)
+
+	owners, err := access.ReadableOwners(t.Context(), person)
+	require.NoError(t, err)
+	assert.True(t, slices.Contains(owners, permission.ResourceShipment.String()))
+	assert.True(t, slices.Contains(owners, permission.ResourceInvoice.String()))
+	assert.False(t, slices.Contains(owners, permission.ResourceWorker.String()))
+	assert.False(t, slices.Contains(owners, permission.ResourceAssistant.String()),
+		"a conversation's files are listed only through the conversation")
+
+	_, err = documentstest.Access(denying(permission.ResourceDocument), nil).
+		ReadableOwners(t.Context(), person)
+	require.Error(t, err)
+	assert.True(t, errortypes.IsAuthorizationError(err))
+}
