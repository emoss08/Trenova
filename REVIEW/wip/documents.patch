index 000000000..c851df54e
--- /dev/null
+++ b/services/tms/internal/modules/workforce/app/driverportalservice/uploadlink.go
@@ -0,0 +1,48 @@
+package driverportalservice
+
+import (
+	"context"
+
+	"github.com/emoss08/trenova/internal/modules/documents/domain/document"
+	"github.com/emoss08/trenova/internal/modules/documents/ports/documentports"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/emoss08/trenova/shared/pulid"
+	"go.uber.org/zap"
+)
+
+type documentDiscarder func(
+	ctx context.Context,
+	req documentports.DeleteDocumentRequest,
+	userID pulid.ID,
+) error
+
+func linkOrDiscard[T any](
+	ctx context.Context,
+	log *zap.Logger,
+	discard documentDiscarder,
+	upload *uploadedDocument,
+	link func() (T, error),
+) (T, error) {
+	linked, err := link()
+	if err == nil {
+		return linked, nil
+	}
+
+	if discardErr := discard(context.WithoutCancel(ctx), documentports.DeleteDocumentRequest{
+		ID:         upload.doc.ID,
+		TenantInfo: upload.tenantInfo,
+	}, upload.userID); discardErr != nil {
+		log.Error("could not remove a driver upload whose record was not updated",
+			zap.String("documentId", upload.doc.ID.String()),
+			zap.Error(discardErr),
+		)
+	}
+
+	return linked, err
+}
+
+type uploadedDocument struct {
+	doc        *document.Document
+	tenantInfo pagination.TenantInfo
+	userID     pulid.ID
+}
diff --git a/services/tms/internal/modules/workforce/app/driverportalservice/uploadlink_test.go b/services/tms/internal/modules/workforce/app/driverportalservice/uploadlink_test.go
new file mode 100644
index 000000000..25811e6ba
--- /dev/null
+++ b/services/tms/internal/modules/workforce/app/driverportalservice/uploadlink_test.go
@@ -0,0 +1,94 @@
+package driverportalservice
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/emoss08/trenova/internal/modules/documents/domain/document"
+	"github.com/emoss08/trenova/internal/modules/documents/ports/documentports"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/emoss08/trenova/shared/pulid"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+)
+
+type recordedDiscard struct {
+	requests []documentports.DeleteDocumentRequest
+	users    []pulid.ID
+	err      error
+}
+
+func (r *recordedDiscard) discard(
+	_ context.Context,
+	req documentports.DeleteDocumentRequest,
+	userID pulid.ID,
+) error {
+	r.requests = append(r.requests, req)
+	r.users = append(r.users, userID)
+
+	return r.err
+}
+
+func receiptUpload() *uploadedDocument {
+	return &uploadedDocument{
+		doc: &document.Document{ID: pulid.MustNew("doc_")},
+		tenantInfo: pagination.TenantInfo{
+			OrgID: pulid.MustNew("org_"),
+			BuID:  pulid.MustNew("bu_"),
+		},
+		userID: pulid.MustNew("usr_"),
+	}
+}
+
+func TestLinkOrDiscard_RemovesTheReceiptWhenTheExpenseIsNotUpdated(t *testing.T) {
+	t.Parallel()
+
+	upload := receiptUpload()
+	discards := &recordedDiscard{}
+	finalized := errortypes.NewValidationError(
+		"id",
+		errortypes.ErrInvalidOperation,
+		"This expense has already been finalized",
+	)
+
+	_, err := linkOrDiscard(t.Context(), zap.NewNop(), discards.discard, upload,
+		func() (*struct{}, error) { return nil, finalized })
+
+	require.ErrorIs(t, err, finalized)
+	require.Len(t, discards.requests, 1)
+	assert.Equal(t, documentports.DeleteDocumentRequest{
+		ID:         upload.doc.ID,
+		TenantInfo: upload.tenantInfo,
+	}, discards.requests[0])
+	assert.Equal(t, []pulid.ID{upload.userID}, discards.users)
+}
+
+func TestLinkOrDiscard_KeepsTheReceiptOnceLinked(t *testing.T) {
+	t.Parallel()
+
+	discards := &recordedDiscard{}
+	linked := &struct{ ok bool }{ok: true}
+
+	got, err := linkOrDiscard(t.Context(), zap.NewNop(), discards.discard, receiptUpload(),
+		func() (*struct{ ok bool }, error) { return linked, nil })
+
+	require.NoError(t, err)
+	assert.Same(t, linked, got)
+	assert.Empty(t, discards.requests)
+}
+
+func TestLinkOrDiscard_ReportsTheLinkFailureWhenTheCleanupFailsToo(t *testing.T) {
+	t.Parallel()
+
+	discards := &recordedDiscard{err: errors.New("storage down")}
+	conflict := errortypes.NewConflictError("The expense changed")
+
+	_, err := linkOrDiscard(t.Context(), zap.NewNop(), discards.discard, receiptUpload(),
+		func() (*struct{}, error) { return nil, conflict })
+
+	require.ErrorIs(t, err, conflict)
+	assert.Len(t, discards.requests, 1)
+}
diff --git a/services/tms/schema/migrations/20261231022760_document_owner_resource.sql b/services/tms/schema/migrations/20261231022760_document_owner_resource.sql
new file mode 100644
index 000000000..59281e7d3
--- /dev/null
+++ b/services/tms/schema/migrations/20261231022760_document_owner_resource.sql
@@ -0,0 +1,33 @@
+-- The permission resource whose read governs a document: its resource type in snake case, with
+-- the aliases document.OwnerResource names (a conversation's files are the assistant's, an
+-- invoice adjustment's the invoice's). Lists filter on it, so a person sees only the documents
+-- of records they may read. The function is the rule document.OwnerResource applies, and
+-- TestOwnerResourceColumnFollowsTheDomainRule holds the two together.
+CREATE OR REPLACE FUNCTION "document_owner_resource"(resource_type TEXT)
+    RETURNS TEXT
+    LANGUAGE sql
+    IMMUTABLE
+    PARALLEL SAFE
+    RETURN (
+        WITH normalized AS (
+            SELECT lower(
+                regexp_replace(
+                    regexp_replace(
+                        btrim(resource_type, E' \t\n\r\f\v'),
+                        '([^[:lower:]])([[:upper:]][[:lower:]])', '\1_\2', 'g'
+                    ),
+                    '([[:lower:]])([[:upper:]])', '\1_\2', 'g'
+                )
+            ) AS value
+        )
+        SELECT CASE value
+            WHEN 'assistant_thread' THEN 'assistant'
+            WHEN 'invoice_adjustment' THEN 'invoice'
+            ELSE value
+        END
+        FROM normalized
+    );
+
+ALTER TABLE "documents"
+    ADD COLUMN IF NOT EXISTS "owner_resource" VARCHAR(100)
+        GENERATED ALWAYS AS ("document_owner_resource"("resource_type")) STORED;
