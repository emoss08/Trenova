@@ -0,0 +1,44 @@
+package documentstest
+
+import (
+	"context"
+
+	"github.com/emoss08/trenova/internal/modules/documents/app/documentaccess"
+	"github.com/emoss08/trenova/internal/modules/documents/ports/documentports"
+	"github.com/emoss08/trenova/internal/modules/identity/domain/permission"
+	"github.com/emoss08/trenova/internal/modules/identity/ports/permissionports"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/emoss08/trenova/shared/pulid"
+)
+
+type ConversationOwners map[pulid.ID]pulid.ID
+
+func (o ConversationOwners) ConversationOwners(
+	_ context.Context,
+	_ pagination.TenantInfo,
+	conversationIDs []pulid.ID,
+) (map[pulid.ID]pulid.ID, error) {
+	owners := make(map[pulid.ID]pulid.ID, len(conversationIDs))
+	for _, id := range conversationIDs {
+		if owner, ok := o[id]; ok {
+			owners[id] = owner
+		}
+	}
+
+	return owners, nil
+}
+
+func Access(
+	engine permissionports.PermissionEngine,
+	conversations ConversationOwners,
+) documentports.DocumentReadAccess {
+	if conversations == nil {
+		conversations = ConversationOwners{}
+	}
+
+	return documentaccess.New(documentaccess.Params{
+		Permissions:   engine,
+		Registry:      permission.NewRegistry(),
+		Conversations: conversations,
+	})
+}
