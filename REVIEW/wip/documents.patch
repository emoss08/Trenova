new file mode 100644
index 000000000..21f42c1d2
--- /dev/null
+++ b/services/tms/internal/modules/documents/app/documentaccess/access.go
@@ -0,0 +1,244 @@
+package documentaccess
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/emoss08/trenova/internal/modules/documents/domain/document"
+	"github.com/emoss08/trenova/internal/modules/documents/ports/documentports"
+	"github.com/emoss08/trenova/internal/modules/identity/domain/permission"
+	"github.com/emoss08/trenova/internal/modules/identity/ports/permissionports"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/shared/pulid"
+	"go.uber.org/fx"
+)
+
+type Params struct {
+	fx.In
+
+	Permissions   permissionports.PermissionEngine
+	Registry      *permission.Registry
+	Conversations documentports.ConversationOwners
+}
+
+type Access struct {
+	permissions   permissionports.PermissionEngine
+	registry      *permission.Registry
+	conversations documentports.ConversationOwners
+}
+
+var _ documentports.DocumentReadAccess = (*Access)(nil)
+
+func New(p Params) documentports.DocumentReadAccess {
+	return &Access{
+		permissions:   p.Permissions,
+		registry:      p.Registry,
+		conversations: p.Conversations,
+	}
+}
+
+func (a *Access) RequireReadable(
+	ctx context.Context,
+	actor *permissionports.RequestActor,
+	docs []*document.Document,
+) error {
+	if err := requireActor(actor); err != nil {
+		return err
+	}
+
+	owners := make([]permission.Resource, 0, len(docs))
+	for _, doc := range docs {
+		if doc != nil {
+			owners = append(owners, doc.OwnerResource())
+		}
+	}
+
+	readable, err := a.ReadableResources(ctx, actor, owners)
+	if err != nil {
+		return err
+	}
+	if !readable[permission.ResourceDocument] {
+		return errortypes.NewAuthorizationError("You do not have permission to read documents")
+	}
+
+	conversationOwners, err := a.conversationOwners(ctx, actor, document.ConversationIDs(docs))
+	if err != nil {
+		return err
+	}
+
+	person := actor.PersonUserID()
+	for _, doc := range docs {
+		if doc == nil {
+			continue
+		}
+		if !readable[doc.OwnerResource()] || !doc.VisibleToPerson(conversationOwners, person) {
+			return errortypes.NewAuthorizationError(
+				"You do not have permission to read {0}",
+				doc.MailFileName(),
+			)
+		}
+	}
+
+	return nil
+}
+
+func (a *Access) RequireResourceReadable(
+	ctx context.Context,
+	actor *permissionports.RequestActor,
+	resourceType, resourceID string,
+) error {
+	if err := requireActor(actor); err != nil {
+		return err
+	}
+
+	owner := document.OwnerResource(resourceType)
+	readable, err := a.ReadableResources(ctx, actor, []permission.Resource{owner})
+	if err != nil {
+		return err
+	}
+	if !readable[permission.ResourceDocument] {
+		return errortypes.NewAuthorizationError("You do not have permission to read documents")
+	}
+	if owner == "" || !readable[owner] {
+		return errortypes.NewAuthorizationError(
+			"You do not have permission to read the documents of this record",
+		)
+	}
+
+	probe := &document.Document{ResourceType: resourceType, ResourceID: resourceID}
+	if !probe.OwnedByConversation() {
+		return nil
+	}
+
+	conversationOwners, err := a.conversationOwners(
+		ctx,
+		actor,
+		document.ConversationIDs([]*document.Document{probe}),
+	)
+	if err != nil {
+		return err
+	}
+	if !probe.VisibleToPerson(conversationOwners, actor.PersonUserID()) {
+		return errortypes.NewAuthorizationError(
+			"You do not have permission to read the documents of this record",
+		)
+	}
+
+	return nil
+}
+
+func (a *Access) ReadableOwners(
+	ctx context.Context,
+	actor *permissionports.RequestActor,
+) ([]string, error) {
+	if err := requireActor(actor); err != nil {
+		return nil, err
+	}
+
+	definitions := a.registry.All()
+	candidates := make([]permission.Resource, 0, len(definitions))
+	for _, definition := range definitions {
+		resource := permission.Resource(definition.Resource)
+		if resource == permission.ResourceAssistant {
+			continue
+		}
+		candidates = append(candidates, resource)
+	}
+
+	readable, err := a.ReadableResources(ctx, actor, candidates)
+	if err != nil {
+		return nil, err
+	}
+	if !readable[permission.ResourceDocument] {
+		return nil, errortypes.NewAuthorizationError(
+			"You do not have permission to read documents",
+		)
+	}
+
+	owners := make([]string, 0, len(candidates))
+	for _, resource := range candidates {
+		if readable[resource] {
+			owners = append(owners, resource.String())
+		}
+	}
+
+	return owners, nil
+}
+
+func (a *Access) ReadableResources(
+	ctx context.Context,
+	actor *permissionports.RequestActor,
+	resources []permission.Resource,
+) (map[permission.Resource]bool, error) {
+	if err := requireActor(actor); err != nil {
+		return nil, err
+	}
+
+	wanted := make([]permission.Resource, 0, len(resources)+1)
+	wanted = append(wanted, permission.ResourceDocument)
+	seen := make(map[permission.Resource]struct{}, len(resources)+1)
+	seen[permission.ResourceDocument] = struct{}{}
+	for _, resource := range resources {
+		if resource == "" {
+			continue
+		}
+		if _, dup := seen[resource]; dup {
+			continue
+		}
+		seen[resource] = struct{}{}
+		wanted = append(wanted, resource)
+	}
+
+	checks := make([]permissionports.ResourceOperationCheck, 0, len(wanted))
+	for _, resource := range wanted {
+		checks = append(checks, permissionports.ResourceOperationCheck{
+			Resource:  resource.String(),
+			Operation: permission.OpRead,
+		})
+	}
+
+	result, err := a.permissions.CheckBatch(ctx, &permissionports.BatchPermissionCheckRequest{
+		PrincipalType:  actor.PrincipalType,
+		PrincipalID:    actor.PrincipalID,
+		UserID:         actor.UserID,
+		APIKeyID:       actor.APIKeyID,
+		BusinessUnitID: actor.BusinessUnitID,
+		OrganizationID: actor.OrganizationID,
+		Checks:         checks,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("check which document owners the actor may read: %w", err)
+	}
+
+	readable := make(map[permission.Resource]bool, len(wanted))
+	for i, resource := range wanted {
+		readable[resource] = result != nil && i < len(result.Results) && result.Results[i].Allowed
+	}
+
+	return readable, nil
+}
+
+func (a *Access) conversationOwners(
+	ctx context.Context,
+	actor *permissionports.RequestActor,
+	ids []pulid.ID,
+) (map[pulid.ID]pulid.ID, error) {
+	if len(ids) == 0 || actor.PersonUserID().IsNil() {
+		return map[pulid.ID]pulid.ID{}, nil
+	}
+
+	owners, err := a.conversations.ConversationOwners(ctx, actor.TenantInfo(), ids)
+	if err != nil {
+		return nil, fmt.Errorf("read who owns the conversations documents are attached to: %w", err)
+	}
+
+	return owners, nil
+}
+
+func requireActor(actor *permissionports.RequestActor) error {
+	if actor == nil || actor.PrincipalID.IsNil() || actor.OrganizationID.IsNil() {
+		return errortypes.NewAuthorizationError("Sign in to read documents")
+	}
+
+	return nil
+}
