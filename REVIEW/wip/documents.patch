+func TestDocumentLists_FilterToTheOwnersThePersonMayRead(t *testing.T) {
+	t.Parallel()
+
+	repo := documentportsmock.NewMockDocumentRepository(t)
+	var listed, optioned []string
+	repo.EXPECT().List(mock.Anything, mock.Anything).RunAndReturn(func(
+		_ context.Context,
