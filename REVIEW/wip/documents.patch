+			d.ResourceType = resourceType
+		})
+		_, err := repo.Create(ctx, doc)
+		require.NoError(t, err, resourceType)
+		ids[doc.ID] = resourceType
+	}
+
+	type ownerRow struct {
+		ID    pulid.ID
+		Owner string
+	}
+	d := documentdb.Documents
+	keys := make([]pulid.ID, 0, len(ids))
+	for id := range ids {
+		keys = append(keys, id)
+	}
+	rows, err := keel.Into[ownerRow](ctx, conn.Keel(ctx), d.Pick(d.ID, d.Owner).
+		Where(d.ID.In(keys...)).
+		Limit(len(keys)))
+	require.NoError(t, err)
+	require.Len(t, rows, len(ids))
+
+	for _, row := range rows {
+		resourceType := ids[row.ID]
+		assert.Equal(t, document.OwnerResource(resourceType).String(), row.Owner, resourceType)
+	}
+}
+
+func TestDocumentList_ReadsOnlyTheOwnersItIsGiven(t *testing.T) {
+	repo, fixtures := setupRepository(t)
+	ctx := fixtures.ctx
+
+	shipmentDoc := createTestDocument(fixtures, func(d *document.Document) {
+		d.ResourceType = "shipment"
+		d.FileName = "pod.pdf"
+	})
+	workerDoc := createTestDocument(fixtures, func(d *document.Document) {
+		d.ResourceType = "Worker"
+		d.FileName = "drug-test.pdf"
+	})
+	for _, doc := range []*document.Document{shipmentDoc, workerDoc} {
+		_, err := repo.Create(ctx, doc)
+		require.NoError(t, err)
+	}
+
+	filter := func() *pagination.QueryOptions {
+		return &pagination.QueryOptions{
+			TenantInfo: pagination.TenantInfo{OrgID: fixtures.orgID, BuID: fixtures.buID},
+			Pagination: pagination.Info{Limit: 10},
+		}
+	}
+
+	listed, err := repo.List(ctx, &documentports.ListDocumentsRequest{
+		Filter: filter(),
+		Owners: []string{"shipment", "trailer"},
+	})
+	require.NoError(t, err)
+	require.Len(t, listed.Items, 1)
+	assert.Equal(t, shipmentDoc.ID, listed.Items[0].ID)
+	assert.Equal(t, 1, listed.Total, "the count is of the readable rows, so pages stay whole")
+
+	listed, err = repo.List(ctx, &documentports.ListDocumentsRequest{
+		Filter: filter(),
+		Owners: []string{"worker"},
+	})
+	require.NoError(t, err)
+	require.Len(t, listed.Items, 1)
+	assert.Equal(t, workerDoc.ID, listed.Items[0].ID)
+
+	listed, err = repo.List(ctx, &documentports.ListDocumentsRequest{Filter: filter()})
+	require.NoError(t, err)
+	assert.Empty(t, listed.Items, "a list with no readable owners reads nothing")
+
+	options, err := repo.SelectOptions(ctx, &documentports.DocumentSelectOptionsRequest{
+		SelectQueryRequest: &pagination.SelectQueryRequest{
+			TenantInfo: pagination.TenantInfo{OrgID: fixtures.orgID, BuID: fixtures.buID},
+			Pagination: pagination.Info{Limit: 10},
+		},
+		Owners: []string{"shipment"},
+	})
+	require.NoError(t, err)
+	require.Len(t, options.Items, 1)
+	assert.Equal(t, shipmentDoc.ID, options.Items[0].ID)
+}
