+package captureservice
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/emoss08/trenova/internal/infrastructure/config"
+	"github.com/emoss08/trenova/internal/modules/documents/domain/capture"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func printJobRefusal(t *testing.T, limits config.CaptureConfig, pages int) (*world, error) {
+	t.Helper()
+
+	w := newWorld()
+	s := w.service()
+	s.cfg.Capture = limits
+	principal := principalFor(t, s, pair(t, w, s))
+	batch, err := s.OpenBatch(t.Context(), principal, &OpenBatchInput{
+		ClientKey: "print-limits", Source: capture.SourcePrint, JobName: "statement.pdf",
+	})
+	require.NoError(t, err)
+
+	parts := make([][]byte, 0, pages)
+	for page := range pages {
+		parts = append(parts, pdfPage(t, uint8(page+1)))
+	}
+	_, err = s.PutPrintJob(t.Context(), principal, &PutPrintJobInput{
+		BatchID: batch.ID,
+		Body:    bytes.NewReader(mergePDFs(t, parts...)),
+	})
+
+	return w, err
+}
+
+func assertRefusedBody(t *testing.T, err error, message string) {
+	t.Helper()
+
+	require.Error(t, err)
+	var refused *errortypes.Error
+	require.ErrorAs(t, err, &refused)
+	assert.Equal(t, "body", refused.Field)
+	assert.Equal(t, message, refused.Message)
+}
+
+func TestPutPrintJob_RefusesMorePagesThanConfigured(t *testing.T) {
+	t.Parallel()
+
+	w, err := printJobRefusal(t, config.CaptureConfig{MaxPrintJobPages: 2}, 3)
+	assertRefusedBody(t, err, "A print job can have at most {0} pages")
+	assert.Empty(t, w.pages, "nothing is split or stored")
+}
+
+func TestPutPrintJob_RefusesAPageLargerThanConfigured(t *testing.T) {
+	t.Parallel()
+
+	w, err := printJobRefusal(t, config.CaptureConfig{MaxPrintPageBytes: 1}, 2)
+	assertRefusedBody(t, err, "The print job's pages are too large to store")
+	assert.Empty(t, w.pages)
+}
+
+func TestPutPrintJob_StopsWhenThePagesAddUpToMoreThanConfigured(t *testing.T) {
+	t.Parallel()
+
+	page := int64(len(pdfPage(t, 1)))
+	w, err := printJobRefusal(t, config.CaptureConfig{MaxPrintSplitBytes: page*2 + page/2}, 5)
+	assertRefusedBody(t, err, "The print job's pages are too large to store")
+	assert.Len(t, w.pages, 2, "the split stops at the bound, not after every page")
+}
+
+func TestPutPrintJob_StoresEachPageAsItIsSplit(t *testing.T) {
+	t.Parallel()
+
+	w, err := printJobRefusal(t, config.CaptureConfig{}, 4)
+	require.NoError(t, err)
+	assert.Len(t, w.pages, 4)
+}
