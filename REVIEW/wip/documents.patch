+++ b/services/tms/internal/modules/documents/app/documentservice/validator_test.go
@@ -0,0 +1,56 @@
+package documentservice
+
+import (
+	"testing"
+
+	"github.com/emoss08/trenova/internal/infrastructure/config"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func pdfOnlyValidator() *Validator {
+	return NewValidator(ValidatorParams{Config: &config.Config{Storage: config.StorageConfig{
+		AllowedMIMETypes: []string{"application/pdf"},
+		MaxFileSize:      1 << 20,
+	}}})
+}
+
+func TestValidateUploadMetadata_NeverLetsAnEmptyContentTypeSkipTheAllowList(t *testing.T) {
+	t.Parallel()
+
+	v := pdfOnlyValidator()
+
+	contentType, multiErr := v.ValidateUploadMetadata("payload.html", 10, "")
+	require.NotNil(t, multiErr)
+	assert.Empty(t, contentType)
+	require.Len(t, multiErr.Errors, 1)
+	assert.Equal(t, "file", multiErr.Errors[0].Field)
+	assert.Equal(t, errortypes.ErrInvalidFormat, multiErr.Errors[0].Code)
+	assert.Equal(t, "File type is not allowed", multiErr.Errors[0].Message)
+
+	contentType, multiErr = v.ValidateUploadMetadata("no-extension", 10, "")
+	require.NotNil(t, multiErr)
+	assert.Empty(t, contentType)
+	require.Len(t, multiErr.Errors, 1)
+	assert.Equal(t, "File type could not be determined", multiErr.Errors[0].Message)
+}
+
+func TestValidateUploadMetadata_ResolvesTheContentTypeItAllowed(t *testing.T) {
+	t.Parallel()
+
+	v := pdfOnlyValidator()
+
+	contentType, multiErr := v.ValidateUploadMetadata("bol.PDF", 10, "")
+	require.Nil(t, multiErr)
+	assert.Equal(t, "application/pdf", contentType, "detected from the extension")
+
+	contentType, multiErr = v.ValidateUploadMetadata("bol.pdf", 10, "application/pdf; name=bol.pdf")
+	require.Nil(t, multiErr)
+	assert.Equal(t, "application/pdf", contentType, "the declared type without its parameters")
+
+	_, multiErr = v.ValidateUploadMetadata("bol.pdf", 10, "text/html")
+	require.NotNil(t, multiErr)
+	assert.Equal(t, "File type is not allowed", multiErr.Errors[0].Message,
+		"a declared type is held to the allow list whatever the extension says")
+}
