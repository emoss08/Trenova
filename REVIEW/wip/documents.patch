+)
+
+func TestUploadSession_IsReachableOnlyByWhoOpenedIt(t *testing.T) {
+	t.Parallel()
+
+	tenant := pagination.TenantInfo{OrgID: pulid.MustNew("org_"), BuID: pulid.MustNew("bu_")}
+	opener := testutil.NewSessionActor(pulid.MustNew("usr_"), tenant.OrgID, tenant.BuID)
+	colleague := testutil.NewSessionActor(pulid.MustNew("usr_"), tenant.OrgID, tenant.BuID)
+	content := []byte("%PDF-1.7 drug test")
+	session := uploadSession(tenant, content)
+	session.CreatedByID = opener.UserID
+
+	sessions := documentuploadportsmock.NewMockDocumentUploadSessionRepository(t)
+	sessions.EXPECT().GetByID(mock.Anything, mock.Anything).Return(session, nil)
+	storage := objectstoretest.New()
+	storage.Put(session.StoragePath, content)
+	svc := &Service{
+		l:           zap.NewNop(),
+		sessionRepo: sessions,
+		storage:     storage,
+		encryption:  scanTestEncryption(),
+	}
+
+	assertHidden := func(t *testing.T, err error) {
+		t.Helper()
+		require.Error(t, err)
+		assert.True(t, errortypes.IsNotFoundError(err), "got %v", err)
+	}
+
+	_, err := svc.GetSessionState(t.Context(), &documentuploadports.SessionStateRequest{
+		TenantInfo: tenant,
+		Actor:      *colleague,
+		SessionID:  session.ID,
+	})
+	assertHidden(t, err)
+
+	_, err = svc.GetPartUploadTargets(t.Context(), &documentuploadports.PartRequest{
+		TenantInfo: tenant,
+		Actor:      *colleague,
+		SessionID:  session.ID,
+	})
+	assertHidden(t, err)
+
+	_, err = svc.UploadPart(t.Context(), &documentuploadports.UploadPartRequest{
+		TenantInfo: tenant,
+		Actor:      *colleague,
+		SessionID:  session.ID,
+		PartNumber: 1,
+		Body:       bytes.NewReader(content),
+		Size:       int64(len(content)),
+	})
+	assertHidden(t, err)
+
+	_, err = svc.Complete(t.Context(), &documentuploadports.CompletionRequest{
+		TenantInfo: tenant,
+		Actor:      *colleague,
+		SessionID:  session.ID,
+	})
+	assertHidden(t, err)
+
+	err = svc.Cancel(t.Context(), &documentuploadports.CancelRequest{
+		TenantInfo: tenant,
+		Actor:      *colleague,
+		SessionID:  session.ID,
+	})
+	assertHidden(t, err)
+	_, kept := storage.Object(session.StoragePath)
+	assert.True(t, kept, "a colleague's cancel deletes nothing")
+
+	targets, err := svc.GetPartUploadTargets(t.Context(), &documentuploadports.PartRequest{
+		TenantInfo: tenant,
+		Actor:      *opener,
+		SessionID:  session.ID,
+	})
+	require.NoError(t, err)
+	require.Len(t, targets, 1)
+	assert.Equal(t, 1, targets[0].PartNumber)
+}
+
+func TestUploadSession_WithoutAnOwnerIsNobodys(t *testing.T) {
+	t.Parallel()
+
+	tenant := pagination.TenantInfo{OrgID: pulid.MustNew("org_"), BuID: pulid.MustNew("bu_")}
+	session := uploadSession(tenant, []byte("%PDF-1.7"))
+	session.CreatedByID = pulid.Nil
+
+	sessions := documentuploadportsmock.NewMockDocumentUploadSessionRepository(t)
+	sessions.EXPECT().GetByID(mock.Anything, mock.Anything).Return(session, nil).Once()
+	svc := &Service{l: zap.NewNop(), sessionRepo: sessions}
+
+	_, err := svc.GetSessionState(t.Context(), &documentuploadports.SessionStateRequest{
+		TenantInfo: tenant,
+		Actor: *testutil.NewSessionActor(
+			pulid.MustNew("usr_"),
+			tenant.OrgID,
+			tenant.BuID,
+		),
+		SessionID: session.ID,
+	})
+	require.Error(t, err)
+	assert.True(t, errortypes.IsNotFoundError(err))
+}
+
+func TestListActive_ListsOnlyTheCallersOwnSessions(t *testing.T) {
+	t.Parallel()
+
+	tenant := pagination.TenantInfo{OrgID: pulid.MustNew("org_"), BuID: pulid.MustNew("bu_")}
+	opener := testutil.NewSessionActor(pulid.MustNew("usr_"), tenant.OrgID, tenant.BuID)
+
+	sessions := documentuploadportsmock.NewMockDocumentUploadSessionRepository(t)
+	var asked *documentuploadports.ListActiveDocumentUploadSessionsRequest
+	sessions.EXPECT().ListActive(mock.Anything, mock.Anything).RunAndReturn(func(
+		_ context.Context,
+		req *documentuploadports.ListActiveDocumentUploadSessionsRequest,
+	) ([]*documentupload.DocumentUploadSession, error) {
+		asked = req
+		return []*documentupload.DocumentUploadSession{}, nil
+	}).Once()
+	svc := &Service{l: zap.NewNop(), sessionRepo: sessions}
+
+	_, err := svc.ListActive(t.Context(), &documentuploadports.ListActiveDocumentUploadSessionsRequest{
+		TenantInfo:   tenant,
+		Actor:        *opener,
+		CreatedByID:  pulid.MustNew("usr_"),
+		ResourceType: "shipment",
+		ResourceID:   "shp_1",
+	})
+	require.NoError(t, err)
+	require.NotNil(t, asked)
+	assert.Equal(t, opener.UserID, asked.CreatedByID, "the caller cannot name another owner")
+}
