+	"github.com/stretchr/testify/require"
+)
+
+const drugTestPath = "org/worker/dot-drug-test.pdf"
+
+func workerDocument(id pulid.ID) *document.Document {
+	return &document.Document{
+		ID:                 id,
+		OrganizationID:     testutil.TestOrgID,
+		BusinessUnitID:     testutil.TestBuID,
+		FileName:           "dot-drug-test.pdf",
+		OriginalName:       "dot-drug-test.pdf",
+		FileType:           "application/pdf",
+		StoragePath:        drugTestPath,
+		PreviewStoragePath: drugTestPath + ".webp",
+		PreviewStatus:      document.PreviewStatusReady,
+		Status:             document.StatusActive,
+		ResourceType:       "worker",
+		ResourceID:         pulid.MustNew("wrk_").String(),
+	}
+}
+
+func serve(t *testing.T, deps *handlerDeps, method, path string) *testutil.GinTestContext {
+	t.Helper()
+
+	ginCtx := testutil.NewGinTestContext().
+		WithMethod(method).
+		WithPath(path).
+		WithDefaultAuthContext()
+	deps.handler.RegisterRoutes(ginCtx.Engine.Group("/api/v1"))
+	ginCtx.Engine.ServeHTTP(ginCtx.Recorder, ginCtx.Context.Request)
+
+	return ginCtx
+}
+
+func TestDocumentReads_RefuseAWorkersFileToAPersonWhoCannotReadWorkers(t *testing.T) {
+	t.Parallel()
+
+	docID := pulid.MustNew("doc_")
+	downloads := 0
+	repo := documentportsmock.NewMockDocumentRepository(t)
+	repo.EXPECT().GetByID(mock.Anything, mock.Anything).Return(workerDocument(docID), nil).Maybe()
+	repo.EXPECT().GetByIDs(mock.Anything, mock.Anything).
+		Return([]*document.Document{workerDocument(docID)}, nil).Maybe()
+	storage := &mockStorageClient{
+		downloadFunc: func(_ context.Context, _ string) (*kernelports.DownloadResult, error) {
+			downloads++
+			body := encryptedDocumentBody(t, "positive", drugTestPath)
+			return &kernelports.DownloadResult{
+				Body: io.NopCloser(strings.NewReader(body)),
+				Size: int64(len(body)),
+			}, nil
+		},
+	}
+
+	deps := setupHandler(t, repo, storage)
+	deps.cacheRepo.On("GetByID", mock.Anything, mock.Anything).
+		Return(workerDocument(docID), nil).Maybe()
+	deps.permissions.Denied = []string{permission.ResourceWorker.String()}
+
+	base := "/api/v1/documents/" + docID.String()
+	for _, path := range []string{
+		base + "/",
+		base + "/download/",
+		base + "/view/",
+		base + "/preview/",
+		base + "/pages/1/image/",
+		base + "/versions/",
+		"/api/v1/documents/select-options/" + docID.String(),
+	} {
+		ginCtx := serve(t, deps, http.MethodGet, path)
+		assert.Equal(t, http.StatusForbidden, ginCtx.ResponseCode(), path)
+		assert.NotContains(t, ginCtx.Recorder.Body.String(), "positive", path)
+	}
+	for _, path := range []string{
+		base + "/approve/",
+		base + "/import-assistant/thread/",
+	} {
+		ginCtx := serve(t, deps, http.MethodPost, path)
+		assert.Equal(t, http.StatusForbidden, ginCtx.ResponseCode(), path)
+	}
+	ginCtx := serve(t, deps, http.MethodDelete, base+"/")
+	assert.Equal(t, http.StatusForbidden, ginCtx.ResponseCode())
+	assert.Zero(t, downloads, "no byte of the file was read")
+
+	deps.permissions.Denied = nil
+	ginCtx = serve(t, deps, http.MethodGet, base+"/download/")
+	require.Equal(t, http.StatusOK, ginCtx.ResponseCode())
+	assert.Equal(t, "positive", ginCtx.Recorder.Body.String())
+}
+
+func TestDocumentReads_KeepAConversationsFileToItsOwner(t *testing.T) {
+	t.Parallel()
+
+	docID := pulid.MustNew("doc_")
+	thread := pulid.MustNew("athr_")
+	attached := workerDocument(docID)
+	attached.ResourceType = document.ConversationResourceType
+	attached.ResourceID = thread.String()
+
+	repo := documentportsmock.NewMockDocumentRepository(t)
+	repo.EXPECT().GetByID(mock.Anything, mock.Anything).Return(attached, nil).Maybe()
+	deps := setupHandler(t, repo, &mockStorageClient{})
+	deps.conversations[thread] = pulid.MustNew("usr_")
+
+	ginCtx := serve(t, deps, http.MethodGet, "/api/v1/documents/"+docID.String()+"/view/")
+	assert.Equal(t, http.StatusForbidden, ginCtx.ResponseCode())
+
+	ginCtx = serve(
+		t,
+		deps,
+		http.MethodGet,
+		"/api/v1/documents/resource/assistant_thread/"+thread.String()+"/",
+	)
+	assert.Equal(t, http.StatusForbidden, ginCtx.ResponseCode())
+}
+
+func TestDocumentsOfARecord_AreRefusedWithoutReadOnTheRecord(t *testing.T) {
+	t.Parallel()
+
+	repo := documentportsmock.NewMockDocumentRepository(t)
+	deps := setupHandler(t, repo, &mockStorageClient{})
+	deps.permissions.Denied = []string{permission.ResourceWorker.String()}
+	workerID := pulid.MustNew("wrk_").String()
+
+	for _, path := range []string{
+		"/api/v1/documents/resource/worker/" + workerID + "/",
+		"/api/v1/documents/resource/worker/" + workerID + "/?query=drug",
+		"/api/v1/documents/resource/worker/" + workerID + "/packet-summary/",
+		"/api/v1/documents/?resourceType=worker&resourceId=" + workerID,
+		"/api/v1/documents/select-options/?resourceType=worker&resourceId=" + workerID,
+	} {
+		ginCtx := serve(t, deps, http.MethodGet, path)
+		assert.Equal(t, http.StatusForbidden, ginCtx.ResponseCode(), path)
+	}
+}
