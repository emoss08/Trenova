@@ -0,0 +1,265 @@
+package documentservice
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+
+	"github.com/emoss08/trenova/internal/modules/documents/app/storedobject"
+	"github.com/emoss08/trenova/internal/modules/documents/app/thumbnailservice"
+	"github.com/emoss08/trenova/internal/modules/documents/domain/document"
+	"github.com/emoss08/trenova/internal/modules/documents/ports/documentports"
+	"github.com/emoss08/trenova/internal/modules/identity/ports/permissionports"
+	"github.com/emoss08/trenova/internal/modules/kernel/ports/kernelports"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/emoss08/trenova/shared/pulid"
+)
+
+func (s *Service) List(
+	ctx context.Context,
+	req *documentports.ListDocumentsRequest,
+) (*pagination.ListResult[*document.Document], error) {
+	owners, err := s.readScope(ctx, req.Actor, req.ResourceType, req.ResourceID)
+	if err != nil {
+		return nil, err
+	}
+
+	scoped := *req
+	scoped.Owners = owners
+
+	return s.repo.List(ctx, &scoped)
+}
+
+func (s *Service) SelectOptions(
+	ctx context.Context,
+	req *documentports.DocumentSelectOptionsRequest,
+) (*pagination.ListResult[*document.Document], error) {
+	owners, err := s.readScope(ctx, req.Actor, req.ResourceType, req.ResourceID)
+	if err != nil {
+		return nil, err
+	}
+
+	scoped := *req
+	scoped.Owners = owners
+
+	return s.repo.SelectOptions(ctx, &scoped)
+}
+
+func (s *Service) readScope(
+	ctx context.Context,
+	actor *permissionports.RequestActor,
+	resourceType, resourceID string,
+) ([]string, error) {
+	if resourceType == "" {
+		return s.access.ReadableOwners(ctx, actor)
+	}
+
+	if err := s.access.RequireResourceReadable(ctx, actor, resourceType, resourceID); err != nil {
+		return nil, err
+	}
+
+	return []string{document.OwnerResource(resourceType).String()}, nil
+}
+
+func (s *Service) RequireResourceReadable(
+	ctx context.Context,
+	actor *permissionports.RequestActor,
+	resourceType, resourceID string,
+) error {
+	return s.access.RequireResourceReadable(ctx, actor, resourceType, resourceID)
+}
+
+func (s *Service) RequireReadable(
+	ctx context.Context,
+	actor *permissionports.RequestActor,
+	ids []pulid.ID,
+) error {
+	if len(ids) == 0 {
+		return nil
+	}
+	if actor == nil {
+		return errortypes.NewAuthorizationError("Sign in to read documents")
+	}
+
+	docs, err := s.repo.GetByIDs(ctx, documentports.BulkDeleteDocumentRequest{
+		IDs:        ids,
+		TenantInfo: actor.TenantInfo(),
+	})
+	if err != nil {
+		return err
+	}
+
+	return s.access.RequireReadable(ctx, actor, docs)
+}
+
+func (s *Service) Read(
+	ctx context.Context,
+	req *documentports.ReadDocumentRequest,
+) (*document.Document, error) {
+	return s.readableWith(ctx, req, s.Get)
+}
+
+func (s *Service) readable(
+	ctx context.Context,
+	req *documentports.ReadDocumentRequest,
+) (*document.Document, error) {
+	return s.readableWith(ctx, req, s.repo.GetByID)
+}
+
+func (s *Service) readableWith(
+	ctx context.Context,
+	req *documentports.ReadDocumentRequest,
+	get func(context.Context, documentports.GetDocumentByIDRequest) (*document.Document, error),
+) (*document.Document, error) {
+	if req.Actor == nil {
+		return nil, errortypes.NewAuthorizationError("Sign in to read documents")
+	}
+
+	doc, err := get(ctx, documentports.GetDocumentByIDRequest{
+		ID:         req.ID,
+		TenantInfo: req.Actor.TenantInfo(),
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	if err = s.access.RequireReadable(ctx, req.Actor, []*document.Document{doc}); err != nil {
+		return nil, err
+	}
+
+	return doc, nil
+}
+
+func (s *Service) Download(
+	ctx context.Context,
+	req *documentports.ReadDocumentRequest,
+) (*DocumentContent, error) {
+	doc, err := s.readable(ctx, req)
+	if err != nil {
+		return nil, err
+	}
+
+	return s.download(ctx, req.Actor.TenantInfo(), req.Actor.AuditActorOrSystem(), doc)
+}
+
+func (s *Service) View(
+	ctx context.Context,
+	req *documentports.ReadDocumentRequest,
+) (*DocumentContent, error) {
+	doc, err := s.readable(ctx, req)
+	if err != nil {
+		return nil, err
+	}
+
+	return s.view(ctx, req.Actor.TenantInfo(), req.Actor.AuditActorOrSystem(), doc)
+}
+
+func (s *Service) Preview(
+	ctx context.Context,
+	req *documentports.ReadDocumentRequest,
+) (*DocumentContent, error) {
+	doc, err := s.readable(ctx, req)
+	if err != nil {
+		return nil, err
+	}
+
+	if doc.PreviewStatus != document.PreviewStatusReady || doc.PreviewStoragePath == "" {
+		return nil, errortypes.NewNotFoundError("Preview not available for this document")
+	}
+
+	tenantInfo := req.Actor.TenantInfo()
+	object, err := storedobject.Open(
+		ctx,
+		s.storage,
+		s.encryption,
+		doc.PreviewStoragePath,
+		storedobject.AAD(tenantInfo, doc.PreviewStoragePath),
+	)
+	if err != nil {
+		return nil, err
+	}
+
+	s.recordAccess(
+		ctx,
+		req.Actor.AuditActorOrSystem(),
+		doc,
+		documentAccessView,
+		documentChannelPreview,
+	)
+	return &DocumentContent{
+		Document:           doc,
+		Body:               object.Body,
+		ContentType:        "image/webp",
+		ContentLength:      object.Size,
+		ContentDisposition: "inline",
+	}, nil
+}
+
+func (s *Service) PageImage(
+	ctx context.Context,
+	req *documentports.GetDocumentPageImageRequest,
+) (*documentports.DocumentPageImage, error) {
+	if req.PageNumber < 1 {
+		return nil, errortypes.NewNotFoundError("This page is not in the document")
+	}
+
+	doc, err := s.readable(ctx, &req.ReadDocumentRequest)
+	if err != nil {
+		return nil, err
+	}
+
+	if !document.SupportsPreview(doc.FileType) {
+		return nil, errortypes.NewNotFoundError("This document has no pages to show")
+	}
+
+	etag := pageImageETag(doc, req.PageNumber)
+	if req.IfNoneMatch == etag {
+		return &documentports.DocumentPageImage{ETag: etag, NotModified: true}, nil
+	}
+
+	tenantInfo := req.Actor.TenantInfo()
+	rendered, err := s.pageRenders.Get(
+		ctx,
+		tenantInfo,
+		doc,
+		req.PageNumber,
+		func(context.Context) (kernelports.ImagingSource, error) {
+			return storedobject.Source(
+				s.storage,
+				s.encryption,
+				doc.StoragePath,
+				storedobject.AAD(tenantInfo, doc.StoragePath),
+				doc.FileType,
+				doc.FileSize,
+			), nil
+		},
+	)
+	if errors.Is(err, thumbnailservice.ErrPageOutOfRange) ||
+		errors.Is(err, thumbnailservice.ErrPDFHasNoPages) {
+		return nil, errortypes.NewNotFoundError("This page is not in the document")
+	}
+	if err != nil {
+		return nil, fmt.Errorf("render page %d of document %s: %w", req.PageNumber, doc.ID, err)
+	}
+
+	s.recordAccess(
+		ctx,
+		req.Actor.AuditActorOrSystem(),
+		doc,
+		documentAccessView,
+		documentChannelPageImage,
+	)
+	return &documentports.DocumentPageImage{
+		DocumentContent: documentports.DocumentContent{
+			Document:           doc,
+			Body:               io.NopCloser(bytes.NewReader(rendered)),
+			ContentType:        "image/webp",
+			ContentLength:      int64(len(rendered)),
+			ContentDisposition: "inline",
+		},
+		ETag: etag,
+	}, nil
+}
