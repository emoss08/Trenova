@@ -0,0 +1,9 @@
+-- The idempotency key a customer payment post or an instant driver payout was
+-- written under: the scoped Idempotency-Key of the request, or the agent tool
+-- call's key. A retry finds the first write under it instead of moving the
+-- money twice; the unique indexes are in the next migration.
+ALTER TABLE "customer_payments"
+    ADD COLUMN IF NOT EXISTS "idempotency_key" varchar(255);
+
+ALTER TABLE "driver_settlements"
+    ADD COLUMN IF NOT EXISTS "idempotency_key" varchar(255);
