+	sharedtestutil "github.com/emoss08/trenova/shared/testutil"
+	"github.com/stretchr/testify/assert"
+	"go.uber.org/zap"
+)
+
+type denyOne struct {
+	mocks.AllowAllPermissionEngine
+
+	resource  permission.Resource
+	operation permission.Operation
+}
+
+func (d *denyOne) Check(
+	_ context.Context,
+	req *permissionports.PermissionCheckRequest,
+) (*permissionports.PermissionCheckResult, error) {
+	allowed := req.Resource != d.resource.String() || req.Operation != d.operation
+	return &permissionports.PermissionCheckResult{Allowed: allowed}, nil
+}
+
+func serve(t *testing.T, engine permissionports.PermissionEngine, method, path string) int {
+	t.Helper()
+
+	logger := zap.NewNop()
+	cfg := &config.Config{App: config.AppConfig{Debug: true}}
+	errorHandler := helpers.NewErrorHandler(helpers.ErrorHandlerParams{Logger: logger, Config: cfg})
+	handler := ratequotehandler.New(ratequotehandler.Params{
+		ErrorHandler: errorHandler,
+		PermissionMiddleware: middleware.NewPermissionMiddleware(
+			middleware.PermissionMiddlewareParams{
+				PermissionEngine: engine,
+				ErrorHandler:     errorHandler,
+			},
+		),
+		PermissionEngine: engine,
+	})
+
+	ginCtx := sharedtestutil.NewGinTestContext().
+		WithMethod(method).
+		WithPath(path).
+		WithJSONBody(map[string]any{}).
+		WithDefaultAuthContext()
+	handler.RegisterRoutes(ginCtx.Engine.Group("/api/v1"))
+	ginCtx.Engine.ServeHTTP(ginCtx.Recorder, ginCtx.Context.Request)
+
+	return ginCtx.ResponseCode()
+}
+
+func TestSavingAQuoteNeedsTheSavePermission(t *testing.T) {
+	t.Parallel()
+
+	shipmentID := pulid.MustNew("shp_").String()
+	engine := &denyOne{resource: permission.ResourceRateQuote, operation: permission.OpCreate}
+	for _, path := range []string{
+		"/api/v1/rate-quotes/quote/save/",
+		"/api/v1/rate-quotes/shipment/" + shipmentID + "/shop/save/",
+	} {
+		assert.Equal(t, http.StatusForbidden, serve(t, engine, http.MethodPost, path), path)
+	}
+}
+
+func TestShipmentRateRoutesNeedToReadTheShipment(t *testing.T) {
+	t.Parallel()
+
+	shipmentID := pulid.MustNew("shp_").String()
+	engine := &denyOne{resource: permission.ResourceShipment, operation: permission.OpRead}
+	routes := map[string]string{
+		"/api/v1/rate-quotes/shipment/" + shipmentID + "/":           http.MethodGet,
+		"/api/v1/rate-quotes/shipment/" + shipmentID + "/applied/":   http.MethodGet,
+		"/api/v1/rate-quotes/shipment/" + shipmentID + "/explain/":   http.MethodPost,
+		"/api/v1/rate-quotes/shipment/" + shipmentID + "/shop/":      http.MethodPost,
+		"/api/v1/rate-quotes/shipment/" + shipmentID + "/shop/save/": http.MethodPost,
+	}
+	for path, method := range routes {
+		assert.Equal(t, http.StatusForbidden, serve(t, engine, method, path), path)
+	}
+}
