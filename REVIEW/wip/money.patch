+func TestRemittanceCandidatesTreatWildcardsInAReferenceAsText(t *testing.T) {
+	e := setupFactoringEnv(t)
+	p := Params{DB: postgres.NewTestConnection(e.db), Logger: zap.NewNop()}
+	submissions := NewSubmissionRepository(p)
+	remittances := NewRemittanceRepository(p)
+	now := time.Now().Unix()
+
+	factor := e.createFactor(t, "FWLD")
+	agreement, err := e.agreements.Create(e.ctx, e.agreement(factor.ID, now-3600, nil))
+	require.NoError(t, err)
+	invoice := e.postInvoice(t, 100000, &factor.ID)
+	sub, err := submissions.Create(e.ctx, e.submission(agreement, "FS-W1", "key-w1", invoice))
+	require.NoError(t, err)
+	require.NoError(t, sub.MarkSent(now-86400, "", 1))
+	_, err = submissions.Update(e.ctx, sub)
+	require.NoError(t, err)
+
+	for _, reference := range []string{"%%%%", "____", `\\\\`} {
+		candidates, listErr := remittances.ListCandidates(e.ctx, &factoringports.ListRemittanceCandidatesRequest{
+			TenantInfo:         e.tenantInfo,
+			FactoringCompanyID: factor.ID,
+			Invoices:           []string{reference},
+		})
+		require.NoError(t, listErr)
+		assert.Empty(t, candidates, "the reference %q is matched as text, not as a pattern", reference)
+	}
+
+	candidates, err := remittances.ListCandidates(e.ctx, &factoringports.ListRemittanceCandidatesRequest{
+		TenantInfo:         e.tenantInfo,
+		FactoringCompanyID: factor.ID,
+		Invoices:           []string{factoring.NormalizeRemittanceReference(sub.Items[0].InvoiceNumber)},
+	})
