+const worklistDay = int64(24 * 60 * 60)
+
+func (e *nonRecourseEnv) worklistCustomer(t *testing.T, code, name string) pulid.ID {
+	t.Helper()
+	cus := customerdb.Customers
+	template, err := cus.Where(cus.ID.Eq(e.customerID)).One(e.ctx, e.db)
+	require.NoError(t, err)
+	template.ID = pulid.Nil
+	template.Code = code
+	template.Name = name
+	template.Version = 0
+	require.NoError(t, cus.Create(e.ctx, e.db, template))
+	return template.ID
+}
+
+type worklistFixture struct {
+	env  *nonRecourseEnv
+	repo *repository
+	now  int64
+}
+
+func (f *worklistFixture) account(t *testing.T, customerID pulid.ID, account *collection.Account) {
+	t.Helper()
+	account.OrganizationID = f.env.tenantInfo.OrgID
+	account.BusinessUnitID = f.env.tenantInfo.BuID
+	account.CustomerID = customerID
+	_, err := f.repo.SaveAccount(f.env.ctx, account)
+	require.NoError(t, err)
+}
+
+func (f *worklistFixture) promise(t *testing.T, customerID pulid.ID, amount, promisedOn int64) pulid.ID {
+	t.Helper()
+	activity := &collection.Activity{
+		ID:                  pulid.MustNew("cact_"),
+		OrganizationID:      f.env.tenantInfo.OrgID,
+		BusinessUnitID:      f.env.tenantInfo.BuID,
+		CustomerID:          customerID,
+		Kind:                collection.ActivityPromiseToPay,
+		Summary:             "Promised to pay",
+		PromisedAmountMinor: &amount,
+		PromisedOn:          &promisedOn,
+		CurrencyCode:        "USD",
+		CreatedByID:         f.env.tenantInfo.UserID,
+	}
+	require.NoError(t, f.repo.InsertActivity(f.env.ctx, activity))
+	return activity.ID
+}
+
+func (f *worklistFixture) overdue(t *testing.T, customerID pulid.ID, number string, amount, daysLate int64) {
+	t.Helper()
+	f.env.postInvoiceFor(t, &openInvoice{
+		customerID:  customerID,
+		number:      number,
+		amountMinor: amount,
+		dueDate:     f.now - daysLate*worklistDay,
+	})
+}
+
+func newWorklistFixture(t *testing.T) *worklistFixture {
+	t.Helper()
+	env := setupNonRecourseEnv(t)
+	repo := New(Params{DB: postgres.NewTestConnection(env.db), Logger: zap.NewNop()})
+	fixture := &worklistFixture{env: env, repo: repo.(*repository), now: time.Now().Unix()}
+
+	ninety := env.worklistCustomer(t, "WLZ1", "WLZ Ninety days")
+	fixture.overdue(t, ninety, "WLZ-1", 20_000, 90)
+
+	broken := env.worklistCustomer(t, "WLZ2", "WLZ Broken promise")
+	fixture.overdue(t, broken, "WLZ-2", 10_000, 12)
+	fixture.account(t, broken, &collection.Account{
+		CollectorID:       env.tenantInfo.UserID,
+		PromiseActivityID: fixture.promise(t, broken, 100_000, fixture.now-2*worklistDay),
+	})
+
+	followUp := env.worklistCustomer(t, "WLZ3", "WLZ Follow-up today")
+	fixture.overdue(t, followUp, "WLZ-3", 30_000, 10)
+	due := fixture.now - 3600
+	fixture.account(t, followUp, &collection.Account{NextFollowUpOn: &due})
+
+	recent := env.worklistCustomer(t, "WLZ4", "WLZ Recent")
+	fixture.overdue(t, recent, "WLZ-4", 500_000, 5)
+
+	open := env.worklistCustomer(t, "WLZ5", "WLZ Open promise")
+	fixture.overdue(t, open, "WLZ-5", 900_000, 45)
+	fixture.account(t, open, &collection.Account{
+		PromiseActivityID: fixture.promise(t, open, 100_000, fixture.now+3*worklistDay),
+	})
+
+	return fixture
+}
+
+func (f *worklistFixture) list(t *testing.T, req *collectionports.WorklistRequest) *collectionports.WorklistPage {
+	t.Helper()
+	req.TenantInfo = f.env.tenantInfo
+	req.Scope = collectionports.CollectorScopeAll
+	req.Search = "WLZ"
+	req.AsOf = f.now
+	page, err := f.repo.ListWorklist(f.env.ctx, req)
+	require.NoError(t, err)
+	return page
+}
+
+func names(page *collectionports.WorklistPage) []string {
+	out := make([]string, 0, len(page.Rows))
+	for _, row := range page.Rows {
+		out = append(out, row.CustomerName)
+	}
+	return out
+}
+
+func TestWorklistRanksAndPagesInTheDatabase(t *testing.T) {
+	f := newWorklistFixture(t)
+
+	page := f.list(t, &collectionports.WorklistRequest{Limit: 10})
+	assert.Equal(t, []string{
+		"WLZ Ninety days",
+		"WLZ Broken promise",
+		"WLZ Follow-up today",
+		"WLZ Recent",
+		"WLZ Open promise",
+	}, names(page), "critical first, then a due follow-up, then the rest, an open promise last")
+	assert.Equal(t, 5, page.Total)
+	assert.Equal(t, collectionports.WorklistSummary{
+		Accounts:       5,
+		Overdue:        []collectionports.CurrencyTotal{{CurrencyCode: "USD", AmountMinor: 1_460_000}},
+		FollowUpsDue:   1,
+		BrokenPromises: 1,
+		Unassigned:     4,
+	}, page.Summary)
+
+	second := f.list(t, &collectionports.WorklistRequest{Limit: 2, Offset: 2})
+	assert.Equal(t, []string{"WLZ Follow-up today", "WLZ Recent"}, names(second))
+	assert.Equal(t, 5, second.Total, "the total counts the whole list, not the page")
+}
+
+func TestWorklistDueOnlyLeavesOutAccountsWaitingOnAPromiseOrAFollowUp(t *testing.T) {
+	f := newWorklistFixture(t)
+	later := f.now + 7*worklistDay
+	scheduled := f.env.worklistCustomer(t, "WLZ6", "WLZ Follow-up next week")
+	f.overdue(t, scheduled, "WLZ-6", 10, 3)
+	f.account(t, scheduled, &collection.Account{NextFollowUpOn: &later})
+
+	page := f.list(t, &collectionports.WorklistRequest{DueOnly: true, Limit: 2, Offset: 1})
+	assert.Equal(t, 4, page.Total)
+	assert.Equal(t, []string{"WLZ Broken promise", "WLZ Follow-up today"}, names(page))
+	assert.Equal(t, 4, page.Summary.Accounts)
+}
+
+func TestWorklistShowsNoOtherTenantsAccounts(t *testing.T) {
+	f := newWorklistFixture(t)
+
+	other := pagination.TenantInfo{OrgID: pulid.MustNew("org_"), BuID: pulid.MustNew("bu_")}
+	page, err := f.repo.ListWorklist(dbscope.WithTenant(f.env.ctx, other.DBTenant()), &collectionports.WorklistRequest{
+		TenantInfo: other,
+		Scope:      collectionports.CollectorScopeAll,
+		Search:     "WLZ",
+		AsOf:       f.now,
+		Limit:      10,
+	})
+	require.NoError(t, err)
+	assert.Empty(t, page.Rows)
+	assert.Zero(t, page.Total)
+}
