+func (v *Validator) ValidateOwner(source *journalsource.Source) *errortypes.MultiError {
+	if source == nil {
+		return nil
+	}
+	me := errortypes.NewMultiError()
+	const field = "originalJournalEntryId"
+	switch source.SourceObjectType {
+	case journalsource.ObjectManualJournalRequest:
+		return nil
+	case journalsource.ObjectInvoice:
+		me.Add(
+			field,
+			errortypes.ErrInvalidOperation,
+			"An invoice posted this journal; void or adjust the invoice instead of reversing its journal",
+		)
+	case journalsource.ObjectInvoiceAdjustment:
+		me.Add(
+			field,
+			errortypes.ErrInvalidOperation,
+			"An invoice adjustment posted this journal; correct it with a new adjustment on the invoice instead of reversing its journal",
+		)
+	case journalsource.ObjectCustomerPayment:
+		me.Add(
+			field,
+			errortypes.ErrInvalidOperation,
+			"A customer payment posted this journal; reverse the payment instead of its journal",
+		)
+	case journalsource.ObjectDriverSettlement:
+		me.Add(
+			field,
+			errortypes.ErrInvalidOperation,
+			"A driver settlement posted this journal; void the settlement instead of reversing its journal",
+		)
+	case journalsource.ObjectCarrierSettlement:
+		me.Add(
+			field,
+			errortypes.ErrInvalidOperation,
+			"A carrier settlement posted this journal; void the settlement instead of reversing its journal",
+		)
+	case journalsource.ObjectFactoringSubmissionItem:
+		me.Add(
+			field,
+			errortypes.ErrInvalidOperation,
+			"A factoring schedule posted this journal; correct it on the schedule instead of reversing its journal",
+		)
+	case journalsource.ObjectFiscalYear:
+		me.Add(
+			field,
+			errortypes.ErrInvalidOperation,
+			"Closing a fiscal year posted this journal; reopen the year instead of reversing its journal",
+		)
+	default:
+		me.Add(
+			field,
+			errortypes.ErrInvalidOperation,
+			"Another record posted this journal; correct that record instead of reversing its journal",
+		)
+	}
+	return me
+}
