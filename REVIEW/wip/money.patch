diff --git a/services/tms/internal/modules/operations/adapters/postgres/detentionrepository/analytics_limit_test.go b/services/tms/internal/modules/operations/adapters/postgres/detentionrepository/analytics_limit_test.go
new file mode 100644
index 000000000..692d6e303
--- /dev/null
+++ b/services/tms/internal/modules/operations/adapters/postgres/detentionrepository/analytics_limit_test.go
@@ -0,0 +1,37 @@
+package detentionrepository
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/emoss08/trenova/internal/modules/operations/ports/detentionports"
+	"github.com/emoss08/trenova/internal/testutil/keeltest"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestDetentionStatsClampTheirLimit(t *testing.T) {
+	t.Parallel()
+
+	cases := map[string]struct {
+		limit int
+		want  int
+	}{
+		"no limit takes the default": {limit: 0, want: pagination.DefaultLimit},
+		"a negative limit takes the default": {limit: -5, want: pagination.DefaultLimit},
+		"a limit past the ceiling is cut to it": {limit: 1_000_000, want: pagination.MaxLimit},
+		"a limit inside the range is kept": {limit: 7, want: 7},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+
+			req := &detentionports.DetentionStatsRequest{Limit: tc.limit}
+			for _, q := range []keeltest.Renderer{facilityStatsQuery(req), customerStatsQuery(req)} {
+				sql, _ := keeltest.Render(t, q)
+				assert.True(t, strings.HasSuffix(sql, " LIMIT "+strconv.Itoa(tc.want)), sql)
+			}
+		})
+	}
+}
