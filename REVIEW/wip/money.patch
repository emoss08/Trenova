+func (f worklistFacts) priorityRank() keel.Int64Expr {
+	return keel.CaseInt64().
+		When(keel.Or(f.broken, f.oldest.Gte(collection.CriticalDaysPastDue)), keel.Int64(0)).
+		When(keel.And(f.open, keel.Not(f.due)), keel.Int64(3)).
+		When(keel.And(f.scheduled, keel.Not(f.due)), keel.Int64(3)).
+		When(keel.Or(f.oldest.Gte(collection.HighDaysPastDue), f.due), keel.Int64(1)).
+		When(f.overdue.Gt(0), keel.Int64(2)).
+		Else(keel.Int64(3))
+}
+
+func (f worklistFacts) needsSomeoneToday() keel.Pred {
+	return keel.Or(
