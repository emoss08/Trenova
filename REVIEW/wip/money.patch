+-- Segregation of duties for journals: whoever creates a manual journal, requests
+-- a journal reversal or writes a journal entry that waits for review may not
+-- approve it. On by default; a one-person accounting office turns it off.
+ALTER TABLE "accounting_controls"
+    ADD COLUMN IF NOT EXISTS "require_separate_journal_approver" BOOLEAN NOT NULL DEFAULT TRUE;
