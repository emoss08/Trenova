+func (r *settlementRepository) GetByIdempotencyKey(
+	ctx context.Context,
+	req driversettlementports.GetDriverSettlementByIdempotencyKeyRequest,
+) (*driversettlement.Settlement, error) {
+	if req.IdempotencyKey == "" {
+		return nil, nil
+	}
+	return dbtx.Read(ctx, r.db, func(ctx context.Context) (*driversettlement.Settlement, error) {
+		s := driversettlementdb.Settlements
+		found, err := s.Where(s.IdempotencyKey.Eq(req.IdempotencyKey)).
+			Load(s.Worker()).
+			Limit(1).
+			List(ctx, r.db.Keel(ctx))
+		if err != nil {
+			return nil, fmt.Errorf("find driver settlement by idempotency key: %w", err)
+		}
+		if len(found) == 0 {
+			return nil, nil
+		}
+		return found[0], nil
+	})
+}
