+func TestReversalPostRefusesAJournalASubledgerOwns(t *testing.T) {
+	t.Parallel()
+
+	orgID, buID, userID := pulid.MustNew("org_"), pulid.MustNew("bu_"), pulid.MustNew("usr_")
+	entryID, reversalID := pulid.MustNew("je_"), pulid.MustNew("jrev_")
+	tenantInfo := pagination.TenantInfo{OrgID: orgID, BuID: buID, UserID: userID}
+	reversalRepo := journalreversalportsmock.NewMockJournalReversalRepository(t)
+	reversalRepo.EXPECT().GetByID(mock.Anything, mock.Anything).Return(&journalreversal.Reversal{
+		ID:                     reversalID,
+		OrganizationID:         orgID,
+		BusinessUnitID:         buID,
+		OriginalJournalEntryID: entryID,
