+func factsOf(w *keel.CTETable, asOf int64) worklistFacts {
+	col := func(name string) keel.Int64Expr { return keel.Int64Of(w.Col(name)) }
+	nextFollowUp := col("next_follow_up_on")
+	promisedOn := col("promised_on")
+	hasPromise := keel.And(
+		w.Col("promise_id").IsNotNull(),
+		col("promised_amount_minor").IsNotNull(),
+		promisedOn.IsNotNull(),
+		col("promise_made_at").IsNotNull(),
+	)
+	unpaid := col("paid_since_promise").LtExpr(col("promised_amount_minor"))
+	lapsed := keel.Int64(asOf).GteExpr(promisedOn.Add(keel.Int64(collection.SecondsPerDay)))
+	due := keel.And(nextFollowUp.IsNotNull(), nextFollowUp.Lte(asOf))
+	return worklistFacts{
+		broken:    keel.And(hasPromise, unpaid, lapsed),
+		open:      keel.And(hasPromise, unpaid, keel.Not(lapsed)),
+		due:       due,
+		scheduled: nextFollowUp.IsNotNull(),
+		oldest:    col("oldest_days"),
+		overdue:   col("overdue_minor"),
+	}
+}
