+func TestReversalRefusesAJournalASubledgerOwns(t *testing.T) {
+	t.Parallel()
+
+	cases := map[string]string{
+		journalsource.ObjectInvoice:                 "An invoice posted this journal; void or adjust the invoice instead of reversing its journal",
+		journalsource.ObjectInvoiceAdjustment:       "An invoice adjustment posted this journal; correct it with a new adjustment on the invoice instead of reversing its journal",
+		journalsource.ObjectCustomerPayment:         "A customer payment posted this journal; reverse the payment instead of its journal",
+		journalsource.ObjectDriverSettlement:        "A driver settlement posted this journal; void the settlement instead of reversing its journal",
+		journalsource.ObjectCarrierSettlement:       "A carrier settlement posted this journal; void the settlement instead of reversing its journal",
+		journalsource.ObjectFactoringSubmissionItem: "A factoring schedule posted this journal; correct it on the schedule instead of reversing its journal",
+		journalsource.ObjectFiscalYear:              "Closing a fiscal year posted this journal; reopen the year instead of reversing its journal",
+		"SomethingNew":                              "Another record posted this journal; correct that record instead of reversing its journal",
+	}
+	for objectType, message := range cases {
+		t.Run(objectType, func(t *testing.T) {
+			t.Parallel()
+
+			orgID, buID, userID := pulid.MustNew("org_"), pulid.MustNew("bu_"), pulid.MustNew("usr_")
+			entryID := pulid.MustNew("je_")
+			tenantInfo := pagination.TenantInfo{OrgID: orgID, BuID: buID, UserID: userID}
+			entryRepo := journalentryportsmock.NewMockJournalEntryRepository(t)
+			entryRepo.EXPECT().
+				GetByID(mock.Anything, mock.Anything).
+				Return(postedEntry(entryID, orgID, buID), nil)
+			svc := &Service{
+				journalEntryRepo:    entryRepo,
+				journalReversalRepo: journalreversalportsmock.NewMockJournalReversalRepository(t),
+				journalSourceRepo:   ownedBy(t, tenantInfo, entryID, objectType),
+				validator:           &Validator{},
+			}
+
+			_, err := svc.PlanCreate(t.Context(), &journalreversalports.CreateJournalReversalRequest{
+				OriginalJournalEntryID:  entryID,
+				RequestedAccountingDate: 1_700_000_000,
+				ReasonCode:              "ERR",
+				ReasonText:              "Posted to the wrong account",
+				TenantInfo:              tenantInfo,
+			}, testutil.NewSessionActor(userID, orgID, buID))
+
+			var multiErr *errortypes.MultiError
+			require.ErrorAs(t, err, &multiErr)
+			require.Len(t, multiErr.Errors, 1)
+			assert.Equal(t, "originalJournalEntryId", multiErr.Errors[0].Field)
+			assert.Equal(t, message, multiErr.Errors[0].Message)
+		})
+	}
+}
