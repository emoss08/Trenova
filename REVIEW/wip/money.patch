+	}
+	for _, row := range totals {
+		summary.Accounts += row.Accounts
+		summary.FollowUpsDue += row.FollowUpsDue
+		summary.BrokenPromises += row.BrokenPromises
+		summary.Unassigned += row.Unassigned
+		if row.OverdueMinor > 0 {
+			summary.Overdue = append(summary.Overdue, collectionports.CurrencyTotal{
+				CurrencyCode: row.CurrencyCode,
+				AmountMinor:  row.OverdueMinor,
+			})
+		}
+	}
+	slices.SortFunc(summary.Overdue, func(a, b collectionports.CurrencyTotal) int {
+		return cmp.Or(
+			cmp.Compare(b.AmountMinor, a.AmountMinor),
+			strings.Compare(a.CurrencyCode, b.CurrencyCode),
+		)
