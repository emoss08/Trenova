+func invoiceRate(invoices []*invoice.Invoice, idx int) decimal.NullDecimal {
+	if idx < 0 || idx >= len(invoices) || invoices[idx] == nil {
+		return decimal.NullDecimal{}
+	}
+	return invoices[idx].ExchangeRate
+}
+
+func receivableRate(
+	control *tenant.AccountingControl,
+	invoices []*invoice.Invoice,
+	idx int,
+) decimal.NullDecimal {
+	if cashRecognized(control) {
+		return decimal.NullDecimal{}
+	}
+	return invoiceRate(invoices, idx)
+}
+
+func postingJournal(
+	control *tenant.AccountingControl,
+	payment *customerpayment.Payment,
+	invoices []*invoice.Invoice,
+) paymentJournal {
+	description := fmt.Sprintf("Customer payment %s", payment.DocumentLabel())
+	appliedCreditAccountID := control.DefaultARAccountID
+	if cashRecognized(control) {
+		appliedCreditAccountID = control.DefaultRevenueAccountID
+		description = fmt.Sprintf("Customer cash receipt %s", payment.DocumentLabel())
+	}
+
+	lines := make([]journalposting.Line, 0, 2+len(payment.Applications)*3)
+	lines = append(lines, journalposting.Line{
+		AccountID:  control.DefaultCashAccountID,
+		Debit:      payment.AmountMinor,
+		CustomerID: payment.CustomerID,
+	})
+	for idx, app := range payment.Applications {
+		if app == nil {
+			continue
+		}
+		if app.AppliedAmountMinor > 0 {
+			lines = append(lines, journalposting.Line{
+				AccountID:  appliedCreditAccountID,
+				Credit:     app.AppliedAmountMinor,
+				CustomerID: payment.CustomerID,
+				Rate:       receivableRate(control, invoices, idx),
+			})
+		}
+		if app.ShortPayAmountMinor > 0 {
+			rate := invoiceRate(invoices, idx)
+			lines = append(lines,
+				journalposting.Line{
+					AccountID:  control.DefaultARAccountID,
+					Credit:     app.ShortPayAmountMinor,
+					CustomerID: payment.CustomerID,
+					Rate:       rate,
+				},
+				journalposting.Line{
+					AccountID:  control.DefaultWriteOffAccountID,
+					Debit:      app.ShortPayAmountMinor,
+					CustomerID: payment.CustomerID,
+					Rate:       rate,
+				},
+			)
+		}
+	}
+	if payment.UnappliedAmountMinor > 0 {
+		lines = append(lines, journalposting.Line{
+			AccountID:  control.DefaultUnappliedCashAccountID,
+			Credit:     payment.UnappliedAmountMinor,
+			CustomerID: payment.CustomerID,
+		})
+	}
+
+	return paymentJournal{description: description, lines: lines}
+}
