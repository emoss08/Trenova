 	assert.Empty(t, priced)
 }
+
+func cappedDaySnapshot() *detention.PolicySnapshot {
+	snapshot := hourlySnapshot()
+	snapshot.MaxChargePerDay = decimal.NewNullDecimal(decimal.RequireFromString("300"))
+	return snapshot
+}
+
+func billedCharge(shipmentID pulid.ID, billStart, clockStop int64, amount string) *detention.DetentionOccurrence {
+	return &detention.DetentionOccurrence{
+		ID:                pulid.MustNew("dto_"),
+		ShipmentID:        shipmentID,
+		PolicySnapshot:    cappedDaySnapshot(),
+		ClockStartAt:      billStart - 7200,
+		FreeTimeExpiresAt: billStart,
+		ClockStopAt:       &clockStop,
+		RoundedMinutes:    int32((clockStop - billStart) / 60),
+		Status:            detention.OccurrenceStatusBilled,
+		BillableAmount:    decimal.RequireFromString(amount),
+	}
+}
+
+func TestPriceShipmentClocks_TheDailyCapCountsABilledChargeOnTheSameDay(t *testing.T) {
+	t.Parallel()
+
+	midnight := int64(1767225600)
+	shipmentID := pulid.MustNew("shp_")
+	billed := billedCharge(shipmentID, midnight+1800, midnight+5400, "250")
+	arrived := midnight + 2*3600
+	running := &detention.DetentionOccurrence{
+		ID:             pulid.MustNew("dto_"),
+		ShipmentID:     shipmentID,
+		PolicySnapshot: cappedDaySnapshot(),
+		StopType:       shipment.StopTypeDelivery,
+		ScheduleType:   shipment.StopScheduleTypeAppointment,
+		ArrivedAt:      &arrived,
+		ClockStartAt:   arrived,
+		IsOpen:         true,
+		Status:         detention.OccurrenceStatusAccruing,
+	}
+
+	priced := map[pulid.ID]ComputeResult{}
+	priceShipmentClocks(
+		[]*detention.DetentionOccurrence{running, billed}, arrived+6*3600, time.UTC, priced,
+	)
+
+	require.Contains(t, priced, running.ID)
+	assert.Equal(t, "50.00", priced[running.ID].BillableAmount.StringFixed(2),
+		"four billable hours are $300, but $250 of the day's $300 cap is already billed")
+	assert.Equal(t, detention.CapKindPerDayAmount, priced[running.ID].CapApplied)
+}
+
+func TestPriceShipmentClocks_ABilledChargeOnAnotherDayLeavesTheCapAlone(t *testing.T) {
+	t.Parallel()
+
+	midnight := int64(1767225600)
+	shipmentID := pulid.MustNew("shp_")
+	billed := billedCharge(shipmentID, midnight-4*3600, midnight-3600, "250")
+	arrived := midnight + 2*3600
+	running := &detention.DetentionOccurrence{
+		ID:             pulid.MustNew("dto_"),
+		ShipmentID:     shipmentID,
+		PolicySnapshot: cappedDaySnapshot(),
+		StopType:       shipment.StopTypeDelivery,
+		ScheduleType:   shipment.StopScheduleTypeAppointment,
+		ArrivedAt:      &arrived,
+		ClockStartAt:   arrived,
+		IsOpen:         true,
+		Status:         detention.OccurrenceStatusAccruing,
+	}
+
+	priced := map[pulid.ID]ComputeResult{}
+	priceShipmentClocks(
+		[]*detention.DetentionOccurrence{running, billed}, arrived+6*3600, time.UTC, priced,
+	)
+
+	require.Contains(t, priced, running.ID)
+	assert.Equal(t, "300.00", priced[running.ID].BillableAmount.StringFixed(2))
+}
+
+func TestFrozenAccrual_SpreadsABilledChargeOverTheDaysItCovers(t *testing.T) {
+	t.Parallel()
+
+	midnight := int64(1767225600)
+	billed := billedCharge(pulid.MustNew("shp_"), midnight-3600, midnight+3*3600, "400")
+	waived := billedCharge(pulid.MustNew("shp_"), midnight, midnight+3600, "0")
+	waived.Status = detention.OccurrenceStatusWaived
+	open := billedCharge(pulid.MustNew("shp_"), midnight, midnight+3600, "75")
+	open.Status = detention.OccurrenceStatusAccruing
+
+	accrual := frozenAccrual([]*detention.DetentionOccurrence{billed, waived, open, nil}, time.UTC)
+
+	assert.Equal(t, "400.00", accrual.shipment.StringFixed(2))
+	require.Len(t, accrual.day, 2)
+	assert.Equal(t, "100.00", accrual.day["2025-12-31"].StringFixed(2))
+	assert.Equal(t, "300.00", accrual.day["2026-01-01"].StringFixed(2))
+}
