+func TestApproveRefusesTheCreatorWhenASeparateApproverIsRequired(t *testing.T) {
+	t.Parallel()
+
+	own := entry("JE-10", journalentry.StatusPending, false)
+	own.CreatedByID = reviewerID
+	other := entry("JE-11", journalentry.StatusPending, false)
+	other.CreatedByID = pulid.MustNew("usr_")
+	repo := &fakeReview{entries: map[pulid.ID]*journalentry.JournalEntry{
+		own.ID:   own,
+		other.ID: other,
+	}}
+
+	result, err := newService(t, repo, &tenant.AccountingControl{RequireSeparateJournalApprover: true}, nil).
+		Approve(t.Context(), request(own.ID, other.ID), actor())
+	require.NoError(t, err)
+
+	require.Len(t, result.Outcomes, 2)
+	assert.Equal(t, 1, result.Changed)
+	assert.Equal(t, 1, result.Failed)
+	assert.Equal(t, "You created this journal entry, so someone else must approve it", result.Outcomes[0].Error)
+	assert.False(t, result.Outcomes[0].Changed)
+	assert.True(t, result.Outcomes[1].Changed)
+	require.Len(t, repo.approved, 1)
+	assert.Equal(t, other.ID, repo.approved[0].EntryID)
+}
