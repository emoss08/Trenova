+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type glLine struct {
+	account pulid.ID
+	debit   int64
+	credit  int64
+}
+
+func cadRate(value string) decimal.NullDecimal {
+	return decimal.NewNullDecimal(decimal.RequireFromString(value))
+}
+
+func foreignWorld(t *testing.T, paymentRate, invoiceRate string) (*paymentWorld, *customerpayment.Payment, pulid.ID) {
+	t.Helper()
+
+	payment := postedPayment(0, 10_000)
+	payment.CurrencyCode = "CAD"
+	payment.ExchangeRate = cadRate(paymentRate)
+	target := openInvoiceFor(payment, 10_000, 0)
+	target.CurrencyCode = "CAD"
+	target.ExchangeRate = cadRate(invoiceRate)
+	w := newPaymentWorld(t, payment, target)
+	w.control.FunctionalCurrencyCode = "USD"
+	w.control.RealizedFXGainAccountID = pulid.MustNew("gla_")
+	w.control.RealizedFXLossAccountID = pulid.MustNew("gla_")
+	return w, payment, target.ID
+}
+
+func glLinesOf(w *paymentWorld) []glLine {
+	lines := make([]glLine, 0, len(w.postings[0].Lines))
+	for _, line := range w.postings[0].Lines {
+		lines = append(lines, glLine{account: line.GLAccountID, debit: line.DebitAmount, credit: line.CreditAmount})
+	}
+	return lines
+}
+
+func TestApplyingForeignCashPostsTheRealizedGainAgainstTheInvoiceRate(t *testing.T) {
+	t.Parallel()
+
+	w, payment, invoiceID := foreignWorld(t, "0.75", "0.73")
+
+	_, err := w.svc.ApplyUnapplied(t.Context(), &customerpaymentports.ApplyCustomerPaymentRequest{
+		PaymentID:      payment.ID,
+		AccountingDate: 200,
+		Applications: []*customerpaymentports.CustomerPaymentApplicationInput{
+			{InvoiceID: invoiceID, AppliedAmountMinor: 10_000},
+		},
+		TenantInfo: w.tenantInfo,
+	}, w.actor)
+	require.NoError(t, err)
+
+	require.Len(t, w.postings, 1)
+	assert.Equal(t, []glLine{
+		{account: w.control.DefaultUnappliedCashAccountID, debit: 7_500},
+		{account: w.control.DefaultARAccountID, credit: 7_300},
+		{account: w.control.RealizedFXGainAccountID, credit: 200},
+	}, glLinesOf(w), "the unapplied cash came in at 0.75, the receivable was booked at 0.73")
+	assert.Equal(t, int64(7_500), w.postings[0].TotalDebit)
+	assert.Equal(t, int64(7_500), w.postings[0].TotalCredit)
+}
+
+func TestReversingForeignCashUndoesItAtTheSameRates(t *testing.T) {
+	t.Parallel()
+
+	w, payment, invoiceID := foreignWorld(t, "0.70", "0.73")
+	payment.AppliedAmountMinor = 10_000
+	payment.UnappliedAmountMinor = 0
+	payment.Applications = []*customerpayment.Application{{
+		ID: pulid.MustNew("cpapp_"), InvoiceID: invoiceID, AppliedAmountMinor: 10_000,
+	}}
+	w.payment = payment
+
+	_, err := w.svc.Reverse(t.Context(), &customerpaymentports.ReverseCustomerPaymentRequest{
+		PaymentID:      payment.ID,
+		AccountingDate: 300,
+		Reason:         "Cheque bounced",
+		TenantInfo:     w.tenantInfo,
+	}, w.actor)
+	require.NoError(t, err)
+
+	require.Len(t, w.postings, 1)
+	assert.Equal(t, []glLine{
+		{account: w.control.DefaultARAccountID, debit: 7_300},
+		{account: w.control.DefaultCashAccountID, credit: 7_000},
+		{account: w.control.RealizedFXLossAccountID, credit: 300},
+	}, glLinesOf(w), "the receivable comes back at its booked rate and the loss the payment realized is taken back off the loss account")
+}
+
+func TestForeignCashWithoutARateDoesNotPost(t *testing.T) {
+	t.Parallel()
+
+	w, payment, invoiceID := foreignWorld(t, "0.75", "0.73")
+	payment.ExchangeRate = decimal.NullDecimal{}
+	w.payment = payment
+
+	_, err := w.svc.ApplyUnapplied(t.Context(), &customerpaymentports.ApplyCustomerPaymentRequest{
+		PaymentID:      payment.ID,
+		AccountingDate: 200,
+		Applications: []*customerpaymentports.CustomerPaymentApplicationInput{
+			{InvoiceID: invoiceID, AppliedAmountMinor: 10_000},
+		},
+		TenantInfo: w.tenantInfo,
+	}, w.actor)
+	require.Error(t, err)
+	assert.True(t, errortypes.IsBusinessError(err))
+	assert.Empty(t, w.postings, "nothing reaches the ledger unconverted")
+}
