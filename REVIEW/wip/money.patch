diff --git a/services/tms/internal/modules/accounting/app/journalposting/currency.go b/services/tms/internal/modules/accounting/app/journalposting/currency.go
new file mode 100644
index 000000000..c3a23c9f4
--- /dev/null
+++ b/services/tms/internal/modules/accounting/app/journalposting/currency.go
@@ -0,0 +1,263 @@
+package journalposting
+
+import (
+	"context"
+	"strings"
+
+	"github.com/emoss08/trenova/internal/modules/accounting/ports/journalentryports"
+	"github.com/emoss08/trenova/internal/modules/identity/domain/tenant"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/shared/i18n"
+	"github.com/emoss08/trenova/shared/pulid"
+	"github.com/shopspring/decimal"
+)
+
+const RealizedFXDescription = "Realized exchange difference"
+
+type Currency struct {
+	Code string
+	Rate decimal.NullDecimal
+}
+
+type BuildLinesRequest struct {
+	Control     *tenant.AccountingControl
+	Currency    Currency
+	Subject     string
+	Description string
+	Reversal    bool
+	Lines       []Line
+}
+
+type BuiltLines struct {
+	Lines       []journalentryports.JournalPostingLine
+	TotalDebit  int64
+	TotalCredit int64
+}
+
+type convertedLine struct {
+	line   Line
+	debit  int64
+	credit int64
+}
+
+func BuildLines(ctx context.Context, req *BuildLinesRequest) (*BuiltLines, error) {
+	if err := checkDocumentLines(req); err != nil {
+		return nil, err
+	}
+
+	converted, err := convertLines(ctx, req)
+	if err != nil {
+		return nil, err
+	}
+	converted, err = settleResidual(ctx, req, converted)
+	if err != nil {
+		return nil, err
+	}
+
+	built := &BuiltLines{Lines: make([]journalentryports.JournalPostingLine, 0, len(converted))}
+	for _, entry := range converted {
+		if entry.debit == 0 && entry.credit == 0 {
+			continue
+		}
+		description := entry.line.Description
+		if description == "" {
+			description = req.Description
+		}
+		built.TotalDebit += entry.debit
+		built.TotalCredit += entry.credit
+		built.Lines = append(built.Lines, journalentryports.JournalPostingLine{
+			ID:           pulid.MustNew("jel_"),
+			GLAccountID:  entry.line.AccountID,
+			LineNumber:   int16(len(built.Lines) + 1),
+			Description:  description,
+			DebitAmount:  entry.debit,
+			CreditAmount: entry.credit,
+			NetAmount:    entry.debit - entry.credit,
+			CustomerID:   entry.line.CustomerID,
+		})
+	}
+	if len(built.Lines) < 2 || built.TotalDebit != built.TotalCredit {
+		return nil, errortypes.NewBusinessError(
+			"The {0} journal does not balance",
+			req.Subject,
+		)
+	}
+	return built, nil
+}
+
+func checkDocumentLines(req *BuildLinesRequest) error {
+	var debit, credit int64
+	for _, line := range req.Lines {
+		if line.AccountID.IsNil() || line.Debit < 0 || line.Credit < 0 ||
+			(line.Debit == 0) == (line.Credit == 0) {
+			return errortypes.NewBusinessError(
+				"Every line of the {0} journal needs an account and one positive side",
+				req.Subject,
+			)
+		}
+		debit += line.Debit
+		credit += line.Credit
+	}
+	if len(req.Lines) < 2 || debit != credit {
+		return errortypes.NewBusinessError(
+			"The {0} journal does not balance",
+			req.Subject,
+		)
+	}
+	return nil
+}
+
+func convertLines(
+	ctx context.Context,
+	req *BuildLinesRequest,
+) ([]convertedLine, error) {
+	converted := make([]convertedLine, 0, len(req.Lines)+1)
+	for _, line := range req.Lines {
+		converted = append(converted, convertedLine{
+			line:   line,
+			debit:  line.Debit,
+			credit: line.Credit,
+		})
+	}
+	functional := functionalCurrency(req.Control)
+	code := strings.ToUpper(strings.TrimSpace(req.Currency.Code))
+	if code == "" || functional == "" || code == functional {
+		return converted, nil
+	}
+
+	base, ok := positiveRate(req.Currency.Rate)
+	if !ok {
+		return nil, missingRate(ctx, req.Subject, code, functional)
+	}
+	realized := false
+	rates := make([]decimal.Decimal, len(req.Lines))
+	for idx, line := range req.Lines {
+		rates[idx] = base
+		if !line.Rate.Valid {
+			continue
+		}
+		if rates[idx], ok = positiveRate(line.Rate); !ok {
+			return nil, missingRate(ctx, req.Subject, code, functional)
+		}
+		realized = realized || !rates[idx].Equal(base)
+	}
+
+	if !realized {
+		apportion(converted, base, func(entry *convertedLine) *int64 { return &entry.debit })
+		apportion(converted, base, func(entry *convertedLine) *int64 { return &entry.credit })
+		return converted, nil
+	}
+	for idx := range converted {
+		converted[idx].debit = toFunctional(converted[idx].debit, rates[idx])
+		converted[idx].credit = toFunctional(converted[idx].credit, rates[idx])
+	}
+	return converted, nil
+}
+
+func apportion(
+	converted []convertedLine,
+	rate decimal.Decimal,
+	side func(*convertedLine) *int64,
+) {
+	total := decimal.Zero
+	remainders := make([]decimal.Decimal, len(converted))
+	var assigned int64
+	for idx := range converted {
+		amount := side(&converted[idx])
+		if *amount == 0 {
+			continue
+		}
+		exact := decimal.NewFromInt(*amount).Mul(rate)
+		total = total.Add(exact)
+		floor := exact.Floor()
+		remainders[idx] = exact.Sub(floor)
+		*amount = floor.IntPart()
+		assigned += *amount
+	}
+	missing := total.Round(0).IntPart() - assigned
+	for ; missing > 0; missing-- {
+		best := -1
+		for idx := range converted {
+			if *side(&converted[idx]) == 0 && remainders[idx].IsZero() {
+				continue
+			}
+			if best < 0 || remainders[idx].GreaterThan(remainders[best]) {
+				best = idx
+			}
+		}
+		if best < 0 {
+			return
+		}
+		*side(&converted[best])++
+		remainders[best] = decimal.NewFromInt(-1)
+	}
+}
+
+func settleResidual(
+	ctx context.Context,
+	req *BuildLinesRequest,
+	converted []convertedLine,
+) ([]convertedLine, error) {
+	var residual int64
+	for _, entry := range converted {
+		residual += entry.debit - entry.credit
+	}
+	if residual == 0 {
+		return converted, nil
+	}
+
+	control := req.Control
+	if control == nil || control.RealizedFXGainAccountID.IsNil() ||
+		control.RealizedFXLossAccountID.IsNil() {
+		return nil, errortypes.NewValidationError(
+			"accountingControl",
+			errortypes.ErrRequired,
+			"Set the realized FX gain and loss accounts in accounting controls to post the {0}",
+			i18n.T(ctx, req.Subject),
+		)
+	}
+	creditAccount, debitAccount := control.RealizedFXGainAccountID, control.RealizedFXLossAccountID
+	if req.Reversal {
+		creditAccount, debitAccount = debitAccount, creditAccount
+	}
+	if residual > 0 {
+		return append(converted, convertedLine{
+			line:   Line{AccountID: creditAccount, Description: RealizedFXDescription},
+			credit: residual,
+		}), nil
+	}
+	return append(converted, convertedLine{
+		line:  Line{AccountID: debitAccount, Description: RealizedFXDescription},
+		debit: -residual,
+	}), nil
+}
+
+func toFunctional(amount int64, rate decimal.Decimal) int64 {
+	if amount == 0 {
+		return 0
+	}
+	return decimal.NewFromInt(amount).Mul(rate).Round(0).IntPart()
+}
+
+func positiveRate(rate decimal.NullDecimal) (decimal.Decimal, bool) {
+	if !rate.Valid || !rate.Decimal.IsPositive() {
+		return decimal.Zero, false
+	}
+	return rate.Decimal, true
+}
+
+func functionalCurrency(control *tenant.AccountingControl) string {
+	if control == nil {
+		return ""
+	}
+	return strings.ToUpper(strings.TrimSpace(control.FunctionalCurrencyCode))
+}
+
+func missingRate(ctx context.Context, subject, code, functional string) error {
+	return errortypes.NewBusinessError(
+		"The {0} is in {1} but has no exchange rate to {2} recorded for it, so it cannot post to the general ledger until a rate for its date is available",
+		i18n.T(ctx, subject),
+		code,
+		functional,
+	)
+}
