--- /dev/null
+++ b/services/tms/internal/modules/operations/app/detentionservice/accrual.go
@@ -0,0 +1,57 @@
+package detentionservice
+
+import (
+	"time"
+
+	"github.com/emoss08/trenova/internal/modules/operations/domain/detention"
+	"github.com/shopspring/decimal"
+)
+
+type shipmentAccrual struct {
+	day      map[string]decimal.Decimal
+	shipment decimal.Decimal
+}
+
+func frozenAccrual(
+	occurrences []*detention.DetentionOccurrence,
+	location *time.Location,
+) *shipmentAccrual {
+	accrual := &shipmentAccrual{day: map[string]decimal.Decimal{}, shipment: decimal.Zero}
+	for _, occurrence := range occurrences {
+		if occurrence == nil || !occurrence.IsFrozen() {
+			continue
+		}
+		accrual.shipment = accrual.shipment.Add(occurrence.BillableAmount)
+		for day, amount := range frozenDayAllocation(occurrence, location) {
+			accrual.day[day] = accrual.day[day].Add(amount)
+		}
+	}
+	return accrual
+}
+
+func frozenDayAllocation(
+	occurrence *detention.DetentionOccurrence,
+	location *time.Location,
+) map[string]decimal.Decimal {
+	if !occurrence.BillableAmount.IsPositive() {
+		return nil
+	}
+	billStart := occurrence.FreeTimeExpiresAt
+	if billStart == 0 {
+		billStart = occurrence.ClockStartAt
+	}
+	clockStop := billStart
+	switch {
+	case occurrence.ClockStopAt != nil:
+		clockStop = *occurrence.ClockStopAt
+	case occurrence.DepartedAt != nil:
+		clockStop = *occurrence.DepartedAt
+	}
+	return allocateByDay(allocateByDayInput{
+		amount:    occurrence.BillableAmount,
+		rounded:   max(occurrence.RoundedMinutes, 1),
+		billStart: billStart,
+		clockStop: clockStop,
+		location:  location,
+	})
+}
diff --git a/services/tms/internal/modules/operations/app/detentionservice/price_clocks_internal_test.go b/services/tms/internal/modules/operations/app/detentionservice/price_clocks_internal_test.go
