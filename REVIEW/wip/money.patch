--- /dev/null
+++ b/services/tms/internal/modules/accounting/app/journalposting/currency_test.go
@@ -0,0 +1,237 @@
+package journalposting
+
+import (
+	"context"
+	"testing"
+
+	"github.com/emoss08/trenova/internal/testutil/mocks/journalentryportsmock"
+
+	"github.com/emoss08/trenova/internal/modules/accounting/domain/fiscalperiod"
+	"github.com/emoss08/trenova/internal/modules/accounting/ports/journalentryports"
+	"github.com/emoss08/trenova/internal/modules/identity/domain/tenant"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/shared/pulid"
+	"github.com/shopspring/decimal"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/mock"
+	"github.com/stretchr/testify/require"
+)
+
+func rate(value string) decimal.NullDecimal {
+	return decimal.NewNullDecimal(decimal.RequireFromString(value))
+}
+
+func usdControl() *tenant.AccountingControl {
+	return &tenant.AccountingControl{
+		FunctionalCurrencyCode:  "USD",
+		RealizedFXGainAccountID: pulid.MustNew("gla_"),
+		RealizedFXLossAccountID: pulid.MustNew("gla_"),
+	}
+}
+
+type journalCapture struct {
+	repo    *journalentryportsmock.MockJournalPostingRepository
+	written []journalentryports.CreateJournalPostingParams
+}
+
+type postedLine struct {
+	account pulid.ID
+	debit   int64
+	credit  int64
+}
+
+func posted(built *BuiltLines) []postedLine {
+	out := make([]postedLine, 0, len(built.Lines))
+	for _, line := range built.Lines {
+		out = append(out, postedLine{account: line.GLAccountID, debit: line.DebitAmount, credit: line.CreditAmount})
+	}
+	return out
+}
+
+func TestBuildLinesKeepsAFunctionalCurrencyDocumentAsItIs(t *testing.T) {
+	t.Parallel()
+
+	ar, revenue := pulid.MustNew("gla_"), pulid.MustNew("gla_")
+	built, err := BuildLines(t.Context(), &BuildLinesRequest{
+		Control:  usdControl(),
+		Currency: Currency{Code: "usd"},
+		Subject:  "invoice",
+		Lines: []Line{
+			{AccountID: ar, Debit: 12_345},
+			{AccountID: revenue, Credit: 12_345},
+		},
+	})
+	require.NoError(t, err)
+	assert.Equal(t, []postedLine{{account: ar, debit: 12_345}, {account: revenue, credit: 12_345}}, posted(built))
+	assert.Equal(t, int64(12_345), built.TotalDebit)
+}
+
+func TestBuildLinesConvertsAForeignDocumentAtItsRate(t *testing.T) {
+	t.Parallel()
+
+	ar, revenue := pulid.MustNew("gla_"), pulid.MustNew("gla_")
+	built, err := BuildLines(t.Context(), &BuildLinesRequest{
+		Control:  usdControl(),
+		Currency: Currency{Code: "CAD", Rate: rate("0.7300")},
+		Subject:  "invoice",
+		Lines: []Line{
+			{AccountID: ar, Debit: 100_000},
+			{AccountID: revenue, Credit: 100_000},
+		},
+	})
+	require.NoError(t, err)
+	assert.Equal(t, []postedLine{{account: ar, debit: 73_000}, {account: revenue, credit: 73_000}}, posted(built))
+	assert.Equal(t, int64(73_000), built.TotalDebit)
+	assert.Equal(t, int64(73_000), built.TotalCredit)
+}
+
+func TestBuildLinesSharesRoundingByTheLargestRemainder(t *testing.T) {
+	t.Parallel()
+
+	ar, freight, fuel := pulid.MustNew("gla_"), pulid.MustNew("gla_"), pulid.MustNew("gla_")
+	built, err := BuildLines(t.Context(), &BuildLinesRequest{
+		Control:  usdControl(),
+		Currency: Currency{Code: "CAD", Rate: rate("0.333")},
+		Subject:  "invoice",
+		Lines: []Line{
+			{AccountID: ar, Debit: 300},
+			{AccountID: freight, Credit: 200},
+			{AccountID: fuel, Credit: 100},
+		},
+	})
+	require.NoError(t, err)
+	assert.Equal(t, []postedLine{
+		{account: ar, debit: 100},
+		{account: freight, credit: 67},
+		{account: fuel, credit: 33},
+	}, posted(built), "99.9 rounds to 100 on each side; 66.6 and 33.3 share it by their remainders")
+}
+
+func TestBuildLinesPostsARealizedGainWhenAReceivableClearsAboveItsBookedRate(t *testing.T) {
+	t.Parallel()
+
+	control := usdControl()
+	cash, ar := pulid.MustNew("gla_"), pulid.MustNew("gla_")
+	built, err := BuildLines(t.Context(), &BuildLinesRequest{
+		Control:  control,
+		Currency: Currency{Code: "CAD", Rate: rate("0.75")},
+		Subject:  "customer payment",
+		Lines: []Line{
+			{AccountID: cash, Debit: 100_000},
+			{AccountID: ar, Credit: 100_000, Rate: rate("0.73")},
+		},
+	})
+	require.NoError(t, err)
+	assert.Equal(t, []postedLine{
+		{account: cash, debit: 75_000},
+		{account: ar, credit: 73_000},
+		{account: control.RealizedFXGainAccountID, credit: 2_000},
+	}, posted(built))
+	assert.Equal(t, RealizedFXDescription, built.Lines[2].Description)
+}
+
+func TestBuildLinesPostsARealizedLossWhenAReceivableClearsBelowItsBookedRate(t *testing.T) {
+	t.Parallel()
+
+	control := usdControl()
+	cash, ar := pulid.MustNew("gla_"), pulid.MustNew("gla_")
+	built, err := BuildLines(t.Context(), &BuildLinesRequest{
+		Control:  control,
+		Currency: Currency{Code: "CAD", Rate: rate("0.70")},
+		Subject:  "customer payment",
+		Lines: []Line{
+			{AccountID: cash, Debit: 100_000},
+			{AccountID: ar, Credit: 100_000, Rate: rate("0.73")},
+		},
+	})
+	require.NoError(t, err)
+	assert.Equal(t, []postedLine{
+		{account: cash, debit: 70_000},
+		{account: ar, credit: 73_000},
+		{account: control.RealizedFXLossAccountID, debit: 3_000},
+	}, posted(built))
+}
+
+func TestBuildLinesRefusesAForeignDocumentWithoutARate(t *testing.T) {
+	t.Parallel()
+
+	for name, line := range map[string]Line{
+		"no document rate": {},
+		"no rate on the balance it settles": {Rate: decimal.NullDecimal{Valid: true, Decimal: decimal.Zero}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+
+			documentRate := decimal.NullDecimal{}
+			if line.Rate.Valid {
+				documentRate = rate("0.73")
+			}
+			line.AccountID = pulid.MustNew("gla_")
+			line.Credit = 100
+			_, err := BuildLines(t.Context(), &BuildLinesRequest{
+				Control:  usdControl(),
+				Currency: Currency{Code: "CAD", Rate: documentRate},
+				Subject:  "invoice",
+				Lines:    []Line{{AccountID: pulid.MustNew("gla_"), Debit: 100}, line},
+			})
+			require.Error(t, err)
+			assert.True(t, errortypes.IsBusinessError(err))
+			var localized interface {
+				LocalizedMessage() (string, []any)
+			}
+			require.ErrorAs(t, err, &localized)
+			message, args := localized.LocalizedMessage()
+			assert.Equal(t,
+				"The {0} is in {1} but has no exchange rate to {2} recorded for it, so it cannot post to the general ledger until a rate for its date is available",
+				message)
+			assert.Equal(t, []any{"invoice", "CAD", "USD"}, args)
+		})
+	}
+}
+
+func TestBuildLinesRefusesARealizedDifferenceWithoutFXAccounts(t *testing.T) {
+	t.Parallel()
+
+	_, err := BuildLines(t.Context(), &BuildLinesRequest{
+		Control:  &tenant.AccountingControl{FunctionalCurrencyCode: "USD"},
+		Currency: Currency{Code: "CAD", Rate: rate("0.75")},
+		Subject:  "customer payment",
+		Lines: []Line{
+			{AccountID: pulid.MustNew("gla_"), Debit: 100_000},
+			{AccountID: pulid.MustNew("gla_"), Credit: 100_000, Rate: rate("0.73")},
+		},
+	})
+	var validation *errortypes.Error
