+func TestConnectionTestersRefusePrivateAddressesByDefault(t *testing.T) {
+	t.Parallel()
+
+	var called bool
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		called = true
+		_, _ = w.Write([]byte(`{}`))
+	}))
+	defer server.Close()
+
+	testers := newConnectionTesters(httpsafe.NewClient)
+	configs := map[integration.Type]map[string]string{
+		integration.TypeResend:             {"apiKey": "key", "baseUrl": server.URL},
+		integration.TypePostmark:           {"serverToken": "token", "baseUrl": server.URL},
+		integration.TypeOANDAExchangeRates: {"apiKey": "key", "baseUrl": server.URL},
+		integration.TypeEIAFuelPrices:      {"apiKey": "key", "baseUrl": server.URL},
+		integration.TypePCMiler:            {"apiKey": "key", "baseUrl": server.URL},
+		integration.TypeSamsara:            {"token": "token", "baseUrl": server.URL},
+	}
+	require.Len(t, testers, len(configs))
+	for typ, cfg := range configs {
+		err := testers[typ].Test(t.Context(), cfg)
+		require.ErrorIs(t, err, httpsafe.ErrBlockedAddress, typ)
+	}
+	require.False(t, called)
