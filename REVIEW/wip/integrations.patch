+)
+
+func egressTestMessage() SendProviderMessage {
+	return SendProviderMessage{
+		From:    "dispatch@example.com",
+		To:      []string{"ops@example.com"},
+		Subject: "Subject",
+		Text:    "Hello",
+	}
+}
+
+func TestEmailProvidersRefusePrivateAddressesByDefault(t *testing.T) {
+	t.Parallel()
+
+	var called bool
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		called = true
+		_, _ = w.Write([]byte(`{"id":"x","MessageID":"y"}`))
+	}))
+	defer server.Close()
+
+	_, err := NewResendSender().Send(t.Context(), SendProviderRequest{
+		Config:  map[string]string{"apiKey": "key", "baseUrl": server.URL},
+		Message: egressTestMessage(),
+	})
+	require.ErrorIs(t, err, httpsafe.ErrBlockedAddress)
+
+	_, err = NewPostmarkSender().Send(t.Context(), SendProviderRequest{
+		Config:  map[string]string{"serverToken": "token", "baseUrl": server.URL},
+		Message: egressTestMessage(),
+	})
+	require.ErrorIs(t, err, httpsafe.ErrBlockedAddress)
+	require.False(t, called)
+}
+
+func TestProviderFailureNeverStoresTheRawResponseBody(t *testing.T) {
+	t.Parallel()
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusBadRequest)
+		_, _ = w.Write([]byte("ami-id\ninstance-id\nAccessKeyId AKIAEXAMPLE"))
+	}))
+	defer server.Close()
+
+	_, err := NewResendSenderWithClient(server.Client()).Send(t.Context(), SendProviderRequest{
+		Config:  map[string]string{"apiKey": "key", "baseUrl": server.URL},
+		Message: egressTestMessage(),
+	})
+
+	require.Error(t, err)
+	assert.Equal(t, "non-retryable email provider failure: resend status 400", err.Error())
+}
+
+func TestProviderResponsePastTheLimitIsAnError(t *testing.T) {
+	t.Parallel()
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write([]byte(`{"MessageID":"` + strings.Repeat("a", providerResponseLimit) + `"}`))
+	}))
+	defer server.Close()
+
+	_, err := NewPostmarkSenderWithClient(server.Client()).Send(t.Context(), SendProviderRequest{
+		Config:  map[string]string{"serverToken": "token", "baseUrl": server.URL},
+		Message: egressTestMessage(),
+	})
+
+	require.ErrorIs(t, err, httpsafe.ErrResponseTooLarge)
+}
