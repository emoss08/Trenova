index 000000000..6e6c01ead
--- /dev/null
+++ b/shared/httpsafe/service.go
@@ -0,0 +1,207 @@
+package httpsafe
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/url"
+	"strings"
+	"unicode"
+
+	"github.com/bytedance/sonic"
+)
+
+var (
+	ErrResponseTooLarge = errors.New("httpsafe: response body exceeds the limit")
+	ErrServiceURL       = errors.New(
+		"httpsafe: service url must be https to a public host name, without credentials, query or fragment",
+	)
+)
+
+const (
+	maxHostLength      = 253
+	maxLabelLength     = 63
+	upstreamMessageMax = 200
+)
+
+var reservedHostSuffixes = []string{
+	"localhost",
+	"local",
+	"internal",
+	"localdomain",
+	"home.arpa",
+	"intranet",
+	"corp",
+	"lan",
+}
+
+func ReadBody(r io.Reader, limit int64) ([]byte, error) {
+	data, err := io.ReadAll(io.LimitReader(r, limit+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(data)) > limit {
+		return nil, fmt.Errorf("%w of %d bytes", ErrResponseTooLarge, limit)
+	}
+
+	return data, nil
+}
+
+func ValidateServiceURL(rawURL string) (*url.URL, error) {
+	parsed, err := ValidateHTTPSURL(rawURL, Policy{})
+	if err != nil {
+		return nil, err
+	}
+	if parsed.Opaque != "" || parsed.RawQuery != "" || parsed.ForceQuery ||
+		parsed.Fragment != "" {
+		return nil, ErrServiceURL
+	}
+	host := parsed.Hostname()
+	if ip := net.ParseIP(host); ip != nil {
+		return parsed, nil
+	}
+	if !publicHostName(host) {
+		return nil, ErrServiceURL
+	}
+
+	return parsed, nil
+}
+
+func publicHostName(host string) bool {
+	name := strings.ToLower(strings.TrimSuffix(host, "."))
+	if name == "" || len(name) > maxHostLength {
+		return false
+	}
+	labels := strings.Split(name, ".")
+	if len(labels) < 2 {
+		return false
+	}
+	for _, label := range labels {
+		if !validLabel(label) {
+			return false
+		}
+	}
+	for _, suffix := range reservedHostSuffixes {
+		if name == suffix || strings.HasSuffix(name, "."+suffix) {
+			return false
+		}
+	}
+
+	return true
+}
+
+func validLabel(label string) bool {
+	if label == "" || len(label) > maxLabelLength ||
+		strings.HasPrefix(label, "-") || strings.HasSuffix(label, "-") {
+		return false
+	}
+	for _, r := range label {
+		switch {
+		case r >= 'a' && r <= 'z', r >= '0' && r <= '9', r == '-':
+		default:
+			return false
+		}
+	}
+
+	return true
+}
+
+func RedactURLError(err error) error {
+	var urlErr *url.Error
+	if !errors.As(err, &urlErr) {
+		return err
+	}
+
+	return &url.Error{Op: urlErr.Op, URL: withoutQuery(urlErr.URL), Err: urlErr.Err}
+}
+
+func withoutQuery(raw string) string {
+	parsed, err := url.Parse(raw)
+	if err != nil {
+		if idx := strings.IndexAny(raw, "?#"); idx >= 0 {
+			return raw[:idx]
+		}
+		return raw
+	}
+	parsed.User = nil
+	parsed.RawQuery = ""
+	parsed.ForceQuery = false
+	parsed.Fragment = ""
+
+	return parsed.String()
+}
+
+func UpstreamErrorMessage(body []byte) string {
+	var envelope struct {
+		Message      any `json:"message"`
+		MessageUpper any `json:"Message"`
+		Error        any `json:"error"`
+		Detail       any `json:"detail"`
+		Title        any `json:"title"`
+		Errors       []struct {
+			Message string `json:"message"`
+		} `json:"errors"`
+	}
+	if err := sonic.Unmarshal(body, &envelope); err != nil {
+		return ""
+	}
+	candidates := []any{
+		envelope.Message,
+		envelope.MessageUpper,
+		envelope.Error,
+		envelope.Detail,
+		envelope.Title,
+	}
+	if len(envelope.Errors) > 0 {
+		candidates = append(candidates, envelope.Errors[0].Message)
+	}
+	for _, candidate := range candidates {
+		if message := UpstreamMessage(textOf(candidate)); message != "" {
+			return message
+		}
+	}
+
+	return ""
+}
+
+func textOf(value any) string {
+	switch typed := value.(type) {
+	case string:
+		return typed
+	case map[string]any:
+		if message, ok := typed["message"].(string); ok {
+			return message
+		}
+	}
+
+	return ""
+}
+
+func UpstreamMessage(message string) string {
+	var b strings.Builder
+	space := false
+	count := 0
+	for _, r := range strings.TrimSpace(message) {
+		if count >= upstreamMessageMax {
+			b.WriteString("...")
+			break
+		}
+		switch {
+		case unicode.IsSpace(r):
+			if !space {
+				b.WriteByte(' ')
+				count++
+			}
+			space = true
+			continue
+		case !unicode.IsPrint(r), r == '<', r == '>', r == '{', r == '}':
+			continue
+		}
+		space = false
+		b.WriteRune(r)
+		count++
+	}
+
+	return strings.TrimSpace(b.String())
+}
