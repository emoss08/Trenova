new file mode 100644
index 000000000..e008c0440
--- /dev/null
+++ b/services/tms/internal/api/handlers/googlemapshandler/handler_test.go
@@ -0,0 +1,112 @@
+package googlemapshandler
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/emoss08/trenova/internal/api/helpers"
+	"github.com/emoss08/trenova/internal/api/middleware"
+	"github.com/emoss08/trenova/internal/infrastructure/config"
+	"github.com/emoss08/trenova/internal/modules/identity/domain/permission"
+	"github.com/emoss08/trenova/internal/modules/identity/ports/permissionports"
+	"github.com/emoss08/trenova/internal/modules/kernel/ports/kernelports"
+	"github.com/emoss08/trenova/internal/testutil/permtest"
+	"github.com/emoss08/trenova/pkg/authctx"
+	"github.com/emoss08/trenova/shared/pulid"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"go.uber.org/zap"
+)
+
+type grantEngine struct {
+	*permtest.Engine
+	allowed map[string]bool
+}
+
+func (e grantEngine) Check(
+	_ context.Context,
+	req *permissionports.PermissionCheckRequest,
+) (*permissionports.PermissionCheckResult, error) {
+	return &permissionports.PermissionCheckResult{
+		Allowed: e.allowed[req.Resource+":"+string(req.Operation)],
+	}, nil
+}
+
+type countingAutocomplete struct {
+	calls int
+}
+
+func (s *countingAutocomplete) GetPlaceDetails(
+	context.Context,
+	*kernelports.AutoCompleteRequest,
+) (*kernelports.AutocompleteLocationResult, error) {
+	s.calls++
+	return &kernelports.AutocompleteLocationResult{Details: []*kernelports.LocationDetails{}}, nil
+}
+
+func autocomplete(t *testing.T, grants ...string) (int, int) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+
+	cfg := &config.Config{App: config.AppConfig{Debug: true}}
+	eh := helpers.NewErrorHandler(helpers.ErrorHandlerParams{Logger: zap.NewNop(), Config: cfg})
+	allowed := make(map[string]bool, len(grants))
+	for _, grant := range grants {
+		allowed[grant] = true
+	}
+	svc := &countingAutocomplete{}
+	handler := New(Params{
+		AutoCompleteService: svc,
+		ErrorHandler:        eh,
+		PermissionMiddleware: middleware.NewPermissionMiddleware(
+			middleware.PermissionMiddlewareParams{
+				PermissionEngine: grantEngine{Engine: permtest.AllowAll(), allowed: allowed},
+				ErrorHandler:     eh,
+			},
+		),
+	})
+
+	router := gin.New()
+	router.Use(func(c *gin.Context) {
+		authctx.SetAuthContext(c, pulid.MustNew("usr_"), pulid.MustNew("bu_"), pulid.MustNew("org_"))
+		c.Next()
+	})
+	handler.RegisterRoutes(&router.RouterGroup)
+
+	req := httptest.NewRequest(
+		http.MethodPost,
+		"/google-maps/autocomplete/",
+		strings.NewReader(`{"input":"1600 Amphitheatre"}`),
+	)
+	req.Header.Set("Content-Type", "application/json")
+	w := httptest.NewRecorder()
+	router.ServeHTTP(w, req)
+
+	return w.Code, svc.calls
+}
+
+func TestAutocompleteRequiresAPermissionToWriteAnAddress(t *testing.T) {
+	t.Parallel()
+
+	status, calls := autocomplete(t)
+	assert.Equal(t, http.StatusForbidden, status)
+	assert.Zero(t, calls)
+
+	status, calls = autocomplete(t, permission.ResourceShipment.String()+":"+string(permission.OpRead))
+	assert.Equal(t, http.StatusForbidden, status)
+	assert.Zero(t, calls)
+
+	for _, grant := range []string{
+		permission.ResourceLocation.String() + ":" + string(permission.OpCreate),
+		permission.ResourceLocation.String() + ":" + string(permission.OpUpdate),
+		permission.ResourceCustomer.String() + ":" + string(permission.OpCreate),
+		permission.ResourceCustomer.String() + ":" + string(permission.OpUpdate),
+	} {
+		status, calls = autocomplete(t, grant)
+		assert.Equal(t, http.StatusOK, status, grant)
+		assert.Equal(t, 1, calls, grant)
+	}
+}
