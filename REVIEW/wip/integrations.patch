+
+func TestUpdateConfigRefusesABaseURLThatIsNotAPublicHTTPSHost(t *testing.T) {
+	t.Parallel()
+
+	refused := []string{
+		"http://api.resend.com",
+		"https://169.254.169.254/latest/meta-data",
+		"https://10.0.0.8",
+		"https://localhost:8443",
+		"https://metadata.google.internal",
+		"https://user:pass@api.resend.com",
+		"https://api.resend.com/?redirect=1",
+		"gopher://api.resend.com",
+	}
+	for _, baseURL := range refused {
+		repo := &stubIntegrationRepo{
+			getByTypeErr: errortypes.NewNotFoundError("integration not found"),
+		}
+		_, err := newDestinationTestService(repo).UpdateConfig(
+			t.Context(),
+			pagination.TenantInfo{},
+			integration.TypeResend,
+			&integrationports.UpdateConfigRequest{
+				Enabled:       true,
+				Configuration: map[string]string{"apiKey": "re_key", "baseUrl": baseURL},
+			},
+			"",
+		)
+
+		var multiErr *errortypes.MultiError
+		require.ErrorAs(t, err, &multiErr, baseURL)
+		require.Len(t, multiErr.Errors, 1, baseURL)
+		assert.Equal(t, "configuration.baseUrl", multiErr.Errors[0].Field, baseURL)
+		assert.Equal(t, errortypes.ErrInvalid, multiErr.Errors[0].Code, baseURL)
+	}
+}
+
+func TestUpdateConfigAcceptsAPublicHTTPSBaseURL(t *testing.T) {
