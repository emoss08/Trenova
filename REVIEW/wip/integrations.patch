+
+func requireSecretsForNewDestination(
+	req *UpsertEDICommunicationProfileRequest,
+	existing *edi.EDICommunicationProfile,
+	method edi.ConnectionMethod,
+	config map[string]any,
+) error {
+	if existing == nil || len(existing.EncryptedSecrets) == 0 ||
+		!profileDestinationChanged(existing, method, config) {
+		return nil
+	}
+
+	multiErr := errortypes.NewMultiError()
+	keys := slices.Sorted(maps.Keys(existing.EncryptedSecrets))
+	for _, key := range keys {
+		if strings.TrimSpace(existing.EncryptedSecrets[key]) == "" ||
+			strings.TrimSpace(req.Secrets[key]) != "" ||
+			!secretSentToDestination(method, key) {
+			continue
+		}
+		multiErr.Add(
+			"secrets."+key,
+			errortypes.ErrRequired,
+			"Enter this secret again: the destination changed, and a saved secret is never sent to a new one",
+		)
+	}
+	if multiErr.HasErrors() {
+		return multiErr
+	}
+
+	return nil
+}
+
+func profileDestinationChanged(
+	existing *edi.EDICommunicationProfile,
+	method edi.ConnectionMethod,
+	config map[string]any,
+) bool {
+	if existing.Method != method {
+		return true
+	}
+	for _, key := range profileDestinationKeys {
+		before := maputils.StringValue(existing.Config, key)
+		after := maputils.StringValue(config, key)
+		if before == after {
+			continue
+		}
+		if key == editransport.ConfigKeyEndpointURL && before != "" && after != "" &&
+			httpsafe.SameOrigin(before, after) {
+			continue
+		}
+		if key != editransport.ConfigKeyEndpointURL && strings.EqualFold(before, after) {
+			continue
+		}
+		return true
+	}
+
+	return false
+}
+
+func secretSentToDestination(method edi.ConnectionMethod, key string) bool {
+	return method != edi.ConnectionMethodAS2 || key != editransport.SecretKeyAS2PrivateKey
+}
