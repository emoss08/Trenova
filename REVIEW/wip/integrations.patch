+package modeladapter
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/emoss08/trenova/shared/httpsafe"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPostJSONRefusesAResponsePastTheLimit(t *testing.T) {
+	t.Parallel()
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"text":"`))
+		chunk := []byte(strings.Repeat("a", 1<<20))
+		for written := 0; written <= maxProviderResponseBytes; written += len(chunk) {
+			if _, err := w.Write(chunk); err != nil {
+				return
+			}
+		}
+		_, _ = w.Write([]byte(`"}`))
+	}))
+	t.Cleanup(server.Close)
+
+	var out map[string]any
+	err := postJSON(t.Context(), server.Client(), server.URL, nil, map[string]any{}, &out)
+
+	require.ErrorIs(t, err, httpsafe.ErrResponseTooLarge)
+	assert.Nil(t, out)
+}
+
+func TestProviderErrorBodyPastTheLimitIsReportedNotTruncated(t *testing.T) {
+	t.Parallel()
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusBadGateway)
+		_, _ = w.Write([]byte(strings.Repeat("x", maxProviderErrorBytes+1)))
+	}))
+	t.Cleanup(server.Close)
+
+	var out map[string]any
+	err := postJSON(t.Context(), server.Client(), server.URL, nil, map[string]any{}, &out)
+
+	var transportErr *TransportError
+	require.ErrorAs(t, err, &transportErr)
+	assert.Equal(t, http.StatusBadGateway, transportErr.StatusCode)
+	assert.Equal(
+		t,
+		"the provider's error response could not be read: httpsafe: response body exceeds the limit of 1048576 bytes",
+		transportErr.Message,
+	)
+}
