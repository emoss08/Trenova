+	"github.com/stretchr/testify/require"
+)
+
+func as2Profile(endpoint string) *edi.EDICommunicationProfile {
+	return &edi.EDICommunicationProfile{
+		Method: edi.ConnectionMethodAS2,
+		Config: map[string]any{editransport.ConfigKeyEndpointURL: endpoint},
+		EncryptedSecrets: map[string]string{
+			editransport.SecretKeyBasicAuthPassword: "sealed-password",
+			editransport.SecretKeyAS2PrivateKey:     "sealed-key",
+		},
+	}
+}
+
+func destinationErrorFields(t *testing.T, err error) []string {
+	t.Helper()
+
+	var multiErr *errortypes.MultiError
+	require.ErrorAs(t, err, &multiErr)
+	fields := make([]string, 0, len(multiErr.Errors))
+	for _, item := range multiErr.Errors {
+		assert.Equal(t, errortypes.ErrRequired, item.Code)
+		fields = append(fields, item.Field)
+	}
+	return fields
+}
+
+func TestMovingAnAS2ProfileToANewEndpointRequiresTheBasicAuthPasswordAgain(t *testing.T) {
+	t.Parallel()
+
+	existing := as2Profile("https://edi.partner.com/as2")
+	err := requireSecretsForNewDestination(
+		&UpsertEDICommunicationProfileRequest{},
+		existing,
+		edi.ConnectionMethodAS2,
+		map[string]any{editransport.ConfigKeyEndpointURL: "https://collector.attacker.example/as2"},
+	)
+
+	assert.Equal(t, []string{"secrets.basicAuthPassword"}, destinationErrorFields(t, err))
+}
+
+func TestAS2ProfileOnTheSameOriginKeepsItsSecrets(t *testing.T) {
+	t.Parallel()
+
+	existing := as2Profile("https://edi.partner.com/as2")
+	err := requireSecretsForNewDestination(
+		&UpsertEDICommunicationProfileRequest{},
+		existing,
+		edi.ConnectionMethodAS2,
+		map[string]any{editransport.ConfigKeyEndpointURL: "https://EDI.partner.com:443/as2/inbound"},
+	)
+
+	require.NoError(t, err)
+}
+
+func TestReenteredSecretSatisfiesTheMove(t *testing.T) {
+	t.Parallel()
+
+	existing := as2Profile("https://edi.partner.com/as2")
+	err := requireSecretsForNewDestination(
+		&UpsertEDICommunicationProfileRequest{
+			Secrets: map[string]string{editransport.SecretKeyBasicAuthPassword: "new-password"},
+		},
+		existing,
+		edi.ConnectionMethodAS2,
+		map[string]any{editransport.ConfigKeyEndpointURL: "https://edi2.partner.com/as2"},
+	)
+
+	require.NoError(t, err)
+}
+
+func TestMovingAnSFTPProfileRequiresEveryStoredSecretAgain(t *testing.T) {
+	t.Parallel()
+
+	existing := &edi.EDICommunicationProfile{
+		Method: edi.ConnectionMethodSFTP,
+		Config: map[string]any{
+			configKeyHost:         "sftp.partner.com",
+			configKeyPort:         "22",
+			configKeyKnownHostKey: "ssh-ed25519 AAAA",
+		},
+		EncryptedSecrets: map[string]string{
+			secretKeyPassword:   "sealed-password",
+			secretKeyPrivateKey: "sealed-key",
+		},
+	}
+
+	for key, value := range map[string]string{
+		configKeyHost:         "sftp.attacker.example",
+		configKeyPort:         "2222",
+		configKeyKnownHostKey: "ssh-ed25519 BBBB",
+	} {
+		config := map[string]any{}
+		for k, v := range existing.Config {
+			config[k] = v
+		}
+		config[key] = value
+
+		err := requireSecretsForNewDestination(
+			&UpsertEDICommunicationProfileRequest{},
+			existing,
+			edi.ConnectionMethodSFTP,
+			config,
+		)
+
+		assert.Equal(
+			t,
+			[]string{"secrets.password", "secrets.privateKey"},
+			destinationErrorFields(t, err),
+			key,
+		)
+	}
+}
+
+func TestChangingTheProfileMethodIsANewDestination(t *testing.T) {
+	t.Parallel()
+
+	existing := as2Profile("https://edi.partner.com/as2")
+	err := requireSecretsForNewDestination(
+		&UpsertEDICommunicationProfileRequest{},
+		existing,
+		edi.ConnectionMethodSFTP,
+		map[string]any{configKeyHost: "sftp.partner.com"},
+	)
+
+	assert.Equal(
+		t,
+		[]string{"secrets.basicAuthPassword", "secrets.privateKey"},
+		destinationErrorFields(t, err),
+	)
+}
