diff --git a/services/tms/schema/migrations/20261231022800_integration_webhook_token.sql b/services/tms/schema/migrations/20261231022800_integration_webhook_token.sql
new file mode 100644
index 000000000..de769226b
--- /dev/null
+++ b/services/tms/schema/migrations/20261231022800_integration_webhook_token.sql
@@ -0,0 +1,42 @@
+-- An integration's webhook token is the route an inbound provider webhook resolves its tenant
+-- by, so the server generates it, it is unique, and it lives in its own column where an index
+-- can find it. It used to sit in the tenant-editable configuration, unindexed and unconstrained.
+ALTER TABLE "integrations"
+    ADD COLUMN IF NOT EXISTS "webhook_token" VARCHAR(100);
+
+-- A token the server generated earlier keeps working; any other value (set by a tenant, or
+-- shared by two rows) is replaced by a fresh one the provider must be given again.
+WITH "generated" AS (
+    SELECT
+        "id",
+        "organization_id",
+        "business_unit_id",
+        TRIM("configuration"->>'webhookToken') AS "token"
+    FROM "integrations"
+    WHERE "type" IN ('Samsara', 'Resend', 'Postmark')
+      AND TRIM("configuration"->>'webhookToken') ~ '^(samsara|resend|postmark)_[0-9a-f]{48}$'
+),
+"unique_tokens" AS (
+    SELECT "token"
+    FROM "generated"
+    GROUP BY "token"
+    HAVING count(*) = 1
+)
+UPDATE "integrations" AS i
+SET "webhook_token" = g."token"
+FROM "generated" AS g
+JOIN "unique_tokens" AS u ON u."token" = g."token"
+WHERE i."id" = g."id"
+  AND i."organization_id" = g."organization_id"
+  AND i."business_unit_id" = g."business_unit_id";
+
+UPDATE "integrations"
+SET "webhook_token" = lower("type") || '_' ||
+    replace(gen_random_uuid()::text, '-', '') ||
+    replace(gen_random_uuid()::text, '-', '')
+WHERE "type" IN ('Samsara', 'Resend', 'Postmark')
+  AND "webhook_token" IS NULL;
+
+UPDATE "integrations"
+SET "configuration" = "configuration" - 'webhookToken'
+WHERE "configuration" ? 'webhookToken';
diff --git a/services/tms/schema/migrations/20261231022810_integration_webhook_token_index.sql b/services/tms/schema/migrations/20261231022810_integration_webhook_token_index.sql
new file mode 100644
index 000000000..319f3d8de
--- /dev/null
+++ b/services/tms/schema/migrations/20261231022810_integration_webhook_token_index.sql
@@ -0,0 +1,6 @@
+--keel:notx
+-- An inbound provider webhook finds its integration, before its tenant is known, by token and
+-- type; a token belongs to exactly one integration.
+CREATE UNIQUE INDEX CONCURRENTLY IF NOT EXISTS "uq_integrations_webhook_token" ON "integrations"("webhook_token")
+WHERE
+    "webhook_token" IS NOT NULL;
