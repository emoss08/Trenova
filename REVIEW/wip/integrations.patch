+
+func TestSuggestCarriersLooksUpEveryIdentityInOneQuery(t *testing.T) {
+	t.Parallel()
+
+	tenant := pagination.TenantInfo{OrgID: pulid.MustNew("org_"), BuID: pulid.MustNew("bu_")}
+	older := &carrier.Carrier{ID: pulid.MustNew("car_"), SCAC: "ACME", DOTNumber: "111"}
+	newer := &carrier.Carrier{ID: pulid.MustNew("car_"), SCAC: "ROAD", DOTNumber: "222"}
+
+	repo := carrierportsmock.NewMockCarrierRepository(t)
+	repo.EXPECT().
+		FindByIdentities(mock.Anything, &carrierports.FindCarriersByIdentitiesRequest{
+			TenantInfo: tenant,
+			SCACs:      []string{"ROAD", "ACME", "NONE"},
+			DOTNumbers: []string{"111"},
+		}).
+		Return([]*carrier.Carrier{older, newer}, nil).
+		Once()
+	svc := &Service{l: zap.NewNop(), carrierRepo: repo}
+
+	road := CarrierIdentity{SCAC: "ROAD", DOTNumber: "111"}
+	acme := CarrierIdentity{SCAC: "ACME"}
+	none := CarrierIdentity{SCAC: "NONE"}
+	got, err := svc.SuggestCarriers(t.Context(), tenant, []CarrierIdentity{road, acme, none, acme, {}})
+
+	require.NoError(t, err)
+	assert.Same(t, older, got[road], "the oldest carrier matching either identifier wins")
+	assert.Same(t, older, got[acme])
+	assert.Nil(t, got[none])
+	assert.Len(t, got, 2)
+}
+
+func TestSuggestCarriersWithoutIdentifiersReadsNothing(t *testing.T) {
