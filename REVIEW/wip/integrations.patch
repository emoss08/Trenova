@@ -0,0 +1,98 @@
+package integrationservice
+
+import (
+	"testing"
+
+	"github.com/emoss08/trenova/internal/modules/kernel/domain/configspec"
+	"github.com/emoss08/trenova/internal/modules/workspace/domain/integration"
+	"github.com/emoss08/trenova/internal/modules/workspace/ports/integrationports"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestWebhookTokenIsGeneratedByTheServerAndNeverTakenFromTheRequest(t *testing.T) {
+	t.Parallel()
+
+	repo := &stubIntegrationRepo{
+		getByTypeErr: errortypes.NewNotFoundError("integration not found"),
+	}
+	resp, err := newDestinationTestService(repo).UpdateConfig(
+		t.Context(),
+		pagination.TenantInfo{},
+		integration.TypeSamsara,
+		&integrationports.UpdateConfigRequest{
+			Enabled: true,
+			Configuration: map[string]string{
+				"token":        "samsara-token",
+				"webhookToken": "samsara_victim-tenant-token",
+			},
+		},
+		"",
+	)
+
+	require.NoError(t, err)
+	assert.Regexp(t, `^samsara_[0-9a-f]{64}$`, resp.WebhookToken)
+	for _, field := range resp.Fields {
+		assert.NotEqual(t, "webhookToken", field.Key)
+	}
+}
+
+func TestSavingAnIntegrationKeepsItsWebhookToken(t *testing.T) {
+	t.Parallel()
+
+	const token = "resend_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+	svc := newDestinationTestService(&stubIntegrationRepo{})
+	existingConfig, err := svc.secrets.Merge(
+		integration.ConfigSpecs[integration.TypeResend].Fields,
+		map[string]string{"apiKey": "re_key"},
+		nil,
+		newSecretScope(pagination.TenantInfo{}, integration.TypeResend),
+	)
+	require.NoError(t, err)
+	require.NotEmpty(t, configspec.ReadString(existingConfig, "apiKey"))
+
+	repo := &stubIntegrationRepo{
+		getByTypeResult: &integration.Integration{
+			Type:          integration.TypeResend,
+			Enabled:       true,
+			Configuration: existingConfig,
+			WebhookToken:  token,
+		},
+	}
+	resp, err := newDestinationTestService(repo).UpdateConfig(
+		t.Context(),
+		pagination.TenantInfo{},
+		integration.TypeResend,
+		&integrationports.UpdateConfigRequest{
+			Enabled:       true,
+			Configuration: map[string]string{"webhookToken": "resend_attacker"},
+		},
+		"",
+	)
+
+	require.NoError(t, err)
+	assert.Equal(t, token, resp.WebhookToken)
+}
+
+func TestIntegrationsWithoutWebhooksGetNoToken(t *testing.T) {
+	t.Parallel()
+
+	repo := &stubIntegrationRepo{
+		getByTypeErr: errortypes.NewNotFoundError("integration not found"),
+	}
+	resp, err := newDestinationTestService(repo).UpdateConfig(
+		t.Context(),
+		pagination.TenantInfo{},
+		integration.TypePCMiler,
+		&integrationports.UpdateConfigRequest{
+			Enabled:       true,
+			Configuration: map[string]string{"apiKey": "pcm-key"},
+		},
+		"",
+	)
+
+	require.NoError(t, err)
+	assert.Empty(t, resp.WebhookToken)
+}
