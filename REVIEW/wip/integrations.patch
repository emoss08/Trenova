+package loaders
+
+import (
+	"context"
+	"testing"
+
+	"github.com/emoss08/trenova/internal/modules/parties/domain/carrier"
+	"github.com/emoss08/trenova/internal/modules/settlement/app/carriersettlementservice"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/vikstrous/dataloadgen"
+)
+
+type countingSuggester struct {
+	calls    int
+	received []carriersettlementservice.CarrierIdentity
+	answers  map[carriersettlementservice.CarrierIdentity]*carrier.Carrier
+}
+
+func (s *countingSuggester) SuggestCarriers(
+	_ context.Context,
+	_ pagination.TenantInfo,
+	identities []carriersettlementservice.CarrierIdentity,
+) (map[carriersettlementservice.CarrierIdentity]*carrier.Carrier, error) {
+	s.calls++
+	s.received = append(s.received, identities...)
+	return s.answers, nil
+}
+
+func TestSuggestedCarrierLoaderResolvesAPageInOneLookup(t *testing.T) {
+	t.Parallel()
+
+	acme := &carrier.Carrier{Name: "Acme", SCAC: "ACME"}
+	byDOT := &carrier.Carrier{Name: "Roadrunner", DOTNumber: "123456"}
+	suggester := &countingSuggester{answers: map[carriersettlementservice.CarrierIdentity]*carrier.Carrier{
+		{SCAC: "ACME"}:         acme,
+		{DOTNumber: "123456"}: byDOT,
+	}}
+	ctx := (&SuggestedCarrierByIdentityLoaderFactory{suggester: suggester}).
+		Attach(t.Context(), pagination.TenantInfo{})
+
+	keys := []string{
+		CarrierIdentityKey(carriersettlementservice.CarrierIdentity{SCAC: "ACME"}),
+		CarrierIdentityKey(carriersettlementservice.CarrierIdentity{DOTNumber: "123456"}),
+		CarrierIdentityKey(carriersettlementservice.CarrierIdentity{SCAC: "NONE", DOTNumber: "9"}),
+		CarrierIdentityKey(carriersettlementservice.CarrierIdentity{SCAC: "ACME"}),
+	}
+	got, err := loadAll(ctx, keys, func(s *set) *dataloadgen.Loader[string, *carrier.Carrier] {
+		return s.suggestedCarrierByIdentity
+	})
+
+	require.NoError(t, err)
+	assert.Equal(t, []*carrier.Carrier{acme, byDOT, nil, acme}, got)
+	assert.Equal(t, 1, suggester.calls)
+	assert.ElementsMatch(t, []carriersettlementservice.CarrierIdentity{
+		{SCAC: "ACME"},
+		{DOTNumber: "123456"},
+		{SCAC: "NONE", DOTNumber: "9"},
+	}, suggester.received)
+}
