+package httpsafe
+
+import (
+	"errors"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestReadBodyRefusesABodyPastTheLimit(t *testing.T) {
+	t.Parallel()
+
+	data, err := ReadBody(strings.NewReader("12345"), 5)
+	require.NoError(t, err)
+	assert.Equal(t, "12345", string(data))
+
+	data, err = ReadBody(strings.NewReader("123456"), 5)
+	require.ErrorIs(t, err, ErrResponseTooLarge)
+	assert.Nil(t, data)
+	assert.Equal(t, "httpsafe: response body exceeds the limit of 5 bytes", err.Error())
+}
+
+func TestValidateServiceURL(t *testing.T) {
+	t.Parallel()
+
+	accepted := []string{
+		"https://api.samsara.com",
+		"https://api.eu.samsara.com/",
+		"https://pcmiler.alk.com/apis/rest/v1.0/Service.svc",
+		"https://exchange-rates-api.oanda.com:8443",
+		"https://8.8.8.8/api",
+		"  https://api.resend.com  ",
+	}
+	for _, raw := range accepted {
+		_, err := ValidateServiceURL(raw)
+		require.NoError(t, err, raw)
+	}
+
+	refused := map[string]error{
+		"http://api.samsara.com":                     ErrInsecureURL,
+		"https://user:pass@api.samsara.com":          ErrInsecureURL,
+		"https://api.samsara.com/?token=1":           ErrServiceURL,
+		"https://api.samsara.com/#frag":              ErrServiceURL,
+		"https://localhost":                          ErrServiceURL,
+		"https://metadata":                           ErrServiceURL,
+		"https://metadata.google.internal":           ErrServiceURL,
+		"https://printer.local":                      ErrServiceURL,
+		"https://db.svc.cluster.localdomain":         ErrServiceURL,
+		"https://bad_host.example.com":               ErrServiceURL,
+		"https://-bad.example.com":                   ErrServiceURL,
+		"https://127.0.0.1":                          ErrBlockedAddress,
+		"https://169.254.169.254/latest/meta-data/":  ErrBlockedAddress,
+		"https://10.0.0.5":                           ErrBlockedAddress,
+		"https://[::1]/":                             ErrBlockedAddress,
+		"ftp://files.example.com":                    ErrBlockedScheme,
+		"https://":                                   ErrMissingHost,
+		"javascript:alert(1)":                        ErrBlockedScheme,
+		"https://api.samsara.com?":                   ErrServiceURL,
+		"https://" + strings.Repeat("a", 64) + ".io": ErrServiceURL,
+	}
+	for raw, want := range refused {
+		_, err := ValidateServiceURL(raw)
+		require.ErrorIs(t, err, want, raw)
+	}
+}
+
+func TestRedactURLErrorDropsTheQueryString(t *testing.T) {
+	t.Parallel()
+
+	original := &url.Error{
+		Op:  "Get",
+		URL: "https://api.eia.gov/v2/petroleum/pri/gnd/data/?api_key=secret-key&frequency=weekly",
+		Err: errors.New("dial tcp: i/o timeout"),
+	}
+
+	redacted := RedactURLError(original)
+
+	assert.Equal(
+		t,
+		`Get "https://api.eia.gov/v2/petroleum/pri/gnd/data/": dial tcp: i/o timeout`,
+		redacted.Error(),
+	)
+	assert.NotContains(t, original.URL, "redacted")
+
+	plain := errors.New("not a url error")
+	assert.Same(t, plain, RedactURLError(plain))
+}
+
+func TestUpstreamErrorMessageReadsOnlyAProviderErrorField(t *testing.T) {
+	t.Parallel()
+
+	cases := map[string]string{
+		`{"message":"Invalid API key"}`:                     "Invalid API key",
+		`{"Message":"Account suspended","ErrorCode":10}`:    "Account suspended",
+		`{"error":"model not found"}`:                       "model not found",
+		`{"error":{"message":"quota exceeded"}}`:            "quota exceeded",
+		`{"errors":[{"message":"first"},{"message":"two"}]}`: "first",
+		`{"detail":"Not authenticated"}`:                    "Not authenticated",
+		`<html><body>ami-id instance-id</body></html>`:      "",
+		`ami-id\nhostname\ninstance-id`:                     "",
+		`{"Code":"Secret","AccessKeyId":"AKIA"}`:            "",
+		``:                                                  "",
+	}
+	for body, want := range cases {
+		assert.Equal(t, want, UpstreamErrorMessage([]byte(body)), body)
+	}
+}
+
+func TestUpstreamMessageIsBoundedAndPlain(t *testing.T) {
+	t.Parallel()
+
+	assert.Equal(t, "Invalid API key", UpstreamMessage("  Invalid\n\tAPI   key \x00"))
+	assert.Equal(t, "scripthi/script", UpstreamMessage("<script>hi</script>"))
+	assert.Equal(t, "a0 b", UpstreamMessage("a{0} b"))
+
+	long := UpstreamMessage(strings.Repeat("x", 500))
+	assert.Equal(t, strings.Repeat("x", 200)+"...", long)
+}
