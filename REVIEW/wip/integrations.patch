diff --git a/services/tms/internal/api/graphql/loaders/suggestedcarrierloader.go b/services/tms/internal/api/graphql/loaders/suggestedcarrierloader.go
new file mode 100644
index 000000000..c646fcf15
--- /dev/null
+++ b/services/tms/internal/api/graphql/loaders/suggestedcarrierloader.go
@@ -0,0 +1,79 @@
+package loaders
+
+import (
+	"context"
+	"strings"
+
+	"github.com/emoss08/trenova/internal/modules/parties/domain/carrier"
+	"github.com/emoss08/trenova/internal/modules/settlement/app/carriersettlementservice"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/vikstrous/dataloadgen"
+	"go.uber.org/fx"
+)
+
+const carrierIdentityKeySeparator = "\x1f"
+
+type carrierSuggester interface {
+	SuggestCarriers(
+		ctx context.Context,
+		tenantInfo pagination.TenantInfo,
+		identities []carriersettlementservice.CarrierIdentity,
+	) (map[carriersettlementservice.CarrierIdentity]*carrier.Carrier, error)
+}
+
+type SuggestedCarrierByIdentityLoaderFactoryParams struct {
+	fx.In
+
+	CarrierSettlementService *carriersettlementservice.Service
+}
+
+type SuggestedCarrierByIdentityLoaderFactory struct {
+	suggester carrierSuggester
+}
+
+func NewSuggestedCarrierByIdentityLoaderFactory(
+	p SuggestedCarrierByIdentityLoaderFactoryParams,
+) *SuggestedCarrierByIdentityLoaderFactory {
+	return &SuggestedCarrierByIdentityLoaderFactory{suggester: p.CarrierSettlementService}
+}
+
+func CarrierIdentityKey(identity carriersettlementservice.CarrierIdentity) string {
+	return identity.SCAC + carrierIdentityKeySeparator + identity.DOTNumber
+}
+
+func parseCarrierIdentityKey(key string) carriersettlementservice.CarrierIdentity {
+	scac, dot, _ := strings.Cut(key, carrierIdentityKeySeparator)
+	return carriersettlementservice.CarrierIdentity{SCAC: scac, DOTNumber: dot}
+}
+
+func newSuggestedCarrierByIdentityLoader(
+	f *SuggestedCarrierByIdentityLoaderFactory,
+	tenantInfo pagination.TenantInfo,
+) *dataloadgen.Loader[string, *carrier.Carrier] {
+	return newLoader(f.batchFunc(tenantInfo))
+}
+
+func (f *SuggestedCarrierByIdentityLoaderFactory) batchFunc(
+	tenantInfo pagination.TenantInfo,
+) batchFetchFunc[*carrier.Carrier] {
+	return func(ctx context.Context, keys []string) ([]*carrier.Carrier, []error) {
+		values := make([]*carrier.Carrier, len(keys))
+		errs := make([]error, len(keys))
+
+		identities := make([]carriersettlementservice.CarrierIdentity, len(keys))
+		for idx, key := range keys {
+			identities[idx] = parseCarrierIdentityKey(key)
+		}
+
+		suggestions, err := f.suggester.SuggestCarriers(ctx, tenantInfo, identities)
+		if err != nil {
+			fillMissingErrors(errs, err)
+			return values, errs
+		}
+		for idx, identity := range identities {
+			values[idx] = suggestions[identity]
+		}
+
+		return values, errs
+	}
+}
