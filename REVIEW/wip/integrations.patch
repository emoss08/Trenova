+func validateDestinationURLs(
+	typ integration.Type,
+	spec integration.IntegrationSpec,
+	config map[string]any,
+) error {
+	if typ.SupportsCarrierIntelligence() {
+		return nil
+	}
+
+	multiErr := errortypes.NewMultiError()
+	for idx := range spec.Fields {
+		field := &spec.Fields[idx]
+		if field.Type != integration.ConfigFieldTypeURL {
+			continue
+		}
+		value := integration.ReadConfigString(config, field.Key)
+		if value == "" {
+			continue
+		}
+		if _, err := httpsafe.ValidateServiceURL(value); err != nil {
+			multiErr.Add(
+				"configuration."+field.Key,
+				errortypes.ErrInvalid,
+				"{0} must be an HTTPS address on a public host name, with no user name, password, query or fragment",
+				field.Label,
+			)
+		}
+	}
+	if multiErr.HasErrors() {
+		return multiErr
+	}
+
+	return nil
+}
