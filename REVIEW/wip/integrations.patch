+	suggestions, err := s.SuggestCarriers(ctx, tenantInfo, []CarrierIdentity{identity})
+	if err != nil {
+		return nil, err
+	}
+
+	return suggestions[identity], nil
+}
+
+func (s *Service) SuggestCarriers(
+	ctx context.Context,
+	tenantInfo pagination.TenantInfo,
+	identities []CarrierIdentity,
+) (map[CarrierIdentity]*carrier.Carrier, error) {
+	scacs := make([]string, 0, len(identities))
+	dots := make([]string, 0, len(identities))
+	for _, identity := range identities {
+		if identity.SCAC != "" && !slices.Contains(scacs, identity.SCAC) {
+			scacs = append(scacs, identity.SCAC)
+		}
+		if identity.DOTNumber != "" && !slices.Contains(dots, identity.DOTNumber) {
+			dots = append(dots, identity.DOTNumber)
+		}
+	}
+	suggestions := make(map[CarrierIdentity]*carrier.Carrier, len(identities))
+	if len(scacs) == 0 && len(dots) == 0 {
+		return suggestions, nil
+	}
+
+	candidates, err := s.carrierRepo.FindByIdentities(
+		ctx,
+		&carrierports.FindCarriersByIdentitiesRequest{
+			TenantInfo: tenantInfo,
+			SCACs:      scacs,
+			DOTNumbers: dots,
+		},
+	)
+	if err != nil {
+		return nil, err
+	}
+	for _, identity := range identities {
+		for _, candidate := range candidates {
+			if identity.matches(candidate) {
+				suggestions[identity] = candidate
+				break
+			}
+		}
+	}
+
+	return suggestions, nil
 }
 
