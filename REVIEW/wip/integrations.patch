+				"baseUrl": "https://api.eu.samsara.com",
+			},
+		},
+		"",
+	)
+
+	require.NoError(t, err)
+	assert.Equal(t, "https://api.eu.samsara.com", findConfigField(t, resp.Fields, "baseUrl").Value)
