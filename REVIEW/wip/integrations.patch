+}
+
+func (i CarrierIdentity) matches(candidate *carrier.Carrier) bool {
+	return (i.SCAC != "" && candidate.SCAC == i.SCAC) ||
+		(i.DOTNumber != "" && candidate.DOTNumber == i.DOTNumber)
+}
+
+func InvoiceCarrierIdentity(invoice *edi.CarrierInvoice) CarrierIdentity {
+	return CarrierIdentity{
+		SCAC: strings.ToUpper(
+			strings.TrimSpace(referenceValue(invoice.ReferenceNumbers, "SCAC", "scac")),
+		),
+		DOTNumber: strings.TrimSpace(
+			referenceValue(invoice.ReferenceNumbers, "DOT", "dot", "DOT_NUMBER"),
+		),
+	}
+}
