+//go:build integration
+
+package carrierrepository
+
+import (
+	"testing"
+
+	"github.com/emoss08/trenova/internal/modules/parties/domain/carrier"
+	"github.com/emoss08/trenova/internal/modules/parties/domain/carrier/carrierdb"
+	"github.com/emoss08/trenova/internal/modules/parties/ports/carrierports"
+	"github.com/emoss08/trenova/internal/testutil/dbtest"
+	"github.com/emoss08/trenova/internal/testutil/seedtest"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+)
+
+func TestFindByIdentitiesReadsEveryMatchOfTheTenantInOneQuery(t *testing.T) {
+	ctx, admin, dsn, cleanup := seedtest.SetupTestDBWithDSN(t)
+	t.Cleanup(cleanup)
+
+	a := seedtest.SeedFullTestData(t, ctx, admin)
+	b := seedtest.SeedAdditionalTenant(t, ctx, admin, "CI")
+	repo := New(Params{DB: dbtest.NewRLSConnection(t, admin, dsn), Logger: zap.NewNop()})
+
+	seed := func(data *seedtest.TestData, code, scac, dot string, createdAt int64) *carrier.Carrier {
+		entity := &carrier.Carrier{
+			OrganizationID: data.Organization.ID,
+			BusinessUnitID: data.BusinessUnit.ID,
+			Code:           code,
+			Name:           code + " Carriers",
+			SCAC:           scac,
+			DOTNumber:      dot,
+		}
+		require.NoError(t, carrierdb.Carriers.Create(ctx, admin, entity))
+		c := carrierdb.Carriers
+		_, err := c.AllTenants().
+			Where(c.ID.Eq(entity.ID)).
+			Update(ctx, admin, c.CreatedAt.To(createdAt))
+		require.NoError(t, err)
+		entity.CreatedAt = createdAt
+		return entity
+	}
+
+	acme := seed(a, "ACME", "ACME", "100001", 100)
+	road := seed(a, "ROAD", "ROAD", "100002", 200)
+	seed(a, "ZETA", "ZETA", "100003", 300)
+	seed(b, "BACM", "ACME", "100001", 50)
+
+	found, err := repo.FindByIdentities(a.Ctx(ctx), &carrierports.FindCarriersByIdentitiesRequest{
+		TenantInfo: a.Info(),
+		SCACs:      []string{"ACME", "NONE"},
+		DOTNumbers: []string{"100002"},
+	})
+
+	require.NoError(t, err)
+	require.Len(t, found, 2)
+	assert.Equal(t, acme.ID, found[0].ID)
+	assert.Equal(t, road.ID, found[1].ID)
+
+	none, err := repo.FindByIdentities(a.Ctx(ctx), &carrierports.FindCarriersByIdentitiesRequest{
+		TenantInfo: a.Info(),
+	})
+	require.NoError(t, err)
+	assert.Empty(t, none)
+}
