@@ -0,0 +1,35 @@
+package middleware
+
+import (
+	"regexp"
+	"strings"
+)
+
+var LongLivedRoutePatterns = []string{
+	`^/api/v1/realtime/stream/$`,
+	`^/api/v1/assistant/turns/[^/]+/stream/$`,
+	`^/api/v1/capture/device/stream/$`,
+	`^/api/v1/agent-definitions/dry-run/$`,
+}
+
+var longLivedRoutes = compileRoutePatterns(LongLivedRoutePatterns)
+
+func compileRoutePatterns(patterns []string) []*regexp.Regexp {
+	compiled := make([]*regexp.Regexp, 0, len(patterns))
+	for _, pattern := range patterns {
+		compiled = append(compiled, regexp.MustCompile(pattern))
+	}
+	return compiled
+}
+
+func IsLongLivedRoute(path string) bool {
+	if !strings.HasPrefix(path, "/api/v1/") {
+		return false
+	}
+	for _, route := range longLivedRoutes {
+		if route.MatchString(path) {
+			return true
+		}
+	}
+	return false
+}
