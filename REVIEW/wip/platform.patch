+
+const handlers = vi.hoisted(() => new Map<string, (data: unknown) => void>());
+const findInFeed = vi.hoisted(() => vi.fn());
+const toastInfo = vi.hoisted(() => vi.fn());
+
+vi.mock("@trenova/shared/services/realtime", () => ({
+  realtimeClient: {
+    on: (event: string, handler: (data: unknown) => void) => {
+      handlers.set(event, handler);
+      return () => handlers.delete(event);
+    },
+    onStateChange: () => () => {},
+    connect: () => {},
+    disconnect: () => {},
+    getState: () => "connected",
+  },
+}));
+
+vi.mock("@trenova/shared/services/notification", () => ({
+  notificationService: { findInFeed },
+}));
+
+vi.mock("@/lib/desktop-notifications", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@/lib/desktop-notifications")>()),
+  deliverToDesktop: vi.fn(),
+}));
+
+vi.mock("@trenova/shared/components/ui/toast", () => ({
+  toast: { info: toastInfo, error: vi.fn(), success: vi.fn(), warning: vi.fn() },
+}));
+
+const { useRealtimeConnection } = await import("../use-realtime-connection");
+
+const ORG = "org_1";
+const BU = "bu_1";
+
+function emit(event: Record<string, unknown>) {
+  handlers.get("resource.invalidation")?.({ organizationId: ORG, businessUnitId: BU, ...event });
+}
+
+function notification(id: string, overrides: Record<string, unknown> = {}) {
+  return {
+    id,
+    organizationId: ORG,
+    businessUnitId: BU,
+    targetUserId: "usr_1",
+    eventType: "report_run_completed",
+    priority: "high",
+    channel: "user",
+    title: "Your report is ready",
+    message: "Lane margins",
+    data: { runId: "rrun_1" },
+    relatedEntities: null,
+    source: "reportjobs",
+    readAt: null,
+    dismissedAt: null,
+    createdAt: 1_700_000_000,
+    ...overrides,
+  };
+}
+
+/*
+The realtime contract carries no record: a notice is { resource, action,
+recordId, parentId?, actorUserId? }. A screen reads what changed through its
+own permission-checked queries, so nothing the reader may not see rides on
+the stream.
+*/
+describe("useRealtimeConnection", () => {
+  let client: QueryClient;
+  const unsubscribes: Array<() => void> = [];
+
+  beforeEach(() => {
+    vi.useFakeTimers();
+    findInFeed.mockReset();
+    toastInfo.mockReset();
+    client = new QueryClient({ defaultOptions: { queries: { retry: false, gcTime: Infinity } } });
