--- /dev/null
+++ b/client/apps/web/src/lib/__tests__/shipment-comment-realtime.test.ts
@@ -0,0 +1,84 @@
+import { QueryClient } from "@tanstack/react-query";
+import type { ResourceInvalidationEvent } from "@trenova/shared/hooks/realtime-patching";
+import { describe, expect, it, vi } from "vitest";
+import {
+  handleShipmentCommentEvent,
+  isShipmentCommentEvent,
+  subscribeToCommentInserts,
+} from "../shipment-comment-realtime";
+
+/*
+Fixtures follow the realtime contract for shipment comments: resource
+"shipment_comment", recordId the shipment, actorUserId the author, and an
+action: "created" for a top-level comment, "replied" for a reply, then
+"updated", "deleted", "pinned", "unpinned", "resolved", "unresolved" or
+"acknowledged". The event never carries the comment.
+*/
+function commentEvent(
+  action: string,
+  overrides: Partial<ResourceInvalidationEvent> = {},
+): ResourceInvalidationEvent {
+  return {
+    organizationId: "org_1",
+    businessUnitId: "bu_1",
+    resource: "shipment_comment",
+    action,
+    recordId: "shp_1",
+    actorUserId: "usr_2",
+    ...overrides,
+  };
+}
+
+function seeded() {
+  const client = new QueryClient();
+  client.setQueryData(["shipment-comments", "shp_1", "list", "all"], { pages: [] });
+  client.setQueryData(["shipment-comment-count", "shp_1"], { count: 3 });
+  client.setQueryData(["shipment-comments", "shp_2", "list", "all"], { pages: [] });
+  return client;
+}
+
+const stale = (client: QueryClient, key: readonly unknown[]) =>
+  client.getQueryState(key)?.isInvalidated ?? false;
+
+describe("handleShipmentCommentEvent", () => {
+  it("reads the named shipment's thread and count again, and no other shipment's", () => {
+    const client = seeded();
+
+    handleShipmentCommentEvent(client, commentEvent("updated"), "usr_1");
+
+    expect(stale(client, ["shipment-comments", "shp_1", "list", "all"])).toBe(true);
+    expect(stale(client, ["shipment-comment-count", "shp_1"])).toBe(true);
+    expect(stale(client, ["shipment-comments", "shp_2", "list", "all"])).toBe(false);
+  });
+
+  it("moves the new-comments pill for someone else's top-level comment only", () => {
+    const client = seeded();
+    const heard = vi.fn();
+    const off = subscribeToCommentInserts("shp_1", heard);
+
+    handleShipmentCommentEvent(client, commentEvent("created"), "usr_1");
+    handleShipmentCommentEvent(client, commentEvent("replied"), "usr_1");
+    handleShipmentCommentEvent(client, commentEvent("created", { actorUserId: "usr_1" }), "usr_1");
+    handleShipmentCommentEvent(client, commentEvent("created", { recordId: "shp_2" }), "usr_1");
+
+    expect(heard).toHaveBeenCalledTimes(1);
+    off();
+  });
+
+  it("reads every thread again when the event names no shipment", () => {
+    const client = seeded();
+
+    handleShipmentCommentEvent(client, commentEvent("updated", { recordId: undefined }), "usr_1");
+
+    expect(stale(client, ["shipment-comments", "shp_2", "list", "all"])).toBe(true);
+  });
+});
+
+describe("isShipmentCommentEvent", () => {
+  it("takes every comment action, replies included, and nothing else", () => {
+    expect(isShipmentCommentEvent(commentEvent("replied"))).toBe(true);
+    expect(isShipmentCommentEvent(commentEvent("acknowledged"))).toBe(true);
+    expect(isShipmentCommentEvent(commentEvent("exported"))).toBe(false);
+    expect(isShipmentCommentEvent(commentEvent("created", { resource: "shipments" }))).toBe(false);
+  });
+});
