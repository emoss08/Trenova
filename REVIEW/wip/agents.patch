+
+func TestSearchQuery_ScopesTheCandidatesToTheTenantInGoAsWellAsByPolicy(t *testing.T) {
+	t.Parallel()
+
+	req := &agentports.VectorSearchRequest{
+		ModelKey:   "text-embedding",
+		Dimensions: 4,
+		Query:      []float32{0.1, 0.2, 0.3, 0.4},
+		Limit:      5,
+	}
+	plan, err := planSearch(req)
+	require.NoError(t, err)
+
+	sql, args := keeltest.Render(t, searchQuery(req, plan))
+
+	candidate := sql[:strings.Index(sql, "best AS")]
+	assert.Contains(t, candidate, `."organization_id" = $`,
+		"the nearest neighbours are read from the caller's organization only")
+	assert.Contains(t, candidate, `."business_unit_id" = $`)
+	assert.Contains(t, args, keeltest.TestOrganizationID.String())
+	assert.Contains(t, args, keeltest.TestBusinessUnitID.String())
+}
