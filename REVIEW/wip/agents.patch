new file mode 100644
index 000000000..3a29bb765
--- /dev/null
+++ b/services/tms/internal/modules/agent/app/agentdefinitionservice/toolgrants.go
@@ -0,0 +1,162 @@
+package agentdefinitionservice
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"slices"
+
+	"github.com/emoss08/trenova/internal/modules/agent/app/agentaccessservice"
+	"github.com/emoss08/trenova/internal/modules/agent/domain/agent"
+	"github.com/emoss08/trenova/internal/modules/agent/domain/agentdefinition"
+	"github.com/emoss08/trenova/internal/modules/agent/ports/agentports"
+	"github.com/emoss08/trenova/internal/modules/identity/domain/permission"
+	"github.com/emoss08/trenova/internal/modules/identity/ports/permissionports"
+	"github.com/emoss08/trenova/pkg/errortypes"
+)
+
+var errNoEditorPermissions = errors.New("no permission engine to check the editor's own access with")
+
+type givenTool struct {
+	index  int
+	name   string
+	policy agentports.ToolPolicy
+}
+
+func (s *Service) checkToolGrants(
+	ctx context.Context,
+	definition, previous *agentdefinition.Definition,
+	actor *permissionports.RequestActor,
+) error {
+	given := s.givenTools(definition, previous)
+	if len(given) == 0 {
+		return nil
+	}
+	if actor == nil || !actor.IsUser() {
+		return errortypes.NewAuthorizationError(
+			"Only a person can give an agent tools, because each tool is checked against " +
+				"the access of the person giving it",
+		)
+	}
+	if s.permissions == nil {
+		return errNoEditorPermissions
+	}
+
+	held, err := s.permissions.GetEffectivePermissions(ctx, actor.UserID, actor.OrganizationID)
+	if err != nil {
+		return fmt.Errorf("read the access of the person saving the agent: %w", err)
+	}
+
+	for _, tool := range given {
+		grant := agentaccessservice.HeldToolOf(tool.policy)
+		violation, refused := held.DelegationViolation(
+			grant.Resource.String(),
+			[]permission.Operation{grant.Operation},
+			permission.DataScopeOrganization,
+		)
+		if !refused {
+			continue
+		}
+		s.recordRefusedTool(ctx, definition, actor, tool.name, violation)
+
+		multiErr := errortypes.NewMultiError()
+		multiErr.Add(
+			fmt.Sprintf("toolNames[%d]", tool.index),
+			errortypes.ErrForbidden,
+			"You can give an agent {0} only if your own role can {1} {2} across the organization",
+			tool.name,
+			string(violationOperation(violation, grant.Operation)),
+			grant.Resource.String(),
+		)
+
+		return multiErr
+	}
+
+	return nil
+}
+
+func (s *Service) recordRefusedTool(
+	ctx context.Context,
+	definition *agentdefinition.Definition,
+	actor *permissionports.RequestActor,
+	tool string,
+	violation permissionports.DelegationViolation,
+) {
+	if s.security == nil {
+		return
+	}
+
+	s.security.RecordChange(ctx, &permissionports.SecurityChange{
+		Resource:       permission.ResourceAgentDefinition,
+		ResourceID:     definition.ID.String(),
+		Operation:      permission.OpUpdate,
+		Actor:          actor.AuditActor(),
+		OrganizationID: actor.OrganizationID,
+		BusinessUnitID: actor.BusinessUnitID,
+		Comment:        "Refused a grant beyond the actor's own permissions",
+		Metadata: map[string]any{
+			"refused":   "agentTool",
+			"tool":      tool,
+			"resource":  violation.Resource,
+			"operation": string(violation.Operation),
+			"dataScope": string(violation.Scope),
+		},
+	})
+}
+
+func violationOperation(
+	violation permissionports.DelegationViolation,
+	wanted permission.Operation,
+) permission.Operation {
+	if violation.Operation != "" {
+		return violation.Operation
+	}
+
+	return wanted
+}
+
+func (s *Service) givenTools(definition, previous *agentdefinition.Definition) []givenTool {
+	given := make([]givenTool, 0, len(definition.ToolNames))
+	for idx, name := range definition.ToolNames {
+		policy, kind, ok := s.policyOf(name)
+		if !ok || agentaccessservice.HeldToolOf(policy).Resource == "" {
+			continue
+		}
+		if previous != nil && slices.Contains(previous.ToolNames, name) &&
+			!tierRaised(definition, previous, name, kind, policy) {
+			continue
+		}
+		given = append(given, givenTool{index: idx, name: name, policy: policy})
+	}
+
+	return given
+}
+
+func tierRaised(
+	definition, previous *agentdefinition.Definition,
+	name string,
+	kind agent.ToolKind,
+	policy agentports.ToolPolicy,
+) bool {
+	if kind != agent.ToolKindAction {
+		return false
+	}
+
+	return definition.EffectiveTier(name, policy.DefaultTier).
+		Above(previous.EffectiveTier(name, policy.DefaultTier))
+}
+
+func (s *Service) policyOf(name string) (agentports.ToolPolicy, agent.ToolKind, bool) {
+	if s.tools != nil {
+		if tool, ok := s.tools.Get(name); ok {
+			return tool.Policy(), agent.ToolKindAction, true
+		}
+	}
+	if s.queryTools != nil {
+		if tool, ok := s.queryTools.Get(name); ok {
+			return tool.Policy(), agent.ToolKindQuery, true
+		}
+	}
+
+	return agentports.ToolPolicy{}, "", false
+}
