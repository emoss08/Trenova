@@ -0,0 +1,43 @@
+package agenttest
+
+import (
+	"context"
+	"sync"
+
+	"github.com/emoss08/trenova/internal/modules/identity/domain/tenant"
+	"github.com/emoss08/trenova/internal/modules/identity/ports/tenantports"
+	"github.com/emoss08/trenova/pkg/domaintypes"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/shared/pulid"
+)
+
+type Members struct {
+	mu      sync.Mutex
+	Status  domaintypes.Status
+	Locked  bool
+	Removed bool
+	Err     error
+	Asked   []pulid.ID
+}
+
+func (m *Members) GetTenantMember(
+	_ context.Context,
+	req tenantports.GetTenantMemberRequest,
+) (*tenant.User, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	m.Asked = append(m.Asked, req.UserID)
+	if m.Err != nil {
+		return nil, m.Err
+	}
+	if m.Removed {
+		return nil, errortypes.NewNotFoundError("User not found")
+	}
+	status := m.Status
+	if status == "" {
+		status = domaintypes.StatusActive
+	}
+
+	return &tenant.User{ID: req.UserID, Status: status, IsLocked: m.Locked}, nil
+}
diff --git a/services/tms/internal/modules/agent/app/agentwaitservice/owner.go b/services/tms/internal/modules/agent/app/agentwaitservice/owner.go
