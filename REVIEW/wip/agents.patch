@@ -0,0 +1,85 @@
+package agentwaitservice
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/emoss08/trenova/internal/modules/agent/app/personaccess"
+	"github.com/emoss08/trenova/internal/modules/agent/domain/agentdefinition"
+	"github.com/emoss08/trenova/internal/modules/agent/domain/conversation"
+	"github.com/emoss08/trenova/internal/modules/agent/ports/agentdefinitionports"
+	"github.com/emoss08/trenova/internal/modules/identity/ports/permissionports"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/pkg/pagination"
+)
+
+const ownerLostAgent = "may no longer use the conversation's agent"
+
+var errNoOwnerAccess = errors.New("no way to check the access of the person a wait picks up for")
+
+type agentDefinitions interface {
+	GetByID(
+		ctx context.Context,
+		req agentdefinitionports.GetAgentDefinitionByIDRequest,
+	) (*agentdefinition.Definition, error)
+}
+
+type agentAccess interface {
+	MayUseAgent(
+		ctx context.Context,
+		actor *permissionports.RequestActor,
+		definition *agentdefinition.Definition,
+	) (bool, error)
+}
+
+func ownerActor(thread *conversation.Thread) *permissionports.RequestActor {
+	return &permissionports.RequestActor{
+		PrincipalType:  permissionports.PrincipalTypeUser,
+		PrincipalID:    thread.UserID,
+		UserID:         thread.UserID,
+		OrganizationID: thread.OrganizationID,
+		BusinessUnitID: thread.BusinessUnitID,
+	}
+}
+
+func (s *Service) ownerRefusal(
+	ctx context.Context,
+	thread *conversation.Thread,
+	tenant pagination.TenantInfo,
+) (string, error) {
+	refusal, err := personaccess.Check(ctx, s.members, tenant, thread.UserID)
+	if err != nil {
+		return "", err
+	}
+	if refusal != "" {
+		return string(refusal), nil
+	}
+	if s.definitions == nil || s.access == nil {
+		return "", errNoOwnerAccess
+	}
+
+	definition, err := s.definitions.GetByID(
+		ctx,
+		agentdefinitionports.GetAgentDefinitionByIDRequest{
+			ID:         thread.AgentDefinitionID,
+			TenantInfo: tenant,
+		},
+	)
+	if errortypes.IsNotFoundError(err) {
+		return ownerLostAgent, nil
+	}
+	if err != nil {
+		return "", fmt.Errorf("read the conversation's agent: %w", err)
+	}
+
+	allowed, err := s.access.MayUseAgent(ctx, ownerActor(thread), definition)
+	if err != nil {
+		return "", fmt.Errorf("check the owner's access to the conversation's agent: %w", err)
+	}
+	if !allowed {
+		return ownerLostAgent, nil
+	}
+
+	return "", nil
+}
