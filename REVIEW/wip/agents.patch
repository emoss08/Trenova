+func (s *Service) ownerMayBeActedFor(
+	ctx context.Context,
+	thread *conversation.Thread,
+	tenant pagination.TenantInfo,
+) bool {
+	refusal, err := personaccess.Check(ctx, s.members, tenant, thread.UserID)
+	if err != nil {
+		s.l.Warn("decision follow-up skipped: its owner could not be confirmed",
+			zap.String("thread", thread.ID.String()),
+			zap.Error(err),
+		)
+		return false
+	}
+	if refusal != "" {
+		s.l.Info("decision follow-up skipped: its owner "+string(refusal),
+			zap.String("thread", thread.ID.String()),
+		)
+		return false
+	}
+
+	return true
+}
