+//go:build integration
+
+package agentdecisionqueuerepository
+
+import (
+	"testing"
+
+	"github.com/emoss08/trenova/internal/modules/agent/domain/agent"
+	"github.com/emoss08/trenova/internal/modules/agent/domain/agent/agentdb"
+	"github.com/emoss08/trenova/internal/modules/agent/domain/conversation"
+	"github.com/emoss08/trenova/internal/modules/agent/domain/conversation/conversationdb"
+	"github.com/emoss08/trenova/internal/modules/agent/ports/agentports"
+	"github.com/emoss08/trenova/internal/testutil/dbtest"
+	"github.com/emoss08/trenova/internal/testutil/seedtest"
+	"github.com/emoss08/trenova/pkg/dbscope"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/emoss08/trenova/shared/pulid"
+	"github.com/emoss08/trenova/shared/timeutils"
+	"github.com/shopspring/decimal"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+)
+
+func TestPendingDecisions_KeepAPrivateConversationsWorkToItsOwner(t *testing.T) {
+	ctx, admin, dsn, cleanup := seedtest.SetupTestDBWithDSN(t)
+	t.Cleanup(cleanup)
+	data := seedtest.SeedFullTestData(t, ctx, admin)
+	tenant := pagination.TenantInfo{OrgID: data.Organization.ID, BuID: data.BusinessUnit.ID}
+	ctx = dbscope.WithTenant(ctx, tenant.DBTenant())
+	repo := &repository{db: dbtest.NewRLSConnection(t, admin, dsn), l: zap.NewNop()}
+	owner := data.User.ID
+	now := timeutils.NowUnix()
+
+	thread := &conversation.Thread{
+		OrganizationID:    tenant.OrgID,
+		BusinessUnitID:    tenant.BuID,
+		UserID:            owner,
+		AgentDefinitionID: pulid.MustNew("agd_"),
+		Title:             "Private conversation",
+	}
+	require.NoError(t, conversationdb.Threads.Create(ctx, admin, thread))
+
+	runOn := func(subject agent.SubjectType, subjectID pulid.ID) *agent.AgentRun {
+		t.Helper()
+		run := &agent.AgentRun{
+			OrganizationID:   tenant.OrgID,
+			BusinessUnitID:   tenant.BuID,
+			AgentType:        agent.TypeGeneral,
+			SubjectType:      subject,
+			SubjectID:        subjectID,
+			Status:           agent.RunStatusCompleted,
+			PromptVersion:    "v1",
+			InputContextHash: "hash",
+			StartedAt:        now,
+		}
+		require.NoError(t, agentdb.AgentRuns.Create(ctx, admin, run))
+
+		return run
+	}
+	propose := func(run *agent.AgentRun) *agent.AgentProposal {
+		t.Helper()
+		proposal := &agent.AgentProposal{
+			OrganizationID: tenant.OrgID,
+			BusinessUnitID: tenant.BuID,
+			RunID:          run.ID,
+			ToolName:       "shipment_hold",
+			ToolParams:     map[string]any{"reason": "private"},
+			Confidence:     decimal.RequireFromString("0.9"),
+			Rationale:      "private rationale",
+			AutonomyTier:   agent.TierPropose,
+			Status:         agent.ProposalStatusPending,
+			ExpiresAt:      now + 3600,
+		}
+		require.NoError(t, agentdb.AgentProposals.Create(ctx, admin, proposal))
+
+		return proposal
+	}
+	planOn := func(run *agent.AgentRun) *agent.AgentPlan {
+		t.Helper()
+		plan := &agent.AgentPlan{
+			OrganizationID: tenant.OrgID,
+			BusinessUnitID: tenant.BuID,
+			RunID:          run.ID,
+			Title:          "Move the loads",
+			Status:         agent.PlanStatusPending,
+			StepCount:      1,
+		}
+		require.NoError(t, agentdb.AgentPlans.Create(ctx, admin, plan))
+
+		return plan
+	}
+
+	privateRun := runOn(agent.SubjectAssistantThread, thread.ID)
+	backgroundRun := runOn(agent.SubjectShipment, pulid.MustNew("shp_"))
+	privateProposal := propose(privateRun)
+	privatePlan := planOn(privateRun)
+	backgroundProposal := propose(backgroundRun)
+	backgroundPlan := planOn(backgroundRun)
+
+	readers := map[string]struct {
+		reader agentports.RunReader
+		sees   []pulid.ID
+	}{
+		"the owner": {
+			reader: agentports.PersonRunRead(owner),
+			sees: []pulid.ID{
+				privateProposal.ID, privatePlan.ID, backgroundProposal.ID, backgroundPlan.ID,
+			},
+		},
+		"a colleague": {
+			reader: agentports.PersonRunRead(pulid.MustNew("usr_")),
+			sees:   []pulid.ID{backgroundProposal.ID, backgroundPlan.ID},
+		},
+		"a shared feed read as no person": {
+			reader: agentports.PersonRunRead(pulid.Nil),
+			sees:   []pulid.ID{backgroundProposal.ID, backgroundPlan.ID},
+		},
+	}
+
+	for name, tc := range readers {
+		query := agentports.ListPendingDecisionsQuery{
+			TenantInfo: tenant,
+			Limit:      10,
+			Now:        now,
+			Reader:     tc.reader,
+		}
+		page, err := repo.ListPending(ctx, query)
+		require.NoError(t, err, name)
+		ids := make([]pulid.ID, 0, len(page.Entries))
+		for _, entry := range page.Entries {
+			ids = append(ids, entry.ID)
+		}
+		assert.ElementsMatch(t, tc.sees, ids, name)
+
+		count, err := repo.CountPending(ctx, query)
+		require.NoError(t, err, name)
+		assert.Equal(t, int64(len(tc.sees)), count.N, "%s: the badge counts what the queue lists", name)
+
+		summary, err := repo.Summary(ctx, agentports.PendingDecisionSummaryRequest{
+			TenantInfo: tenant,
+			Now:        now,
+			Reader:     tc.reader,
+		})
+		require.NoError(t, err, name)
+		assert.Equal(t, len(tc.sees), summary.Total, name)
+	}
+}
