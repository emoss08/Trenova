+++ b/services/tms/internal/modules/agent/app/personaccess/personaccess.go
@@ -0,0 +1,72 @@
+package personaccess
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/emoss08/trenova/internal/modules/identity/domain/tenant"
+	"github.com/emoss08/trenova/internal/modules/identity/ports/tenantports"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/emoss08/trenova/shared/pulid"
+	"github.com/emoss08/trenova/shared/timeutils"
+)
+
+type Members interface {
+	GetTenantMember(
+		ctx context.Context,
+		req tenantports.GetTenantMemberRequest,
+	) (*tenant.User, error)
+}
+
+type Refusal string
+
+const (
+	NotMember Refusal = "no longer belongs to the organization"
+	Inactive  Refusal = "no longer has an active account"
+	Locked    Refusal = "has a locked account"
+)
+
+var errNoMembers = errors.New("no member reader to confirm the person with")
+
+func Check(
+	ctx context.Context,
+	members Members,
+	tenantInfo pagination.TenantInfo,
+	userID pulid.ID,
+) (Refusal, error) {
+	if members == nil {
+		return "", errNoMembers
+	}
+	if userID.IsNil() {
+		return NotMember, nil
+	}
+
+	user, err := members.GetTenantMember(ctx, tenantports.GetTenantMemberRequest{
+		UserID:     userID,
+		TenantInfo: pagination.TenantInfo{OrgID: tenantInfo.OrgID, BuID: tenantInfo.BuID},
+		Now:        timeutils.NowUnix(),
+	})
+	if errortypes.IsNotFoundError(err) {
+		return NotMember, nil
+	}
+	if err != nil {
+		return "", fmt.Errorf("read the person the work acts for: %w", err)
+	}
+
+	return refusalOf(user), nil
+}
+
+func refusalOf(user *tenant.User) Refusal {
+	switch {
+	case user == nil:
+		return NotMember
+	case !user.IsActive():
+		return Inactive
+	case user.IsLocked:
+		return Locked
+	default:
+		return ""
+	}
+}
