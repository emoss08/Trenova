@@ -0,0 +1,101 @@
+//go:build integration
+
+package agentplanrepository
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/emoss08/trenova/internal/modules/agent/domain/agent"
+	"github.com/emoss08/trenova/internal/modules/agent/domain/agent/agentdb"
+	"github.com/emoss08/trenova/internal/modules/agent/domain/conversation"
+	"github.com/emoss08/trenova/internal/modules/agent/domain/conversation/conversationdb"
+	"github.com/emoss08/trenova/internal/modules/agent/ports/agentports"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/emoss08/trenova/shared/pulid"
+	"github.com/emoss08/trenova/shared/timeutils"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPlanReads_KeepAPrivateConversationsPlansToItsOwner(t *testing.T) {
+	h := newPlanHarness(t)
+	owner := h.tenant.UserID
+	tenant := pagination.TenantInfo{OrgID: h.tenant.OrgID, BuID: h.tenant.BuID}
+
+	thread := &conversation.Thread{
+		OrganizationID:    tenant.OrgID,
+		BusinessUnitID:    tenant.BuID,
+		UserID:            owner,
+		AgentDefinitionID: pulid.MustNew("agd_"),
+		Title:             "Private conversation",
+	}
+	require.NoError(t, conversationdb.Threads.Create(h.ctx, h.admin, thread))
+
+	planOn := func(subject agent.SubjectType, subjectID pulid.ID) *agent.AgentPlan {
+		t.Helper()
+		run := &agent.AgentRun{
+			OrganizationID:   tenant.OrgID,
+			BusinessUnitID:   tenant.BuID,
+			AgentType:        agent.TypeGeneral,
+			SubjectType:      subject,
+			SubjectID:        subjectID,
+			Status:           agent.RunStatusCompleted,
+			PromptVersion:    "v1",
+			InputContextHash: "hash",
+			StartedAt:        timeutils.NowUnix(),
+		}
+		require.NoError(t, agentdb.AgentRuns.Create(h.ctx, h.admin, run))
+
+		return h.plan(t, run)
+	}
+	private := planOn(agent.SubjectAssistantThread, thread.ID)
+	background := planOn(agent.SubjectShipment, pulid.MustNew("shp_"))
+	all := []pulid.ID{private.ID, background.ID}
+
+	readers := map[string]struct {
+		reader agentports.RunReader
+		sees   []pulid.ID
+	}{
+		"the owner":     {reader: agentports.PersonRunRead(owner), sees: all},
+		"a colleague":   {reader: agentports.PersonRunRead(pulid.MustNew("usr_")), sees: []pulid.ID{background.ID}},
+		"no person":     {reader: agentports.PersonRunRead(pulid.Nil), sees: []pulid.ID{background.ID}},
+		"the runtime":   {reader: agentports.UnattendedRunRead(), sees: all},
+	}
+
+	for name, tc := range readers {
+		connection, err := h.repo.ListConnection(h.ctx, &agentports.ListAgentPlanConnectionRequest{
+			Filter: &pagination.QueryOptions{
+				TenantInfo: tenant,
+				Pagination: pagination.Info{Limit: 10},
+			},
+			Cursor: pagination.CursorInfo{Limit: 10, IncludeTotalCount: true},
+			Reader: tc.reader,
+		})
+		require.NoError(t, err, name)
+		ids := make([]pulid.ID, 0, len(connection.Items))
+		for _, plan := range connection.Items {
+			ids = append(ids, plan.ID)
+		}
+		assert.ElementsMatch(t, tc.sees, ids, name)
+		require.NotNil(t, connection.TotalCount, name)
+		assert.Equal(t, len(tc.sees), *connection.TotalCount, name)
+
+		for _, id := range all {
+			got, getErr := h.repo.GetByID(h.ctx, agentports.GetAgentPlanByIDRequest{
+				ID:         id,
+				TenantInfo: tenant,
+				Reader:     tc.reader,
+			})
+			if slices.Contains(tc.sees, id) {
+				require.NoError(t, getErr, name)
+				assert.Equal(t, id, got.ID, name)
+
+				continue
+			}
+			assert.True(t, errortypes.IsNotFoundError(getErr),
+				"%s: a plan from someone else's conversation reads as missing", name)
+		}
+	}
+}
