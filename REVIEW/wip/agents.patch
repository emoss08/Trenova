+func TestRegisterPortalRunWait_ParksTheWorkOnlyForAnOwnerWhoCanStillBeActedFor(t *testing.T) {
+	t.Parallel()
+
+	request := func(h *harness) *agentextensionports.RegisterPortalRunWaitRequest {
+		return &agentextensionports.RegisterPortalRunWaitRequest{
+			TenantInfo: pagination.TenantInfo{
+				OrgID: h.actor.OrganizationID,
+				BuID:  h.actor.BusinessUnitID,
+			},
+			RunID:    pulid.MustNew("aprn_"),
+			SiteName: "Kroger dock portal",
+			Owner:    agentextensionports.PortalTaskOwner{ThreadID: pulid.MustNew("athr_")},
+		}
+	}
+
+	active := newHarness()
+	active.svc.facts.portalRuns = runningPortal{}
+	require.NoError(t, active.svc.RegisterPortalRunWait(t.Context(), request(active)))
+	require.Len(t, active.waits.items, 1)
+	for _, wait := range active.waits.items {
+		assert.Equal(t, active.actor.UserID, wait.UserID)
+		assert.Equal(t, agentwait.KindPortalRun, wait.Kind)
+	}
+
+	locked := newHarness()
+	locked.svc.facts.portalRuns = runningPortal{}
+	locked.members.Locked = true
+	err := locked.svc.RegisterPortalRunWait(t.Context(), request(locked))
+	require.True(t, errortypes.IsBusinessError(err))
+	assert.Contains(t, err.Error(), "can no longer be acted for")
+	assert.Empty(t, locked.waits.items, "no wait is parked for a locked account")
+	assert.Empty(t, locked.workflows.started)
+}
+
+type runningPortal struct {
+	agentextensionports.PortalRunRepository
+}
+
+func (runningPortal) Get(
+	_ context.Context,
+	_ pagination.TenantInfo,
+	id pulid.ID,
+) (*agentextension.PortalRun, error) {
+	return &agentextension.PortalRun{ID: id, Status: agentextension.PortalRunStatusRunning}, nil
+}
