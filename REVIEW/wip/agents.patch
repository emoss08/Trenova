+
+	var authz *errortypes.AuthorizationError
+	require.ErrorAs(t, err, &authz)
+}
+
+func TestCheckToolGrants_RefusesWhenTheEditorCannotBeRead(t *testing.T) {
+	t.Parallel()
+
+	svc, engine := grantsService(nil)
+	engine.err = errors.New("cache down")
+	require.Error(t, svc.checkToolGrants(t.Context(),
+		definition(agentdefinition.TemplateGeneralAssistant, "shipment_get"), nil, personActor()))
+
+	unwired, _ := grantsService(nil)
+	unwired.permissions = nil
+	require.Error(t, unwired.checkToolGrants(t.Context(),
+		definition(agentdefinition.TemplateGeneralAssistant, "shipment_get"), nil, personActor()))
+}
