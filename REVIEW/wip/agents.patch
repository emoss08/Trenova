+
+func proposalIDs(proposals []*agent.AgentProposal) []pulid.ID {
+	ids := make([]pulid.ID, 0, len(proposals))
+	for _, proposal := range proposals {
+		ids = append(ids, proposal.ID)
+	}
+
+	return ids
+}
+
+func TestProposalReads_KeepAPrivateConversationsProposalsToItsOwner(t *testing.T) {
+	ctx, admin, dsn, cleanup := seedtest.SetupTestDBWithDSN(t)
+	t.Cleanup(cleanup)
+	data := seedtest.SeedFullTestData(t, ctx, admin)
+	tenant := pagination.TenantInfo{OrgID: data.Organization.ID, BuID: data.BusinessUnit.ID}
+	ctx = dbscope.WithTenant(ctx, tenant.DBTenant())
+	repo := &repository{db: dbtest.NewRLSConnection(t, admin, dsn), l: zap.NewNop()}
+	owner := data.User.ID
+	now := timeutils.NowUnix()
+
+	thread := &conversation.Thread{
+		OrganizationID:    tenant.OrgID,
+		BusinessUnitID:    tenant.BuID,
+		UserID:            owner,
+		AgentDefinitionID: pulid.MustNew("agd_"),
+		Title:             "Private conversation",
+	}
+	require.NoError(t, conversationdb.Threads.Create(ctx, admin, thread))
+
+	raise := func(subject agent.SubjectType, subjectID pulid.ID, at int64) *agent.AgentProposal {
+		t.Helper()
+		run := &agent.AgentRun{
+			OrganizationID:   tenant.OrgID,
+			BusinessUnitID:   tenant.BuID,
+			AgentType:        agent.TypeGeneral,
+			Trigger:          agent.RunTriggerChat,
+			SubjectType:      subject,
+			SubjectID:        subjectID,
+			Status:           agent.RunStatusCompleted,
+			PromptVersion:    "v1",
+			InputContextHash: "hash",
+			StartedAt:        at,
+		}
+		require.NoError(t, agentdb.AgentRuns.Create(ctx, admin, run))
+		proposal := &agent.AgentProposal{
+			OrganizationID: tenant.OrgID,
+			BusinessUnitID: tenant.BuID,
+			RunID:          run.ID,
+			ToolName:       "shipment_hold",
+			ToolParams:     map[string]any{"reason": "what the owner said in private"},
+			Confidence:     decimal.RequireFromString("0.9"),
+			Rationale:      "The owner said, in their own conversation, to hold it",
+			AutonomyTier:   agent.TierPropose,
+			Status:         agent.ProposalStatusPending,
+			ExpiresAt:      now + 3600,
+		}
+		require.NoError(t, agentdb.AgentProposals.Create(ctx, admin, proposal))
+
+		return proposal
+	}
+	private := raise(agent.SubjectAssistantThread, thread.ID, now-30)
+	orphan := raise(agent.SubjectAssistantThread, pulid.MustNew("athr_"), now-20)
+	background := raise(agent.SubjectShipment, pulid.MustNew("shp_"), now-10)
+	all := []pulid.ID{private.ID, orphan.ID, background.ID}
+
+	readers := map[string]struct {
+		reader agentports.RunReader
+		sees   []pulid.ID
+	}{
+		"the owner": {
+			reader: agentports.PersonRunRead(owner),
+			sees:   []pulid.ID{private.ID, background.ID},
+		},
+		"a colleague": {
+			reader: agentports.PersonRunRead(pulid.MustNew("usr_")),
+			sees:   []pulid.ID{background.ID},
+		},
+		"an agent or an API key": {
+			reader: agentports.PersonRunRead(pulid.Nil),
+			sees:   []pulid.ID{background.ID},
+		},
+		"the runtime": {
+			reader: agentports.UnattendedRunRead(),
+			sees:   all,
+		},
+	}
+
+	for name, tc := range readers {
+		listed, err := repo.List(ctx, &agentports.ListAgentProposalRequest{
+			Filter: &pagination.QueryOptions{
+				TenantInfo: tenant,
+				Pagination: pagination.Info{Limit: 10},
+			},
+			Reader: tc.reader,
+		})
+		require.NoError(t, err, name)
+		assert.ElementsMatch(t, tc.sees, proposalIDs(listed.Items), name)
+		assert.Equal(t, len(tc.sees), listed.Total, "%s: the total agrees with the page", name)
+
+		connection, err := repo.ListConnection(ctx, &agentports.ListAgentProposalConnectionRequest{
+			Filter: &pagination.QueryOptions{
+				TenantInfo: tenant,
+				Pagination: pagination.Info{Limit: 10},
+			},
+			Cursor: pagination.CursorInfo{Limit: 10, IncludeTotalCount: true},
+			Reader: tc.reader,
+		})
+		require.NoError(t, err, name)
+		assert.ElementsMatch(t, tc.sees, proposalIDs(connection.Items), name)
+		require.NotNil(t, connection.TotalCount, name)
+		assert.Equal(t, len(tc.sees), *connection.TotalCount, name)
+
+		for _, id := range all {
+			got, getErr := repo.GetByID(ctx, agentports.GetAgentProposalByIDRequest{
+				ID:         id,
+				TenantInfo: &tenant,
+				Reader:     tc.reader,
+			})
+			if slices.Contains(tc.sees, id) {
+				require.NoError(t, getErr, name)
+				assert.Equal(t, id, got.ID, name)
+
+				continue
+			}
+			assert.True(t, errortypes.IsNotFoundError(getErr),
+				"%s: a proposal from someone else's conversation reads as missing", name)
+		}
+	}
+}
