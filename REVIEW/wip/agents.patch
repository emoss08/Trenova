+func (s *Service) assertMayStartAgent(
+	ctx context.Context,
+	req watchtowerports.HandOffWatchtowerItemRequest,
+	actor *permissionports.RequestActor,
+) error {
+	if actor == nil || s.permissions == nil || s.definitions == nil {
+		return errortypes.NewAuthorizationError(
+			"You don't have permission to perform this action: {0} {1}",
+			permission.ResourceAgentRun, permission.OpCreate,
+		)
+	}
+
+	result, err := s.permissions.Check(
+		ctx,
+		actor.PermissionCheck(permission.ResourceAgentRun, permission.OpCreate),
+	)
+	if err != nil {
+		return fmt.Errorf("check permission to start an agent: %w", err)
+	}
+	if result == nil || !result.Allowed {
+		return errortypes.NewAuthorizationError(
+			"You don't have permission to perform this action: {0} {1}",
+			permission.ResourceAgentRun, permission.OpCreate,
+		)
+	}
+
+	definition, err := s.definitions.GetByID(ctx, agentdefinitionports.GetAgentDefinitionByIDRequest{
+		ID:         req.AgentDefinitionID,
+		TenantInfo: req.TenantInfo,
+	})
+	if err != nil {
+		return err
+	}
+	allowed, err := s.permissions.MayUseAgent(ctx, actor, definition)
+	if err != nil {
+		return fmt.Errorf("check access to agent %s: %w", definition.ID, err)
+	}
+	if !allowed {
+		return errortypes.NewAuthorizationError(
+			"You do not have access to {0}. An administrator can give one of your roles access to it.",
+			definition.Name,
+		)
+	}
+
+	return nil
+}
