@@ -0,0 +1,105 @@
+package personaccess
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/emoss08/trenova/internal/modules/identity/domain/tenant"
+	"github.com/emoss08/trenova/internal/modules/identity/ports/tenantports"
+	"github.com/emoss08/trenova/pkg/domaintypes"
+	"github.com/emoss08/trenova/pkg/errortypes"
+	"github.com/emoss08/trenova/pkg/pagination"
+	"github.com/emoss08/trenova/shared/pulid"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type members struct {
+	user *tenant.User
+	err  error
+	asks []tenantports.GetTenantMemberRequest
+}
+
+func (m *members) GetTenantMember(
+	_ context.Context,
+	req tenantports.GetTenantMemberRequest,
+) (*tenant.User, error) {
+	m.asks = append(m.asks, req)
+
+	return m.user, m.err
+}
+
+func TestCheck_RefusesWhoeverCanNoLongerSignIn(t *testing.T) {
+	t.Parallel()
+
+	userID := pulid.MustNew("usr_")
+	cases := map[string]struct {
+		members *members
+		refusal Refusal
+	}{
+		"an active member": {
+			members: &members{user: &tenant.User{ID: userID, Status: domaintypes.StatusActive}},
+		},
+		"a deactivated account": {
+			members: &members{user: &tenant.User{ID: userID, Status: domaintypes.StatusInactive}},
+			refusal: Inactive,
+		},
+		"a locked account": {
+			members: &members{
+				user: &tenant.User{ID: userID, Status: domaintypes.StatusActive, IsLocked: true},
+			},
+			refusal: Locked,
+		},
+		"a person removed from the organization": {
+			members: &members{err: errortypes.NewNotFoundError("User not found")},
+			refusal: NotMember,
+		},
+	}
+
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+
+			tenantInfo := pagination.TenantInfo{
+				OrgID:  pulid.MustNew("org_"),
+				BuID:   pulid.MustNew("bu_"),
+				UserID: pulid.MustNew("usr_"),
+			}
+			refusal, err := Check(t.Context(), tc.members, tenantInfo, userID)
+			require.NoError(t, err)
+			assert.Equal(t, tc.refusal, refusal)
+			require.Len(t, tc.members.asks, 1)
+			assert.Equal(t, userID, tc.members.asks[0].UserID)
+			assert.Equal(t, tenantInfo.OrgID, tc.members.asks[0].TenantInfo.OrgID)
+			assert.Equal(t, tenantInfo.BuID, tc.members.asks[0].TenantInfo.BuID)
+			assert.Positive(t, tc.members.asks[0].Now)
+		})
+	}
+}
+
+func TestCheck_NobodyIsNoMember(t *testing.T) {
+	t.Parallel()
+
+	reader := &members{}
+	refusal, err := Check(t.Context(), reader, pagination.TenantInfo{}, pulid.Nil)
+	require.NoError(t, err)
+	assert.Equal(t, NotMember, refusal)
+	assert.Empty(t, reader.asks)
+}
+
+func TestCheck_AFailedReadIsAnErrorNotAnAnswer(t *testing.T) {
+	t.Parallel()
+
+	refusal, err := Check(
+		t.Context(),
+		&members{err: errors.New("connection reset")},
+		pagination.TenantInfo{},
+		pulid.MustNew("usr_"),
+	)
+	require.ErrorContains(t, err, "connection reset")
+	assert.Empty(t, refusal)
+
+	_, err = Check(t.Context(), nil, pagination.TenantInfo{}, pulid.MustNew("usr_"))
+	require.Error(t, err)
+}
