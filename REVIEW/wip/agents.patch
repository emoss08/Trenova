+)
+
+type heldEngine struct {
+	permissionports.PermissionEngine
+
+	held  map[string]permissionports.EffectiveResourcePermission
+	err   error
+	asked int
+}
+
+func (e *heldEngine) GetEffectivePermissions(
+	_ context.Context,
+	userID, orgID pulid.ID,
+) (*permissionports.EffectivePermissions, error) {
+	e.asked++
+	if e.err != nil {
+		return nil, e.err
+	}
+
+	return &permissionports.EffectivePermissions{
+		UserID:         userID,
+		OrganizationID: orgID,
+		Resources:      e.held,
+	}, nil
+}
+
+func grantsService(held map[string]permissionports.EffectiveResourcePermission) (*Service, *heldEngine) {
+	actions, queries := testRegistries()
+	engine := &heldEngine{held: held}
+
+	return &Service{
+		l:           zap.NewNop(),
+		tools:       actions,
+		queryTools:  queries,
+		permissions: engine,
+		security:    &refusals{},
+	}, engine
+}
+
+type refusals struct {
+	changes []*permissionports.SecurityChange
+}
+
+func (r *refusals) RecordChange(_ context.Context, change *permissionports.SecurityChange) {
+	r.changes = append(r.changes, change)
+}
+
+func orgWide(ops ...permission.Operation) permissionports.EffectiveResourcePermission {
+	return permissionports.EffectiveResourcePermission{
+		Operations: ops,
+		DataScope:  permission.DataScopeOrganization,
+	}
+}
+
+func refusedField(t *testing.T, err error) string {
+	t.Helper()
+
+	var multiErr *errortypes.MultiError
+	require.ErrorAs(t, err, &multiErr)
+	require.Len(t, multiErr.Errors, 1)
+	assert.Equal(t, errortypes.ErrForbidden, multiErr.Errors[0].Code)
+
+	return multiErr.Errors[0].Field
+}
+
+func TestCheckToolGrants_AnEditorCannotGiveAToolBeyondTheirOwnAccess(t *testing.T) {
+	t.Parallel()
+
+	svc, _ := grantsService(map[string]permissionports.EffectiveResourcePermission{
+		permission.ResourceShipment.String(): orgWide(permission.OpRead),
+	})
+
+	err := svc.checkToolGrants(t.Context(),
+		definition(agentdefinition.TemplateGeneralAssistant, "shipment_get", "customer_update"),
+		nil, personActor())
+
+	assert.Equal(t, "toolNames[1]", refusedField(t, err),
+		"customer_update needs customer update, which the editor does not hold")
+	recorded := svc.security.(*refusals).changes
+	require.Len(t, recorded, 1, "the refusal is in the security trail")
+	assert.Equal(t, "Refused a grant beyond the actor's own permissions", recorded[0].Comment)
+	assert.Equal(t, "customer_update", recorded[0].Metadata["tool"])
+	assert.Equal(t, permission.ResourceCustomer.String(), recorded[0].Metadata["resource"])
+}
+
+func TestCheckToolGrants_AnEditorWhoHoldsEveryToolsGrantMayGiveThem(t *testing.T) {
+	t.Parallel()
+
+	svc, _ := grantsService(map[string]permissionports.EffectiveResourcePermission{
+		permission.ResourceShipment.String(): orgWide(permission.OpRead),
+		permission.ResourceCustomer.String(): orgWide(permission.OpUpdate),
+	})
+
+	require.NoError(t, svc.checkToolGrants(t.Context(),
+		definition(agentdefinition.TemplateGeneralAssistant, "shipment_get", "customer_update"),
+		nil, personActor()))
+}
+
+func TestCheckToolGrants_AnOwnScopeIsNotTheWholeOrganization(t *testing.T) {
+	t.Parallel()
+
+	svc, _ := grantsService(map[string]permissionports.EffectiveResourcePermission{
+		permission.ResourceShipment.String(): {
+			Operations: []permission.Operation{permission.OpRead},
+			DataScope:  permission.DataScopeOwn,
+		},
+	})
+
+	err := svc.checkToolGrants(t.Context(),
+		definition(agentdefinition.TemplateGeneralAssistant, "shipment_get"), nil, personActor())
+
+	assert.Equal(t, "toolNames[0]", refusedField(t, err),
+		"an unattended run reads the whole organization")
+}
+
+func TestCheckToolGrants_KeepingAToolSomeoneElseGaveIsNotAGrant(t *testing.T) {
+	t.Parallel()
+
+	svc, engine := grantsService(map[string]permissionports.EffectiveResourcePermission{})
+	previous := definition(agentdefinition.TemplateGeneralAssistant, "customer_update")
+	updated := definition(agentdefinition.TemplateGeneralAssistant, "customer_update")
+	updated.Name = "Renamed"
+
+	require.NoError(t, svc.checkToolGrants(t.Context(), updated, previous, personActor()))
+	assert.Zero(t, engine.asked, "nothing was given, so nothing is checked")
+}
+
+func TestCheckToolGrants_RaisingAToolsTierIsGivingIt(t *testing.T) {
+	t.Parallel()
+
+	svc, _ := grantsService(map[string]permissionports.EffectiveResourcePermission{})
+	previous := definition(agentdefinition.TemplateGeneralAssistant, "reassign_move")
+	previous.AutonomyCeiling = agent.TierAutoExecute
+	updated := definition(agentdefinition.TemplateGeneralAssistant, "reassign_move")
+	updated.AutonomyCeiling = agent.TierAutoExecute
+	updated.ToolTiers = map[string]agent.AutonomyTier{"reassign_move": agent.TierAutoExecute}
+
+	err := svc.checkToolGrants(t.Context(), updated, previous, personActor())
+
+	assert.Equal(t, "toolNames[0]", refusedField(t, err))
+
+	lowered := definition(agentdefinition.TemplateGeneralAssistant, "reassign_move")
+	lowered.ToolTiers = map[string]agent.AutonomyTier{"reassign_move": agent.TierPropose}
+	require.NoError(t, svc.checkToolGrants(t.Context(), lowered, previous, personActor()),
+		"lowering a tier gives nothing")
+}
+
+func TestCheckToolGrants_OnlyAPersonCanGiveTools(t *testing.T) {
+	t.Parallel()
+
+	svc, _ := grantsService(map[string]permissionports.EffectiveResourcePermission{
+		permission.ResourceShipment.String(): orgWide(permission.OpRead),
+	})
+	key := &permissionports.RequestActor{
