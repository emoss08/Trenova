map statusOut
  from shipmentStatus
  to   acme.214
  use  common

B10 { 01 <- proNumber ?? key, 02 <- key, 03 <- org.scac }
L11 when exists bol { 01 <- bol, 02 <- "BM" }
L11 when exists shipperReference { 01 <- shipperReference, 02 <- "PO" }

0205 <- each events as event {
  LX { 01 <- index + 1 }
  0210 {
    AT7 {
      01 <- event.kind via statusCodes
      02 <- event.reason ?? "NS"
      05 <- event.at
      06 <- event.at
      07 <- event.at.zoneCode()
    }
    MS1 when exists event.city { 01 <- event.city.upper(), 02 <- event.state, 03 <- event.country ?? "US" }
  }
  L11 when exists event.stop { 01 <- text(event.stop), 02 <- "QN" }
}

test "an arrival at the consignee writes the AT7 and MS1" {
  given shipmentStatus {
    key: "AM-48213"
    proNumber: "PRO-1001"
    bol: "BOL-77120"
    events: [{ kind: ArrivedDelivery, at: @2026-03-04T13:52[America/New_York], stop: 2, city: "Columbus", state: "OH" }]
  }
  expect x12 contains "B10*PRO-1001*AM-48213*TRNV~"
  expect x12 contains "LX*1~AT7*X1*NS***20260304*1352*ET~MS1*COLUMBUS*OH*US~L11*2*QN~"
}

test "a time is written without its seconds when the guide does not ask for them" {
  given shipmentStatus { key: "AM-1", events: [{ kind: ArrivedPickup, at: @2026-03-04T04:53:10Z }] }
  expect x12 contains "LX*1~AT7*X3*NS***20260304*0453*UT~"
}

test "an appointment is never sent to Acme" {
  given shipmentStatus { key: "AM-1", events: [{ kind: AppointmentSet, at: @2026-03-04T14:30Z }] }
  expect no sent
}

test "an appointment in a batch is left out and the rest are numbered in order" {
  given shipmentStatus {
    key: "AM-1"
    events: [
      { kind: ArrivedPickup, at: @2026-03-04T14:30Z },
      { kind: AppointmentSet, at: @2026-03-04T14:40Z },
      { kind: DepartedPickup, at: @2026-03-04T15:30Z }
    ]
  }
  expect sent
  expect x12 contains "LX*1~AT7*X3*NS***20260304*1430*UT~LX*2~AT7*AF*NS***20260304*1530*UT~"
}

property "every event Acme takes writes a status code" {
  vary kind in [Dispatched, ArrivedPickup, Loaded, DepartedPickup, EnRoute, ArrivedDelivery, Delivered, DepartedDelivery, Delayed, EtaChanged, Exception]
  given shipmentStatus { key: "AM-1", events: [{ kind: kind, at: @2026-03-04T14:30Z }] }
  expect x12 contains "AT7*"
}

test "a country Acme's guide does not take is refused" {
  given shipmentStatus {
    key: "AM-1"
    events: [{ kind: ArrivedPickup, at: @2026-03-04T14:30Z, city: "Monterrey", state: "NL", country: "MX" }]
  }
  expect rejected
}

test "a city with accents is written in the X12 character set, with a warning" {
  given shipmentStatus {
    key: "AM-1"
    events: [{ kind: ArrivedPickup, at: @2026-03-04T14:30Z, city: "Peñasco", state: "TX" }]
  }
  expect x12 contains "MS1*PENASCO*TX*US~"
  expect warned "MS101 was written in the X12 character set: PEÑASCO became PENASCO"
}

test "a value folding lengthened is cut to the element's maximum" {
  given shipmentStatus {
    key: "AM-1"
    events: [{ kind: ArrivedPickup, at: @2026-03-04T14:30Z, city: "Ærøskøbing Østre Havnekaj Nord", state: "ON", country: "CA" }]
  }
  expect x12 contains "MS1*AEROSKOBING OSTRE HAVNEKAJ NOR*ON*CA~"
  expect warned "cut to its 30 characters"
}

test "a value with no character X12 can carry is left out, and the element it was required in is missing" {
  given shipmentStatus { key: "AM-1", bol: "北京", events: [{ kind: ArrivedPickup, at: @2026-03-04T14:30Z }] }
  expect rejected
  expect warned "L1101 was left out"
}
