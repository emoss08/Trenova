library "std.time"

/// Calendar rules for accessorials: weekends, business hours and time spent within them. Every
/// function reads a date-time on its own clock, in the offset it carries.

/// Whether `at` falls on a Saturday or a Sunday.
fn weekend(at: DateTime) -> Bool = at.weekend

/// Whether `at` is outside business hours: on a weekend, before `open` or at or after `close`,
/// on `at`'s own clock.
fn afterHours(at: DateTime, open: Time = @08:00, close: Time = @17:00) -> Bool = at.weekend or at.time < open or at.time >= close

/// The time between `start` and `end` that falls within business hours, from `open` to `close`
/// on weekdays, each day read on the date-times' own clock. Zero when `end` is not after
/// `start`, or when `close` is not after `open`.
fn businessDuration(start: DateTime, end: DateTime, open: Time = @08:00, close: Time = @17:00) -> Duration {
  if end <= start {
    return 0 min
  }
  let first = start.date
  let days = (end.date - first).in(d).value.floor()
  var total = 0 min
  for index in 0..=days {
    let day = first.addDays(index)
    if not day.weekend {
      let opens = if index == 0 { sinceMidnight(start.time) } else { 0 min }
      let closes = if index == days { sinceMidnight(end.time) } else { 1_440 min }
      let from = opens.max(sinceMidnight(open))
      let until = closes.min(sinceMidnight(close))
      if until > from {
        total += until - from
      }
    }
  }
  return total
}

/// How long after midnight `time` is, in minutes, so the sums above stay exact to the second.
private fn sinceMidnight(time: Time) -> Duration = (time - @00:00).in(min)

test "weekends are Saturday and Sunday on the date-time's own clock" {
  expect weekend(@2026-10-24T10:00-05:00)
  expect weekend(@2026-10-25T23:00-05:00)
  expect not weekend(@2026-10-23T23:30-05:00)
  expect weekend(@2026-10-24T03:00Z)
}

test "after hours is before open, from close, or a weekend" {
  expect afterHours(@2026-10-22T07:59-05:00)
  expect not afterHours(@2026-10-22T08:00-05:00)
  expect not afterHours(@2026-10-22T16:59-05:00)
  expect afterHours(@2026-10-22T17:00-05:00)
  expect afterHours(@2026-10-24T12:00-05:00)
  expect not afterHours(@2026-10-22T06:30-05:00, open: @06:00, close: @22:00)
  expect not afterHours(@2026-10-22T17:29:59-05:00, close: @17:30)
  expect afterHours(@2026-10-22T17:30-05:00, close: @17:30)
  expect afterHours(@2026-10-22T08:15Z, open: @08:30)
  expect not afterHours(@2026-10-22T13:00Z, open: @13:00)
}

test "after hours reads the clock where the date-time is" {
  expect not afterHours(@2026-10-22T09:00-05:00)
  expect afterHours(@2026-10-22T09:00-05:00.addHours(-2))
  expect afterHours(@2026-10-22T16:45-05:00.addMinutes(15))
}

test "business duration counts weekday time between open and close" {
  expect businessDuration(@2026-10-22T07:00-05:00, @2026-10-22T19:00-05:00) == 9 h
  expect businessDuration(@2026-10-22T09:30-05:00, @2026-10-22T11:00-05:00) == 90 min
  expect businessDuration(@2026-10-23T15:00-05:00, @2026-10-26T10:00-05:00) == 4 h
  expect businessDuration(@2026-10-24T09:00-05:00, @2026-10-25T17:00-05:00) == 0 h
  expect businessDuration(@2026-10-22T12:00-05:00, @2026-10-22T08:00-05:00) == 0 h
  expect businessDuration(@2026-10-22T08:00:30Z, @2026-10-22T09:00Z) == 59.5 min
  expect businessDuration(@2026-10-22T06:00-05:00, @2026-10-22T23:00-05:00, open: @06:00, close: @22:00) == 16 h
  expect businessDuration(@2026-10-22T08:00-05:00, @2026-10-22T18:00-05:00, open: @08:30, close: @17:15) == 525 min
  expect businessDuration(@2026-10-22T08:00-05:00, @2026-10-22T18:00-05:00, open: @17:00, close: @08:00) == 0 h
}
