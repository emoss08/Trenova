{
  "op": "matrix.coverage",
  "cases": [
    {
      "name": "a position outside 0 to 3 is a request error",
      "input": {"dimensions": [{"position": 4, "matchMode": "Exact"}], "cells": []},
      "error": "invalid_input"
    },
    {
      "name": "coverage (TS): a matrix with no axes",
      "input": {"dimensions": [], "cells": [{"d0Key": ""}]},
      "exact": true,
      "output": {"issues": [{"kind": "empty", "position": null, "message": {"message": "This matrix has no axes, so nothing can ever look a rate up in it."}}]}
    },
    {
      "name": "coverage (TS): a matrix with axes but no rates",
      "input": {"dimensions": [{"position": 0, "kind": "WeightBreak", "matchMode": "Range", "label": "Weight"}], "cells": []},
      "exact": true,
      "output": {"issues": [{"kind": "empty", "position": null, "message": {"message": "This matrix has no rates yet, so every lane pointing at it prices nothing."}}]}
    },
    {
      "name": "coverage (TS): bands that meet exactly are contiguous",
      "input": {"dimensions": [{"position": 0, "kind": "WeightBreak", "matchMode": "Range", "label": "Weight"}], "cells": [{"d0Min": 0, "d0Max": 1000}, {"d0Min": 1000}]},
      "exact": true,
      "output": {"issues": []}
    },
    {
      "name": "coverage (TS): the hole between two bands",
      "input": {"dimensions": [{"position": 0, "kind": "WeightBreak", "matchMode": "Range", "label": "Weight"}], "cells": [{"d0Min": 0, "d0Max": 1000}, {"d0Min": 5000}]},
      "exact": true,
      "output": {"issues": [{"kind": "gap", "position": 0, "message": {"message": "{0} jumps from {1} to {2} with nothing in between.", "args": ["Weight", "1,000", "5,000"]}}]}
    },
    {
      "name": "coverage (TS): two bands claiming the same weight",
      "input": {"dimensions": [{"position": 0, "kind": "WeightBreak", "matchMode": "Range", "label": "Weight"}], "cells": [{"d0Min": 0, "d0Max": 2000}, {"d0Min": 1000}]},
      "exact": true,
      "output": {"issues": [{"kind": "overlap", "position": 0,
        "message": {"message": "{0} bands {1} and {2} overlap, so the same shipment matches both.", "args": ["Weight", {"message": "{0} – under {1}", "args": ["0", "2,000"]}, {"message": "{0} and over", "args": ["1,000"]}]},
        "bands": [{"min": "0", "max": "2000"}, {"min": "1000", "max": null}]}]}
    },
    {
      "name": "coverage (TS): a top band with a ceiling leaves everything above it unpriced",
      "input": {"dimensions": [{"position": 0, "kind": "WeightBreak", "matchMode": "Range", "label": "Weight"}], "cells": [{"d0Min": 0, "d0Max": 1000}, {"d0Min": 1000, "d0Max": 20000}]},
      "exact": true,
      "output": {"issues": [{"kind": "unbounded", "position": 0, "message": {"message": "{0} stops at {1}. Anything at or above that finds no rate — give the top band no upper bound to catch it.", "args": ["Weight", "20,000"]}}]}
    },
    {
      "name": "coverage (TS): a bottom band that leaves light freight unpriced",
      "input": {"dimensions": [{"position": 0, "kind": "WeightBreak", "matchMode": "Range"}], "cells": [{"d0Min": 500}]},
      "exact": true,
      "output": {"issues": [{"kind": "gap", "position": 0, "message": {"message": "{0} has no band below {1}, so anything smaller finds no rate.", "args": ["Weight break", "500"]}}]}
    },
    {
      "name": "coverage (TS): two rates at one coordinate, reported once however often it repeats",
      "input": {"dimensions": [{"position": 0, "kind": "Zone", "matchMode": "Exact"}], "cells": [{"d0Key": "SE", "value": 2.1}, {"d0Key": "SE", "value": 9.99}, {"d0Key": "SE"}]},
      "exact": true,
      "output": {"issues": [{"kind": "duplicate", "position": null, "message": {"message": "Two rates sit at {0}. The engine will take the one entered first and never mention the other.", "args": ["SE"]}}]}
    },
    {
      "name": "coverage (TS): a complete exact grid passes",
      "input": {"dimensions": [{"position": 0, "kind": "Zone", "matchMode": "Exact"}, {"position": 1, "kind": "Zone", "matchMode": "Exact"}], "cells": [{"d0Key": "SE", "d1Key": "MW"}, {"d0Key": "SE", "d1Key": "NE"}]},
      "exact": true,
      "output": {"issues": []}
    },
    {
      "name": "coverage: a duplicate coordinate names every axis, bands by their bounds",
      "input": {"dimensions": [{"position": 0, "kind": "Zone", "matchMode": "Exact"}, {"position": 1, "kind": "WeightBreak", "matchMode": "Range"}], "cells": [
        {"d0Key": "SE", "d1Min": "0.0", "d1Max": 1000},
        {"d0Key": "SE", "d1Min": 0, "d1Max": "1000.00"}
      ]},
      "output": {"issues": [{"kind": "duplicate", "message": {"args": ["SE · 0..1000"]}}, {"kind": "unbounded", "slices": ["SE"]}]}
    },
    {
      "name": "coverage: each zone's weight breaks are checked on their own",
      "input": {"dimensions": [
        {"position": 0, "kind": "Zone", "matchMode": "Exact", "label": "Origin"},
        {"position": 1, "kind": "WeightBreak", "matchMode": "Range", "label": "Weight"}
      ], "cells": [
        {"d0Key": "A", "d1Min": 0, "d1Max": 1000}, {"d0Key": "A", "d1Min": 1000},
        {"d0Key": "B", "d1Min": 0, "d1Max": 500}, {"d0Key": "B", "d1Min": 500},
        {"d0Key": "C", "d1Min": 0, "d1Max": 500}, {"d0Key": "C", "d1Min": 800},
        {"d0Key": "D", "d1Min": 0, "d1Max": 500}, {"d0Key": "D", "d1Min": 800}
      ]},
      "exact": true,
      "output": {"issues": [{"kind": "gap", "position": 1, "message": {"message": "{0} jumps from {1} to {2} with nothing in between.", "args": ["Weight", "500", "800"]}, "slices": ["C", "D"]}]}
    },
    {
      "name": "coverage: a wide band covering two narrow ones overlaps both and leaves no false gap",
      "input": {"dimensions": [{"position": 0, "kind": "WeightBreak", "matchMode": "Range", "label": "Weight"}], "cells": [
        {"d0Min": 0, "d0Max": 5000}, {"d0Min": 1000, "d0Max": 2000}, {"d0Min": 3000, "d0Max": 4000}, {"d0Min": 5000}
      ]},
      "output": {"issues": [
        {"kind": "overlap", "message": {"args": ["Weight", {"message": "{0} – under {1}", "args": ["0", "5,000"]}, {"message": "{0} – under {1}", "args": ["1,000", "2,000"]}]}},
        {"kind": "overlap", "message": {"args": ["Weight", {"message": "{0} – under {1}", "args": ["0", "5,000"]}, {"message": "{0} – under {1}", "args": ["3,000", "4,000"]}]}}
      ]}
    },
    {
      "name": "coverage: an unbounded band in the middle overlaps everything above it",
      "input": {"dimensions": [{"position": 0, "kind": "WeightBreak", "matchMode": "Range", "label": "Weight"}], "cells": [
        {"d0Min": 0}, {"d0Min": 1000, "d0Max": 2000}
      ]},
      "output": {"issues": [{"kind": "overlap", "message": {"args": ["Weight", {"message": "{0} and over", "args": ["0"]}, {"message": "{0} – under {1}", "args": ["1,000", "2,000"]}]}, "bands": [{"min": "0", "max": null}, {"min": "1000", "max": "2000"}]}]}
    },
    {
      "name": "coverage: bands without a floor sort first and overlap each other",
      "input": {"dimensions": [{"position": 0, "kind": "WeightBreak", "matchMode": "Range", "label": "Weight"}], "cells": [
        {"d0Max": 1000}, {"d0Max": 2000}, {"d0Min": 2000}
      ]},
      "output": {"issues": [{"kind": "overlap", "message": {"args": ["Weight", {"message": "under {0}", "args": ["1,000"]}, {"message": "under {0}", "args": ["2,000"]}]}}]}
    },
    {
      "name": "coverage: an empty band label reads Any",
      "input": {"dimensions": [{"position": 0, "kind": "LinearFeet", "matchMode": "Range"}], "cells": [{}, {"d0Min": 5}]},
      "output": {"issues": [{"kind": "overlap", "message": {"args": ["Linear feet", {"message": "Any"}, {"message": "{0} and over", "args": ["5"]}]}}]}
    }
  ]
}
