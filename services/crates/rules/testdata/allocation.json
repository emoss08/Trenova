      "output": {"totals": ["150", "245"], "sum": "395"}
    },
    {
      "name": "chargeTotal: TS chargeLineTotal cases",
      "op": "allocation.chargeTotal",
      "input": {"base": 2450, "charges": [
        {"method": "Flat", "amount": 25, "unit": 2},
        {"method": "PerUnit", "amount": "1.5", "unit": 4},
        {"method": "Percentage", "amount": 10, "unit": 1}
      ]},
      "output": {"totals": ["50", "6", "245"]}
    },
    {
      "name": "chargeTotal: a given total wins over the line, and no base means zero",
      "op": "allocation.chargeTotal",
      "input": {"charges": [{"total": "12.345", "method": "Flat", "amount": 1}, {"method": "Percentage", "amount": 10}]},
      "output": {"totals": ["12.345", "0"], "sum": "12.345"}
    },
    {
      "name": "chargeTotal: a percentage of a fractional base is exact",
      "op": "allocation.chargeTotal",
      "input": {"base": "1000.01", "charges": [{"method": "Percentage", "amount": "12.5"}]},
      "output": {"totals": ["125.00125"]}
    },
    {
      "name": "remainder: what is left of 100%, and when a split is over",
      "op": "allocation.remainder",
      "input": {"charges": [
        {"total": 100, "allocations": [{"billToCustomerId": "a", "method": "Percent", "percent": 60}]},
        {"total": 100, "allocations": [
          {"billToCustomerId": "a", "method": "Percent", "percent": 60},
          {"billToCustomerId": "b", "method": "Percent", "percent": 50}
        ]}
      ]},
      "output": {"charges": [
        {"method": "Percent", "allocated": "60", "remaining": "40", "complete": false, "over": false, "valid": false, "problem": {"message": "Percents must add up to 100"}},
        {"allocated": "110", "remaining": "-10", "complete": false, "over": true, "valid": false}
      ]}
    },
    {
      "name": "remainder: 33.33 + 33.33 + 33.34 is complete",
      "op": "allocation.remainder",
      "input": {"charges": [{"total": 100, "allocations": [
        {"billToCustomerId": "a", "method": "Percent", "percent": 33.33},
        {"billToCustomerId": "b", "method": "Percent", "percent": 33.33},
        {"billToCustomerId": "c", "method": "Percent", "percent": 33.34}
      ]}]},
      "output": {"charges": [{"allocated": "100", "remaining": "0", "complete": true, "valid": true, "problem": null}]}
    },
    {
      "name": "remainder: three thirds at seven places are complete, as the server rounds percents to six",
      "op": "allocation.remainder",
      "input": {"charges": [{"total": 100, "allocations": [
        {"billToCustomerId": "a", "method": "Percent", "percent": "33.3333333"},
        {"billToCustomerId": "b", "method": "Percent", "percent": "33.3333333"},
        {"billToCustomerId": "c", "method": "Percent", "percent": "33.3333333"}
      ]}]},
      "output": {"charges": [{"allocated": "99.9999999", "remaining": "0.0000001", "complete": true, "valid": true}]}
    },
    {
      "name": "remainder: amount rows are measured against the charge in cents",
      "op": "allocation.remainder",
      "input": {"charges": [{"total": "20.3", "allocations": [
        {"billToCustomerId": "a", "method": "Amount", "amount": 10.1},
        {"billToCustomerId": "b", "method": "Amount", "amount": 10.2}
      ]}]},
      "output": {"charges": [{"method": "Amount", "allocated": "20.3", "remaining": "0", "complete": true, "over": false, "valid": true}]}
    },
    {
      "name": "remainder: the charge total can come from its line",
      "op": "allocation.remainder",
      "input": {"charges": [{"method": "Flat", "amount": 50, "unit": 2, "allocations": [
        {"billToCustomerId": "a", "method": "Amount", "amount": 60},
        {"billToCustomerId": "b", "method": "Amount", "amount": 50}
      ]}]},
      "output": {"charges": [{"allocated": "110", "remaining": "-10", "complete": false, "over": true, "problem": {"message": "Amounts must add up to the charge"}}]}
    },
    {
      "name": "remainder: amount rows against an unknown total cannot be judged complete",
      "op": "allocation.remainder",
      "input": {"charges": [{"allocations": [{"billToCustomerId": "a", "method": "Amount", "amount": 60}]}]},
      "output": {"charges": [{"allocated": "60", "remaining": null, "complete": false, "over": false, "problem": null, "valid": true}]}
    },
    {
      "name": "remainder: mixed methods, duplicate payers and blank payers are flagged in that order",
      "op": "allocation.remainder",
      "input": {"charges": [
        {"total": 100, "allocations": [
          {"billToCustomerId": "a", "method": "Percent", "percent": 50},
          {"billToCustomerId": "b", "method": "Amount", "amount": 50}
        ]},
        {"total": 100, "allocations": [
          {"billToCustomerId": "a", "method": "Percent", "percent": 50},
          {"billToCustomerId": "a", "method": "Percent", "percent": 50}
        ]},
        {"total": 100, "allocations": [{"billToCustomerId": "", "method": "Percent", "percent": 100}]}
      ]},
      "output": {"charges": [
        {"mixedMethods": true, "problem": {"message": "Split every row by percent or every row by amount"}, "valid": false},
        {"mixedMethods": false, "duplicatePayers": true, "complete": true, "problem": {"message": "Each payer may appear only once"}, "valid": false},
        {"missingPayers": true, "problem": {"message": "Every row needs a payer"}, "valid": false}
      ]}
    },
    {
      "name": "remainder (TS allocationsValid): empty is valid, 99.99 is not, 100 is, a zero row is not",
      "op": "allocation.remainder",
      "input": {"charges": [
        {"total": 100, "allocations": []},
        {"total": 100, "allocations": [{"billToCustomerId": "a", "method": "Percent", "percent": 99.99}]},
        {"total": 100, "allocations": [{"billToCustomerId": "a", "method": "Percent", "percent": 100}]},
        {"total": 100, "allocations": [{"billToCustomerId": "a", "method": "Percent", "percent": 0}]}
      ]},
      "output": {"charges": [
        {"method": "Percent", "allocated": "0", "complete": false, "valid": true, "problem": null},
        {"valid": false, "problem": {"message": "Percents must add up to 100"}},
        {"valid": true, "complete": true},
        {"valid": false, "problem": {"message": "Percent must be greater than 0 and at most 100"}}
      ]}
    },
    {
      "name": "remainder: a non-positive amount row is refused",
      "op": "allocation.remainder",
      "input": {"charges": [{"total": 10, "allocations": [
        {"billToCustomerId": "a", "method": "Amount", "amount": 10},
        {"billToCustomerId": "b", "method": "Amount", "amount": 0}
      ]}]},
      "output": {"charges": [{"complete": true, "problem": {"message": "Amount must be greater than zero"}}]}
    },
    {
      "name": "rebalance: freight amounts that no longer add up convert to proportional percents",
      "op": "allocation.rebalance",
      "input": {"charges": [{"total": 3000, "allocations": [
        {"billToCustomerId": "peak", "method": "Amount", "amount": 1500, "sequence": 0},
        {"billToCustomerId": "acme", "method": "Amount", "amount": 1350, "sequence": 1}
      ]}]},
      "exact": true,
      "output": {"charges": [{"stale": true, "allocatedTotal": "2850", "chargeTotal": "3000", "percents": ["52.631579", "47.368421"]}], "converted": 1}
    },
    {
      "name": "rebalance: the converted percents split the new charge without loss",
      "input": {"defaultPayerId": "x", "charges": [{"kind": "Freight", "total": 3000, "allocations": [
        {"billToCustomerId": "peak", "method": "Percent", "percent": "52.631579", "sequence": 0},
        {"billToCustomerId": "acme", "method": "Percent", "percent": "47.368421", "sequence": 1}
      ]}]},
      "output": {"payers": [
        {"payerId": "x", "totalAmount": "0"},
        {"payerId": "acme", "totalAmount": "1421.05"},
        {"payerId": "peak", "totalAmount": "1578.95"}
      ]}
    },
    {
      "name": "rebalance: percent splits and balanced amounts are current",
      "op": "allocation.rebalance",
      "input": {"base": 2850, "charges": [
        {"total": 2850, "allocations": [
          {"billToCustomerId": "peak", "method": "Amount", "amount": 1500, "sequence": 0},
          {"billToCustomerId": "acme", "method": "Amount", "amount": 1350, "sequence": 1}
        ]},
        {"method": "Flat", "amount": 100, "unit": 1, "allocations": [
          {"billToCustomerId": "peak", "method": "Percent", "percent": 60, "sequence": 0},
          {"billToCustomerId": "acme", "method": "Percent", "percent": 40, "sequence": 1}
        ]},
        {"method": "Flat", "amount": 100, "unit": 1}
      ]},
      "exact": true,
      "output": {"charges": [
        {"stale": false, "allocatedTotal": null, "chargeTotal": null, "percents": null},
        {"stale": false, "allocatedTotal": null, "chargeTotal": null, "percents": null},
        {"stale": false, "allocatedTotal": null, "chargeTotal": null, "percents": null}
      ], "converted": 0}
    },
    {
      "name": "rebalance: an accessorial is reported at its position with its line total",
      "op": "allocation.rebalance",
      "input": {"base": 1000, "charges": [
        {"total": 1000},
        {"method": "Flat", "amount": 50, "unit": 1},
        {"method": "Flat", "amount": 200, "unit": 1, "allocations": [
          {"billToCustomerId": "peak", "method": "Amount", "amount": 150}
        ]}
      ]},
      "output": {"charges": [{"stale": false}, {"stale": false}, {"stale": true, "allocatedTotal": "150", "chargeTotal": "200", "percents": ["100"]}], "converted": 1}
    },
    {
      "name": "rebalance: a three way split totals exactly one hundred",
      "op": "allocation.rebalance",
      "input": {"charges": [{"total": 1000, "allocations": [
        {"billToCustomerId": "a", "method": "Amount", "amount": 100, "sequence": 0},
        {"billToCustomerId": "b", "method": "Amount", "amount": 100, "sequence": 1},
        {"billToCustomerId": "c", "method": "Amount", "amount": 100, "sequence": 2}
      ]}]},
      "output": {"charges": [{"stale": true, "percents": ["33.333333", "33.333333", "33.333334"]}]}
    },
    {
      "name": "rebalance: the last row by sequence absorbs rounding, wherever it sits in the request",
      "op": "allocation.rebalance",
      "input": {"charges": [{"total": 1000, "allocations": [
        {"billToCustomerId": "c", "method": "Amount", "amount": 100, "sequence": 2},
        null,
        {"billToCustomerId": "a", "method": "Amount", "amount": 100, "sequence": 0},
        {"billToCustomerId": "b", "method": "Amount", "amount": 100, "sequence": 1}
      ]}]},
      "output": {"charges": [{"stale": true, "percents": ["33.333334", null, "33.333333", "33.333333"]}]}
    },
    {
      "name": "rebalance: a stale split summing to zero cannot be converted",
      "op": "allocation.rebalance",
      "input": {"charges": [{"total": 100, "allocations": [{"billToCustomerId": "a", "method": "Amount", "amount": 0}]}]},
      "exact": true,
      "output": {"charges": [{"stale": true, "allocatedTotal": "0", "chargeTotal": "100", "percents": null}], "converted": 0}
    }
  ]
}
