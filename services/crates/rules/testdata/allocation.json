        {"billToCustomerId": "cus_c", "method": "Percent", "percent": "33.333334", "sequence": 2}
      ]}]},
      "output": {"charges": [{"total": "100", "shares": [
        {"amount": "33.33", "percent": "33.333333", "partial": true},
        {"amount": "33.33", "percent": "33.333333", "partial": true},
        {"amount": "33.34", "percent": "33.333334", "partial": true}
      ]}], "payers": [
        {"payerId": "cus_a", "freightAmount": "33.33", "accessorialAmount": "0", "totalAmount": "33.33"},
        {"payerId": "cus_b", "freightAmount": "33.33"},
        {"payerId": "cus_c", "freightAmount": "33.34"}
