        {"currency": "EUR", "decimals": 10, "grouping": false, "negative": "parentheses", "notation": "compact", "prefix": "~", "boolStyle": "check", "durationUnit": "hours", "durationStyle": "verbose", "nullText": "—", "dateStyle": "iso"},
        {"decimals": 0}
      ]}
