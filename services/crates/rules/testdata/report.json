      ]}
    },
    {
      "name": "null strings and lists in a display read as empty",
      "input": {"columns": [{"display": {"style": "number", "decimals": 1, "prefix": null, "suffix": null, "rules": null, "band": {"width": null, "edges": null}, "nullText": null}, "values": [2.25, null]}]},
      "exact": true,
      "output": {"columns": [{"values": [{"text": "2.3"}, {"text": ""}]}]}
    },
    {
      "name": "a bool column reads true and false strings as booleans",
