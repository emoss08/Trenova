    },
    {
      "name": "compact notation is chosen on the unrounded magnitude",
      "input": {"columns": [
        {"display": {"style": "number", "decimals": 0, "grouping": true, "notation": "compact"}, "values": [999999, 999.5, 1000000000000000, -1284000]},
        {"display": {"style": "number", "decimals": 0, "grouping": false, "notation": "compact"}, "values": [999999]},
        {"display": {"style": "percent", "decimals": 1, "grouping": true, "notation": "compact"}, "values": [12345]},
        {"display": {"style": "currency", "decimals": 1, "currency": "EUR", "notation": "compact"}, "values": [2500000000]}
      ]},
      "exact": true,
      "output": {"columns": [
        {"values": [{"text": "1,000K"}, {"text": "1,000"}, {"text": "1,000T"}, {"text": "-1M"}]},
        {"values": [{"text": "1000K"}]},
        {"values": [{"text": "1.2M%"}]},
        {"values": [{"text": "€2.5B"}]}
      ]}
    },
    {
      "name": "decimals are clamped to 0..10",
      "input": {"columns": [
        {"display": {"style": "number", "decimals": 12}, "values": [1.23456789012345]},
        {"display": {"style": "number", "decimals": -3}, "values": [1.5]}
      ]},
      "exact": true,
      "output": {"columns": [{"values": [{"text": "1.2345678901"}]}, {"values": [{"text": "2"}]}]}
    },
    {
      "name": "currency symbols, prefixes and suffixes",
      "input": {"columns": [
        {"display": {"style": "currency", "decimals": 2, "currency": "CHF"}, "values": [5]},
        {"display": {"style": "currency", "decimals": 2, "currency": ""}, "values": [5]},
        {"display": {"style": "currency", "decimals": 0, "currency": "JPY", "grouping": true}, "values": [1500]},
        {"display": {"style": "currency", "decimals": 2, "currency": "CAD", "negative": "parentheses", "prefix": "~", "suffix": " net"}, "values": [-5]},
        {"display": {"style": "number", "decimals": 2, "prefix": "~"}, "values": [-5]}
      ]},
      "exact": true,
      "output": {"columns": [
        {"values": [{"text": "CHF 5.00"}]},
        {"values": [{"text": "$5.00"}]},
        {"values": [{"text": "¥1,500"}]},
        {"values": [{"text": "(~C$5.00 net)"}]},
        {"values": [{"text": "-~5.00"}]}
      ]}
    },
    {
      "name": "Go formats a number in a text or bool column as a number, and a boolean in a numeric column as a boolean",
      "input": {"columns": [
        {"display": {"style": "text", "decimals": 2, "grouping": true}, "values": [1234.5]},
