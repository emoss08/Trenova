        {"display": {"style": "number", "decimals": 2, "boolStyle": "onOff"}, "values": [true]}
      ]},
      "exact": true,
      "output": {"columns": [
        {"values": [{"text": "1,234.50"}]},
        {"values": [{"text": "0.3"}]},
        {"values": [{"text": "On"}]}
      ]}
    },
    {
      "name": "text values take the prefix and suffix; arrays and objects read as empty",
      "input": {"columns": [
        {"display": {"style": "number", "decimals": 2, "prefix": "<", "suffix": ">", "nullText": "n/a"}, "valueType": "decimal", "values": ["pending", "", [1], {"a": 1}]},
        {"display": {"style": "text"}, "valueType": "decimal", "values": ["12345"]}
      ]},
      "exact": true,
      "output": {"columns": [
        {"values": [{"text": "<pending>"}, {"text": "n/a"}, {"text": "n/a"}, {"text": "n/a"}]},
