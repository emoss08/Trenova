      "exact": true,
      "output": {"columns": [{"values": [{"text": "1e400"}]}]}
    },
    {
      "name": "band arithmetic is exact",
      "input": {"columns": [
        {"display": {"style": "number", "decimals": 1, "band": {"width": 0.1}}, "values": [0.2]},
