  {
    "name": "an uncoded charge may be a discount",
    "source": "tariff \"t\"\ncharge \"Linehaul\" = $100\ncharge \"Discount\" = -$10",
    "expect": {
      "status": "rated",
      "bill": {
        "lines": [
          {
            "kind": "charge",
            "amount": {
              "$q": "100",
              "u": "$"
            }
          },
          {
            "kind": "charge",
            "amount": {
              "$q": "-10",
              "u": "$"
            },
            "label": "Discount"
          }
        ],
        "total": {
          "$q": "90",
          "u": "$"
        }
      }
    }
  },
  {
    "name": "a negative coded charge names its code",
    "source": "tariff \"t\"\ncharge \"Credit\" as FSC = -$5",
    "expect": {
      "status": "error",
      "error": {
        "code": "negativeCharge",
        "message": {
          "message": "The {0} charge came out at {1}: a coded charge must be more than zero",
          "args": [
            "FSC",
            "-$5.00"
          ]
        },
        "range": {
          "from": 11,
          "to": 39
        }
      }
    }
  },
  {
    "name": "negative freight is a rating error",
    "source": "tariff \"t\"\ncharge \"Discount\" = -$10",
    "expect": {
      "status": "error",
      "error": {
        "code": "negativeTotal"
      }
    }
  },
  {
    "name": "negative freight is an error even with accessorials",
    "source": "tariff \"t\"\ncharge \"Discount\" = -$10\ncharge \"Fuel\" as FSC = $50",
    "expect": {
      "status": "error",
      "error": {
        "code": "negativeTotal"
      }
    }
  },
