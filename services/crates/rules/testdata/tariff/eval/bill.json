  {
    "name": "the trace records bindings, branches, loops and charges",
    "source": "tariff \"t\"\nlet a = $5\nif a > $1 {\n  charge \"A\" = a\n}\nfor i in 1..=2 {\n  note \"{i}\"\n}",
    "expect": {
      "status": "rated",
      "trace": [
        {
          "kind": "bind",
          "name": "a",
          "value": {
            "$q": "5",
            "u": "$"
          },
          "display": "$5.00"
        },
        {
          "kind": "branch",
          "taken": 0
        },
        {
          "kind": "charge",
          "label": "A",
          "value": {
            "$q": "5",
            "u": "$"
          }
        },
        {
          "kind": "iteration",
          "name": "i",
          "index": 0,
          "display": "1"
        },
        {
          "kind": "note",
          "text": "1"
        },
        {
          "kind": "iteration",
          "name": "i",
          "index": 1
        },
        {
          "kind": "note",
          "text": "2"
        },
        {
          "kind": "loop",
          "name": "i",
          "iterations": 2
        }
      ]
    },
    "trace": true
  },
  {
    "name": "the trace records a refusal",
    "source": "tariff \"t\"\nfail \"stop\"",
    "expect": {
      "status": "refused",
      "trace": [
        {
          "kind": "refusal",
          "message": "stop"
        }
      ]
    },
    "trace": true
  },
  {
    "name": "without trace the trace is null",
    "source": "tariff \"t\"\ncharge \"A\" = $1",
    "expect": {
      "status": "rated",
      "trace": null,
      "lookups": []
    }
  },
  {
    "name": "the trace records match arms and assignments",
    "source": "tariff \"t\"\nvar x = 1\nx += 2\nmatch x {\n  3 => {\n    note \"three\"\n  }\n  _ => {\n    note \"other\"\n  }\n}",
    "expect": {
      "status": "rated",
      "trace": [
        {
          "kind": "bind",
          "name": "x"
        },
        {
          "kind": "assign",
          "name": "x",
          "display": "3"
        },
        {
          "kind": "arm",
          "arm": 0
        },
        {
          "kind": "note"
        }
      ]
    },
    "trace": true
  }
]
