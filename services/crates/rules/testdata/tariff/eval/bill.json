[
  {
    "name": "an uncoded charge is freight",
    "source": "tariff \"t\"\ncharge \"Linehaul\" = $100",
    "expect": {
      "status": "rated",
      "bill": {
        "lines": [
          {
            "kind": "charge",
            "amount": {
              "$q": "100",
              "u": "$"
            },
            "label": "Linehaul",
            "code": null,
            "freight": true
          }
        ],
        "total": {
          "$q": "100",
          "u": "$"
        },
        "freightTotal": {
          "$q": "100",
          "u": "$"
        },
        "accessorialTotal": {
          "$q": "0",
          "u": "$"
        }
      }
    }
  },
  {
    "name": "a coded charge is an accessorial",
    "source": "tariff \"t\"\ncharge \"Fuel\" as FSC = $25",
    "expect": {
      "status": "rated",
      "bill": {
        "lines": [
          {
            "kind": "charge",
            "amount": {
              "$q": "25",
              "u": "$"
            },
            "code": "FSC",
            "freight": false
          }
        ],
        "total": {
          "$q": "25",
          "u": "$"
        },
        "freightTotal": {
          "$q": "0",
          "u": "$"
        },
        "accessorialTotal": {
          "$q": "25",
          "u": "$"
        }
      }
    }
  },
  {
    "name": "quantity and rate give the amount",
    "source": "tariff \"t\"\ncharge \"Linehaul\" (quantity: 812 mi, rate: $2.35/mi)",
    "expect": {
      "status": "rated",
      "bill": {
        "lines": [
          {
            "kind": "charge",
            "amount": {
              "$q": "1908.2",
              "u": "$"
            },
            "quantity": {
              "$q": "812",
              "u": "mi"
            },
            "rate": {
              "$q": "2.35",
              "u": "$/mi"
            }
          }
        ],
        "total": {
          "$q": "1908.2",
          "u": "$"
        }
      }
    }
  },
  {
