    "name": "the budgets apply across all options",
    "source": "tariff \"t\"\nbest \"L\" {\n  option \"A\" {\n    var a = $0\n    for i in 0..40 { a += $1 }\n    charge \"A\" = a\n  }\n  option \"B\" {\n    var b = $0\n    for i in 0..40 { b += $1 }\n    charge \"B\" = b\n  }\n}",
    "budget": {
      "steps": 150
    },
    "expect": {
      "status": "error",
      "error": {
        "code": "budget"
      }
    }
  },
