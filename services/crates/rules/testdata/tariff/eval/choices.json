  {
    "name": "a tariff without choices sends an empty list, as does a condition",
    "op": "tariff.evaluate",
    "input": {
      "programs": [
        {
          "id": "t",
          "source": "tariff \"t\"\ncharge \"x\" = $1"
        },
        {
          "id": "c",
          "source": "condition \"c\"\nshipment.distance > 1 mi"
        },
        {
          "id": "bad",
          "source": "tariff \"t\"\ncharge \"x\" = 1 lb"
        }
      ]
    },
    "expect": {
      "ok": {
        "results": [
          {
            "id": "t",
            "status": "rated",
            "choices": []
          },
          {
            "id": "c",
            "status": "rated",
            "choices": []
          },
          {
            "id": "bad",
            "status": "error",
            "choices": []
          }
        ]
      }
    }
  },
  {
    "name": "a refused rating still reports the choices it evaluated",
    "source": "tariff \"t\"\nbest \"L\" {\n  option \"A\" { charge \"A\" = $1 }\n  option \"B\" { charge \"B\" = $2 }\n}\nfail \"No rate after all\"",
    "expect": {
      "status": "refused",
      "choices": [
        {
          "label": "L",
          "chosen": "A"
        }
      ]
    }
  },
  {
    "name": "chosen reads the option each choice kept the last time it ran",
    "tests": "tariff \"t\"\ninput rate: Money/mi = $2/mi\nbest \"Linehaul\" {\n  option \"Per mile\" { charge \"Linehaul\" = rate * shipment.distance }\n  option \"Flat\" { charge \"Flat\" = $500 }\n}\nif shipment.distance > 1_000 mi {\n  best \"Long haul\" {\n    option \"A\" { charge \"A\" = $1 }\n    option \"B\" { charge \"B\" = $2 }\n  }\n}\nfor stop in shipment.stops {\n  worst \"Stop\" {\n    option \"First\" {\n      require stop.sequence == 1 else \"Only the first stop\"\n      charge \"First stop\" = $5\n    }\n    option \"Other\" { charge \"Other stop\" = $3 }\n  }\n}\ntest \"short loads bill per mile\" {\n  given shipment.distance = 100 mi\n  expect chosen(\"Linehaul\") == \"Per mile\"\n  expect chosen(\"Long haul\") == none\n  expect chosen(\"Stop\") == \"Other\"\n  expect total == $200 + $5 + $3\n}\ntest \"long loads bill flat\" {\n  given shipment.distance = 2_000 mi\n  expect chosen(\"Linehaul\") == \"Flat\"\n  expect chosen(\"Long haul\") == \"A\"\n}\ntest \"a wrong expectation reports what was chosen\" {\n  given shipment.distance = 100 mi\n  expect chosen(\"Linehaul\") == \"Flat\"\n}",
    "expect": [
      {
        "name": "short loads bill per mile",
        "status": "passed"
      },
      {
        "name": "long loads bill flat",
        "status": "passed"
      },
      {
        "name": "a wrong expectation reports what was chosen",
        "status": "failed",
        "failures": [
          {
            "range": {
              "from": 971,
              "to": 1006
            },
            "message": {
              "message": "This expectation does not hold"
            },
            "values": [
              {
                "range": {
                  "from": 978,
                  "to": 996
                },
                "display": "Per mile",
                "value": "Per mile"
              }
            ]
          }
        ]
      }
    ]
  }
