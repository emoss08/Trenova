  {
    "name": "when every option refuses, the rating refuses with the first option's message",
    "source": "tariff \"t\"\nbest \"L\" {\n  option \"A\" { fail \"A doesn't apply\" }\n  option \"B\" {\n    let w = shipment.weight ?? fail \"B needs a weight\"\n    charge \"B\" = $1/lb * w\n  }\n}",
    "expect": {
      "status": "refused",
      "refusal": {
        "message": "A doesn't apply",
        "range": {
          "from": 37,
          "to": 59
        }
      },
      "choices": [
        {
          "label": "L",
          "chosen": null,
          "options": [
            {
              "label": "A",
              "status": "refused",
              "subtotal": null,
              "refusal": {
                "message": "A doesn't apply"
              }
            },
            {
              "label": "B",
              "status": "refused",
              "subtotal": null,
              "refusal": {
                "message": "B needs a weight"
              }
            }
          ]
        }
      ]
    }
  },
  {
    "name": "an evaluation error inside an option stops the rating",
    "source": "tariff \"t\"\ninput divisor: Int = 0\nbest \"L\" {\n  option \"A\" { charge \"A\" = $1 }\n  option \"B\" { charge \"B\" = $10 / divisor }\n}",
    "expect": {
      "status": "error",
      "error": {
        "code": "divideByZero"
      },
      "choices": []
    }
  },
  {
    "name": "an option's own bindings and vars stay inside it",
    "source": "tariff \"t\"\nlet base = $10\nbest \"L\" {\n  option \"A\" {\n    var sum = base\n    for stop in shipment.stops { sum += $1 }\n    charge \"A\" = sum\n  }\n  option \"B\" {\n    let sum = base * 2\n    charge \"B\" = sum\n  }\n}\ncharge \"After\" = base",
    "expect": {
      "status": "rated",
      "bill": {
        "lines": [
          {
            "label": "A",
            "amount": {
              "$q": "12",
              "u": "$"
            }
          },
          {
            "label": "After"
          }
        ],
        "total": {
          "$q": "22",
          "u": "$"
        }
      }
    }
  },
