[
  {
    "name": "the spec's best keeps the cheapest method and records the others",
    "source": "tariff \"t\"\ninput rate: Money/mi = $2.35/mi\ninput flatRate: Money = $900\ninput volumeRate: Money/lb = $0.10/lb\nbest \"Linehaul\" {\n  option \"Per mile\" {\n    charge \"Linehaul\" (quantity: shipment.distance, rate: rate)\n  }\n  option \"Flat\" {\n    charge \"Flat rate\" = flatRate\n  }\n  option \"Volume\" {\n    require (shipment.weight ?? 0 lb) >= 6_000 lb else \"Volume rates start at 6,000 lb\"\n    charge \"Volume\" = volumeRate * (shipment.weight ?? 0 lb)\n  }\n}",
    "facts": {
      "shipment": {
        "distance": {
          "$q": "500",
          "u": "mi"
        }
      }
    },
    "expect": {
      "status": "rated",
      "bill": {
        "lines": [
          {
            "kind": "charge",
            "label": "Flat rate",
            "amount": {
              "$q": "900",
              "u": "$"
            },
            "range": {
              "from": 240,
              "to": 269
            }
          }
        ],
        "total": {
          "$q": "900",
          "u": "$"
        }
      },
      "choices": [
        {
          "label": "Linehaul",
          "kind": "best",
          "range": {
            "from": 110,
            "to": 448
          },
          "chosen": "Flat",
          "options": [
            {
              "label": "Per mile",
              "range": {
                "from": 130,
                "to": 217
              },
              "status": "lost",
              "subtotal": {
                "$q": "1175",
                "u": "$"
              },
              "refusal": null
            },
            {
              "label": "Flat",
              "range": {
                "from": 220,
                "to": 273
              },
              "status": "chosen",
              "subtotal": {
                "$q": "900",
                "u": "$"
              },
              "refusal": null
            },
            {
              "label": "Volume",
              "range": {
                "from": 276,
                "to": 446
              },
              "status": "refused",
              "subtotal": null,
              "refusal": {
                "message": "Volume rates start at 6,000 lb",
                "range": {
                  "from": 298,
                  "to": 381
                }
              }
            }
          ]
        }
      ]
    }
  },
  {
    "name": "a short load bills per mile",
    "source": "tariff \"t\"\ninput rate: Money/mi = $2.35/mi\ninput flatRate: Money = $900\ninput volumeRate: Money/lb = $0.10/lb\nbest \"Linehaul\" {\n  option \"Per mile\" {\n    charge \"Linehaul\" (quantity: shipment.distance, rate: rate)\n  }\n  option \"Flat\" {\n    charge \"Flat rate\" = flatRate\n  }\n  option \"Volume\" {\n    require (shipment.weight ?? 0 lb) >= 6_000 lb else \"Volume rates start at 6,000 lb\"\n    charge \"Volume\" = volumeRate * (shipment.weight ?? 0 lb)\n  }\n}",
    "facts": {
      "shipment": {
        "distance": {
          "$q": "100",
          "u": "mi"
        }
      }
    },
    "expect": {
      "status": "rated",
      "bill": {
        "lines": [
          {
            "label": "Linehaul",
            "amount": {
