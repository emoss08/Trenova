  {
    "name": "a tie goes to the option written first, for best and for worst",
    "source": "tariff \"t\"\nbest \"Low\" {\n  option \"A\" { charge \"A\" = $100.00 }\n  option \"B\" { charge \"B\" = $100 }\n}\nworst \"High\" {\n  option \"C\" { charge \"C\" = $50 }\n  option \"D\" { charge \"D\" = $50.000 }\n}",
    "expect": {
      "status": "rated",
      "bill": {
        "lines": [
          {
            "label": "A"
          },
          {
            "label": "C"
          }
        ]
      },
      "choices": [
        {
          "chosen": "A"
        },
        {
          "chosen": "C"
        }
      ]
    }
  },
