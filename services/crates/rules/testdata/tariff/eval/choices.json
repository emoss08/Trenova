  {
    "name": "the kept option's lines and notes join the bill where the choice is written",
    "source": "tariff \"t\"\ncharge \"Before\" = $1\nbest \"L\" {\n  option \"A\" {\n    note \"A was used\"\n    charge \"A\" = $20\n  }\n  option \"B\" {\n    note \"B was used\"\n    charge \"B1\" = $5\n    charge \"B2\" as FSC = $6\n  }\n}\ncharge \"After\" = $2\nminimum $50",
    "context": {
      "codes": [
        {
          "code": "FSC",
          "active": true
        }
      ]
    },
    "expect": {
      "status": "rated",
      "bill": {
        "lines": [
          {
            "label": "Before"
          },
          {
            "label": "B1"
          },
          {
            "label": "B2",
            "code": "FSC",
            "freight": false
          },
          {
            "label": "After"
          },
          {
            "kind": "minimum",
            "amount": {
              "$q": "36",
              "u": "$"
            }
          }
        ],
        "notes": [
          {
            "text": "B was used"
          }
        ],
        "total": {
          "$q": "50",
          "u": "$"
        }
      },
      "choices": [
        {
          "chosen": "B",
          "options": [
            {
              "subtotal": {
                "$q": "20",
                "u": "$"
              }
            },
            {
              "subtotal": {
                "$q": "11",
                "u": "$"
              }
            }
          ]
        }
      ]
    }
