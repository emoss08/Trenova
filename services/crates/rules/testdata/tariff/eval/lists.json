[
  {
    "name": "where keeps matching items",
    "expr": "xs.where(x => x > 2)",
    "display": "[3, 4, 5]",
    "prelude": "let xs = [3, 1, 4, 1, 5]\nlet ws = [500 lb, 2 cwt, 1_000 lb]"
  },
  {
    "name": "map transforms items",
    "expr": "xs.map(x => x * 2)",
    "display": "[6, 2, 8, 2, 10]",
    "prelude": "let xs = [3, 1, 4, 1, 5]\nlet ws = [500 lb, 2 cwt, 1_000 lb]"
  },
  {
    "name": "count without a test",
