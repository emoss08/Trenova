    "freightTotal": {
     "$q": "399.99",
     "u": "$"
    },
    "accessorialTotal": {
     "$q": "20.02",
     "u": "$"
    },
    "total": {
     "$q": "420.01",
     "u": "$"
    }
   }
  }
 }
]
