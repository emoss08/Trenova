    "name": "every region kind is counted",
    "tests": "tariff \"Coverage\"\n\nfn surcharge(miles: Distance) -> Money {\n  if miles > 100 mi {\n    return $10\n  }\n  return $0\n}\n\ninput rate: Money/mi = $2/mi\n\nlet w = shipment.weight ?? 0 lb\nlet band = match w {\n  ..1_000 lb => \"light\"\n  _ => \"heavy\"\n}\nlet price = fuel.price ?? fail \"No fuel price\"\nif shipment.hazmat {\n  require w < 5_000 lb else \"Hazmat over 5,000 lb\"\n  charge \"Hazmat\" = $25\n} else if band == \"heavy\" {\n  charge \"Heavy\" = $15\n} else {\n  note \"Standard at {price}\"\n}\nmatch shipment.status {\n  New => {\n    charge \"New\" = $1\n  }\n  _ => {}\n}\nfor stop in shipment.stops {\n  charge \"Stop {stop.sequence}\" = $5\n}\nbest \"Linehaul\" {\n  option \"Per mile\" {\n    charge \"Per mile\" = rate * shipment.distance\n  }\n  option \"Flat\" {\n    charge \"Flat\" = $50 + surcharge(shipment.distance)\n  }\n}\nlet kind = if shipment.reefer { \"cold\" } else { \"dry\" }\nnote \"{kind}\"\nif (shipment.pieces ?? 0) == 999 {\n  fail \"Never\"\n}\n\ntest \"light\" {\n  given fuel.price = $3/gal\n  expect total > $0\n}\n\ntest \"hazmat\" {\n  given fuel.price = $3/gal\n  given shipment.hazmat = true\n  given shipment.weight = 6_000 lb\n  expect fails\n}\n\nproperty \"heavier\" {\n  vary shipment.weight in 1 lb..2_000 lb\n  given fuel.price = $3/gal\n  expect total > $0\n}\n",
