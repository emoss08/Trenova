   ],
   "expect": {
    "contents": {
     "signature": "StopKind.Pickup"
    }
   }
  },
  {
   "name": "a declared enum's variant with its doc",
   "source": [
    "tariff \"t\"",
    "enum Zone {",
    "  /// The home zone.",
    "  North,",
    "  South",
    "}",
    "let z: Zone = Nor|th",
    "charge \"x\" = $1"
   ],
   "expect": {
    "contents": {
     "signature": "Zone.North",
     "doc": "The home zone."
    }
   }
  },
  {
   "name": "a declared type",
   "source": [
    "tariff \"t\"",
    "/// A weight break.",
    "type Break = { from: Weight, rate: Money/cwt }",
    "input breaks: List<Bre|ak> = []",
    "charge \"x\" = $1"
   ],
   "expect": {
    "contents": {
     "signature": "type Break = { from: Weight, rate: Money/cwt }",
     "doc": "A weight break."
    }
   }
  },
  {
   "name": "a built-in type",
   "source": [
    "tariff \"t\"",
    "input r: Mon|ey = $1",
    "charge \"x\" = r"
   ],
   "expect": {
    "contents": {
     "signature": "Money",
