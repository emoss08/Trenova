    "contents": {
     "signature": "from: Weight",
     "doc": "Where the break starts."
    }
   }
  },
  {
   "name": "a unit in a literal",
   "source": [
    "tariff \"t\"",
    "let w = 1_200 l|b",
    "charge \"x\" = $1"
   ],
   "expect": {
    "contents": {
     "signature": "lb",
     "type": "Weight",
     "doc": {
      "message": "`{0}` is a {1}, a unit of {2}: 1 {0} = {3} {4}, exactly.",
      "args": [
       "lb",
       {
        "message": "pound"
       },
       {
        "message": "weight"
       },
       "0.45359237",
       "kg"
      ]
     }
    }
   }
  },
