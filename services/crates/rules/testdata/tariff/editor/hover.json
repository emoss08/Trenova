  },
  {
   "name": "a test constructor's field",
   "source": [
    "tariff \"t\"",
    "charge \"x\" = $1",
    "test \"t\" {",
    "  given shipment.stops = [pickup(arri|val: @2026-01-05T08:00Z)]",
    "}"
   ],
   "expect": {
    "contents": {
     "signature": "arrival: DateTime?"
    }
   }
  }
 ]
