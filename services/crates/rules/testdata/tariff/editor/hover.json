      "message": "Money in the rating currency, written `$450`."
     }
    }
   }
  },
  {
   "name": "a schema record type",
   "source": [
    "tariff \"t\"",
    "input s: List<St|op> = []",
    "charge \"x\" = $1"
   ],
   "expect": {
    "contents": {
     "signature": "type Stop = { sequence: Int, kind: StopKind, status: StopStatus, appointment: Bool, window: { start: DateTime?, end: DateTime? }, arrival: DateTime?, departure: DateTime?, dwell: Duration?, pieces: Int?, weight: Weight?, legDistance: Distance?, location: { city: Text, state: Text, zip: Text, zip3: Text, … } }"
    }
   }
  },
  {
   "name": "a record field of a declared type",
   "source": [
    "tariff \"t\"",
    "type Break = {",
    "  /// Where the break starts.",
    "  from: Weight",
    "}",
    "input b: Break = { from: 1 lb }",
    "charge \"x\" = $1/lb * b.fr|om"
   ],
