     "type": "Stop"
    }
   }
  },
  {
   "name": "a loop variable",
   "source": [
    "tariff \"t\"",
    "for st|op in shipment.stops {",
    "}",
    "charge \"x\" = $1"
   ],
   "expect": {
    "contents": {
     "signature": "stop: Stop"
    }
   }
  },
  {
   "name": "an if let binding is narrowed",
