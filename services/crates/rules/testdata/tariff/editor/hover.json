    }
   }
  },
  {
   "name": "a given path's field",
   "source": [
    "tariff \"t\"",
    "charge \"x\" = $1",
    "test \"t\" {",
    "  given shipment.wei|ght = 1 lb",
    "  expect total == $1",
    "}"
   ],
   "expect": {
    "contents": {
     "signature": "shipment.weight: Weight?"
    }
   }
  },
  {
   "name": "a constant",
   "source": [
    "tariff \"t\"",
    "/// The base.",
    "const BASE: Money = $5",
    "charge \"x\" = BA|SE"
   ],
   "expect": {
    "contents": {
     "signature": "const BASE: Money = $5",
     "doc": "The base."
    }
   }
  },
  {
   "name": "a let's previewed value",
   "source": [
    "tariff \"t\"",
    "let mi|les = shipment.distance",
    "charge \"x\" = $1/mi * miles"
   ],
   "expect": {
    "contents": {
     "value": {
      "display": "412 mi",
      "value": {
       "$q": "412",
       "u": "mi"
      },
      "times": 1
     }
    }
   },
   "input": {
    "values": [
     {
      "kind": "bind",
      "name": "miles",
      "value": {
       "$q": "412",
       "u": "mi"
      },
      "display": "412 mi",
      "range": {
       "from": 11,
       "to": 40
      }
     }
    ]
   }
  },
  {
   "name": "a var's last value",
   "source": [
    "tariff \"t\"",
    "var total = $0",
    "for s in shipment.stops {",
    "  total += $1",
    "}",
    "charge \"x\" = tot|al"
   ],
   "expect": {
    "contents": {
     "value": {
      "display": "$2.00",
      "times": 3
     }
    }
   },
   "input": {
    "values": [
     {
      "kind": "bind",
      "name": "total",
      "value": {
       "$q": "0",
       "u": "$"
      },
      "display": "$0.00",
      "range": {
       "from": 11,
       "to": 25
      }
     },
     {
      "kind": "assign",
      "name": "total",
      "value": {
       "$q": "1",
       "u": "$"
      },
      "display": "$1.00",
      "range": {
       "from": 53,
       "to": 63
      }
     },
     {
      "kind": "assign",
      "name": "total",
      "value": {
       "$q": "2",
       "u": "$"
      },
      "display": "$2.00",
      "range": {
       "from": 53,
       "to": 63
      }
     }
    ]
   }
  },
  {
   "name": "malformed values are ignored",
   "source": [
    "tariff \"t\"",
    "let mi|les = shipment.distance",
