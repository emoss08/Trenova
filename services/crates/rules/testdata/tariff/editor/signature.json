{
 "cases": [
  {
   "name": "a user function's first parameter",
   "source": [
    "tariff \"t\"",
    "/// Waiting time billed by the hour. `free` is the time not billed. Then `rate` per hour.",
    "fn wait(free: Duration, rate: Money/h) -> Money = rate * free",
    "charge \"x\" = wait(|)"
   ],
   "expect": {
    "signatures": [
     {
      "label": "wait(free: Duration, rate: Money/h) -> Money",
      "doc": "Waiting time billed by the hour. `free` is the time not billed. Then `rate` per hour.",
      "parameters": [
       {
        "label": [
         5,
         19
        ],
        "doc": "`free` is the time not billed."
       },
       {
        "label": [
         21,
         34
        ]
       }
      ]
     }
    ],
    "active": 0,
    "activeParameter": 0
   }
  },
  {
   "name": "the second positional parameter",
   "source": [
    "tariff \"t\"",
    "fn wait(free: Duration, rate: Money/h) -> Money = rate * free",
    "charge \"x\" = wait(1 h, |)"
   ],
   "expect": {
    "activeParameter": 1
   }
  },
  {
   "name": "a named argument by its name",
   "source": [
    "tariff \"t\"",
    "fn wait(free: Duration, rate: Money/h) -> Money = rate * free",
    "charge \"x\" = wait(rate: |)"
   ],
   "expect": {
    "activeParameter": 1
   }
  },
  {
   "name": "after a named argument, the first parameter not given",
   "source": [
    "tariff \"t\"",
    "fn wait(free: Duration, rate: Money/h) -> Money = rate * free",
    "charge \"x\" = wait(rate: $1/h, |)"
   ],
   "expect": {
    "activeParameter": 0
   }
  },
  {
   "name": "past the last parameter",
   "source": [
    "tariff \"t\"",
    "fn wait(free: Duration) -> Money = $1",
    "charge \"x\" = wait(1 h, 2, |)"
   ],
   "expect": {
    "activeParameter": null,
    "active": 0
   }
  },
  {
   "name": "a library function with defaults",
   "source": [
    "tariff \"t\"",
    "use std.ltl.{ deficit }",
    "let r = deficit(|)",
    "charge \"x\" = $1"
   ],
   "expect": {
    "signatures": [
     {
      "label": "deficit(breaks: List<Break>, actual: Weight, allow: Bool = true) -> Rated"
     }
    ],
    "activeParameter": 0
   }
  },
  {
   "name": "a module function",
   "source": [
    "tariff \"t\"",
    "use std.fuel",
    "let p = fuel.perMile($1/gal, |)",
    "charge \"x\" = $1"
   ],
   "expect": {
    "signatures": [
     {
      "label": "perMile(price: Money/gal, peg: Money/gal, mpg: Number) -> Money/mi"
     }
    ],
    "activeParameter": 1
   }
  },
  {
   "name": "a method",
   "source": [
    "tariff \"t\"",
    "let a = $5",
    "charge \"x\" = a.clamp($1, |)"
   ],
   "expect": {
    "signatures": [
     {
      "label": "clamp(lo: Money, hi: Money) -> Money"
     }
    ],
    "activeParameter": 1
   }
  },
  {
   "name": "a list method's lambda is typed",
   "source": [
    "tariff \"t\"",
    "let d = shipment.stops.where(|)",
    "charge \"x\" = $1"
   ],
   "expect": {
    "signatures": [
     {
      "label": "where(f: Stop => Bool) -> List<Stop>",
      "doc": {
       "message": "The items `f` holds for, in order: `stops.where(s => s.kind == Delivery)`."
      }
     }
    ],
    "activeParameter": 0
   }
  },
  {
   "name": "inside a lambda the call is still the method",
   "source": [
    "tariff \"t\"",
    "let d = shipment.stops.sum(s => s.|)",
    "charge \"x\" = $1"
   ],
   "expect": {
    "signatures": [
     {
      "label": "sum(f: Stop => U = the item) -> U"
     }
    ]
   }
  },
  {
   "name": "a test constructor",
   "source": [
    "tariff \"t\"",
    "charge \"x\" = $1",
    "test \"t\" {",
    "  given shipment.stops = [pickup(arrival: @2026-01-05T08:00Z, |)]",
    "}"
   ],
   "expect": {
