  {
   "name": "inside a list argument the call is still found",
   "source": [
    "tariff \"t\"",
    "fn f(xs: List<Int>, n: Int) -> Int = n",
    "charge \"x\" = $1 * f([1, |], 2)"
   ],
   "expect": {
    "activeParameter": 0,
    "signatures": [
     {
      "label": "f(xs: List<Int>, n: Int) -> Int"
     }
    ]
   }
  },
  {
   "name": "the innermost call",
   "source": [
    "tariff \"t\"",
    "fn f(a: Int, b: Int) -> Int = a",
    "charge \"x\" = $1 * f(1, f(|))"
   ],
   "expect": {
    "activeParameter": 0
   }
  },
  {
   "name": "an unclosed call",
   "source": [
