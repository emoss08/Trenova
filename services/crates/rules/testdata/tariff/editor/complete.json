    "includes": [
     "price",
     "priceDate",
     "index"
    ]
   }
  },
  {
   "name": "a local named like a module shadows nothing",
   "source": [
    "tariff \"t\"",
    "let x = lane.origin.|",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "zip3",
     "zones",
     "city"
    ]
   }
  },
  {
   "name": "a percent's value",
   "source": [
    "tariff \"t\"",
    "let p = 18%",
    "let v = p.|",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "value"
    ],
    "items": {
     "value": {
      "kind": "property"
     }
    }
   }
  },
  {
   "name": "a whole number's methods",
   "source": [
