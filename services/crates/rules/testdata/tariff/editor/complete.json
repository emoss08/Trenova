{
 "cases": [
  {
   "name": "after a root's dot, its fields",
   "source": [
    "tariff \"t\"",
    "let w = shipment.|",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "weight",
     "distance",
     "stops",
     "hazmat"
    ],
    "excludes": [
     "round",
     "miles"
    ],
    "items": {
     "weight": {
      "kind": "field",
      "detail": "Weight?"
     }
    }
   }
  },
  {
   "name": "a partial field name replaces the word",
   "source": [
    "tariff \"t\"",
    "let w = shipment.wei|",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "weight"
    ],
    "range": "wei"
   }
  },
  {
   "name": "names in scope with their types",
   "source": [
    "tariff \"t\"",
    "input rate: Money/mi = $2.35/mi",
    "let miles = shipment.distance",
    "charge \"x\" = |"
   ],
   "expect": {
    "includes": [
     "miles",
     "rate",
     "shipment",
     "tables"
    ],
    "items": {
     "miles": {
      "kind": "name",
      "detail": "Distance"
     },
     "rate": {
      "kind": "input",
      "detail": "Money/mi"
     }
    }
   }
  },
  {
   "name": "money methods",
   "source": [
    "tariff \"t\"",
    "let a = $5",
    "charge \"x\" = a.|"
   ],
   "expect": {
    "includes": [
     "roundUp",
     "round",
     "max"
    ],
    "excludes": [
     "value",
     "upper"
    ],
    "items": {
     "roundUp": {
      "kind": "method",
      "detail": "roundUp(to: Money) -> Money",
      "snippet": true,
      "insert": "roundUp($0)"
     }
    }
   }
  },
  {
   "name": "quantity properties and methods",
   "source": [
    "tariff \"t\"",
    "let w = shipment.distance",
    "charge \"x\" = $1/mi * w.|"
   ],
   "expect": {
    "includes": [
     "value",
     "in",
     "roundUp",
     "clamp"
    ],
    "items": {
     "value": {
      "kind": "property",
      "detail": "value: Number"
     }
    }
   }
  },
  {
   "name": "optional chaining reads the inner record's fields",
   "source": [
    "tariff \"t\"",
    "let c = shipment.trailerType?.|",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "code",
     "description"
    ],
    "items": {
     "code": {
      "kind": "field",
      "insert": "code"
     }
    }
   }
  },
  {
   "name": "a dot on an optional rewrites itself to ?.",
   "source": [
    "tariff \"t\"",
    "let a = shipment.pickup.|",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "arrival",
     "dwell"
    ],
    "items": {
     "arrival": {
      "insert": "?.arrival",
      "range": {
       "text": "."
      }
     }
    }
   }
  },
  {
   "name": "a dot on an optional with a partial name rewrites the dot and the word",
   "source": [
    "tariff \"t\"",
    "let a = shipment.pickup.arr|",
    "charge \"x\" = $1"
   ],
   "expect": {
    "items": {
     "arrival": {
      "insert": "?.arrival",
      "range": {
       "text": ".arr"
      }
     }
    },
    "range": "arr"
   }
  },
  {
   "name": "tables lists the table codes",
   "source": [
    "tariff \"t\"",
    "let r = tables.|",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "Zones",
     "Breaks",
     "ClassRates"
    ],
    "items": {
     "Zones": {
      "kind": "table",
      "detail": "[origin zip3, destination zip3] -> Money/cwt?",
      "doc": "Zone rates"
     }
    }
   }
  },
  {
   "name": "a table's methods",
   "source": [
    "tariff \"t\"",
    "let r = tables.Breaks.|",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "cell",
     "band",
     "interpolate"
    ],
    "excludes": [
     "weight"
    ],
    "items": {
     "band": {
      "kind": "table",
      "insert": "band($0)"
     }
    }
   }
  },
  {
   "name": "a table's first axis keys",
   "source": [
    "tariff \"t\"",
    "let r = tables.Zones[|]",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "\"752\"",
     "\"100\""
    ],
    "excludes": [
     "\"606\""
    ],
    "items": {
     "\"752\"": {
      "kind": "value",
      "detail": "Zones: origin zip3"
     }
    },
    "order": [
     "\"100\"",
     "\"752\""
    ]
   }
  },
  {
   "name": "a table's second axis keys",
   "source": [
    "tariff \"t\"",
    "let r = tables.Zones[lane.origin.zip3, |]",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "\"606\"",
     "\"303\"",
     "lane"
    ],
    "excludes": [
     "\"752\""
    ],
    "items": {
     "\"303\"": {
      "detail": "Zones: destination zip3"
     }
    }
   }
  },
  {
   "name": "a freight class axis offers its classes as variants",
   "source": [
    "tariff \"t\"",
    "let r = tables.ClassRates[|]",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "Class50",
     "Class70"
    ],
    "order": [
     "Class50",
     "shipment"
    ]
   }
  },
  {
   "name": "a range axis offers values",
   "source": [
    "tariff \"t\"",
    "let r = tables.Breaks[|]",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "shipment"
    ],
    "excludes": [
     "\"752\""
    ]
   }
  },
  {
   "name": "an unknown table offers values",
   "source": [
    "tariff \"t\"",
    "let r = tables.Nope[|]",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "shipment"
    ]
   }
  },
  {
   "name": "units of the expected dimension after a number",
   "source": [
    "tariff \"t\"",
    "let w: Weight = 5 |",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "lb",
     "cwt",
     "kg",
     "t",
     "ton"
    ],
    "excludes": [
     "mi",
     "h",
     "%"
    ],
    "items": {
     "cwt": {
      "kind": "unit",
      "detail": "Weight"
     }
    }
   }
  },
  {
   "name": "a partial unit after a number",
   "source": [
    "tariff \"t\"",
    "let w: Distance = 5 k|",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "km",
     "mi"
    ],
    "excludes": [
     "lb"
    ],
    "range": "k"
   }
  },
  {
   "name": "every unit after a number with nothing expected",
   "source": [
    "tariff \"t\"",
    "let w = 5 |",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "lb",
     "mi",
     "h",
     "ft3",
     "°F",
     "pallet"
    ],
    "excludes": [
     "$"
    ]
   }
  },
  {
   "name": "units after a money rate's slash",
   "source": [
    "tariff \"t\"",
    "input rate: Money/mi = $2.35/|",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "mi",
     "cwt",
     "h",
     "pallet"
    ],
    "excludes": [
     "%",
     "$"
    ]
   }
  },
  {
   "name": "count labels after a number where a count is expected",
   "source": [
    "tariff \"t\"",
    "fn f(n: Int) -> Int = n",
    "let n = f(3 |)",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "pallet",
     "piece",
     "stop"
    ],
    "excludes": [
     "lb",
     "%"
    ]
   }
  },
  {
   "name": "the active accessorial codes after as",
   "source": [
    "tariff \"t\"",
    "charge \"Fuel\" as |"
   ],
   "expect": {
    "includes": [
     "FSC",
     "DET",
     "HAZ",
     "XDROP"
    ],
    "excludes": [
     "LIFT",
     "miles"
    ],
    "items": {
     "FSC": {
      "kind": "code",
      "detail": "Fuel surcharge"
     }
    }
   }
  },
  {
   "name": "a partial code after as",
   "source": [
    "tariff \"t\"",
    "charge \"Fuel\" as FS| = $5"
   ],
   "expect": {
    "includes": [
     "FSC"
    ],
    "range": "FS"
   }
  },
  {
   "name": "no codes when the host has not loaded them",
   "source": [
    "tariff \"t\"",
    "charge \"Fuel\" as |"
   ],
   "expect": {
    "empty": true
   },
   "context": {
    "codes": null
   }
  },
  {
   "name": "the module roots after use",
   "source": [
    "tariff \"t\"",
    "use |"
   ],
   "expect": {
    "includes": [
     "std",
     "org"
    ],
    "items": {
     "std": {
      "kind": "module"
     }
    }
   }
  },
  {
   "name": "the standard library modules",
   "source": [
    "tariff \"t\"",
    "use std.|"
   ],
   "expect": {
    "includes": [
     "ltl",
     "fuel",
     "time",
     "accessorials"
    ],
    "excludes": [
     "lanes"
    ],
    "items": {
     "ltl": {
      "kind": "module",
      "detail": "std.ltl"
     }
    }
   }
  },
  {
   "name": "the organisation's libraries",
   "source": [
    "tariff \"t\"",
    "use org.|"
   ],
   "expect": {
    "includes": [
     "accessorials",
     "lanes"
    ],
    "excludes": [
     "ltl"
    ]
   }
  },
  {
   "name": "a module's exported names",
   "source": [
    "tariff \"t\"",
    "use std.ltl.{ | }"
   ],
   "expect": {
    "includes": [
     "deficit",
     "Break",
     "Rated",
     "billed",
     "densityClass"
    ],
    "items": {
     "deficit": {
      "kind": "function"
     },
     "Break": {
      "kind": "type"
     }
    }
   }
  },
  {
   "name": "an imported name is not offered twice",
   "source": [
    "tariff \"t\"",
    "use std.ltl.{ deficit, | }"
   ],
   "expect": {
    "includes": [
     "Break"
    ],
    "excludes": [
     "deficit"
    ]
   }
  },
  {
   "name": "a library's private names are not exported",
   "source": [
    "tariff \"t\"",
    "use org.accessorials.{ | }"
   ],
   "expect": {
    "includes": [
     "hazmat",
     "liftgate",
     "Zone",
     "Fee",
     "BASE"
    ],
    "excludes": [
     "secret"
    ],
    "items": {
     "Zone": {
      "kind": "enum"
     },
     "hazmat": {
      "doc": "Hazmat handling per loaded mile."
     }
    }
   }
  },
  {
   "name": "tariff statements at file level",
   "source": [
    "tariff \"t\"",
    "let a = 1",
    "|"
   ],
   "expect": {
    "includes": [
     "charge",
     "note",
     "let",
     "var",
     "input",
     "fn",
     "test",
     "minimum",
     "maximum",
     "round",
     "use",
     "if",
     "for",
     "match",
     "require",
     "fail",
     "charge (quantity, rate)",
     "test",
     "for … in …"
    ],
    "excludes": [
     "return",
     "given",
     "expect",
     "break"
    ]
   }
  },
  {
   "name": "a snippet inserts tab stops",
   "source": [
    "tariff \"t\"",
    "|"
   ],
   "expect": {
    "items": {
     "charge (quantity, rate)": {
      "kind": "snippet",
      "snippet": true,
      "insert": "charge \"${1:Label}\" (quantity: ${2:quantity}, rate: ${3:rate})"
     },
     "require let … else": {
      "kind": "snippet"
     },
     "if let": {
      "kind": "snippet"
     },
     "match": {
      "kind": "keyword"
     }
    }
   }
  },
  {
   "name": "a function body's statements",
   "source": [
    "tariff \"t\"",
    "fn f(a: Money) -> Money {",
    "  |",
    "}",
    "charge \"x\" = f($1)"
   ],
   "expect": {
    "includes": [
     "return",
     "let",
     "if",
     "for",
     "require",
     "a"
    ],
    "excludes": [
     "charge",
     "note",
     "minimum",
     "input",
     "test",
     "given",
     "shipment",
     "tables"
    ]
   }
  },
  {
   "name": "a test's statements",
   "source": [
    "tariff \"t\"",
    "charge \"x\" = $1",
    "test \"t\" {",
    "  |",
    "}"
   ],
   "expect": {
    "includes": [
     "given",
     "expect",
     "let"
    ],
    "excludes": [
     "note",
     "minimum",
     "input",
     "return",
     "charge (quantity, rate)",
     "charge as CODE"
    ]
   }
  },
  {
   "name": "a library's file-level statements",
   "source": [
    "library \"l\"",
    "|"
   ],
   "expect": {
    "includes": [
     "fn",
     "const",
     "type",
     "enum",
     "private",
     "test",
     "use"
    ],
    "excludes": [
     "charge",
     "input",
     "let",
     "minimum",
     "shipment"
    ]
   }
  },
  {
   "name": "a condition's file-level statements",
   "source": [
    "condition \"c\"",
    "input z: List<Text> = []",
    "|"
   ],
   "expect": {
    "includes": [
     "let",
     "input",
     "if",
     "z",
     "shipment"
    ],
    "excludes": [
     "charge",
     "note",
     "minimum",
     "test"
    ]
   }
  },
  {
   "name": "statements inside a tariff block",
   "source": [
    "tariff \"t\"",
    "if shipment.hazmat {",
    "  |",
    "}"
   ],
   "expect": {
    "includes": [
     "charge",
     "note",
     "let"
    ],
    "excludes": [
     "minimum",
     "input",
     "fn",
     "test",
     "return",
     "break"
    ]
   }
  },
  {
   "name": "break and continue inside a loop",
   "source": [
    "tariff \"t\"",
    "for s in shipment.stops {",
    "  |",
    "}",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "break",
     "continue",
     "s",
     "charge"
    ]
   }
  },
  {
   "name": "a function sees its parameters but not the record",
   "source": [
    "tariff \"t\"",
    "input rate: Money = $1",
    "let miles = shipment.distance",
    "fn f(a: Money, b: Int) -> Money = |",
    "charge \"x\" = f($1, 2)"
   ],
   "expect": {
    "includes": [
     "a",
     "b",
     "f"
    ],
    "excludes": [
     "shipment",
     "tables",
     "rate",
     "miles"
    ],
    "items": {
     "a": {
      "detail": "Money"
     }
    }
   }
  },
  {
   "name": "a test sees the record and the bill but not inputs or bindings",
   "source": [
    "tariff \"t\"",
    "input rate: Money = $1",
    "let miles = shipment.distance",
    "charge \"Linehaul\" = rate",
    "test \"t\" {",
    "  expect |",
    "}"
   ],
   "expect": {
    "includes": [
     "shipment",
     "total",
     "lines",
     "charge",
     "pickup",
     "delivery",
     "commodity"
    ],
    "excludes": [
     "rate",
     "miles"
    ],
    "items": {
     "total": {
      "detail": "Money"
     },
     "charge": {
      "kind": "function"
     }
    }
   }
  },
  {
   "name": "a library's test has no bill",
   "source": [
    "library \"l\"",
    "fn f() -> Int = 1",
    "test \"t\" {",
    "  expect |",
    "}"
   ],
   "expect": {
    "includes": [
     "f",
     "pickup"
    ],
    "excludes": [
     "total",
     "lines",
     "charge"
    ]
   }
  },
