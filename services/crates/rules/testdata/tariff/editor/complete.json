    "use std.ltl.{ deficit }",
    "let r = deficit([], |)",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "actual:",
     "allow:"
    ],
    "excludes": [
     "breaks:"
    ]
   }
  },
  {
   "name": "a named argument fills its parameter",
   "source": [
