   "expect": {
    "includes": [
     "Number",
     "Int.parse"
    ]
   }
  },
  {
   "name": "a for loop's list",
   "source": [
    "tariff \"t\"",
    "for s in | {",
    "}",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "shipment"
    ],
    "excludes": [
     "s"
    ]
   }
  },
  {
   "name": "a for loop's filter sees the loop variable",
   "source": [
    "tariff \"t\"",
    "for s in shipment.stops where s.| {",
    "}",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "dwell",
     "kind"
    ]
   }
  },
  {
   "name": "a var is offered in its loop",
   "source": [
    "tariff \"t\"",
    "var total = $0",
    "for s in shipment.stops {",
    "  total += |",
    "}",
    "charge \"x\" = total"
   ],
   "expect": {
    "includes": [
     "total",
     "s"
    ]
   }
  },
  {
   "name": "a test's local binding",
   "source": [
    "tariff \"t\"",
    "charge \"x\" = $1",
    "test \"t\" {",
    "  let expected = $1",
    "  expect total == |",
    "}"
   ],
   "expect": {
    "includes": [
     "expected",
     "total"
    ],
    "order": [
     "expected",
     "shipment"
    ]
   }
  },
  {
   "name": "a condition's final expression",
   "source": [
    "condition \"c\"",
    "input zips: List<Text> = []",
    "|"
   ],
   "expect": {
    "includes": [
     "zips",
     "lane",
     "shipment"
    ]
   }
  },
  {
   "name": "a fuel record's fields",
   "source": [
    "tariff \"t\"",
    "let p = fuel.|",
    "charge \"x\" = $1"
   ],
