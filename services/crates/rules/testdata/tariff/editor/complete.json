  {
   "name": "the parameters of a call",
   "source": [
    "tariff \"t\"",
    "use std.ltl.{ deficit }",
    "let r = deficit(|)",
    "charge \"x\" = $1"
   ],
   "expect": {
    "includes": [
     "breaks:",
     "actual:",
     "allow:",
     "shipment"
    ],
    "order": [
     "breaks:",
     "shipment"
    ],
    "items": {
     "actual:": {
      "kind": "field",
      "insert": "actual: ",
      "detail": "Weight"
     }
    }
   }
  },
  {
   "name": "a positional argument fills its parameter",
   "source": [
