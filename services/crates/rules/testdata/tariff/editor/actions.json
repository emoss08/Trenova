{
 "cases": [
  {
   "name": "a rate option: the label plus Rate, after the last input",
   "source": [
    "tariff \"Dry van\"",
    "",
    "/// Paid per stop.",
    "input stopFee: Money = $75",
    "",
    "charge \"Linehaul\" (quantity: shipment.distance, rate: |$2.35/mi|)",
    "charge \"Stops\" = stopFee"
   ],
   "expect": {
    "actions": [
     {
      "edits": [
       {
        "insert": "input linehaulRate: Money/mi = $2.35/mi\n",
        "range": {
         "text": ""
        }
       },
       {
        "insert": "linehaulRate",
        "range": {
         "text": "$2.35/mi"
        }
       }
      ],
      "id": "promote-input",
      "result": [
       "tariff \"Dry van\"",
       "",
       "/// Paid per stop.",
       "input stopFee: Money = $75",
       "input linehaulRate: Money/mi = $2.35/mi",
       "",
       "charge \"Linehaul\" (quantity: shipment.distance, rate: linehaulRate)",
       "charge \"Stops\" = stopFee"
      ],
      "select": {
       "text": "linehaulRate"
      },
      "title": {
       "args": [
        "`$2.35/mi`"
       ],
       "message": "Promote {0} to an input"
      }
     }
    ]
   }
  },
