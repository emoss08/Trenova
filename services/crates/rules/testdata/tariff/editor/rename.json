{
 "cases": [
  {
   "name": "a let and its references",
   "source": [
    "tariff \"t\"",
    "let mi|les = shipment.distance",
    "charge \"x\" = $1/mi * miles",
    "note \"{miles}\""
   ],
   "expect": {
    "edits": [
     {
      "range": {
       "text": "miles"
      },
      "insert": "distance"
     },
     {
      "range": {
       "text": "miles"
      },
      "insert": "distance"
     },
     {
      "range": {
       "text": "miles"
      },
      "insert": "distance"
     }
    ]
   },
   "input": {
    "newName": "distance"
   }
  },
  {
   "name": "an input and its given",
   "source": [
    "tariff \"t\"",
    "input ra|te: Money = $1",
    "charge \"x\" = rate",
    "test \"t\" {",
    "  given input.rate = $2",
    "  expect total == $2",
    "}"
   ],
   "expect": {
    "edits": [
     {
      "range": {
       "text": "rate"
      }
     },
     {
      "range": {
       "text": "rate"
      }
     },
     {
      "range": {
       "text": "rate"
      }
     }
    ]
   },
   "input": {
    "newName": "fee"
   }
  },
  {
   "name": "a parameter and its named arguments",
   "source": [
    "tariff \"t\"",
    "fn fee(a|mount: Money) -> Money = amount",
    "charge \"x\" = fee(amount: $1)"
   ],
   "expect": {
    "edits": [
     {
      "range": {
       "text": "amount"
      },
      "insert": "value"
     },
     {
      "range": {
       "text": "amount"
      }
     },
     {
      "range": {
       "text": "amount"
      }
     }
    ]
   },
   "input": {
    "newName": "value"
   }
  },
  {
   "name": "a function",
   "source": [
