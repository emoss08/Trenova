    "charge \"x\" = f.a"
   ],
   "expect": {
    "edits": [
     {
      "insert": "Price"
     },
     {
      "insert": "Price"
     }
    ]
   },
   "input": {
    "newName": "Price"
   }
  },
  {
   "name": "a record field everywhere",
   "source": [
    "tariff \"t\"",
    "type Fee = { amo|unt: Money }",
    "input f: Fee = { amount: $1 }",
    "charge \"x\" = f.amount",
    "let y = match f {",
    "  { amount: a } => a",
    "}"
   ],
   "expect": {
    "edits": [
     {
      "range": {
       "text": "amount"
      },
      "insert": "value"
     },
     {
      "insert": "value"
     },
     {
      "insert": "value"
     },
     {
      "insert": "value"
     }
    ]
   },
   "input": {
    "newName": "value"
   }
  },
  {
   "name": "an enum variant everywhere",
   "source": [
    "tariff \"t\"",
    "enum Zone { North, South }",
    "input z: Zone = Nor|th",
    "let r = match z {",
    "  North => 1",
    "  Zone.South => 2",
    "}",
    "charge \"x\" = $1 * r",
    "note \"{z == Zone.North}\""
   ],
   "expect": {
    "edits": [
     {
      "insert": "Up"
     },
     {
      "insert": "Up"
     },
     {
      "insert": "Up"
     },
     {
      "insert": "Up"
     }
    ]
   },
   "input": {
    "newName": "Up"
   }
  },
  {
   "name": "a module alias gains an as",
   "source": [
    "tariff \"t\"",
    "use std.fuel",
    "let p = fu|el.perMile($1/gal, peg: $1/gal, mpg: 6)",
    "charge \"x\" = $1/mi * shipment.distance * 0 + p * shipment.distance"
   ],
   "expect": {
    "edits": [
     {
      "range": {
       "text": ""
      },
      "insert": " as f"
     },
     {
      "range": {
       "text": "fuel"
      },
      "insert": "f"
     }
    ]
   },
   "input": {
    "newName": "f"
   }
  },
  {
   "name": "an explicit alias changes",
   "source": [
    "tariff \"t\"",
    "use std.fuel as fu",
    "let p = f|u.perMile($1/gal, peg: $1/gal, mpg: 6)",
    "charge \"x\" = p * shipment.distance"
   ],
   "expect": {
    "edits": [
     {
      "range": {
       "text": "fu"
      },
      "insert": "g"
     },
     {
      "range": {
       "text": "fu"
      },
      "insert": "g"
     }
    ]
   },
   "input": {
    "newName": "g"
   }
  },
  {
   "name": "prepare gives the name and its range",
   "source": [
    "tariff \"t\"",
    "let mi|les = shipment.distance",
    "charge \"x\" = $1/mi * miles"
   ],
   "expect": {
    "range": {
     "text": "miles"
    },
    "placeholder": "miles"
   }
  },
  {
   "name": "prepare refuses a root",
   "source": [
    "tariff \"t\"",
    "let w = ship|ment.weight",
    "charge \"x\" = $1"
   ],
   "expect": {
    "error": {
     "message": "{0} is part of the record a tariff rates, so it can't be renamed",
     "args": [
      "`shipment`"
     ]
    }
   }
  },
  {
   "name": "a root can't be renamed",
   "source": [
    "tariff \"t\"",
    "let w = ship|ment.weight",
    "charge \"x\" = $1"
   ],
   "expect": {
    "error": {
     "args": [
      "`shipment`"
     ]
    }
   },
   "input": {
    "newName": "load"
   }
  },
  {
   "name": "a schema field can't be renamed",
   "source": [
    "tariff \"t\"",
    "let w = shipment.wei|ght",
    "charge \"x\" = $1"
   ],
   "expect": {
    "error": {
     "message": "{0} is a field of the record a tariff rates, so it can't be renamed"
    }
   },
   "input": {
    "newName": "mass"
   }
  },
  {
   "name": "a keyword can't be renamed",
   "source": [
    "tariff \"t\"",
    "le|t a = 1",
    "charge \"x\" = $1"
   ],
   "expect": {
    "error": {
     "message": "{0} is a keyword, so it can't be renamed"
    }
   }
  },
  {
   "name": "a standard library function can't be renamed",
   "source": [
    "tariff \"t\"",
    "use std.ltl.{ deficit }",
    "let r = defi|cit([], actual: 1 lb)",
    "charge \"x\" = $1"
   ],
   "expect": {
    "error": {
     "message": "{0} is declared in the standard library ({1}), so it can't be renamed",
     "args": [
      "`deficit`",
      "`std.ltl`"
     ]
    }
   },
   "input": {
    "newName": "d"
   }
  },
  {
   "name": "an organisation library name renames in its library",
   "source": [
    "tariff \"t\"",
    "use org.accessorials.{ hazmat }",
    "charge \"x\" = haz|mat(1 mi)"
   ],
   "expect": {
    "error": {
     "message": "{0} is declared in the library {1}; rename it there, then update this file's import"
    }
   },
   "input": {
    "newName": "h"
   }
  },
  {
   "name": "a test is named by its text",
   "source": [
    "tariff \"t\"",
    "charge \"x\" = $1",
    "te|st \"t\" {",
    "  expect total == $1",
    "}"
   ],
   "expect": {
    "error": {
     "message": "{0} is a keyword, so it can't be renamed"
    }
   }
  },
  {
   "name": "a new name that is not a name",
   "source": [
    "tariff \"t\"",
    "let mi|les = 1",
    "charge \"x\" = $1 * miles"
   ],
   "expect": {
    "error": {
     "message": "{0} isn't a name: a name is a letter followed by letters, digits and `_`"
    }
   },
   "input": {
    "newName": "9lives"
   }
  },
  {
   "name": "a new name of the wrong case",
   "source": [
    "tariff \"t\"",
    "let mi|les = 1",
    "charge \"x\" = $1 * miles"
   ],
   "expect": {
    "error": {
     "message": "{0} can't name {1}: names are camelCase, like `extraDropFee`"
    }
   },
   "input": {
    "newName": "Miles"
   }
  },
  {
   "name": "a type must be PascalCase",
   "source": [
    "tariff \"t\"",
    "type Fe|e = { a: Money }",
    "input f: Fee = { a: $1 }",
    "charge \"x\" = f.a"
   ],
   "expect": {
    "error": {
     "message": "{0} can't name {1}: types, enums and variants are PascalCase, like `ExtraDrop`"
    }
   },
   "input": {
    "newName": "fee"
   }
  },
  {
   "name": "a constant may be UPPERCASE",
   "source": [
    "tariff \"t\"",
    "const ba|se: Money = $1",
    "charge \"x\" = base"
   ],
   "expect": {
    "edits": [
     {
      "insert": "BASE"
     },
     {
      "insert": "BASE"
     }
    ]
   },
   "input": {
    "newName": "BASE"
   }
  },
  {
   "name": "a keyword as the new name",
   "source": [
    "tariff \"t\"",
    "let mi|les = 1",
    "charge \"x\" = $1 * miles"
   ],
   "expect": {
    "error": {
     "message": "{0} is a keyword, so it can't be a name"
    }
   },
   "input": {
    "newName": "match"
   }
  },
  {
   "name": "a collision with a binding in scope",
   "source": [
    "tariff \"t\"",
    "let a = 1",
    "let b| = 2",
    "charge \"x\" = $1 * a * b"
   ],
   "expect": {
    "error": {
     "message": "{0} is already {1} here; pick another name",
     "args": [
      "`a`",
      {
       "message": "a name in scope"
      }
     ]
    }
   },
   "input": {
    "newName": "a"
   }
  },
  {
   "name": "a collision with a root",
   "source": [
    "tariff \"t\"",
    "let b| = 2",
    "charge \"x\" = $1 * b"
   ],
   "expect": {
    "error": {
     "args": [
      "`lane`",
      {
       "message": "a schema root"
      }
     ]
    }
   },
   "input": {
    "newName": "lane"
   }
  },
  {
   "name": "a collision with a function",
   "source": [
    "tariff \"t\"",
    "fn fee() -> Money = $1",
    "let b| = 2",
    "charge \"x\" = fee() * b"
   ],
   "expect": {
    "error": {
     "args": [
      "`fee`",
      {
       "message": "declared in this file"
      }
     ]
    }
   },
   "input": {
    "newName": "fee"
   }
  },
  {
   "name": "names in separate blocks don't collide",
   "source": [
    "tariff \"t\"",
    "if shipment.hazmat {",
    "  let a = 1",
    "  charge \"x\" = $1 * a",
    "}",
    "if shipment.reefer {",
    "  let b| = 2",
    "  charge \"y\" = $1 * b",
    "}"
   ],
   "expect": {
    "edits": [
     {
      "insert": "a"
     },
     {
      "insert": "a"
     }
    ]
   },
   "input": {
    "newName": "a"
   }
  },
  {
   "name": "a file binding and a function's local don't collide",
   "source": [
    "tariff \"t\"",
    "let a = 1",
    "fn f() -> Int {",
    "  let b| = 2",
    "  return b",
    "}",
    "charge \"x\" = $1 * a * f()"
   ],
   "expect": {
    "edits": [
     {
      "insert": "a"
     },
     {
      "insert": "a"
     }
    ]
   },
   "input": {
    "newName": "a"
   }
  },
  {
   "name": "a variant that would be ambiguous",
   "source": [
    "tariff \"t\"",
    "enum Zone { North, South }",
    "input z: Zone = Nor|th",
    "charge \"x\" = $1",
    "note \"{z}\""
   ],
   "expect": {
    "error": {
     "message": "{0} is also a variant of {1}, so a bare {0} would be ambiguous; pick another name"
    }
   },
   "input": {
    "newName": "Pickup"
   }
  },
  {
   "name": "a field that already exists",
   "source": [
    "tariff \"t\"",
    "type Fee = { amo|unt: Money, floor: Money }",
    "input f: Fee = { amount: $1, floor: $1 }",
    "charge \"x\" = f.amount + f.floor"
   ],
   "expect": {
    "error": {
     "message": "{0} already has a field {1}"
    }
   },
   "input": {
    "newName": "floor"
   }
  },
  {
