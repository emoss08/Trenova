     {
      "range": {
       "text": "rate"
      },
      "insert": "perMile"
     },
     {
      "range": {
       "text": "rate"
      },
      "insert": "perMile"
     },
     {
      "range": {
       "text": "rate"
      },
      "insert": "perMile"
     }
    ]
   },
   "input": {
    "newName": "perMile"
   }
  },
  {
   "name": "new syntax: a choice is renamed by its text",
   "source": [
    "tariff \"t\"",
    "best \"Line|haul\" {",
    "  option \"A\" {",
    "    charge \"A\" = $1",
    "  }",
    "  option \"B\" {",
    "    charge \"B\" = $2",
    "  }",
    "}"
   ],
   "expect": {
    "error": {
     "message": "A choice is named by its label, which is text: edit it between the quotes, and in every `chosen` that names it"
    }
   }
  },
  {
   "name": "new syntax: chosen's label is text",
   "source": [
    "tariff \"t\"",
    "best \"Linehaul\" {",
    "  option \"A\" {",
    "    charge \"A\" = $1",
    "  }",
    "  option \"B\" {",
    "    charge \"B\" = $2",
    "  }",
    "}",
    "test \"t\" {",
    "  expect chosen(\"Line|haul\") == \"A\"",
    "}"
   ],
   "expect": {
    "error": {
     "message": "A choice is named by its label, which is text: edit it between the quotes, and in every `chosen` that names it"
    }
   },
   "input": {
    "newName": "Flat"
   }
  },
  {
   "name": "new syntax: a let inside an option",
   "source": [
    "tariff \"t\"",
    "best \"Linehaul\" {",
    "  option \"A\" {",
    "    let f|ee = $1",
    "    charge \"A\" = fee",
    "  }",
    "  option \"B\" {",
    "    charge \"B\" = $2",
    "  }",
    "}"
   ],
   "expect": {
    "edits": [
     {
      "range": {
       "text": "fee"
      },
      "insert": "flat"
     },
     {
      "range": {
       "text": "fee"
      },
      "insert": "flat"
     }
    ]
   },
   "input": {
    "newName": "flat"
   }
  },
  {
   "name": "prepare refuses the bill",
   "source": [
    "tariff \"t\"",
    "charge \"Linehaul\" = $1",
    "let w = bi|ll.freight",
    "charge \"x\" = w"
   ],
   "expect": {
    "error": {
     "message": "`bill` is the bill so far, so it can't be renamed"
    }
   }
  }
 ]
