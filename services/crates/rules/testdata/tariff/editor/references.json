  {
   "name": "an input from a use: a given and a vary set it, a monotone target reads it",
   "source": [
    "tariff \"t\"",
    "input rate: Money/mi = $2/mi where $1/mi..=$5/mi",
    "charge \"Linehaul\" = ra|te * shipment.distance",
    "test \"t\" {",
    "  given input.rate = $3/mi",
    "  expect total > $0",
    "}",
    "property \"p\" {",
    "  vary input.rate",
    "  expect total nondecreasing in input.rate",
    "}"
   ],
   "expect": {
    "references": [
     {
      "range": {
       "text": "rate"
      },
      "kind": "declaration",
      "module": null
     },
     {
      "range": {
       "text": "rate"
      },
      "kind": "read",
      "module": null
     },
     {
      "range": {
       "text": "rate"
      },
      "kind": "write",
      "module": null
     },
     {
      "range": {
       "text": "rate"
      },
      "kind": "write",
      "module": null
     },
     {
      "range": {
       "text": "rate"
      },
      "kind": "read",
      "module": null
     }
    ]
   }
  },
