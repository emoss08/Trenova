{
 "cases": [
  {
   "name": "a let: its declaration and every read, interpolations included",
   "source": [
    "tariff \"t\"",
    "let mi|les = shipment.distance",
    "charge \"Linehaul\" = $1/mi * miles",
    "note \"{miles} loaded\""
   ],
   "expect": {
    "references": [
     {
      "range": {
       "text": "miles"
      },
      "kind": "declaration",
      "module": null
     },
     {
      "range": {
       "text": "miles"
      },
      "kind": "read",
      "module": null
     },
     {
      "range": {
       "text": "miles"
      },
      "kind": "read",
      "module": null
     }
    ]
   }
  },
  {
   "name": "the ranges are UTF-16 code units of the root file",
   "source": [
    "tariff \"Prix ✓\"",
    "let a = 1",
    "let b = |a + 1",
    "charge \"Rate ✓\" = $1 * b"
   ],
   "expect": {
    "references": [
     {
      "range": {
       "from": 20,
       "to": 21,
       "text": "a"
      },
      "kind": "declaration",
      "module": null
     },
     {
      "range": {
       "from": 34,
       "to": 35,
       "text": "a"
      },
      "kind": "read",
      "module": null
     }
    ]
   }
  },
  {
   "name": "a var: assignments are writes",
   "source": [
    "tariff \"t\"",
    "var to|tal = $0",
    "for stop in shipment.stops {",
    "  total += $5",
    "}",
    "total = total - $1",
    "charge \"Stops\" = total"
   ],
   "expect": {
    "references": [
     {
      "range": {
       "text": "total"
      },
      "kind": "declaration",
      "module": null
     },
     {
      "range": {
       "text": "total"
      },
      "kind": "write",
      "module": null
     },
     {
      "range": {
       "text": "total"
      },
      "kind": "write",
      "module": null
     },
     {
      "range": {
       "text": "total"
      },
      "kind": "read",
      "module": null
     },
     {
      "range": {
       "text": "total"
      },
      "kind": "read",
      "module": null
     }
    ]
   }
