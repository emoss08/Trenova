   "source": [
    "tariff \"t\"",
    "const MAX_WEIGHT = 40_000 lb",
    "input minimumCharge: Money = $450 where $0..",
    "input weight: Weight = 100 lb where ..=MAX_WEIGHT",
    "input share: Percent = 10% where 0%..100%",
    "input pallets: Int = 1 where ..26",
    "charge \"x\" = minimumCharge + $1/lb * weight * share + $1 * pallets"
   ]
