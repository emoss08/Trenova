   "name": "the spec's constraints check and are reported folded",
   "source": [
    "tariff \"t\"",
    "enum Service { Standard, Guaranteed, Expedited }",
    "/// Paid per loaded mile.",
    "input rate: Money/mi = $2.35/mi where $0.50/mi..=$15/mi",
    "input freeStops: Int = 2 where 0..=10",
    "input service: Service = Standard where [Standard, Guaranteed]",
    "charge \"x\" = rate * shipment.distance + $1 * freeStops",
    "note \"{service}\""
   ]
