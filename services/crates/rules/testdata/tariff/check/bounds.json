  {
   "name": "a test's given outside a list constraint, with the nearest as a fix",
   "source": [
    "tariff \"t\"",
    "input service: Text = \"Standard\" where [\"Standard\", \"Guaranteed\"]",
    "input rate: Money/mi = $2/mi where $0.50/mi..=$15/mi",
    "enum Level { Low, Mid, High }",
    "input level: Level = Low where [Low, Mid]",
    "charge \"Linehaul\" (quantity: shipment.distance, rate: rate)",
    "note \"Service {service} at level {level}\"",
    "test \"t\" {",
    "  given input.service = \"Guarenteed\"",
    "  expect total == $0",
    "}"
   ],
   "diagnostics": [
    {
     "at": "\"Guarenteed\"",
     "code": "constraint",
     "fixes": [
      {
       "label": "Change to `\"Guaranteed\"`",
       "result": [
        "tariff \"t\"",
        "input service: Text = \"Standard\" where [\"Standard\", \"Guaranteed\"]",
        "input rate: Money/mi = $2/mi where $0.50/mi..=$15/mi",
        "enum Level { Low, Mid, High }",
        "input level: Level = Low where [Low, Mid]",
        "charge \"Linehaul\" (quantity: shipment.distance, rate: rate)",
        "note \"Service {service} at level {level}\"",
        "test \"t\" {",
        "  given input.service = \"Guaranteed\"",
        "  expect total == $0",
        "}"
       ]
      }
     ],
     "message": "`service` must be one of [Standard, Guaranteed]; Guarenteed isn't, so no contract can set it and this test proves nothing"
    }
   ]
  },
