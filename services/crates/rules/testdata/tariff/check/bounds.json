{
 "cases": [
  {
   "name": "a text input compared with a value outside its list, with the nearest as a fix",
   "source": [
    "tariff \"t\"",
    "input service: Text = \"Standard\" where [\"Standard\", \"Guaranteed\"]",
    "input rate: Money/mi = $2/mi where $0.50/mi..=$15/mi",
    "enum Level { Low, Mid, High }",
    "input level: Level = Low where [Low, Mid]",
    "charge \"Linehaul\" (quantity: shipment.distance, rate: rate)",
    "note \"Service {service} at level {level}\"",
    "if service == \"Guarenteed\" {",
    "  charge \"Guaranteed\" = $150",
    "}"
   ],
   "diagnostics": [
    {
     "at": "service == \"Guarenteed\"",
     "code": "bounds",
     "fixes": [
      {
       "label": "Change to `\"Guaranteed\"`",
       "result": [
        "tariff \"t\"",
        "input service: Text = \"Standard\" where [\"Standard\", \"Guaranteed\"]",
        "input rate: Money/mi = $2/mi where $0.50/mi..=$15/mi",
        "enum Level { Low, Mid, High }",
        "input level: Level = Low where [Low, Mid]",
        "charge \"Linehaul\" (quantity: shipment.distance, rate: rate)",
        "note \"Service {service} at level {level}\"",
        "if service == \"Guaranteed\" {",
        "  charge \"Guaranteed\" = $150",
        "}"
       ]
      }
     ],
     "message": "This is never true: `service` is only ever one of `[\"Standard\", \"Guaranteed\"]`. Did you mean `\"Guaranteed\"`?",
     "severity": "warning"
    }
   ]
  },
