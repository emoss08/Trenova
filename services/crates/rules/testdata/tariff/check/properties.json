  {
   "name": "vary, given and assume come first",
   "source": [
    "tariff \"t\"",
    "input rate: Money/mi = $2/mi where $1/mi..$5/mi",
    "charge \"Linehaul\" = rate * shipment.distance + $1/lb * (shipment.weight ?? 0 lb)",
    "property \"p\" {",
    "  vary shipment.weight in 1 lb..2 lb",
    "  let floor = $0",
    "  assume shipment.hazmat",
    "  expect total > floor",
    "  vary shipment.distance in 1 mi..2 mi",
    "}"
   ],
   "diagnostics": [
    {
     "at": "assume shipment.hazmat",
     "code": "given-order",
     "message": "`assume` comes before the property's other statements: `vary`, `given` and `assume` set up each case before the tariff rates",
     "related": [
      {
       "at": "let floor = $0",
       "line": 6,
       "message": "The first other statement"
      }
     ]
    },
    {
     "at": "vary shipment.distance in 1 mi..2 mi",
     "code": "given-order",
     "message": "`vary` comes before the property's other statements: `vary`, `given` and `assume` set up each case before the tariff rates",
     "related": [
