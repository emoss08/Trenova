{
 "cases": [
  {
   "name": "the reference's properties check",
   "source": [
    "tariff \"t\"",
    "input rate: Money/mi = $2/mi where $1/mi..$5/mi",
    "charge \"Linehaul\" = rate * shipment.distance + $1/lb * (shipment.weight ?? 0 lb)",
    "property \"heavier never bills less\" {",
    "  vary shipment.weight in 1 lb..40_000 lb",
    "  expect total nondecreasing in shipment.weight",
    "}",
    "property \"never below the minimum\" {",
    "  vary shipment.distance in 1 mi..3_000 mi",
    "  vary input.rate",
    "  given fuel.price = $3.20/gal",
    "  expect total >= $450",
    "}"
   ],
   "diagnostics": []
  },
  {
   "name": "a library property varies a new name",
   "source": [
    "library \"l\"",
    "fn double(x: Int) -> Int = x * 2",
    "property \"doubling grows\" {",
    "  vary n in 1..10",
    "  expect double(n) > n",
    "  expect double(n) nondecreasing in n",
    "}"
   ],
   "diagnostics": [],
   "types": {
    "n": "Int"
   }
  },
  {
   "name": "a library varies only names",
   "source": [
    "library \"l\"",
    "fn double(x: Int) -> Int = x * 2",
    "property \"p\" {",
    "  vary shipment.weight in 1 lb..2 lb",
    "  vary n in 1..3",
    "  expect double(n) > 0",
    "}"
   ],
   "diagnostics": [
    {
     "at": "shipment.weight",
     "code": "vary-target",
     "message": "A library has no record or inputs to vary: vary a new name, as in `vary x in 1..10`, and pass it to the functions under test"
    }
   ]
  },
  {
   "name": "a varied name can't shadow an input or the bill",
   "source": [
    "tariff \"t\"",
    "input rate: Money/mi = $2/mi where $1/mi..$5/mi",
    "charge \"Linehaul\" = rate * shipment.distance + $1/lb * (shipment.weight ?? 0 lb)",
    "property \"p\" {",
    "  vary rate in 1..3",
    "  vary total in [1, 2]",
    "  expect rate > 0 and total > 0",
    "}"
   ],
   "diagnostics": [
    {
     "at": "rate",
     "code": "shadow",
     "message": "`rate` is already an input; pick another name",
     "nth": 3
    },
    {
     "at": "total",
     "code": "shadow",
     "message": "`total` is already what a property reads from the bill; pick another name"
    }
   ]
  },
  {
   "name": "a varied name can't shadow a function",
   "source": [
    "library \"l\"",
    "fn double(x: Int) -> Int = x * 2",
    "property \"p\" {",
    "  vary double in 1..3",
    "  expect true",
    "}"
   ],
   "diagnostics": [
    {
     "at": "double",
     "code": "shadow",
     "message": "`double` is already a function; pick another name",
     "nth": 2,
     "related": [
      {
       "at": "double",
       "line": 2,
       "message": "It is declared here"
      }
     ]
    },
    {
     "at": "double",
     "code": "unused",
     "message": "`double` is never used",
     "nth": 2
    }
   ]
  },
  {
   "name": "a varied path resolves like a given",
   "source": [
    "tariff \"t\"",
    "input rate: Money/mi = $2/mi where $1/mi..$5/mi",
    "charge \"Linehaul\" = rate * shipment.distance + $1/lb * (shipment.weight ?? 0 lb)",
    "property \"p\" {",
    "  vary shipment.wieght in 1 lb..2 lb",
    "  vary input.rat in $1/mi..$2/mi",
    "  expect total > $0",
    "}"
   ],
   "diagnostics": [
    {
     "at": "wieght",
     "code": "unknown-field",
     "fixes": [
      {
       "label": "Change to `weight`",
       "result": [
        "tariff \"t\"",
        "input rate: Money/mi = $2/mi where $1/mi..$5/mi",
        "charge \"Linehaul\" = rate * shipment.distance + $1/lb * (shipment.weight ?? 0 lb)",
        "property \"p\" {",
        "  vary shipment.weight in 1 lb..2 lb",
        "  vary input.rat in $1/mi..$2/mi",
        "  expect total > $0",
        "}"
       ]
      }
     ],
     "message": "There is no field `wieght` to set. Did you mean `weight`?"
    },
    {
     "at": "rat",
     "code": "given-target",
     "fixes": [
      {
       "label": "Change to `rate`",
       "result": [
        "tariff \"t\"",
        "input rate: Money/mi = $2/mi where $1/mi..$5/mi",
        "charge \"Linehaul\" = rate * shipment.distance + $1/lb * (shipment.weight ?? 0 lb)",
        "property \"p\" {",
        "  vary shipment.wieght in 1 lb..2 lb",
        "  vary input.rate in $1/mi..$2/mi",
        "  expect total > $0",
        "}"
       ]
      }
     ],
     "message": "This file has no input `rat`. Did you mean `rate`?",
     "nth": 3
    }
   ]
  },
  {
   "name": "a range needs an ordered type",
   "source": [
    "tariff \"t\"",
    "input rate: Money/mi = $2/mi where $1/mi..$5/mi",
    "charge \"Linehaul\" = rate * shipment.distance + $1/lb * (shipment.weight ?? 0 lb)",
    "property \"p\" {",
    "  vary shipment.proNumber in \"A\"..\"B\"",
    "  expect total > $0",
    "}"
   ],
   "diagnostics": [
    {
     "at": "\"A\"..\"B\"",
     "code": "unordered",
     "message": "`shipment.proNumber` is text, which has no next value to step to, so it can't be varied over a range: list its values instead, as in `vary shipment.proNumber in [a, b]`"
    }
   ]
  },
  {
   "name": "a range needs both ends",
