   "name": "input descriptors and defaults",
   "source": [
    "tariff \"t\"",
    "",
    "input minimumCharge: Money = $450",
    "/// Paid per loaded mile.",
    "input rate: Money/mi = $2.35/mi",
    "input fuelPercent: Percent = 18%",
    "input drops: Int = 2",
    "input factor: Number = 1.5",
    "input label: Text = \"Standard\"",
    "input waived: Bool = false",
    "input starts: Date = @2026-10-22",
    "input cutoff: DateTime = @2026-10-22T08:00-05:00",
    "input free: Duration = 2 h",
    "input threshold: Weight = 1 cwt",
    "input density: Weight/Volume = 8 lb/ft3",
    "input mode: RatingMode = Sell",
    "input tolerance: Weight? = none",
    "charge \"x\" = rate * shipment.distance + minimumCharge * fuelPercent + $1 * drops + $1 * factor",
    "note \"{label} {waived} {starts} {cutoff} {free} {threshold} {density} {mode} {tolerance ?? 0 lb}\""
   ]
