{
  "about": "The formula language as the engine runs it. Each case says whether the formula saves (it checks against the shipment schema with these inputs, with no error diagnostic, and comes to an amount) and, where it matters, what it comes to on the corpus shipment. For a refused case, code and from (a UTF-16 offset) name the error diagnostic the checker reports there. The checker's test (tests/formula_conformance.rs) holds the static side to it and the evaluator's tests hold the values.",
  "inputs": [
    { "name": "baseRate", "type": "Number", "defaultValue": 2.5 },
    { "name": "isRush", "type": "Boolean", "defaultValue": false },
    { "name": "laneCode", "type": "String", "defaultValue": "TX-OK" }
  ],
  "cases": [
    {"id": "per-mile", "expression": "baseRate * totalWeight", "accepted": true, "value": "3000"},
    {"id": "flag-in-a-test", "expression": "hasHazmat ? 25 : 0", "accepted": true, "value": "0"},
    {"id": "flag-in-arithmetic", "expression": "hasHazmat * 2", "accepted": false, "code": "type", "from": 0},
    {"id": "text-plus-number", "expression": "\"a\" + 1", "accepted": false, "code": "type", "from": 4},
    {"id": "result-is-a-test", "expression": "totalWeight > 1", "accepted": false, "note": "Rating refuses a true/false amount; saving used to accept it, so the template saved and then failed on every shipment. The engine moved.", "code": "result-type", "from": 0},
    {"id": "result-is-text", "expression": "laneCode", "accepted": false, "code": "result-type", "from": 0},
    {"id": "unknown-name", "expression": "foo + 1", "accepted": false, "code": "unknown-variable", "from": 0},
    {"id": "unknown-name-indented", "expression": "  foo", "accepted": false, "code": "unknown-variable", "from": 2},
    {"id": "unknown-name-on-a-later-line", "expression": "let a = 1;\nfoo + a", "accepted": false, "code": "unknown-variable", "from": 11},
    {"id": "unknown-name-after-a-non-ascii-name", "expression": "let tarifa_año = 1; tarifa_año + bar", "accepted": false, "code": "unknown-variable", "from": 33},
    {"id": "chained-comparison", "expression": "0 < totalWeight <= 5000 ? 1 : 0", "accepted": true, "value": "1"},
    {"id": "chained-comparison-three-way", "expression": "0 < totalWeight < 2000 <= 3000 ? 1 : 0", "accepted": true, "value": "1"},
    {"id": "grouped-comparison-does-not-chain", "expression": "(1 < 2) < 3 ? 1 : 0", "accepted": false, "code": "type", "from": 0},
    {"id": "digit-separators", "expression": "10_000", "accepted": true, "value": "10000"},
    {"id": "hex-octal-binary", "expression": "0x1F + 0o17 + 0b101", "accepted": true, "value": "51"},
    {"id": "number-ending-in-a-dot", "expression": "1. + 2", "accepted": true, "value": "3"},
    {"id": "range-after-an-integer", "expression": "len(1..3)", "accepted": true, "value": "3"},
    {"id": "named-pointer-acc", "expression": "reduce([1, 2, 3], #acc + #, 0)", "accepted": true, "value": "6"},
    {"id": "named-pointer-index", "expression": "len(map([1, 2], #index))", "accepted": true, "value": "2"},
    {"id": "acc-outside-reduce", "expression": "len(map([1], #acc))", "accepted": false, "code": "syntax", "from": 13},
    {"id": "let-in-parentheses", "expression": "(let a = 2; a * 3)", "accepted": true, "value": "6"},
    {"id": "let-in-an-if-block", "expression": "if isRush { let a = 2; a } else { 0 }", "accepted": true, "value": "0"},
    {"id": "let-in-a-predicate", "expression": "len(filter([1, 2, 3], { let x = #; x > 1 }))", "accepted": true, "value": "2"},
    {"id": "let-in-sibling-scopes", "expression": "(let x = 1; x) + (let x = 2; x)", "accepted": true, "value": "3"},
    {"id": "let-redeclared-in-an-inner-scope", "expression": "let x = 1; (let x = 2; x)", "accepted": false, "code": "let-duplicate", "from": 16},
    {"id": "let-in-parentheses-shadowing-a-field", "expression": "(let totalWeight = 1; totalWeight)", "accepted": false, "code": "let-shadows", "from": 5},
    {"id": "optional-index", "expression": "stops?.[0] == nil ? 1 : 0", "accepted": true, "value": "0"},
    {"id": "trailing-comma-in-a-call", "expression": "max(1, 2,)", "accepted": true, "value": "2"},
    {"id": "trailing-comma-in-a-list", "expression": "len([1, 2,])", "accepted": true, "value": "2"},
    {"id": "unicode-identifier", "expression": "let tarifa_año = 2; tarifa_año * baseRate", "accepted": true, "value": "5"},
    {"id": "builtin-reverse", "expression": "len(reverse([1, 2]))", "accepted": true, "value": "2"},
    {"id": "builtin-to-pairs", "expression": "len(toPairs({a: 1}))", "accepted": true, "value": "1"},
    {"id": "builtin-from-pairs", "expression": "len(fromPairs([[\"a\", 1]]))", "accepted": true, "value": "1"},
    {"id": "builtin-bitnot", "expression": "bitnot(1) + 3", "accepted": true, "value": "1"},
    {"id": "disabled-now", "expression": "now().Year()", "accepted": false, "code": "disabled-function", "from": 0},
    {"id": "let-shadows-a-field", "expression": "let totalWeight = 1; totalWeight", "accepted": false, "code": "let-shadows", "from": 4},
    {"id": "let-shadows-an-input", "expression": "let baseRate = 1; baseRate", "accepted": false, "code": "let-shadows", "from": 4},
    {"id": "let-named-after-a-builtin", "expression": "let count = 1; count", "accepted": false, "code": "let-shadows", "from": 4},
    {"id": "let-named-after-a-function", "expression": "let max = 1; max", "accepted": false, "code": "let-shadows", "from": 4},
    {"id": "let-named-after-round", "expression": "let round = 1; round", "accepted": false, "code": "let-shadows", "from": 4},
    {"id": "modulo-on-a-decimal-field", "expression": "totalDistance % 100", "accepted": false, "code": "type", "from": 0},
    {"id": "modulo-on-a-decimal-input", "expression": "baseRate % 2", "accepted": false, "code": "type", "from": 0},
    {"id": "modulo-on-a-quotient", "expression": "10 / 2 % 3", "accepted": false, "code": "type", "from": 0},
    {"id": "modulo-on-a-decimal-literal", "expression": "5.5 % 2", "accepted": false, "code": "type", "from": 0},
    {"id": "modulo-on-a-whole-field", "expression": "totalStops % 2", "accepted": true, "value": "0"},
    {"id": "modulo-on-whole-arithmetic", "expression": "(10 + 2) * 3 % 5", "accepted": true, "value": "1"},
    {"id": "modulo-after-int", "expression": "int(totalWeight) % 7", "accepted": true, "value": "3"},
    {"id": "modulo-on-a-whole-let", "expression": "let x = 10; x % 3", "accepted": true, "value": "1"},
    {"id": "modulo-on-a-length", "expression": "len([1, 2, 3]) % 2", "accepted": true, "value": "1"},
    {"id": "equals-text-and-number", "expression": "status == 1 ? 1 : 0", "accepted": false, "code": "type", "from": 7},
    {"id": "equals-number-and-text", "expression": "totalWeight == \"heavy\" ? 1 : 0", "accepted": false, "code": "type", "from": 12},
    {"id": "equals-flag-and-number", "expression": "hasHazmat == 1 ? 1 : 0", "accepted": false, "code": "type", "from": 10},
    {"id": "equals-literals-of-different-kinds", "expression": "\"a\" == 1 ? 1 : 0", "accepted": false, "code": "type", "from": 4},
    {"id": "equals-relation-field-and-number", "expression": "origin.zip == 75201 ? 1 : 0", "accepted": false, "note": "Relation fields used to reach the engine untyped, so this compiled and was never true, and the editor only warned. Fields are typed now wherever they come from, and comparing text with a number is refused.", "code": "type", "from": 11},
    {"id": "sum-with-a-predicate", "expression": "sum(stops, .weight)", "accepted": false, "code": "type", "from": 11},
    {"id": "sum-with-a-pointer-predicate", "expression": "sum([1, 2], # * 2)", "accepted": false, "code": "type", "from": 12},
    {"id": "sum-over-a-mapped-list", "expression": "sum(map([1, 2], # * 2))", "accepted": true, "value": "6"},
    {"id": "sum-of-values", "expression": "sum(1, 2, 3)", "accepted": true, "value": "6"},
    {"id": "count-with-a-predicate", "expression": "count([1, 2, 3], # > 1)", "accepted": true, "value": "2"},
    {"id": "member-outside-a-predicate", "expression": "len(.weight)", "accepted": false, "code": "syntax", "from": 4},
    {"id": "pointer-outside-a-predicate", "expression": "# + 1", "accepted": false, "code": "syntax", "from": 0},
    {"id": "if-as-an-operand", "expression": "2 + if isRush { 50 } else { 0 }", "accepted": false, "code": "syntax", "from": 4},
    {"id": "if-in-parentheses", "expression": "2 + (if isRush { 50 } else { 0 })", "accepted": true, "value": "2"},
    {"id": "if-as-an-argument", "expression": "max(if isRush { 1 } else { 2 }, 0)", "accepted": true, "value": "2"},
    {"id": "pipe-without-parentheses", "expression": "totalWeight | round", "accepted": false, "code": "syntax", "from": 14},
    {"id": "pipe-with-parentheses", "expression": "totalWeight | round(2)", "accepted": true, "value": "1200"},
    {"id": "date-plus-number", "expression": "ratingTime + 1 > ratingTime ? 1 : 0", "accepted": false, "code": "type", "from": 13},
    {"id": "date-minus-number", "expression": "ratingTime - 1 > ratingTime ? 1 : 0", "accepted": false, "code": "type", "from": 13},
    {"id": "date-plus-duration", "expression": "ratingTime + duration(\"1h\") > ratingTime ? 1 : 0", "accepted": true, "value": "1"},
    {"id": "date-minus-date", "expression": "ratingTime - ratingTime > duration(\"1h\") ? 1 : 0", "accepted": true, "value": "0"},
    {"id": "raw-string-doubled-backtick", "expression": "len(`a``b`)", "accepted": true, "value": "3"},
    {"id": "raw-string-keeps-backslashes", "expression": "len(`a\\n`)", "accepted": true, "value": "3"},
    {"id": "escaped-string", "expression": "len(\"a\\nb\")", "accepted": true, "value": "3"},
    {"id": "exact-decimal-sum", "expression": "0.1 + 0.2 == 0.3 ? 1 : 0", "accepted": true, "value": "1", "note": "Numbers are exact decimals; the old engine's float64 made this 0."},
    {"id": "max-takes-a-list", "expression": "max([1, 2], 3)", "accepted": true, "value": "3", "note": "min and max take lists of numbers, flattened one level, like sum."},
    {"id": "keys-in-key-order", "expression": "keys({b: 1, a: 2})[0] == \"a\" ? 1 : 0", "accepted": true, "value": "1", "note": "Maps iterate in key order."},
    {"id": "divide-by-a-literal-zero", "expression": "totalWeight / 0", "accepted": true, "note": "A literal zero divisor is a warning, not an error; evaluating it is a run-time error."},
    {"id": "nullable-read-is-a-warning", "expression": "weight * 2", "accepted": true, "value": "2400", "note": "Reading a field that can be empty without a guard warns and still saves."},
    {"id": "and-guards-its-right-side", "expression": "weight != nil && weight > 10 ? 1 : 0", "accepted": true, "value": "1"},
    {"id": "discarded-line-is-a-warning", "expression": "1; 2", "accepted": true, "value": "2"},
    {"id": "duration-method", "expression": "(ratingTime - ratingTime).Hours()", "accepted": true, "value": "0"},
    {"id": "date-method", "expression": "ratingTime.Year() > 2000 ? 1 : 0", "accepted": true, "value": "1"},
    {"id": "let-in-a-grouped-call-argument", "expression": "max((let a = 2; a), 1)", "accepted": true, "value": "2"},
    {"id": "nil-is-not-an-amount", "expression": "nil", "accepted": false, "code": "result-type", "from": 0, "note": "The editor used to let an empty result through; the engine refused it."},
    {"id": "empty-if-block", "expression": "if isRush {} else { 0 }", "accepted": false, "code": "syntax", "from": 10, "note": "The editor used to read an empty block as a missing value without a diagnostic; the engine refused it."},
    {"id": "text-function-on-a-number", "expression": "len(upper(5))", "accepted": false, "code": "type", "from": 10, "note": "The editor checked only numeric arguments; the engine refused text functions on numbers."},
    {"id": "field-of-text", "expression": "len(customer.name.first)", "accepted": false, "code": "type", "from": 18, "note": "The editor let any field under a known one through; the engine refused reading a field of text."},
    {"id": "method-on-a-number", "expression": "totalWeight.Year()", "accepted": false, "code": "type", "from": 12},
    {"id": "unknown-date-method", "expression": "ratingTime.Yaer()", "accepted": false, "code": "unknown-function", "from": 11},
    {"id": "removed-to-base64", "expression": "len(toBase64(\"a\"))", "accepted": false, "code": "unknown-function", "from": 4, "note": "toBase64, fromBase64 and timezone are not part of the language."},
    {"id": "removed-timezone", "expression": "len(timezone(\"UTC\"))", "accepted": false, "code": "unknown-function", "from": 4},
    {"id": "date-with-a-layout", "expression": "date(\"2026-01-02\", \"2006-01-02\") > ratingTime ? 1 : 0", "accepted": false, "code": "arity", "from": 4, "note": "date takes the text alone; layouts and time zones are not part of the language."},
    {"id": "bit-function-on-a-fraction", "expression": "bitand(1.5, 1)", "accepted": false, "code": "type", "from": 7},
    {"id": "range-of-fractions", "expression": "len(1.5..3)", "accepted": false, "code": "type", "from": 4},
    {"id": "take-a-fraction", "expression": "len(take([1, 2], 1.5))", "accepted": false, "code": "type", "from": 17},
    {"id": "table-name-not-in-quotes", "expression": "lookup(laneCode, 1)", "accepted": false, "code": "rate-table", "from": 7, "note": "The table name must be a string literal; the editor only warned and the engine failed at run time."},
    {"id": "let-in-a-call-argument", "expression": "max(let a = 2; a, 1)", "accepted": false, "code": "syntax", "from": 4, "note": "A let belongs at the top level, in parentheses, a block or a predicate; the old engine took one in an argument."},
    {"id": "unknown-escape", "expression": "len(\"a\\qb\")", "accepted": false, "code": "syntax", "from": 6, "note": "The editor kept an unknown escape as written; the engine refused it."},
    {"id": "number-too-large", "expression": "100000000000000000000000000000000 > 1 ? 1 : 0", "accepted": false, "code": "syntax", "from": 0, "note": "The editor read any number; the engine refused one past its integer range."},
    {"id": "unknown-field", "expression": "customer.nmae == \"x\" ? 1 : 0", "accepted": false, "code": "unknown-field", "from": 9},
    {"id": "let-before-definition", "expression": "b + 1; let b = 2; b", "accepted": false, "code": "let-before-definition", "from": 0},
    {"id": "ends-on-a-let", "expression": "let a = 1;", "accepted": false, "code": "let-last", "from": 0},
    {"id": "empty-formula", "expression": "  ", "accepted": false, "code": "empty", "from": 0}
  ]
}
