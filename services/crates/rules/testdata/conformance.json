{
  "about": "The formula language as the engine runs it. Each case says whether the engine saves the expression (it compiles against the shipment schema with these inputs and comes to an amount) and, where it matters, what it comes to on the corpus shipment. A Go test in the formula package holds the engine to it, and a vitest in the formula editor holds the editor to it: the editor reports an error exactly where the engine refuses. errorFrom is the UTF-16 offset the engine's message points at.",
  "inputs": [
    { "name": "baseRate", "type": "Number", "defaultValue": 2.5 },
    { "name": "isRush", "type": "Boolean", "defaultValue": false },
    { "name": "laneCode", "type": "String", "defaultValue": "TX-OK" }
  ],
  "cases": [
    { "id": "per-mile", "expression": "baseRate * totalWeight", "accepted": true, "value": "3000" },
    { "id": "flag-in-a-test", "expression": "hasHazmat ? 25 : 0", "accepted": true, "value": "0" },
    { "id": "flag-in-arithmetic", "expression": "hasHazmat * 2", "accepted": false },
    { "id": "text-plus-number", "expression": "\"a\" + 1", "accepted": false },
    {
      "id": "result-is-a-test",
      "expression": "totalWeight > 1",
      "accepted": false,
      "note": "Rating refuses a true/false amount; saving used to accept it, so the template saved and then failed on every shipment. The engine moved."
    },
    { "id": "result-is-text", "expression": "laneCode", "accepted": false },
    {
      "id": "unknown-name",
      "expression": "foo + 1",
      "accepted": false,
      "serverError": "unknown name foo (1:1)",
      "errorFrom": 0
    },
    {
      "id": "unknown-name-indented",
      "expression": "  foo",
      "accepted": false,
      "serverError": "unknown name foo (1:3)",
      "errorFrom": 2
    },
    {
      "id": "unknown-name-on-a-later-line",
      "expression": "let a = 1;\nfoo + a",
      "accepted": false,
      "serverError": "unknown name foo (2:1)",
      "errorFrom": 11
    },
    {
      "id": "unknown-name-after-a-non-ascii-name",
      "expression": "let tarifa_año = 1; tarifa_año + bar",
      "accepted": false,
      "serverError": "unknown name bar (1:34)",
      "errorFrom": 33
    },

    { "id": "chained-comparison", "expression": "0 < totalWeight <= 5000 ? 1 : 0", "accepted": true, "value": "1" },
    { "id": "chained-comparison-three-way", "expression": "0 < totalWeight < 2000 <= 3000 ? 1 : 0", "accepted": true, "value": "1" },
    { "id": "grouped-comparison-does-not-chain", "expression": "(1 < 2) < 3 ? 1 : 0", "accepted": false },

    { "id": "digit-separators", "expression": "10_000", "accepted": true, "value": "10000" },
    { "id": "hex-octal-binary", "expression": "0x1F + 0o17 + 0b101", "accepted": true, "value": "51" },
    { "id": "number-ending-in-a-dot", "expression": "1. + 2", "accepted": true, "value": "3" },
    { "id": "range-after-an-integer", "expression": "len(1..3)", "accepted": true, "value": "3" },

    { "id": "named-pointer-acc", "expression": "reduce([1, 2, 3], #acc + #, 0)", "accepted": true, "value": "6" },
    { "id": "named-pointer-index", "expression": "len(map([1, 2], #index))", "accepted": true, "value": "2" },
    { "id": "acc-outside-reduce", "expression": "len(map([1], #acc))", "accepted": false },

    { "id": "let-in-parentheses", "expression": "(let a = 2; a * 3)", "accepted": true, "value": "6" },
    { "id": "let-in-an-if-block", "expression": "if isRush { let a = 2; a } else { 0 }", "accepted": true, "value": "0" },
    { "id": "let-in-a-predicate", "expression": "len(filter([1, 2, 3], { let x = #; x > 1 }))", "accepted": true, "value": "2" },
    { "id": "let-in-sibling-scopes", "expression": "(let x = 1; x) + (let x = 2; x)", "accepted": true, "value": "3" },
    { "id": "let-redeclared-in-an-inner-scope", "expression": "let x = 1; (let x = 2; x)", "accepted": false },
    { "id": "let-in-parentheses-shadowing-a-field", "expression": "(let totalWeight = 1; totalWeight)", "accepted": false },

    { "id": "optional-index", "expression": "stops?.[0] == nil ? 1 : 0", "accepted": true, "value": "0" },
    { "id": "trailing-comma-in-a-call", "expression": "max(1, 2,)", "accepted": true, "value": "2" },
    { "id": "trailing-comma-in-a-list", "expression": "len([1, 2,])", "accepted": true, "value": "2" },
    { "id": "unicode-identifier", "expression": "let tarifa_año = 2; tarifa_año * baseRate", "accepted": true, "value": "5" },

    { "id": "builtin-reverse", "expression": "len(reverse([1, 2]))", "accepted": true, "value": "2" },
    { "id": "builtin-to-pairs", "expression": "len(toPairs({a: 1}))", "accepted": true, "value": "1" },
    { "id": "builtin-from-pairs", "expression": "len(fromPairs([[\"a\", 1]]))", "accepted": true, "value": "1" },
    { "id": "builtin-bitnot", "expression": "bitnot(1) + 3", "accepted": true, "value": "1" },
    { "id": "disabled-now", "expression": "now().Year()", "accepted": false },

    { "id": "let-shadows-a-field", "expression": "let totalWeight = 1; totalWeight", "accepted": false },
    { "id": "let-shadows-an-input", "expression": "let baseRate = 1; baseRate", "accepted": false },
    { "id": "let-named-after-a-builtin", "expression": "let count = 1; count", "accepted": false },
    { "id": "let-named-after-a-function", "expression": "let max = 1; max", "accepted": false },
    { "id": "let-named-after-round", "expression": "let round = 1; round", "accepted": false },

    { "id": "modulo-on-a-decimal-field", "expression": "totalDistance % 100", "accepted": false },
    { "id": "modulo-on-a-decimal-input", "expression": "baseRate % 2", "accepted": false },
    { "id": "modulo-on-a-quotient", "expression": "10 / 2 % 3", "accepted": false },
    { "id": "modulo-on-a-decimal-literal", "expression": "5.5 % 2", "accepted": false },
    { "id": "modulo-on-a-whole-field", "expression": "totalStops % 2", "accepted": true, "value": "0" },
    { "id": "modulo-on-whole-arithmetic", "expression": "(10 + 2) * 3 % 5", "accepted": true, "value": "1" },
    { "id": "modulo-after-int", "expression": "int(totalWeight) % 7", "accepted": true, "value": "3" },
    { "id": "modulo-on-a-whole-let", "expression": "let x = 10; x % 3", "accepted": true, "value": "1" },
    { "id": "modulo-on-a-length", "expression": "len([1, 2, 3]) % 2", "accepted": true, "value": "1" },

    { "id": "equals-text-and-number", "expression": "status == 1 ? 1 : 0", "accepted": false },
    { "id": "equals-number-and-text", "expression": "totalWeight == \"heavy\" ? 1 : 0", "accepted": false },
    { "id": "equals-flag-and-number", "expression": "hasHazmat == 1 ? 1 : 0", "accepted": false },
    { "id": "equals-literals-of-different-kinds", "expression": "\"a\" == 1 ? 1 : 0", "accepted": false },
    {
      "id": "equals-relation-field-and-number",
      "expression": "origin.zip == 75201 ? 1 : 0",
      "accepted": true,
      "note": "Relation fields reach the engine untyped, so this compiles and is never true; the editor warns rather than refusing."
    },

    { "id": "sum-with-a-predicate", "expression": "sum(stops, .weight)", "accepted": false },
    { "id": "sum-with-a-pointer-predicate", "expression": "sum([1, 2], # * 2)", "accepted": false },
    { "id": "sum-over-a-mapped-list", "expression": "sum(map([1, 2], # * 2))", "accepted": true, "value": "6" },
    { "id": "sum-of-values", "expression": "sum(1, 2, 3)", "accepted": true, "value": "6" },
    { "id": "count-with-a-predicate", "expression": "count([1, 2, 3], # > 1)", "accepted": true, "value": "2" },

    { "id": "member-outside-a-predicate", "expression": "len(.weight)", "accepted": false },
    { "id": "pointer-outside-a-predicate", "expression": "# + 1", "accepted": false },

    { "id": "if-as-an-operand", "expression": "2 + if isRush { 50 } else { 0 }", "accepted": false },
    { "id": "if-in-parentheses", "expression": "2 + (if isRush { 50 } else { 0 })", "accepted": true, "value": "2" },
    { "id": "if-as-an-argument", "expression": "max(if isRush { 1 } else { 2 }, 0)", "accepted": true, "value": "2" },

    { "id": "pipe-without-parentheses", "expression": "totalWeight | round", "accepted": false },
    { "id": "pipe-with-parentheses", "expression": "totalWeight | round(2)", "accepted": true, "value": "1200" },

    { "id": "date-plus-number", "expression": "ratingTime + 1 > ratingTime ? 1 : 0", "accepted": false },
    { "id": "date-minus-number", "expression": "ratingTime - 1 > ratingTime ? 1 : 0", "accepted": false },
    { "id": "date-plus-duration", "expression": "ratingTime + duration(\"1h\") > ratingTime ? 1 : 0", "accepted": true, "value": "1" },
    { "id": "date-minus-date", "expression": "ratingTime - ratingTime > duration(\"1h\") ? 1 : 0", "accepted": true, "value": "0" },

    { "id": "raw-string-doubled-backtick", "expression": "len(`a``b`)", "accepted": true, "value": "3" },
    { "id": "raw-string-keeps-backslashes", "expression": "len(`a\\n`)", "accepted": true, "value": "3" },
    { "id": "escaped-string", "expression": "len(\"a\\nb\")", "accepted": true, "value": "3" }
  ]
}
