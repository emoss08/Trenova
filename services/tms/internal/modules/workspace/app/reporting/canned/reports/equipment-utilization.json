{
  "key": "equipment-utilization",
  "version": "1.0.0",
  "name": "Equipment Assignment History",
  "description": "Assignment counts per tractor with the drivers and trailers it ran with, plus first and last assignment dates",
  "category": "Fleet",
  "tags": [
    "tractors",
    "utilization",
    "assignments"
  ],
  "defaultFormat": "xlsx",
  "definition": {
    "version": 2,
    "entity": "assignment",
    "columns": [
      {
        "id": "unit",
        "label": "Tractor Unit",
        "dimension": {
          "field": "tractor.code"
        }
      },
      {
        "id": "fleet_code",
        "label": "Fleet",
        "dimension": {
          "field": "tractor.fleetCode.code"
        }
      },
      {
        "id": "equipment_type",
        "label": "Equipment Type",
        "dimension": {
          "field": "tractor.equipmentType.code"
        }
      },
      {
        "id": "assignment_count",
        "label": "Assignments",
        "measure": {
          "field": "id",
          "agg": "count"
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "grouping": true
        }
      },
      {
        "id": "driver_count",
        "label": "Drivers Used",
        "measure": {
          "field": "primaryWorker.id",
          "agg": "count_distinct"
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "grouping": true
        }
      },
      {
        "id": "trailer_count",
        "label": "Trailers Pulled",
        "measure": {
          "field": "trailer.id",
          "agg": "count_distinct"
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "grouping": true
        }
      },
      {
        "id": "first_assignment",
        "label": "First Assignment",
        "measure": {
          "field": "createdAt",
          "agg": "min"
        },
        "display": {
          "style": "date",
          "dateStyle": "dateTime"
        }
      },
      {
        "id": "last_assignment",
        "label": "Last Assignment",
        "measure": {
          "field": "createdAt",
          "agg": "max"
        },
        "display": {
          "style": "date",
          "dateStyle": "dateTime"
        }
      }
    ],
    "filters": {
      "and": [
        {
          "field": "createdAt",
          "op": "last_n_days",
          "param": "windowDays"
        },
        {
          "field": "status",
          "op": "not_in",
          "value": [
            "Canceled"
          ]
        }
      ]
    },
    "sort": [
      {
        "column": "assignment_count",
        "desc": true
      }
    ],
    "parameters": [
      {
        "name": "windowDays",
        "label": "Window (days)",
        "type": "int",
        "required": true,
        "default": 30
      }
    ]
  }
}
