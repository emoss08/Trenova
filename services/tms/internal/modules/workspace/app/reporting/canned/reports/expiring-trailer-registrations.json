{
  "key": "expiring-trailer-registrations",
  "version": "1.0.0",
  "name": "Expiring Trailer Registrations",
  "description": "Trailers whose plates expire inside the horizon, with inspection status and fleet assignment",
  "category": "Fleet",
  "tags": [
    "trailers",
    "registrations",
    "compliance"
  ],
  "defaultFormat": "xlsx",
  "definition": {
    "version": 2,
    "entity": "trailer",
    "columns": [
      {
        "id": "unit",
        "label": "Unit Number",
        "dimension": {
          "field": "code"
        }
      },
      {
        "id": "status",
        "label": "Status",
        "dimension": {
          "field": "status"
        }
      },
      {
        "id": "year",
        "label": "Year",
        "dimension": {
          "field": "year"
        }
      },
      {
        "id": "make",
        "label": "Make",
        "dimension": {
          "field": "make"
        }
      },
      {
        "id": "model",
        "label": "Model",
        "dimension": {
          "field": "model"
        }
      },
      {
        "id": "license_plate",
        "label": "License Plate",
        "dimension": {
          "field": "licensePlateNumber"
        },
        "display": {
          "nullText": "—"
        }
      },
      {
        "id": "registration_expiry",
        "label": "Registration Expiry",
        "dimension": {
          "field": "registrationExpiry"
        },
        "display": {
          "style": "date",
          "dateStyle": "date"
        }
      },
      {
        "id": "last_inspection",
        "label": "Last Inspection",
        "dimension": {
          "field": "lastInspectionDate"
        },
        "display": {
          "style": "date",
          "dateStyle": "date"
        }
      },
      {
        "id": "equipment_type",
        "label": "Equipment Type",
        "dimension": {
          "field": "equipmentType.code"
        }
      },
      {
        "id": "fleet_code",
        "label": "Fleet",
        "dimension": {
          "field": "fleetCode.code"
        }
      }
    ],
    "filters": {
      "and": [
        {
          "field": "registrationExpiry",
          "op": "next_n_days",
          "param": "horizonDays"
        }
      ]
    },
    "sort": [
      {
        "column": "registration_expiry"
      }
    ],
    "parameters": [
      {
        "name": "horizonDays",
        "label": "Horizon (days)",
        "type": "int",
        "required": true,
        "default": 60
      }
    ]
  }
}
