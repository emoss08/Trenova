{
  "key": "credential-expiry-forecast",
  "version": "1.0.0",
  "name": "Credential Expiry Forecast",
  "description": "Every tracked credential expiring inside the horizon, from the credential registry rather than the fixed profile columns",
  "category": "Compliance",
  "tags": [
    "workforce",
    "credentials",
    "compliance"
  ],
  "defaultFormat": "xlsx",
  "definition": {
    "version": 2,
    "entity": "worker_credential",
    "columns": [
      {
        "id": "last_name",
        "label": "Last Name",
        "dimension": {
          "field": "worker.lastName"
        }
      },
      {
        "id": "first_name",
        "label": "First Name",
        "dimension": {
          "field": "worker.firstName"
        }
      },
      {
        "id": "fleet_code",
        "label": "Fleet",
        "dimension": {
          "field": "worker.fleetCode.code"
        }
      },
      {
        "id": "credential",
        "label": "Credential",
        "dimension": {
          "field": "credentialType.name"
        }
      },
      {
        "id": "credential_code",
        "label": "Code",
        "dimension": {
          "field": "credentialType.code"
        }
      },
      {
        "id": "required",
        "label": "Required",
        "dimension": {
          "field": "credentialType.isRequired"
        },
        "display": {
          "style": "bool",
          "boolStyle": "yesNo"
        }
      },
      {
        "id": "status",
        "label": "Status",
        "dimension": {
          "field": "status"
        }
      },
      {
        "id": "number",
        "label": "Number",
        "dimension": {
          "field": "number"
        },
        "display": {
          "nullText": "—"
        }
      },
      {
        "id": "issuing_authority",
        "label": "Issuing Authority",
        "dimension": {
          "field": "issuingAuthority"
        }
      },
      {
        "id": "expires_at",
        "label": "Expires",
        "dimension": {
          "field": "expiresAt"
        },
        "display": {
          "style": "date",
          "dateStyle": "date"
        }
      },
      {
        "id": "verified_at",
        "label": "Verified",
        "dimension": {
          "field": "verifiedAt"
        },
        "display": {
          "style": "date",
          "dateStyle": "date"
        }
      }
    ],
    "filters": {
      "and": [
        {
          "field": "status",
          "op": "eq",
          "value": "Active"
        },
        {
          "field": "expiresAt",
          "op": "next_n_days",
          "param": "horizonDays"
        }
      ]
    },
    "sort": [
      {
        "column": "expires_at"
      }
    ],
    "parameters": [
      {
        "name": "horizonDays",
        "label": "Horizon (days)",
        "type": "int",
        "required": true,
        "default": 60
      }
    ]
  }
}
