{
  "key": "watchtower-resolution-reasons",
  "version": "1.0.0",
  "name": "Watchtower Resolution Reasons",
  "description": "Why Watchtower items closed in the window, by kind: resolved by a person, by an agent for a person, or by the source clearing on its own, and the reason given, with how long they took and how many were late",
  "category": "Desk",
  "tags": [
    "desk",
    "watchtower",
    "exceptions",
    "root-cause"
  ],
  "defaultFormat": "xlsx",
  "definition": {
    "version": 2,
    "entity": "resolution",
    "columns": [
      {
        "id": "kind",
        "label": "Kind",
        "dimension": {
          "field": "kind"
        }
      },
      {
        "id": "resolved_via",
        "label": "Resolved Via",
        "dimension": {
          "field": "resolvedVia"
        }
      },
      {
        "id": "reason",
        "label": "Reason",
        "dimension": {
          "field": "resolutionCode"
        }
      },
      {
        "id": "resolved",
        "measure": {
          "field": "id",
          "agg": "count"
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "grouping": true
        },
        "label": "Resolutions"
      },
      {
        "id": "avg_time_to_resolve",
        "label": "Average Time to Resolve",
        "measure": {
          "field": "secondsToResolve",
          "agg": "avg"
        },
        "display": {
          "style": "duration",
          "durationUnit": "seconds",
          "durationStyle": "compact"
        }
      },
      {
        "id": "resolved_late",
        "measure": {
          "field": "id",
          "agg": "count",
          "filter": {
            "field": "pastDue",
            "op": "eq",
            "value": true
          }
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "grouping": true
        },
        "label": "Resolved After Due"
      }
    ],
    "filters": {
      "and": [
        {
          "field": "resolvedAt",
          "op": "last_n_days",
          "param": "windowDays"
        }
      ]
    },
    "groupings": {
      "subtotals": [
        "kind"
      ],
      "total": true
    },
    "sort": [
      {
        "column": "resolved",
        "desc": true
      }
    ],
    "parameters": [
      {
        "name": "windowDays",
        "label": "Window (days)",
        "type": "int",
        "required": true,
        "default": 30
      }
    ]
  }
}
