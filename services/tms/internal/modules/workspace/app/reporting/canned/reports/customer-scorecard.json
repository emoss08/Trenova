{
  "key": "customer-scorecard",
  "version": "1.0.0",
  "name": "Customer Scorecard",
  "description": "Account-level view of volume, revenue quality, freight profile, and first and last shipment dates",
  "category": "Customers",
  "tags": [
    "customers",
    "revenue",
    "scorecard"
  ],
  "defaultFormat": "xlsx",
  "definition": {
    "version": 2,
    "entity": "shipment",
    "columns": [
      {
        "id": "customer",
        "label": "Customer",
        "dimension": {
          "field": "customer.name"
        }
      },
      {
        "id": "customer_code",
        "label": "Customer Code",
        "dimension": {
          "field": "customer.code"
        }
      },
      {
        "id": "shipment_count",
        "label": "Shipments",
        "measure": {
          "field": "id",
          "agg": "count"
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "grouping": true
        }
      },
      {
        "id": "total_revenue",
        "label": "Total Revenue",
        "measure": {
          "field": "totalChargeAmount",
          "agg": "sum"
        },
        "display": {
          "style": "currency",
          "decimals": 2,
          "negative": "parentheses"
        }
      },
      {
        "id": "avg_revenue",
        "label": "Average Revenue per Shipment",
        "measure": {
          "field": "totalChargeAmount",
          "agg": "avg"
        },
        "transform": {
          "op": "round",
          "precision": 2
        },
        "display": {
          "style": "currency",
          "decimals": 2,
          "negative": "parentheses"
        }
      },
      {
        "id": "max_revenue",
        "label": "Largest Shipment",
        "measure": {
          "field": "totalChargeAmount",
          "agg": "max"
        },
        "display": {
          "style": "currency",
          "decimals": 2,
          "negative": "parentheses"
        }
      },
      {
        "id": "total_weight",
        "label": "Total Weight",
        "measure": {
          "field": "weight",
          "agg": "sum"
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "suffix": " lbs"
        }
      },
      {
        "id": "total_miles",
        "label": "Total Miles",
        "measure": {
          "field": "moves.distance",
          "agg": "sum"
        },
        "transform": {
          "op": "round",
          "precision": 0
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "suffix": " mi"
        }
      },
      {
        "id": "first_shipment",
        "label": "First Shipment",
        "measure": {
          "field": "createdAt",
          "agg": "min"
        },
        "display": {
          "style": "date",
          "dateStyle": "dateTime"
        }
      },
      {
        "id": "last_shipment",
        "label": "Last Shipment",
        "measure": {
          "field": "createdAt",
          "agg": "max"
        },
        "display": {
          "style": "date",
          "dateStyle": "dateTime"
        }
      },
      {
        "id": "revenue_per_mile",
        "label": "Revenue per Mile",
        "calc": "[total_revenue] / [total_miles]",
        "transform": {
          "op": "round",
          "precision": 2
        },
        "display": {
          "style": "currency",
          "decimals": 2,
          "negative": "parentheses"
        }
      },
      {
        "id": "avg_weight",
        "label": "Average Weight per Shipment",
        "calc": "[total_weight] / [shipment_count]",
        "transform": {
          "op": "round",
          "precision": 0
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "suffix": " lbs"
        }
      }
    ],
    "filters": {
      "and": [
        {
          "field": "createdAt",
          "op": "last_n_days",
          "param": "windowDays"
        },
        {
          "field": "status",
          "op": "not_in",
          "value": [
            "Canceled"
          ]
        }
      ]
    },
    "sort": [
      {
        "column": "total_revenue",
        "desc": true
      }
    ],
    "parameters": [
      {
        "name": "windowDays",
        "label": "Window (days)",
        "type": "int",
        "required": true,
        "default": 180
      }
    ]
  }
}
