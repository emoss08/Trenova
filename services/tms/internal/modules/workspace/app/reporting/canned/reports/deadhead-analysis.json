{
  "key": "deadhead-analysis",
  "version": "1.0.0",
  "name": "Loaded vs Empty Miles by Fleet",
  "description": "Deadhead exposure by fleet and tractor — loaded miles against empty miles for the selected window",
  "category": "Fleet",
  "tags": [
    "deadhead",
    "miles",
    "assets",
    "utilization"
  ],
  "defaultFormat": "xlsx",
  "definition": {
    "version": 2,
    "entity": "shipment_move",
    "columns": [
      {
        "id": "fleet_code",
        "label": "Fleet",
        "dimension": {
          "field": "assignment.tractor.fleetCode.code"
        }
      },
      {
        "id": "unit",
        "label": "Tractor Unit",
        "dimension": {
          "field": "assignment.tractor.code"
        }
      },
      {
        "id": "move_count",
        "label": "Moves",
        "measure": {
          "field": "id",
          "agg": "count"
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "grouping": true
        }
      },
      {
        "id": "total_miles",
        "label": "Total Miles",
        "measure": {
          "field": "distance",
          "agg": "sum"
        },
        "transform": {
          "op": "round",
          "precision": 0
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "suffix": " mi"
        }
      },
      {
        "id": "split_miles",
        "label": "Miles",
        "measure": {
          "field": "distance",
          "agg": "sum"
        },
        "transform": {
          "op": "round",
          "precision": 0
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "suffix": " mi"
        }
      },
      {
        "id": "avg_miles",
        "label": "Average Miles per Move",
        "measure": {
          "field": "distance",
          "agg": "avg"
        },
        "transform": {
          "op": "round",
          "precision": 1
        },
        "display": {
          "style": "number",
          "decimals": 1,
          "suffix": " mi"
        }
      }
    ],
    "filters": {
      "and": [
        {
          "field": "createdAt",
          "op": "last_n_days",
          "param": "windowDays"
        },
        {
          "field": "status",
          "op": "not_in",
          "value": [
            "Canceled"
          ]
        }
      ]
    },
    "pivot": {
      "field": "loaded",
      "values": [
        "true",
        "false"
      ],
      "labels": [
        "Loaded",
        "Empty"
      ],
      "columns": [
        "split_miles"
      ]
    },
    "sort": [
      {
        "column": "total_miles",
        "desc": true
      }
    ],
    "parameters": [
      {
        "name": "windowDays",
        "label": "Window (days)",
        "type": "int",
        "required": true,
        "default": 30
      }
    ]
  }
}
