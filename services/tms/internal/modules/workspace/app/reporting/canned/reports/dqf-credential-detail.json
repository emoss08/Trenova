{
  "key": "dqf-credential-detail",
  "version": "1.0.0",
  "name": "DQ File Credential Detail",
  "description": "Every credential on file for every driver, with type, requirement, issue and expiry dates and who verified it",
  "category": "Compliance",
  "tags": [
    "drivers",
    "compliance",
    "dq",
    "credentials"
  ],
  "defaultFormat": "xlsx",
  "definition": {
    "version": 2,
    "entity": "worker_credential",
    "columns": [
      {
        "id": "last_name",
        "label": "Last Name",
        "dimension": {
          "field": "worker.lastName"
        }
      },
      {
        "id": "first_name",
        "label": "First Name",
        "dimension": {
          "field": "worker.firstName"
        }
      },
      {
        "id": "fleet_code",
        "label": "Fleet",
        "dimension": {
          "field": "worker.fleetCode.code"
        }
      },
      {
        "id": "credential",
        "label": "Credential",
        "dimension": {
          "field": "credentialType.name"
        }
      },
      {
        "id": "category",
        "label": "Category",
        "dimension": {
          "field": "credentialType.category"
        }
      },
      {
        "id": "required",
        "label": "Required",
        "dimension": {
          "field": "credentialType.isRequired"
        },
        "display": {
          "style": "bool",
          "boolStyle": "yesNo"
        }
      },
      {
        "id": "status",
        "label": "Status",
        "dimension": {
          "field": "status"
        }
      },
      {
        "id": "number",
        "label": "Number",
        "dimension": {
          "field": "number"
        },
        "display": {
          "nullText": "—"
        }
      },
      {
        "id": "issued_at",
        "label": "Issued",
        "dimension": {
          "field": "issuedAt"
        },
        "display": {
          "style": "date",
          "dateStyle": "date"
        }
      },
      {
        "id": "expires_at",
        "label": "Expires",
        "dimension": {
          "field": "expiresAt"
        },
        "display": {
          "style": "date",
          "dateStyle": "date"
        }
      },
      {
        "id": "verified_at",
        "label": "Verified",
        "dimension": {
          "field": "verifiedAt"
        },
        "display": {
          "style": "date",
          "dateStyle": "date"
        }
      }
    ],
    "filters": {
      "and": [
        {
          "field": "status",
          "op": "in",
          "param": "statuses"
        }
      ]
    },
    "sort": [
      {
        "column": "last_name"
      },
      {
        "column": "credential"
      }
    ],
    "parameters": [
      {
        "name": "statuses",
        "label": "Statuses",
        "type": "enum",
        "required": true,
        "multi": true,
        "default": [
          "Active"
        ],
        "allowed": [
          "Active",
          "Inactive"
        ]
      }
    ]
  }
}
