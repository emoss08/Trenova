{
  "key": "expiring-worker-credentials",
  "version": "1.0.0",
  "name": "Expiring Driver Credentials",
  "description": "Any driver credential — CDL, medical card, hazmat, or TWIC — expiring inside the horizon, with fleet and contact routing",
  "category": "Compliance",
  "tags": [
    "drivers",
    "compliance",
    "credentials"
  ],
  "defaultFormat": "xlsx",
  "definition": {
    "version": 2,
    "entity": "worker",
    "columns": [
      {
        "id": "first_name",
        "label": "First Name",
        "dimension": {
          "field": "firstName"
        }
      },
      {
        "id": "last_name",
        "label": "Last Name",
        "dimension": {
          "field": "lastName"
        }
      },
      {
        "id": "status",
        "label": "Status",
        "dimension": {
          "field": "status"
        }
      },
      {
        "id": "driver_type",
        "label": "Driver Type",
        "dimension": {
          "field": "driverType"
        }
      },
      {
        "id": "fleet_code",
        "label": "Fleet",
        "dimension": {
          "field": "fleetCode.code"
        }
      },
      {
        "id": "cdl_class",
        "label": "CDL Class",
        "dimension": {
          "field": "profile.cdlClass"
        }
      },
      {
        "id": "compliance_status",
        "label": "Compliance Status",
        "dimension": {
          "field": "profile.complianceStatus"
        }
      },
      {
        "id": "license_expiry",
        "label": "License Expiry",
        "dimension": {
          "field": "profile.licenseExpiry"
        },
        "display": {
          "style": "date",
          "dateStyle": "date"
        }
      },
      {
        "id": "medical_card_expiry",
        "label": "Medical Card Expiry",
        "dimension": {
          "field": "profile.medicalCardExpiry"
        },
        "display": {
          "style": "date",
          "dateStyle": "date"
        }
      },
      {
        "id": "hazmat_expiry",
        "label": "Hazmat Expiry",
        "dimension": {
          "field": "profile.hazmatExpiry"
        },
        "display": {
          "style": "date",
          "dateStyle": "date"
        }
      },
      {
        "id": "twic_expiry",
        "label": "TWIC Expiry",
        "dimension": {
          "field": "profile.twicExpiry"
        },
        "display": {
          "style": "date",
          "dateStyle": "date"
        }
      },
      {
        "id": "mvr_due",
        "label": "MVR Due",
        "dimension": {
          "field": "profile.mvrDueDate"
        },
        "display": {
          "style": "date",
          "dateStyle": "date"
        }
      }
    ],
    "filters": {
      "and": [
        {
          "field": "status",
          "op": "eq",
          "value": "Active"
        },
        {
          "or": [
            {
              "field": "profile.licenseExpiry",
              "op": "next_n_days",
              "param": "horizonDays"
            },
            {
              "field": "profile.medicalCardExpiry",
              "op": "next_n_days",
              "param": "horizonDays"
            },
            {
              "field": "profile.hazmatExpiry",
              "op": "next_n_days",
              "param": "horizonDays"
            },
            {
              "field": "profile.twicExpiry",
              "op": "next_n_days",
              "param": "horizonDays"
            }
          ]
        }
      ]
    },
    "sort": [
      {
        "column": "license_expiry"
      }
    ],
    "parameters": [
      {
        "name": "horizonDays",
        "label": "Horizon (days)",
        "type": "int",
        "required": true,
        "default": 30
      }
    ]
  }
}
