{
  "key": "trailer-utilization",
  "version": "1.0.0",
  "name": "Trailer Utilization",
  "description": "Turns and miles per trailer with last activity — find trailers sitting idle or over-cycled",
  "category": "Fleet",
  "tags": [
    "trailers",
    "utilization",
    "assets"
  ],
  "defaultFormat": "xlsx",
  "definition": {
    "version": 2,
    "entity": "shipment_move",
    "columns": [
      {
        "id": "unit",
        "label": "Trailer Unit",
        "dimension": {
          "field": "assignment.trailer.code"
        }
      },
      {
        "id": "fleet_code",
        "label": "Fleet",
        "dimension": {
          "field": "assignment.trailer.fleetCode.code"
        }
      },
      {
        "id": "equipment_type",
        "label": "Equipment Type",
        "dimension": {
          "field": "assignment.trailer.equipmentType.code"
        }
      },
      {
        "id": "move_count",
        "label": "Moves",
        "measure": {
          "field": "id",
          "agg": "count"
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "grouping": true
        }
      },
      {
        "id": "total_miles",
        "label": "Total Miles",
        "measure": {
          "field": "distance",
          "agg": "sum"
        },
        "transform": {
          "op": "round",
          "precision": 0
        },
        "display": {
          "style": "number",
          "decimals": 0,
          "suffix": " mi"
        }
      },
      {
        "id": "avg_miles",
        "label": "Average Miles per Move",
        "measure": {
          "field": "distance",
          "agg": "avg"
        },
        "transform": {
          "op": "round",
          "precision": 1
        },
        "display": {
          "style": "number",
          "decimals": 1,
          "suffix": " mi"
        }
      },
      {
        "id": "first_move",
        "label": "First Move",
        "measure": {
          "field": "createdAt",
          "agg": "min"
        },
        "display": {
          "style": "date",
          "dateStyle": "dateTime"
        }
      },
      {
        "id": "last_move",
        "label": "Last Move",
        "measure": {
          "field": "createdAt",
          "agg": "max"
        },
        "display": {
          "style": "date",
          "dateStyle": "dateTime"
        }
      }
    ],
    "filters": {
      "and": [
        {
          "field": "createdAt",
          "op": "last_n_days",
          "param": "windowDays"
        },
        {
          "field": "status",
          "op": "not_in",
          "value": [
            "Canceled"
          ]
        }
      ]
    },
    "sort": [
      {
        "column": "total_miles",
        "desc": true
      }
    ],
    "parameters": [
      {
        "name": "windowDays",
        "label": "Window (days)",
        "type": "int",
        "required": true,
        "default": 30
      }
    ]
  }
}
