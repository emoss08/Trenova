      "operator": false,
      "minArgs": 1,
      "maxArgs": -1,
      "returns": "Any",
      "numericArgs": false,
      "predicate": false
    },
    {
      "name": "clamp",
      "signature": "clamp(value, min, max)",
      "description": "Constrains a value between a minimum and maximum bound.",
