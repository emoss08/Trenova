      "numericArgs": true,
      "predicate": false
    },
    {
      "name": "sqrt",
      "signature": "sqrt(x)",
      "description": "Returns the square root of a non-negative number.",
      "example": "sqrt(16) // 4",
      "category": "math",
      "operator": false,
      "minArgs": 1,
      "maxArgs": 1,
