{
  "schemaId": "shipment",
  "variables": [
    {
      "name": "commodities",
      "type": "array",
      "description": "Every commodity line with its class, dimensions, cube, density, and hazmat flag. Use with map, filter, and sum: sum(map(commodities, .cubicFeet ?? 0)), any(commodities, .freightClass == \"85\")",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "currentTotalCharge",
      "type": "number",
      "description": "The total charge stored on the shipment before this rating ran: 0 on a new shipment, and the previous save's total afterwards. A freight charge formula that reads it prices against its own last result",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "deliveryDate",
      "type": "datetime",
      "description": "The delivery as a date in the delivery location's local time (UTC when the location has no timezone), from the final delivery stop's actual departure, actual arrival, scheduled window end, or scheduled window start; empty when the shipment has no delivery stop",
      "category": "computed",
      "nullable": true,
      "computed": true
    },
    {
      "name": "density",
      "type": "number",
      "description": "Total weight over total cubic feet in pounds per cubic foot; empty when no commodity line has dimensions",
      "category": "computed",
      "nullable": true,
      "computed": true
    },
    {
      "name": "hasHazmat",
      "type": "boolean",
      "description": "Whether any shipment commodity is hazardous material",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "highestFreightClass",
      "type": "string",
      "description": "Numerically highest freight class on the shipment, which governs a mixed LTL shipment without a mixing exception; empty when no line has a class",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "isWeekendPickup",
      "type": "boolean",
      "description": "Whether the pickup falls on a Saturday or Sunday in the pickup location's local time, or UTC when the location has no timezone",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "pickupDate",
      "type": "datetime",
      "description": "The pickup as a date in the pickup location's local time (UTC when the location has no timezone), from the first pickup stop's actual arrival or scheduled window start. Supports date methods such as pickupDate.Hour() and comparisons with date(\"2026-01-01\"); empty when the shipment has no pickup stop",
      "category": "computed",
      "nullable": true,
      "computed": true
    },
    {
      "name": "pickupDayOfWeek",
      "type": "integer",
      "description": "Day of week of the pickup (0 = Sunday through 6 = Saturday) in the pickup location's local time, or UTC when the location has no timezone; from the first stop's actual arrival or scheduled window; 0 when the shipment has no stops",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "pickupHour",
      "type": "integer",
      "description": "Hour of the pickup (0-23) in the pickup location's local time, or UTC when the location has no timezone; from the first stop's actual arrival or scheduled window; 0 when the shipment has no stops",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "pickupMonth",
      "type": "integer",
      "description": "Month of the pickup (1-12) in the pickup location's local time, or UTC when the location has no timezone; 0 when the shipment has no stops",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "primaryFreightClass",
      "type": "string",
      "description": "Freight class of the heaviest commodity line; empty when no line has a class",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "requiresTemperatureControl",
      "type": "boolean",
      "description": "Whether the shipment requires temperature control",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "stops",
      "type": "array",
      "description": "Every stop on the shipment in move and sequence order, with its type, status, window, actuals, and location. Use with map, filter, and sum: count(stops, .type == \"Delivery\"), sum(map(stops, .weight ?? 0))",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "temperatureDifferential",
      "type": "number",
      "description": "Difference between maximum and minimum temperature requirements",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "totalCubicFeet",
      "type": "number",
      "description": "Sum of length × width × height × pieces across commodity lines that have all three dimensions; lines without dimensions add nothing",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "totalDistance",
      "type": "number",
      "description": "Total distance across all moves",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "totalHours",
      "type": "number",
      "description": "Hours from the first stop arrival to the last stop departure, using actual times and falling back to the scheduled windows",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "totalLinearFeet",
      "type": "number",
      "description": "Total linear feet from shipment commodities",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "totalPieces",
      "type": "integer",
      "description": "Total shipment pieces including commodity fallback",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "totalStops",
      "type": "integer",
      "description": "Total number of stops across all moves",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "totalWeight",
      "type": "number",
      "description": "Total shipment weight including commodity fallback",
      "category": "computed",
      "nullable": false,
      "computed": true
    },
    {
      "name": "fuelIndexCode",
      "type": "string",
      "description": "Code of the fuel index behind fuelPrice, such as DOE_US; empty when no index has a price",
      "category": "context",
      "nullable": true,
      "computed": false
    },
    {
      "name": "fuelPrice",
      "type": "number",
      "description": "Latest fuel price per gallon from the organization's freshest active fuel index, supplied at rating time; empty when no index has a price, so guard it with coalesce(fuelPrice, 0) or a fallback lookup",
      "category": "context",
      "nullable": true,
      "computed": false
    },
    {
      "name": "fuelPriceDate",
      "type": "string",
      "description": "Date (YYYY-MM-DD) of the fuel price behind fuelPrice; empty when no index has a price",
      "category": "context",
      "nullable": true,
      "computed": false
    },
    {
      "name": "ratingTime",
      "type": "datetime",
      "description": "The date the contract terms are read at, as a UTC instant: the date the rating asked for, else the actual ship date, else when the shipment was entered. It is fixed for a shipment, so it stands in for \"now\" and re-rating gives the same answer. Supports date methods such as ratingTime.Year() and comparisons with date(\"2026-01-01\")",
      "category": "context",
      "nullable": false,
      "computed": false
    },
    {
      "name": "customer.code",
      "type": "string",
      "description": "Customer code",
      "category": "customer",
      "nullable": false,
      "computed": false
    },
    {
      "name": "customer.name",
      "type": "string",
      "description": "Customer company name",
      "category": "customer",
      "nullable": false,
      "computed": false
    },
    {
