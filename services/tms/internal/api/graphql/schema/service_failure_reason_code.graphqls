enum ServiceFailureReasonCategory {
  Carrier
  Customer
  Facility
  Weather
  Equipment
  Documentation
  Driver
  Shipper
  Consignee
  Appointment
  Other
}

enum ServiceFailureReasonCodeAppliesTo {
  Pickup
  Delivery
  Both
  All
}

type ServiceFailureReasonCode {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  code: String!
  label: String!
  description: String
  category: ServiceFailureReasonCategory!
  appliesTo: ServiceFailureReasonCodeAppliesTo!
  defaultStatusCode: String!
  defaultReasonCode: String!
  defaultExceptionCode: String!
  defaultNote: String!
  active: Boolean!
  sortOrder: Int!
  externalMap: JSON
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  businessUnit: BusinessUnit
  organization: Organization
}

type ServiceFailureReasonCodeEdge {
  node: ServiceFailureReasonCode!
  cursor: String!
}

type ServiceFailureReasonCodeConnection {
  edges: [ServiceFailureReasonCodeEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  serviceFailureReasonCodes(
    input: DataTableConnectionInput!
  ): ServiceFailureReasonCodeConnection!
  serviceFailureReasonCode(id: ID!): ServiceFailureReasonCode
}

input ServiceFailureReasonCodeInput {
  code: String!
  label: String!
  description: String
  category: ServiceFailureReasonCategory!
  appliesTo: ServiceFailureReasonCodeAppliesTo!
  defaultStatusCode: String
  defaultReasonCode: String
  defaultExceptionCode: String
  defaultNote: String
  "Omit on create for an active code; omit on update to leave it as it is."
  active: Boolean
  sortOrder: Int!
  externalMap: JSON
  version: Int
}

extend type Mutation {
  createServiceFailureReasonCode(
    input: ServiceFailureReasonCodeInput!
  ): ServiceFailureReasonCode!
  updateServiceFailureReasonCode(
    id: ID!
    input: ServiceFailureReasonCodeInput!
  ): ServiceFailureReasonCode!
  "Puts an archived reason code back in the list people pick from."
  activateServiceFailureReasonCode(id: ID!): ServiceFailureReasonCode!
  "Takes a reason code out of the list people pick from; failures already coded keep it."
  archiveServiceFailureReasonCode(id: ID!): ServiceFailureReasonCode!
}
