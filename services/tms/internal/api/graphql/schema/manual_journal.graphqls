enum ManualJournalStatus {
  Draft
  PendingApproval
  Approved
  Rejected
  Cancelled
  Posted
}

type ManualJournal {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  requestNumber: String!
  status: ManualJournalStatus!
  description: String!
  reason: String
  accountingDate: Timestamp!
  requestedFiscalYearId: ID!
  requestedFiscalPeriodId: ID!
  currencyCode: String!
  totalDebit: Int!
  totalCredit: Int!
  approvedAt: Timestamp
  approvedById: ID
  rejectedAt: Timestamp
  rejectedById: ID
  rejectionReason: String
  cancelledAt: Timestamp
  cancelledById: ID
  cancelReason: String
  postedBatchId: ID
  createdById: ID
  updatedById: ID
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type ManualJournalEdge {
  node: ManualJournal!
  cursor: String!
}

type ManualJournalConnection {
  edges: [ManualJournalEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type ManualJournalCard {
  journal: ManualJournal!
  lines: [JournalCardLine!]!
  requestedPeriod: FiscalPeriod
  "Where it will post; null once it is posted, rejected or cancelled."
  posting: JournalCardPosting
  createdBy: User
  approvedBy: User
  rejectedBy: User
  cancelledBy: User
  postedBy: User
  postedAt: Timestamp
  "The journal entries it became; empty before it posts or to someone who may not read journal entries."
  entries: [JournalEntry!]!
}

extend type Query {
  manualJournals(input: DataTableConnectionInput!): ManualJournalConnection!
  manualJournal(id: ID!): ManualJournal
  "A manual journal as the Desk card draws it, read in one pass."
  manualJournalCard(id: ID!): ManualJournalCard! @authorizes(resource: "manual_journal") @authorizes(resource: "journal_entry")
}
