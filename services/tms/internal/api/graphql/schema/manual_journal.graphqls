enum ManualJournalStatus {
  Draft
  PendingApproval
  Approved
  Rejected
  Cancelled
  Posted
}

type ManualJournal {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  requestNumber: String!
  status: ManualJournalStatus!
  description: String!
  reason: String
  accountingDate: Timestamp!
  requestedFiscalYearId: ID!
  requestedFiscalPeriodId: ID!
  currencyCode: String!
  totalDebit: Int!
  totalCredit: Int!
  "Whether it has debits and they equal its credits."
  isBalanced: Boolean!
  approvedAt: Timestamp
  approvedById: ID
  rejectedAt: Timestamp
  rejectedById: ID
  rejectionReason: String
  cancelledAt: Timestamp
  cancelledById: ID
  cancelReason: String
  postedBatchId: ID
  createdById: ID
  updatedById: ID
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  "Its lines in order; null in the manualJournals list, read one journal for them."
  lines: [ManualJournalLine!]
}

"One debit or credit line of a manual journal."
type ManualJournalLine {
  id: ID!
  manualJournalRequestId: ID!
  lineNumber: Int!
  glAccountId: ID!
  description: String!
  debitAmount: Int!
  creditAmount: Int!
  customerId: ID
  locationId: ID
  glAccount: JournalEntryLineAccount
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type ManualJournalEdge {
  node: ManualJournal!
  cursor: String!
}

type ManualJournalConnection {
  edges: [ManualJournalEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

type ManualJournalCard @kind(resource: "manual_journal") {
  journal: ManualJournal!
  lines: [JournalCardLine!]!
  requestedPeriod: FiscalPeriod
  "Where it will post; null once it is posted, rejected or cancelled."
  posting: JournalCardPosting
  createdBy: User
  approvedBy: User
  rejectedBy: User
  cancelledBy: User
  postedBy: User
  postedAt: Timestamp
  "The journal entries it became; empty before it posts or to someone who may not read journal entries."
  entries: [JournalEntry!]!
}

extend type Query {
  manualJournals(input: DataTableConnectionInput!): ManualJournalConnection!
  manualJournal(id: ID!): ManualJournal
  "A manual journal as the Desk card draws it, read in one pass."
  manualJournalCard(id: ID!): ManualJournalCard! @authorizes(resource: "manual_journal") @authorizes(resource: "journal_entry")
}

input ManualJournalDraftLineInput {
  "Empty until an account is picked; the draft is refused with the line named."
  glAccountId: ID!
  description: String!
  debitAmount: Int!
  creditAmount: Int!
  customerId: ID
  locationId: ID
}

input ManualJournalDraftInput {
  description: String!
  reason: String
  "The day it books to; null until one is picked, which the draft refuses."
  accountingDate: Timestamp
  currencyCode: String!
  lines: [ManualJournalDraftLineInput!]!
}

extend type Mutation {
  createManualJournalDraft(input: ManualJournalDraftInput!): ManualJournal!
  "Replaces a draft's header and lines."
  updateManualJournalDraft(id: ID!, input: ManualJournalDraftInput!): ManualJournal!
  "Sends a draft for approval."
  submitManualJournal(id: ID!): ManualJournal!
  "The second person's sign-off on a manual journal someone else prepared."
  approveManualJournal(id: ID!): ManualJournal!
  "Posts an approved manual journal to the ledger."
  postManualJournal(id: ID!): ManualJournal!
  "Sends a manual journal back, recording why."
  rejectManualJournal(id: ID!, reason: String!): ManualJournal!
  "Withdraws a manual journal that has not posted, recording why."
  cancelManualJournal(id: ID!, reason: String!): ManualJournal!
}
