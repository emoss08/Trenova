"""
A structured JSON value (object or array). Serialized as-is in the response body.
"""
scalar JSON

"""
A scalar whose runtime type is decided by the field that carries it. Used for
filter values, where the value may be a string, number, boolean, or null.
"""
scalar Any

"""
A point in time as a Unix timestamp: the number of whole seconds since the
Unix epoch (1970-01-01T00:00:00Z), UTC. Serialized as a JSON number.
"""
scalar Timestamp

"""
An arbitrary-precision decimal number serialized as a JSON string, with a dot
as the decimal point and no thousands separators (for example "123.4500").
"""
scalar Decimal

directive @goField(
  forceResolver: Boolean
  name: String
  omittable: Boolean
  type: String
  autoBindGetterHaser: Boolean
  forceGenerate: Boolean
  batch: Boolean
) on INPUT_FIELD_DEFINITION | FIELD_DEFINITION

"""
A set of fields a role must be granted to see, wherever they appear. A reader
without the grant receives null for every field in the set.
"""
enum ProtectedFieldGroup {
  "A worker's date of birth, licence, TWIC and credential numbers, and drug test dates."
  Personal
  "The margin floor and pay ceiling a rate agreement sets against the sell price."
  Margins
}

"""
Withholds the field from a reader whose role does not grant its group. A
protected field is always nullable, and null is what such a reader receives.
"""
directive @protected(group: ProtectedFieldGroup!) on FIELD_DEFINITION

"""
The permission kind a projection type shows, such as the shipment page's
customer. The field guard gates it as that kind: a record carried by another
shows only its kind's reference view unless the reader may read the kind.
"""
directive @kind(resource: String!) on OBJECT

"""
Declares that a root field's resolver checks read on a kind, so the records of
that kind it returns inside a card, summary or overview are its own records,
not linked ones. A test holds each declaration to the resolver's check.
"""
directive @authorizes(resource: String!) repeatable on FIELD_DEFINITION

"""
Declares that an operation selects fields of a linked kind beyond that kind's
reference view. Without the kind's read those fields are answered null and
named in extensions.withheldByAccess. Client codegen requires it on every
operation that selects such a field, and the field must be nullable.
"""
directive @requiresRead(kind: String!) repeatable on QUERY | MUTATION | SUBSCRIPTION

enum EntityStatus {
  Active
  Inactive
}

input FieldFilterInput {
  field: String!
  operator: String!
  value: Any
}

input FilterGroupInput {
  filters: [FieldFilterInput!]!
}

input SortFieldInput {
  field: String!
  direction: String!
}

input DataTableConnectionInput {
  first: Int = 20
  after: String
  query: String
  fieldFilters: [FieldFilterInput!]
  filterGroups: [FilterGroupInput!]
  sort: [SortFieldInput!]
}

type PageInfo {
  hasNextPage: Boolean!
  endCursor: String
}
