enum WorkerCredentialCategory {
  License
  Medical
  Endorsement
  Security
  Certification
  Background
  Other
}

enum WorkerCredentialStatus {
  Active
  Archived
}

"""
Evaluated state of one credential slot. Missing only appears on a summary item
for a required type the worker does not hold.
"""
enum WorkerCredentialHealth {
  Valid
  ExpiringSoon
  Expired
  Missing
}

type WorkerCredentialType {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  code: String!
  name: String!
  description: String
  category: WorkerCredentialCategory!
  status: EntityStatus!
  isRequired: Boolean!
  """
  Driver types this credential is required for. Empty means every worker when
  isRequired is set.
  """
  requiredForDriverTypes: [DriverType!]!
  renewalWindowDays: Int!
  validityMonths: Int
  requiresNumber: Boolean!
  requiresDocument: Boolean!
  """
  Worker-profile column this system type mirrors, when it does.
  """
  profileField: String
  isSystem: Boolean!
  sortOrder: Int!
  activeCredentialCount: Int!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type WorkerCredentialTypeEdge {
  node: WorkerCredentialType!
  cursor: String!
}

type WorkerCredentialTypeConnection {
  edges: [WorkerCredentialTypeEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type WorkerCredentialDocument {
  id: ID!
  fileName: String!
  originalName: String!
  fileType: String!
  fileSize: Int!
  createdAt: Timestamp!
}

type WorkerCredential {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  workerId: ID!
  credentialTypeId: ID!
  credentialType: WorkerCredentialType
  status: WorkerCredentialStatus!
  number: String
  issuingAuthority: String
  issuedAt: Timestamp
  expiresAt: Timestamp
  documentId: ID
  document: WorkerCredentialDocument
  notes: String
  verifiedById: ID
  verifiedBy: User
  verifiedAt: Timestamp
  archivedById: ID
  archivedAt: Timestamp
  archiveReason: String
  health: WorkerCredentialHealth!
  daysUntilExpiry: Int
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  worker: Worker
}

type WorkerCredentialSummaryItem {
  credentialType: WorkerCredentialType!
  credential: WorkerCredential
  health: WorkerCredentialHealth!
  daysUntilExpiry: Int
  required: Boolean!
}

type WorkerCredentialSummary {
  workerId: ID!
  complianceStatus: ComplianceStatus!
  requiredCount: Int!
  validCount: Int!
  expiringCount: Int!
  expiredCount: Int!
  missingCount: Int!
  items: [WorkerCredentialSummaryItem!]!
}

type CredentialExpiryForecastItem {
  credential: WorkerCredential!
  health: WorkerCredentialHealth!
  daysUntilExpiry: Int!
}

type CredentialExpiryForecast {
  horizonDays: Int!
  expiringCount: Int!
  expiredCount: Int!
  items: [CredentialExpiryForecastItem!]!
}

input WorkerCredentialTypeInput {
  code: String!
  name: String!
  description: String
  category: WorkerCredentialCategory!
  status: EntityStatus!
  isRequired: Boolean!
  requiredForDriverTypes: [DriverType!]
  renewalWindowDays: Int!
  validityMonths: Int
  requiresNumber: Boolean!
  requiresDocument: Boolean!
  sortOrder: Int
  version: Int
}

input WorkerCredentialTypesInput {
  first: Int = 20
  after: String
  query: String
  fieldFilters: [FieldFilterInput!]
  filterGroups: [FilterGroupInput!]
  sort: [SortFieldInput!]
  status: EntityStatus
  category: WorkerCredentialCategory
}

input WorkerCredentialInput {
  workerId: ID!
  credentialTypeId: ID!
  number: String
  issuingAuthority: String
  issuedAt: Timestamp
  expiresAt: Timestamp
  documentId: ID
  notes: String
  """
  Archive the worker's current active credential of this type so the new one
  takes its slot. Without it a second active credential of a type is refused.
  """
  renew: Boolean
}

input UpdateWorkerCredentialInput {
  id: ID!
  number: String
  issuingAuthority: String
  issuedAt: Timestamp
  expiresAt: Timestamp
  documentId: ID
  notes: String
  version: Int!
}

input ArchiveWorkerCredentialInput {
  id: ID!
  reason: String
  version: Int
}

input AttachWorkerCredentialDocumentInput {
  id: ID!
  documentId: ID!
}

extend type Query {
  workerCredentialTypes(input: WorkerCredentialTypesInput!): WorkerCredentialTypeConnection!
  workerCredentialType(id: ID!): WorkerCredentialType!
  """
  Active credential types for pickers and the per-worker summary. Seeds the
  system catalog for an organisation that has none.
  """
  activeWorkerCredentialTypes: [WorkerCredentialType!]!
  workerCredentials(workerId: ID!, includeArchived: Boolean = true): [WorkerCredential!]!
  workerCredential(id: ID!): WorkerCredential!
  workerCredentialSummary(workerId: ID!): WorkerCredentialSummary!
  """
  Active credentials expired within the last week or expiring within `days`,
  soonest first.
  """
  credentialExpiryForecast(days: Int = 30, limit: Int = 100): CredentialExpiryForecast!
}

extend type Mutation {
  createWorkerCredentialType(input: WorkerCredentialTypeInput!): WorkerCredentialType!
  updateWorkerCredentialType(id: ID!, input: WorkerCredentialTypeInput!): WorkerCredentialType!
  archiveWorkerCredentialType(id: ID!, version: Int): WorkerCredentialType!
  restoreWorkerCredentialType(id: ID!, version: Int): WorkerCredentialType!
  createWorkerCredential(input: WorkerCredentialInput!): WorkerCredential!
  updateWorkerCredential(input: UpdateWorkerCredentialInput!): WorkerCredential!
  verifyWorkerCredential(id: ID!, version: Int): WorkerCredential!
  archiveWorkerCredential(input: ArchiveWorkerCredentialInput!): WorkerCredential!
  attachWorkerCredentialDocument(input: AttachWorkerCredentialDocumentInput!): WorkerCredential!
}
