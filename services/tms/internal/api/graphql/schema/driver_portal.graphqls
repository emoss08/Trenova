enum PortalInvitationStatus {
  Pending
  Accepted
  Revoked
}

enum SettlementDisputeStatus {
  Open
  InReview
  Resolved
  Denied
  Withdrawn
}

enum SettlementDisputeCategory {
  MissingPay
  IncorrectRate
  IncorrectDeduction
  MissingReimbursement
  Other
}

enum PortalLoadScope {
  Active
  History
}

enum PortalStopAction {
  Arrive
  Depart
}

"""
An invitation for a driver to create a Dash (driver portal) account. The token
itself is never stored or exposed; only its hash is persisted.
"""
type PortalInvitation {
  id: ID!
  organizationId: ID!
  businessUnitId: ID!
  workerId: ID!
  email: String!
  status: PortalInvitationStatus!
  expiresAt: Timestamp!
  invitedById: ID!
  acceptedAt: Timestamp
  acceptedUserId: ID
  createdAt: Timestamp!
  updatedAt: Timestamp!
  invitedBy: User
  worker: Worker
}

"""
Portal access state for one worker: whether they have a linked portal login,
the linked user if so, and their invitation history.
"""
type WorkerPortalStatus {
  linked: Boolean!
  portalUser: User
  pendingInvitation: PortalInvitation
  invitations: [PortalInvitation!]!
}

type InviteWorkerToPortalResult {
  invitation: PortalInvitation!
  """
  Shareable invitation link. Also emailed to the driver when an email provider
  is configured; surface this so dispatch can text it manually if needed.
  """
  inviteUrl: String!
  emailSent: Boolean!
}

"""
A driver-submitted question or challenge against an issued settlement or one of
its lines, tracked through review to resolution or denial.
"""
type SettlementDispute {
  id: ID!
  organizationId: ID!
  businessUnitId: ID!
  settlementId: ID!
  settlementLineId: ID
  workerId: ID!
  status: SettlementDisputeStatus!
  category: SettlementDisputeCategory!
  description: String!
  submittedByUserId: ID!
  resolutionNote: String!
  resolutionLineId: ID
  resolvedById: ID
  resolvedAt: Timestamp
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  settlement: DriverSettlement
  settlementLine: DriverSettlementLine
  worker: Worker
  resolvedBy: User
}

type SettlementDisputeEdge {
  node: SettlementDispute!
  cursor: String!
}

type SettlementDisputeConnection {
  edges: [SettlementDisputeEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

"""
The signed-in driver's profile as shown in Dash.
"""
type PortalProfile {
  workerId: ID!
  firstName: String!
  lastName: String!
  email: String!
  phoneNumber: String!
  workerType: String!
  driverType: String!
  fleetCodeName: String!
  organizationName: String!
}

type PortalStop {
  id: ID!
  type: String!
  status: String!
  sequence: Int!
  locationName: String!
  addressLine: String!
  scheduledWindowStart: Timestamp!
  scheduledWindowEnd: Timestamp
  actualArrival: Timestamp
  actualDeparture: Timestamp
}

"""
A load as the assigned driver sees it: the move, its stops, and the equipment,
without any customer billing or rate detail.
"""
type PortalLoad {
  assignmentId: ID!
  moveId: ID!
  shipmentId: ID!
  proNumber: String!
  bol: String!
  status: String!
  isPrimary: Boolean!
  tractorCode: String!
  trailerCode: String!
  pieces: Int
  weight: Int
  distanceMiles: Float
  """
  What this load pays the signed-in driver, summed across their pay events for
  the move. Null until pay accrues.
  """
  payGrossMinor: Int
  payStatus: String!
  payOnHold: Boolean!
  """
  Driver acknowledgment of the assignment: Pending, Accepted, or Declined.
  """
  ackStatus: String!
  stops: [PortalStop!]!
}

"""
A dispatch note on one of the driver's loads. Only comments explicitly marked
with Driver visibility are ever returned.
"""
type PortalComment {
  id: ID!
  type: String!
  priority: String!
  comment: String!
  authorName: String!
  createdAt: Timestamp!
}

"""
The signed-in driver's qualification-file view: license, medical, and other
FMCSA compliance dates, plus their contact details. Compliance fields are
read-only for drivers — only contact details are self-serviceable.
"""
type PortalComplianceProfile {
  workerId: ID!
  licenseNumber: String!
  licenseState: String!
  cdlClass: String!
  endorsement: String!
  licenseExpiry: Timestamp!
  hazmatExpiry: Timestamp
  medicalCardExpiry: Timestamp
  physicalDueDate: Timestamp
  mvrDueDate: Timestamp
  twicExpiry: Timestamp
  complianceStatus: String!
  isQualified: Boolean!
  hireDate: Timestamp!
  addressLine1: String!
  addressLine2: String!
  city: String!
  stateAbbreviation: String!
  postalCode: String!
  phoneNumber: String!
  emergencyContactName: String!
  emergencyContactPhone: String!
}

input UpdateMyContactInfoInput {
  phoneNumber: String!
  addressLine1: String!
  addressLine2: String
  city: String!
  postalCode: String!
  emergencyContactName: String
  emergencyContactPhone: String
}

"""
Live pay accrued in the driver's current open pay period.
"""
type PortalPeriodSummary {
  periodStart: Timestamp!
  periodEnd: Timestamp!
  payDate: Timestamp!
  accruedGrossMinor: Int!
  eventCount: Int!
}

type PortalEscrowSummary {
  account: EscrowAccount
  transactions: [EscrowTransaction!]!
}

type MySettlementList {
  items: [DriverSettlement!]!
  total: Int!
}

input InviteWorkerToPortalInput {
  workerId: ID!
  """
  Overrides the email on the worker record when provided.
  """
  email: String
}

input CreateMyLoadCommentInput {
  shipmentId: ID!
  comment: String!
}

input RecordMyStopActionInput {
  moveId: ID!
  stopId: ID!
  action: PortalStopAction!
}

input CreateSettlementDisputeInput {
  settlementId: ID!
  settlementLineId: ID
  category: SettlementDisputeCategory!
  description: String!
}

input DisputeAdjustmentInput {
  description: String!
  amountMinor: Int!
  payCodeId: ID
}

input ResolveSettlementDisputeInput {
  disputeId: ID!
  approve: Boolean!
  resolutionNote: String!
  """
  Optional correcting adjustment applied to the driver's open settlement (one is
  generated off-cycle when none exists). Only valid when approving.
  """
  adjustment: DisputeAdjustmentInput
}

enum PortalPtoStatus {
  Requested
  Approved
  Rejected
  Cancelled
}

enum PortalPtoType {
  Personal
  Vacation
  Sick
  Holiday
  Bereavement
  Maternity
  Paternity
}

"""
A driver's time-off request, self-serviced from Dash and approved by the back
office through the existing worker PTO workflow.
"""
type PortalPto {
  id: ID!
  workerId: ID!
  status: PortalPtoStatus!
  type: PortalPtoType!
  startDate: Timestamp!
  endDate: Timestamp!
  reason: String!
  createdAt: Timestamp!
}

input RequestMyPtoInput {
  type: PortalPtoType!
  startDate: Timestamp!
  endDate: Timestamp!
  reason: String!
}

enum DriverExpenseStatus {
  Pending
  Approved
  Rejected
  Reimbursed
  Cancelled
}

"""
A driver-submitted out-of-pocket expense (lumper, tolls, supplies). Approval
immediately applies a reimbursement adjustment to the driver's open settlement.
"""
type DriverExpense {
  id: ID!
  organizationId: ID!
  businessUnitId: ID!
  workerId: ID!
  shipmentId: ID
  payCodeId: ID
  status: DriverExpenseStatus!
  amountMinor: Int!
  currencyCode: String!
  description: String!
  incurredDate: Timestamp!
  receiptDocumentId: ID
  reviewNote: String!
  reviewedById: ID
  reviewedAt: Timestamp
  settlementLineId: ID
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  worker: Worker
  payCode: PayCode
  reviewedBy: User
}

type DriverExpenseEdge {
  node: DriverExpense!
  cursor: String!
}

type DriverExpenseConnection {
  edges: [DriverExpenseEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

input SubmitMyExpenseInput {
  shipmentId: ID
  payCodeId: ID
  amountMinor: Int!
  description: String!
  incurredDate: Timestamp
}

input ReviewDriverExpenseInput {
  expenseId: ID!
  approve: Boolean!
  note: String
}

input RespondToMyAssignmentInput {
  assignmentId: ID!
  accept: Boolean!
  reason: String
}

"""
A read-only estimate of what a load pays the signed-in driver under their
current pay assignment. Nothing is persisted.
"""
type PortalPayEstimate {
  grossMinor: Int!
  currencyCode: String!
}

"""
Org-level feature toggles for the Dash driver portal — what drivers can see
and do. One row per organization, created on first read.
"""
type DashControl {
  id: ID!
  organizationId: ID!
  businessUnitId: ID!
  "Show the accept/decline card when a driver is assigned a load."
  requireLoadAcknowledgment: Boolean!
  "Allow drivers to decline an assigned load (requires acknowledgment)."
  allowLoadRefusals: Boolean!
  "Allow drivers to record their own arrivals and departures at stops."
  allowStopActions: Boolean!
  "Allow POD/BOL photo uploads on loads."
  allowLoadDocumentUpload: Boolean!
  "Allow drivers to send messages on load chat (reading is always allowed)."
  allowLoadComments: Boolean!
  "Show per-load pay amounts and recent pay events in Dash."
  showLoadPay: Boolean!
  "Show estimated pay on loads before pay accrues (requires per-load pay)."
  showPayEstimates: Boolean!
  "Allow drivers to submit out-of-pocket expenses for reimbursement."
  allowExpenseSubmission: Boolean!
  "Block expense approval until a receipt is attached."
  requireExpenseReceipt: Boolean!
  "Allow drivers to dispute settlement statements from Dash."
  allowSettlementDisputes: Boolean!
  "Allow drivers to upload qualification-file documents (CDL, medical card)."
  allowProfileDocumentUpload: Boolean!
  "Allow drivers to edit their own contact details and emergency contact."
  allowContactInfoEdit: Boolean!
  "Allow drivers to request time off from Dash."
  allowPtoRequests: Boolean!
  "Send drivers push reminders as their credentials approach expiry."
  sendCredentialReminders: Boolean!
  "Make a driver's own contact edits wait on the office instead of landing straight on the record."
  requireContactChangeApproval: Boolean!
  """
  How a driver hears about what they owe. Immediate keeps one notice per
  obligation; Daily and Weekly bundle a driver's obligations into a single
  notice instead.
  """
  driverDigestCadence: DriverDigestCadence!
  "Day the weekly digest goes out, 0 = Sunday. Ignored unless the cadence is Weekly."
  driverDigestWeekday: Int!
  "Alert dispatch when a driver dwells at a stop beyond the threshold."
  enableDetentionAlerts: Boolean!
  detentionAlertThresholdMinutes: Int!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

input UpdateDashControlInput {
  version: Int!
  requireLoadAcknowledgment: Boolean!
  allowLoadRefusals: Boolean!
  allowStopActions: Boolean!
  allowLoadDocumentUpload: Boolean!
  allowLoadComments: Boolean!
  showLoadPay: Boolean!
  showPayEstimates: Boolean!
  allowExpenseSubmission: Boolean!
  requireExpenseReceipt: Boolean!
  allowSettlementDisputes: Boolean!
  allowProfileDocumentUpload: Boolean!
  allowContactInfoEdit: Boolean!
  allowPtoRequests: Boolean!
  sendCredentialReminders: Boolean!
  requireContactChangeApproval: Boolean!
  driverDigestCadence: DriverDigestCadence
  driverDigestWeekday: Int
  enableDetentionAlerts: Boolean!
  detentionAlertThresholdMinutes: Int!
}

"""
How a driver hears about what they owe. Immediate is the default so no carrier
silently loses notices they already rely on.
"""
enum DriverDigestCadence {
  Immediate
  Daily
  Weekly
}

"""
One credential slot as the signed-in driver sees it: every required type and
every optional credential they hold, graded against its renewal window.
"""
type PortalCredential {
  """
  Null when the slot is required but the driver holds nothing yet.
  """
  id: ID
  credentialTypeId: ID!
  name: String!
  category: WorkerCredentialCategory!
  health: WorkerCredentialHealth!
  daysUntilExpiry: Int
  expiresAt: Timestamp
  numberMasked: String!
  required: Boolean!
  verified: Boolean!
  requiresDocument: Boolean!
  documentId: ID
}

"""
The signed-in driver's view of what their carrier has enabled in Dash. The
server enforces every one of these — the client uses them only to hide UI.
"""
type PortalFeatures {
  requireLoadAcknowledgment: Boolean!
  allowLoadRefusals: Boolean!
  allowStopActions: Boolean!
  allowLoadDocumentUpload: Boolean!
  allowLoadComments: Boolean!
  showLoadPay: Boolean!
  showPayEstimates: Boolean!
  allowExpenseSubmission: Boolean!
  requireExpenseReceipt: Boolean!
  allowSettlementDisputes: Boolean!
  allowProfileDocumentUpload: Boolean!
  allowContactInfoEdit: Boolean!
  allowPtoRequests: Boolean!
  ptoBalances: Boolean!
  """
  Whether to offer the driver their leave standing. On only once they have a
  leave case: an empty FMLA card reads as an entitlement they are owed rather
  than one they have not started drawing on.
  """
  leaveBalance: Boolean!
  """
  Whether to offer the driver their own rota. On once they are actually on a
  shift: an empty week reads as a roster nobody filled in rather than as a job
  with no fixed pattern, which is what an owner-operator has.
  """
  schedule: Boolean!
  "Follows schedule — a day you are not rostered on is not a day you can offer."
  shiftSwaps: Boolean!
  "Whether a contact edit waits on the office. The app says so before the driver saves."
  requireContactChangeApproval: Boolean!
  "How many policies the driver still has to sign."
  policiesOutstanding: Int!
}

"""
One of the signed-in driver's own leave cases, trimmed to what they may see.
The office's notes and the decision-maker are not part of it.
"""
type PortalLeaveCase {
  id: ID!
  leaveType: WorkerLeaveType!
  status: LeaveCaseStatus!
  frequency: LeaveFrequency!
  fmlaDesignated: Boolean!
  reason: String
  startsAt: Timestamp!
  endsAt: Timestamp
  decidedAt: Timestamp
  certificationStatus: LeaveCertificationStatus!
  certificationDueAt: Timestamp
  certificationLate: Boolean!
  """
  Hours recorded against the case, whether or not they were charged to the
  entitlement — a driver counts the days they were away.
  """
  hoursUsed: Decimal!
  """
  The part of those hours that drew the FMLA entitlement down.
  """
  hoursCharged: Decimal!
}

"""
The signed-in driver's leave standing: the balance and the cases it was drawn
down by, which are only meaningful beside each other.
"""
type PortalLeave {
  entitlement: LeaveEntitlement!
  cases: [PortalLeaveCase!]!
}

"One day of the signed-in driver's own week."
type PortalShiftDay {
  "The day this row describes, as the Unix timestamp of its start."
  date: Timestamp!
  state: RotaDayState!
  scheduled: Boolean!
  startMinute: Int!
  durationMinutes: Int!
  preference: AvailabilityPreference
  assignmentCount: Int!
}

"""
The driver's own rota. It carries their week and nothing about anybody else:
the office board shows the roster, and a driver seeing who else is off is a
personnel matter rather than a scheduling one.
"""
type PortalSchedule {
  weekStart: Timestamp!
  weekEnd: Timestamp!
  shiftName: String
  shiftCode: String
  shiftColor: String
  scheduledDays: Int!
  days: [PortalShiftDay!]!
}

"""
A swap from the driver's own side of it. Outgoing is computed on the server:
which side you are on decides whether the app offers "take it" or "withdraw",
and a client that had to work that out would first have to be told its own
worker id.
"""
type PortalShiftSwap {
  id: ID!
  status: ShiftSwapStatus!
  outgoing: Boolean!
  counterpartyName: String
  "The day being given up."
  shiftDate: Timestamp!
  "The day offered back, when the swap is a trade rather than a hand-off."
  counterpartyShiftDate: Timestamp
  reason: String
  responseNote: String
  respondedAt: Timestamp
  decidedAt: Timestamp
}

"""
A policy from the driver's side: what it is, whether they have signed the
version in force, and what signing it asks of them.
"""
type PortalPolicy {
  id: ID!
  code: String!
  title: String!
  summary: String
  body: String
  hasDocument: Boolean!
  versionLabel: String!
  requiresSignature: Boolean!
  effectiveFrom: Timestamp!
  acknowledgedAt: Timestamp
  signatureName: String
}

input AcknowledgeMyPolicyInput {
  policyId: ID!
  "Typed full name. Required when the policy asks for a signature, and it has to be the name on the record."
  signatureName: String
}

input SetMyAvailabilityInput {
  dayOfWeek: Int!
  preference: AvailabilityPreference!
  note: String
}

input ProposeMyShiftSwapInput {
  counterpartyWorkerId: ID
  "The day being given up."
  shiftDate: Timestamp!
  "The day offered back, when the swap is a trade rather than a hand-off."
  counterpartyShiftDate: Timestamp
  reason: String
}

"""
The driver's own answer to a swap. Approving and rejecting are deliberately
absent: a swap is decided by the office.
"""
enum MyShiftSwapResponse {
  Accepted
  Declined
  Withdrawn
}

input RespondToMyShiftSwapInput {
  id: ID!
  response: MyShiftSwapResponse!
  note: String
}

type MyPTOBalance {
  ptoType: PTOType!
  enforced: Boolean!
  balanceDays: Decimal!
  pendingDays: Decimal!
  availableDays: Decimal!
  accruedYtdDays: Decimal!
  usedYtdDays: Decimal!
  nextAccrual: PlannedPTOAccrual
}

extend type Query {
  """
  Portal access state for a worker (back office).
  """
  workerPortalStatus(workerId: ID!): WorkerPortalStatus!
  """
  Settlement dispute queue (back office).
  """
  settlementDisputes(input: DataTableConnectionInput!): SettlementDisputeConnection!
  settlementDispute(id: ID!): SettlementDispute!
  """
  Count of open or in-review disputes for workspace badges.
  """
  openSettlementDisputeCount: Int!

  """
  The signed-in driver's profile. All my* queries resolve the worker from the
  session user and never accept a worker ID.
  """
  myPortalProfile: PortalProfile!
  myLoads(scope: PortalLoadScope!, limit: Int): [PortalLoad!]!
  """
  The signed-in driver's qualification-file view (license, medical, contact).
  """
  myComplianceProfile: PortalComplianceProfile!
  """
  The signed-in driver's credentials, required slots first.
  """
  myCredentials: [PortalCredential!]!
  """
  Driver-visible dispatch notes for one of the signed-in driver's loads.
  """
  myLoadComments(shipmentId: ID!): [PortalComment!]!
  myPeriodSummary: PortalPeriodSummary!
  myRecentPayEvents(limit: Int): [DriverPayEvent!]!
  mySettlements(limit: Int, offset: Int): MySettlementList!
  mySettlement(id: ID!): DriverSettlement!
  myEscrow: PortalEscrowSummary!
  myAdvances: [PayAdvance!]!
  myDisputes: [SettlementDispute!]!
  """
  Feature toggles for the signed-in driver's carrier.
  """
  myPortalFeatures: PortalFeatures!
  "Every policy in force that binds the signed-in driver, signed or not."
  myPolicies: [PortalPolicy!]!
  "A short-lived link to read a policy's attached document."
  myPolicyDocumentUrl(policyId: ID!): String!
  "What the signed-in driver has asked to change on their record."
  myProfileChangeRequests: [WorkerProfileChangeRequest!]!
  "The signed-in driver's own rota."
  mySchedule(at: Timestamp, weeks: Int): PortalSchedule!
  "What the signed-in driver has said they would rather work."
  myAvailability: [WorkerAvailabilityPreference!]!
  "Every swap the signed-in driver is on either side of."
  myShiftSwaps: [PortalShiftSwap!]!
  myPto: [PortalPto!]!
  myPtoBalances: [MyPTOBalance!]!
  """
  The signed-in driver's own leave standing.
  """
  myLeave: PortalLeave!
  myExpenses: [DriverExpense!]!
  """
  Estimated driver pay for one of the signed-in driver's own moves.
  """
  myLoadPayEstimate(shipmentId: ID!, moveId: ID!): PortalPayEstimate!
  """
  The signed-in driver's year-to-date pay summary.
  """
  myYtdPay(year: Int!): WorkerYTDPaySummary!

  """
  The signed-in driver's live hours-of-service clocks from the carrier's ELD
  provider. Null when the carrier has no telematics integration or the driver
  is not linked to a provider record.
  """
  myHosState: WorkerHosState
  """
  The signed-in driver's ELD daily logs (YYYY-MM-DD range).
  """
  myHosDailyLogs(startDate: String!, endDate: String!): [WorkerHosDailyLog!]!
  """
  The signed-in driver's recent hours-of-service violations.
  """
  myHosViolations(since: Timestamp): [WorkerHosViolation!]!

  """
  The signed-in driver's notification feed. Scoped strictly to notifications
  targeted at the driver; organization-wide (global) notifications are never
  returned.
  """
  myNotifications(
    input: DataTableConnectionInput!
    filter: NotificationFilterInput
  ): NotificationConnection!
  """
  Count of the signed-in driver's unread, personally targeted notifications.
  """
  myNotificationUnreadCount: Int!

  """
  Driver expense review queue (back office).
  """
  driverExpenses(input: DataTableConnectionInput!): DriverExpenseConnection!
  driverExpense(id: ID!): DriverExpense!
  pendingDriverExpenseCount: Int!

  """
  Dash feature toggles for this organization (back office).
  """
  dashControl: DashControl!
}

extend type Mutation {
  """
  Invites a worker to the driver portal (back office).
  """
  inviteWorkerToPortal(input: InviteWorkerToPortalInput!): InviteWorkerToPortalResult!
  """
  Revokes portal access: deactivates the linked login and voids pending invitations.
  """
  revokeWorkerPortalAccess(workerId: ID!): Boolean!

  """
  Updates the signed-in driver's own contact details (phone, address,
  emergency contact). Compliance fields are carrier-controlled.
  """
  updateMyContactInfo(input: UpdateMyContactInfoInput!): PortalComplianceProfile!

  """
  Posts a driver update on one of the signed-in driver's loads. Recorded as a
  DriverUpdate comment with Driver visibility so dispatch sees it on the shipment.
  """
  createMyLoadComment(input: CreateMyLoadCommentInput!): PortalComment!

  """
  Records the signed-in driver's arrival at or departure from a stop on their
  own load. Timestamps are server-side; stop, move, and shipment statuses
  cascade, and pay accrues when the move completes.
  """
  recordMyStopAction(input: RecordMyStopActionInput!): Boolean!

  """
  Files a dispute against one of the signed-in driver's issued settlements.
  """
  createSettlementDispute(input: CreateSettlementDisputeInput!): SettlementDispute!
  """
  Withdraws one of the signed-in driver's own open disputes.
  """
  withdrawSettlementDispute(id: ID!): SettlementDispute!

  """
  Moves an open dispute into review (back office).
  """
  startSettlementDisputeReview(id: ID!): SettlementDispute!
  """
  Resolves or denies a dispute, optionally applying a correcting adjustment (back office).
  """
  resolveSettlementDispute(input: ResolveSettlementDisputeInput!): SettlementDispute!

  """
  Marks all of the signed-in driver's personally targeted notifications as read.
  """
  markAllMyNotificationsRead: Boolean!
  """
  Notification state changes for the signed-in driver. Each only ever touches
  notifications targeted at the driver; organization-wide notifications are
  never affected.
  """
  markMyNotificationsRead(ids: [ID!]!): Boolean!
  markMyNotificationsUnread(ids: [ID!]!): Boolean!
  dismissMyNotifications(ids: [ID!]!): Boolean!
  restoreMyNotifications(ids: [ID!]!): Boolean!

  requestMyPto(input: RequestMyPtoInput!): PortalPto!
  "The signed-in driver signing a policy."
  acknowledgeMyPolicy(input: AcknowledgeMyPolicyInput!): WorkerPolicyAcknowledgement!
  "The signed-in driver taking back a change they asked for."
  withdrawMyProfileChange(id: ID!): WorkerProfileChangeRequest!
  "The signed-in driver stating what they would rather work on one weekday."
  setMyAvailability(input: SetMyAvailabilityInput!): WorkerAvailabilityPreference!
  "The signed-in driver asking a colleague to take a day."
  proposeMyShiftSwap(input: ProposeMyShiftSwapInput!): ShiftSwapRequest!
  "The signed-in driver answering a swap, or withdrawing one they made."
  respondToMyShiftSwap(input: RespondToMyShiftSwapInput!): ShiftSwapRequest!
  cancelMyPto(id: ID!): PortalPto!

  submitMyExpense(input: SubmitMyExpenseInput!): DriverExpense!
  cancelMyExpense(id: ID!): DriverExpense!
  """
  Approves or rejects a driver expense (back office). Approval applies the
  reimbursement to the driver's open settlement immediately.
  """
  reviewDriverExpense(input: ReviewDriverExpenseInput!): DriverExpense!

  """
  Accept or decline one of the signed-in driver's load assignments. Declining
  requires a reason and alerts dispatch.
  """
  respondToMyAssignment(input: RespondToMyAssignmentInput!): Boolean!

  """
  Updates the org's Dash feature toggles (back office).
  """
  updateDashControl(input: UpdateDashControlInput!): DashControl!
}
