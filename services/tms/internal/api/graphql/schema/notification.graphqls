enum NotificationPriority {
  critical
  high
  medium
  low
}

enum NotificationChannel {
  global
  user
  role
}

enum NotificationDeliveryStatus {
  pending
  delivered
  failed
  expired
}

type Notification {
  id: ID!
  organizationId: ID!
  businessUnitId: ID
  targetUserId: ID
  eventType: String!
  priority: NotificationPriority!
  channel: NotificationChannel!
  title: String!
  message: String!
  data: JSON
  relatedEntities: JSON
  actions: JSON
  expiresAt: Timestamp
  deliveredAt: Timestamp
  readAt: Timestamp
  dismissedAt: Timestamp
  createdAt: Timestamp!
  updatedAt: Timestamp!
  deliveryStatus: NotificationDeliveryStatus!
  source: String!
  jobId: String
  correlationId: String
  tags: [String!]
  "Why the person got it: it was theirs, or it went to everyone who could act."
  reason: NotificationReason!
  "How many times the subject came up while this notification was open."
  occurrenceCount: Int!
  "When it shows: now, or later when the person set it aside."
  surfacesAt: Timestamp!
  "Set when the work it pointed at was finished and it cleared itself."
  resolvedAt: Timestamp
  "How it cleared itself, in words."
  resolution: String!
  version: Int!
}

"Why a person got a notification."
enum NotificationReason {
  direct
  team
}

"How many notifications wait in each part of the panel."
type NotificationCounts {
  forYou: Int!
  forYouUnread: Int!
  team: Int!
  teamUnread: Int!
  later: Int!
}

type NotificationEdge {
  node: Notification!
  cursor: String!
}

type NotificationConnection {
  edges: [NotificationEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

"""
A part of the panel. forYou and team split what is open by why the person got it,
later is what they set aside, done is what they finished or what cleared itself, and
open is everything open whatever the reason.
"""
enum NotificationLens {
  forYou
  team
  later
  done
  open
}

input NotificationFilterInput {
  lens: NotificationLens
  unreadOnly: Boolean
}

extend type Query {
  notifications(
    input: DataTableConnectionInput!
    filter: NotificationFilterInput
  ): NotificationConnection!
  notificationCounts: NotificationCounts!
}

extend type Mutation {
  markNotificationsRead(ids: [ID!]!): Boolean!
  markNotificationsUnread(ids: [ID!]!): Boolean!
  dismissNotifications(ids: [ID!]!): Boolean!
  "Marks every open notification in one part of the panel done."
  dismissAllNotifications(lens: NotificationLens!): Boolean!
  restoreNotifications(ids: [ID!]!): Boolean!
  "Sets notifications aside until a time, when they come back unread."
  snoozeNotifications(ids: [ID!]!, until: Timestamp!): Boolean!
  "Brings set-aside notifications back now."
  wakeNotifications(ids: [ID!]!): Boolean!
}
