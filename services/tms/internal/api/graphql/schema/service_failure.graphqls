enum ServiceFailureType {
  LatePickup
  LateDelivery
  MissedPickup
  MissedDelivery
  AppointmentMissed
  Other
}

enum ServiceFailureSource {
  Detected
  Manual
  EDI
  Integration
}

enum ServiceFailureStatus {
  Open
  Reviewed
  Resolved
  Voided
}

type ServiceFailureShipment @kind(resource: "shipment") {
  id: ID!
  proNumber: String!
  bol: String
  customer: Customer
}

type ServiceFailureStop {
  id: ID!
  type: StopType!
  sequence: Int!
  locationId: ID!
  location: Location
}

type ServiceFailure {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  shipmentId: ID!
  shipmentMoveId: ID!
  stopId: ID!
  reasonCodeId: ID
  number: String!
  type: ServiceFailureType!
  source: ServiceFailureSource!
  status: ServiceFailureStatus!
  stopType: StopType!
  scheduledCutoff: Timestamp!
  actualArrival: Timestamp!
  gracePeriodMinutes: Int!
  lateMinutes: Int!
  notes: String!
  """
  Notes kept off the customer-facing record and the EDI 214.
  """
  internalNotes: String!
  """
  Three-character X12 codes that replace the ones derived from the failure type
  when the 214 is built; blank means derive.
  """
  x12StatusCodeOverride: String!
  x12ReasonCodeOverride: String!
  x12ExceptionCode: String!
  detectedAt: Timestamp!
  reviewedAt: Timestamp
  resolvedAt: Timestamp
  voidedAt: Timestamp
  voidReason: String!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  shipment: ServiceFailureShipment
  stop: ServiceFailureStop
  reasonCode: ServiceFailureReasonCode
  """
  Who logged the failure by hand; null for one detected or received.
  """
  createdBy: User
  reviewedBy: User
  resolvedBy: User
  voidedBy: User
}

type ServiceFailureEdge {
  node: ServiceFailure!
  cursor: String!
}

type ServiceFailureConnection {
  edges: [ServiceFailureEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  serviceFailures(
    input: DataTableConnectionInput!
    shipmentId: ID
    "Only failures at a stop made at this location."
    locationId: ID
  ): ServiceFailureConnection!
  serviceFailure(id: ID!): ServiceFailure
}
