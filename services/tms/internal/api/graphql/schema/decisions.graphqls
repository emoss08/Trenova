"""
One thing waiting on a person: a proposal that stands on its own, or a plan
decided as a whole. A plan's steps never appear on their own.
"""
union PendingDecision = AgentProposal | AgentPlan

"Which switch keeps a waiting decision from being taken."
enum PendingDecisionHoldReason {
  "Every agent in the organization is paused on the AI Control overview."
  OrganizationPaused
  "The agent that raised it is in shadow."
  AgentShadow
}

"A switch that keeps a waiting decision from being taken. The server refuses a decision on it until the switch is off."
type PendingDecisionHold {
  reason: PendingDecisionHoldReason!
  "The agent in shadow; empty for the organization's pause."
  agentName: String!
}

type PendingDecisionEdge {
  node: PendingDecision!
  cursor: String!
  hold: PendingDecisionHold @deprecated(reason: "Read hold on the node: AgentProposal.hold or AgentPlan.hold.")
}

type PendingDecisionConnection {
  edges: [PendingDecisionEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

input PendingDecisionsInput {
  first: Int = 25
  after: String
  "Only this agent's work."
  agentDefinitionId: ID
  "Only proposals of this tool; a plan matches when any step uses it."
  toolName: String
}

type PendingDecisionAgentCount {
  agentDefinitionId: ID!
  agentName: String!
  count: Int!
}

type PendingDecisionToolCount {
  "A plan counts under the tool name plan."
  toolName: String!
  count: Int!
}

"The queue in numbers: how much is waiting, from whom, of what, and for how long."
type PendingDecisionSummary {
  total: Int!
  "How many of total a switch keeps from being decided."
  held: Int!
  byAgent: [PendingDecisionAgentCount!]!
  byTool: [PendingDecisionToolCount!]!
  oldestAt: Timestamp
}

input DecideAgentProposalsInput {
  "Accepted or Rejected. A change applies to one proposal, from its own card."
  decision: AgentDecisionType!
  reasonCode: String
  "The digest of the preview shown for each proposal. A digest that no longer matches fails that proposal alone; a proposal without one is recorded as approved unreviewed."
  previewDigests: [AgentProposalPreviewDigestInput!]
  "What the decider tells the agent, recorded on each proposal's decision; at most 2000 characters."
  note: String
}

"What came of deciding one proposal, on its own or in a batch."
type AgentProposalDecisionResult {
  proposalId: ID!
  "The decision recorded; absent when this one could not be decided."
  decision: AgentDecision
  "Why this one could not be decided, its write failed or its approval was refused, written for the person; absent when it went through."
  error: String
  "The approved write ran. False for a rejection and for an approval still in its undo window."
  executed: Boolean!
  """
  The approval was recorded but refused, because the record the change is
  for moved on since it was proposed. Nothing was changed; error says what
  moved, and the conversation that raised it is told.
  """
  refused: Boolean!
}

"A decision on a proposal, with the proposal and the person who made it."
type RecentDecision {
  id: ID!
  decision: AgentDecisionType!
  reasonCode: String!
  "What the decider told the agent; empty when they said nothing."
  note: String!
  decidedByUserId: ID!
  "The decider as the app names them."
  decidedByName: String!
  decidedAt: Timestamp!
  proposal: AgentProposal!
}

extend type AgentProposal {
  "The run that raised this proposal, for the agent behind it."
  run: AgentRun
  "Set while it waits and a switch keeps it from being decided; absent once decided or when a person can decide it now."
  hold: PendingDecisionHold
}

extend type AgentPlan {
  "The run that raised this plan, for the agent behind it."
  run: AgentRun
  "Set while it waits and a switch keeps it from being decided; absent once decided or when a person can decide it now."
  hold: PendingDecisionHold
}

extend type AgentRun {
  "The agent definition behind the run; absent for runs of the retired built-in agents."
  definition: AgentDefinition
  "The agent that handed the run its task, for the run of an agent a conversation's agent asked; absent otherwise, and for an agent deleted since."
  handedBy: AgentDefinition
}

extend type Query {
  "What is waiting on a person, newest first: proposals on their own and plans as one unit."
  pendingDecisions(input: PendingDecisionsInput!): PendingDecisionConnection!
  pendingDecisionSummary: PendingDecisionSummary!
  "What was decided since a moment, newest first: proposals that stood on their own."
  recentDecisions(since: Timestamp!, first: Int = 25): [RecentDecision!]! @authorizes(resource: "agent_proposal")
}

extend type Mutation {
  """
  Decides several proposals of one tool the same way, each as proposed. The
  batch is refused before anything runs when it mixes tools or includes a
  plan's step; once it starts, every proposal is decided in turn and each
  outcome is reported.
  """
  decideAgentProposals(ids: [ID!]!, input: DecideAgentProposalsInput!): [AgentProposalDecisionResult!]!
}
