type JournalEntryLineAccount {
  id: ID!
  accountCode: String!
  name: String!
}

type JournalEntryLine {
  id: ID!
  journalEntryId: ID!
  glAccountId: ID!
  lineNumber: Int!
  description: String!
  debitAmount: Int!
  creditAmount: Int!
  netAmount: Int!
  customerId: ID
  locationId: ID
  glAccount: JournalEntryLineAccount
}

type JournalEntry {
  id: ID!
  organizationId: ID!
  businessUnitId: ID!
  batchId: ID!
  fiscalYearId: ID!
  fiscalPeriodId: ID!
  entryNumber: String!
  "The day the entry was written, which can differ from the day it books to."
  entryDate: Timestamp!
  entryType: String!
  status: String!
  accountingDate: Timestamp!
  description: String!
  referenceType: String!
  referenceId: String!
  totalDebit: Int!
  totalCredit: Int!
  isPosted: Boolean!
  isReversal: Boolean!
  reversalOfId: ID
  reversedById: ID
  reversalDate: Timestamp
  reversalReason: String!
  referenceNumber: String!
  isAutoGenerated: Boolean!
  requiresApproval: Boolean!
  isApproved: Boolean!
  approvedById: ID
  approvedAt: Timestamp
  "What the approver wrote when approving it; empty when nothing was."
  approvalNotes: String!
  rejectedAt: Timestamp
  "Why it was rejected; empty unless it was."
  rejectionReason: String!
  postedById: ID
  postedAt: Timestamp
  createdById: ID
  createdAt: Timestamp!
  version: Int!
  lines: [JournalEntryLine!]
}

type JournalEntryEdge {
  node: JournalEntry!
  cursor: String!
}

type JournalEntryConnection {
  edges: [JournalEntryEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

"How many journal entries wait for a person before they reach the general ledger."
type JournalReviewSummary {
  awaitingApproval: Int!
  readyToPost: Int!
  oldestAccountingDate: Timestamp
  postingMode: String!
  requiresApproval: Boolean!
}

type JournalReviewOutcome {
  entryId: ID!
  entryNumber: String!
  status: String!
  changed: Boolean!
  error: String!
}

type JournalReviewResult {
  outcomes: [JournalReviewOutcome!]!
  changed: Int!
  failed: Int!
}

input JournalReviewInput {
  entryIds: [ID!]!
}

type JournalSourceInfo {
  id: ID!
  sourceObjectType: String!
  sourceObjectId: String!
  sourceEventType: String!
  sourceDocumentNumber: String!
  status: String!
  "The number of the batch the source's entries were written in, when it could be read."
  batchNumber: String
}

"One line of a journal as the Desk card draws it: the account it books to and the side of the accounting equation that account sits on."
type JournalCardLine {
  lineNumber: Int!
  glAccountId: ID!
  accountCode: String!
  accountName: String!
  "Null when the account or its type could not be read."
  category: AccountCategory
  description: String!
  debitAmount: Int!
  creditAmount: Int!
  "Null when the line names no customer or the reader may not read customers."
  customerId: ID
  customerName: String!
  "Null when the line names no location or the reader may not read locations."
  locationId: ID
  locationName: String!
  "Whether the line has been reconciled. A manual journal's lines never are: they reconcile once posted, as journal entry lines."
  isReconciled: Boolean!
}

"Where a journal not yet posted would land if it posted now, under the organization's closed-period policy."
type JournalCardPosting {
  "Null when it cannot post as things stand."
  period: FiscalPeriod
  accountingDate: Timestamp
  "Why it cannot post as things stand; empty when it can."
  refusal: String!
}

type JournalEntryCard @kind(resource: "journal_entry") {
  entry: JournalEntry!
  lines: [JournalCardLine!]!
  period: FiscalPeriod
  "Where it will post; null once it is posted, reversed, rejected or void."
  posting: JournalCardPosting
  source: JournalSourceInfo
  createdBy: User
  approvedBy: User
  postedBy: User
  rejectedBy: User
  "The entry this one reverses."
  reversalOf: JournalEntry
  "The entry that reversed this one."
  reversedBy: JournalEntry
  "The reversal request that stands against this entry or made it; null to someone who may not read journal reversals."
  reversal: JournalReversal
  reversalRequestedBy: User
}

extend type Query {
  journalEntry(id: ID!): JournalEntry
  "Every journal entry in the general ledger, whatever its status, newest accounting date first."
  journalEntries(input: DataTableConnectionInput!): JournalEntryConnection!
  journalEntriesBySource(sourceType: String!, sourceId: String!): [JournalEntry!]!
  journalSourceByObject(sourceType: String!, sourceId: String!): JournalSourceInfo
  "Journal entries waiting to be approved or posted, oldest first."
  journalReviewTable(input: DataTableConnectionInput!): JournalEntryConnection!
  journalReviewSummary: JournalReviewSummary!
  "A journal entry as the Desk card draws it, read in one pass."
  journalEntryCard(id: ID!): JournalEntryCard! @authorizes(resource: "journal_entry") @authorizes(resource: "journal_reversal")
}

extend type Mutation {
  "Approve journal entries awaiting approval. Each entry is decided on its own."
  approveJournalEntries(input: JournalReviewInput!): JournalReviewResult!
  "Post approved journal entries to the general ledger. Each entry is decided on its own."
  postJournalEntries(input: JournalReviewInput!): JournalReviewResult!
}
