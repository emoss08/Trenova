enum HoldType {
  OperationalHold
  ComplianceHold
  CustomerHold
  FinanceHold
}

enum HoldSeverity {
  Informational
  Advisory
  Blocking
}

type HoldReason {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  type: HoldType!
  code: String!
  label: String!
  description: String!
  active: Boolean!
  defaultSeverity: HoldSeverity!
  defaultBlocksDispatch: Boolean!
  defaultBlocksDelivery: Boolean!
  defaultBlocksBilling: Boolean!
  defaultVisibleToCustomer: Boolean!
  sortOrder: Int!
  externalMap: JSON
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  businessUnit: BusinessUnit
  organization: Organization
}

type HoldReasonEdge {
  node: HoldReason!
  cursor: String!
}

type HoldReasonConnection {
  edges: [HoldReasonEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  holdReasons(input: DataTableConnectionInput!): HoldReasonConnection!
  holdReason(id: ID!): HoldReason
}

input HoldReasonInput {
  type: HoldType!
  code: String!
  label: String!
  description: String
  active: Boolean!
  defaultSeverity: HoldSeverity!
  defaultBlocksDispatch: Boolean!
  defaultBlocksDelivery: Boolean!
  defaultBlocksBilling: Boolean!
  defaultVisibleToCustomer: Boolean!
  sortOrder: Int!
  "Codes this reason maps to in other systems, keyed by system."
  externalMap: JSON
  version: Int
}

extend type Mutation {
  createHoldReason(input: HoldReasonInput!): HoldReason!
  updateHoldReason(id: ID!, input: HoldReasonInput!): HoldReason!
}
