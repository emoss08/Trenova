  hazmatClass: String
  minTemp: Int
  maxTemp: Int
  loadingInstructions: String
  estimatedLength: Boolean!
  stopNumber: Int
}

type ShipmentHazmatZone {
  commodityAId: ID!
  commodityBId: ID!
  commodityAName: String!
  commodityBName: String!
  ruleName: String!
  segregationType: String!
  requiredDistanceFeet: Float
  actualDistanceFeet: Float!
  satisfied: Boolean!
}

type ShipmentLoadingWarning {
  type: String!
  message: String!
  severity: String!
  commodityIds: [String!]
}

type ShipmentAxleWeight {
  axle: String!
  weight: Int!
  limit: Int!
  percentage: Float!
  compliant: Boolean!
}

type ShipmentLoadingRecommendation {
  type: String!
  priority: String!
  title: String!
  description: String!
  impact: String
  commodityIds: [String!]
}

type ShipmentStopDivider {
  positionFeet: Float!
  stopNumber: Int!
  label: String!
}

type ShipmentLoadingOptimizationResponse {
  trailerLengthFeet: Float!
  totalLinearFeet: Float!
  totalWeight: Int!
  maxWeight: Int!
  linearFeetUtil: Float!
  weightUtil: Float!
  utilizationScore: Int!
  utilizationGrade: String!
  placements: [ShipmentLoadingCommodity!]!
  hazmatZones: [ShipmentHazmatZone!]!
  warnings: [ShipmentLoadingWarning!]!
  axleWeights: [ShipmentAxleWeight!]!
  recommendations: [ShipmentLoadingRecommendation!]!
  stopDividers: [ShipmentStopDivider!]
  aiAnalysis: String
}

input ShipmentInput {
  sourceDocumentId: String
  serviceTypeId: ID!
  shipmentTypeId: ID!
  customerId: ID!
  tractorTypeId: ID
  trailerTypeId: ID
  ownerId: ID
  enteredById: ID
  canceledById: ID
  formulaTemplateId: ID!
  consolidationGroupId: ID
  orderId: ID
  status: ShipmentStatus = New
  tenderStatus: ShipmentTenderStatus
  entryMethod: ShipmentEntryMethod = Manual
  proNumber: String
  bol: String
  cancelReason: String
  otherChargeAmount: String = "0"
  freightChargeAmount: String = "0"
  baseRate: String = "0"
  totalChargeAmount: String = "0"
  pieces: Int
  weight: Int
  temperatureMin: Int
  temperatureMax: Int
  actualDeliveryDate: Int
  actualShipDate: Int
  canceledAt: Int
  billingTransferStatus: String
  transferredToBillingAt: Int
  markedReadyToBillAt: Int
  billedAt: Int
  ratingUnit: Int = 1
  fuelSurchargeLocked: Boolean = false
  """
  Why this shipment is billed at something other than its contract rate. It is
  the only rating field a caller may write: everything else the rater owns is
  an ordinary field, and everything else the system owns is restored on save.
  """
  rateOverrideReason: String
  version: Int
  moves: [ShipmentMoveInput!] = []
  additionalCharges: [ShipmentAdditionalChargeInput!] = []
  commodities: [ShipmentCommodityInput!] = []
}

input ShipmentMoveInput {
  id: ID
  shipmentId: ID
  status: MoveStatus = New
  loaded: Boolean = true
  sequence: Int = 0
  distance: Float
  distanceSource: String
  distanceProvider: String
  distanceCalculatedAt: Int
  distanceRouteSignature: String
  distanceDataVersion: String
  distanceRoutingType: String
  distanceUnits: String
  distanceMetadata: JSON
  version: Int
  stops: [ShipmentStopInput!] = []
}

input ShipmentStopInput {
  id: ID
  shipmentMoveId: ID
  locationId: ID!
  status: StopStatus = New
  type: StopType = Pickup
  scheduleType: StopScheduleType = Open
  sequence: Int = 0
  pieces: Int
  weight: Int
  scheduledWindowStart: Int = 0
  scheduledWindowEnd: Int
  actualArrival: Int
  actualDeparture: Int
  countLateOverride: Boolean
  countDetentionOverride: Boolean
  addressLine: String
  version: Int
}

input ShipmentAdditionalChargeInput {
  id: ID
  shipmentId: ID
  accessorialChargeId: ID!
  isSystemGenerated: Boolean = false
  method: String = "Flat"
  amount: String = "0"
  unit: Int = 1
  fuelSurchargeProgramId: ID
  detentionOccurrenceId: ID
  version: Int
}

input ShipmentCommodityInput {
  id: ID
  shipmentId: ID
  commodityId: ID!
  pieces: Int = 1
  weight: Int = 0
  lengthFeet: Float
  widthFeet: Float
  heightFeet: Float
  version: Int
}

input ShipmentDuplicateInput {
  shipmentId: ID!
  count: Int = 1
  overrideDates: Boolean = false
}

input ShipmentCancelInput {
  cancelReason: String
}

input ShipmentTransferOwnershipInput {
  ownerId: ID!
}

input ShipmentDuplicateBolInput {
  bol: String!
  shipmentId: ID
}

input ShipmentHazmatInput {
  commodityIds: [ID!]!
}

input ShipmentPreviousRatesInput {
  originLocationId: ID!
  destinationLocationId: ID!
  shipmentTypeId: ID!
  serviceTypeId: ID!
  customerId: ID
  excludeShipmentId: ID
}

input ShipmentLoadingCommodityInput {
  commodityId: ID!
  pieces: Int!
  weight: Int!
}

input ShipmentLoadingStopInput {
  sequence: Int!
  locationName: String!
  locationCity: String!
}

input ShipmentLoadingOptimizationInput {
  commodities: [ShipmentLoadingCommodityInput!]!
  equipmentTypeId: ID
  stops: [ShipmentLoadingStopInput!]
}

input ShipmentTransferToBillingInput {
  shipmentId: ID!
  billType: BillType = Invoice
}

input ShipmentBulkTransferToBillingInput {
  shipmentIds: [ID!]!
  billType: BillType = Invoice
}

input ShipmentCommentInput {
  comment: String!
  "Structured comment body (comment body v1). When present, the plain-text comment is derived server-side."
  body: JSON
  parentCommentId: ID
  mentionedUserIds: [ID!] = []
  attachmentDocumentIds: [ID!] = []
  type: ShipmentCommentType = Internal
  visibility: ShipmentCommentVisibility = Internal
  priority: ShipmentCommentPriority = Normal
  requiresAcknowledgment: Boolean
  "Client-generated reference echoed on the created entity for optimistic-update reconciliation."
  clientRef: String
}

input ShipmentCommentUpdateInput {
  id: ID!
  comment: String!
  "Structured comment body (comment body v1). When present, the plain-text comment is derived server-side."
  body: JSON
  mentionedUserIds: [ID!] = []
  attachmentDocumentIds: [ID!] = []
  type: ShipmentCommentType = Internal
  visibility: ShipmentCommentVisibility = Internal
  priority: ShipmentCommentPriority = Normal
  requiresAcknowledgment: Boolean
  version: Int!
}

input ShipmentCommentsFilterInput {
  types: [ShipmentCommentType!]
  priorities: [ShipmentCommentPriority!]
  authorIds: [ID!]
  mentionsUserId: ID
  pinnedOnly: Boolean = false
  unresolvedOnly: Boolean = false
  search: String
}

input ShipmentsInput {
  first: Int = 20
  after: String
  query: String
  fieldFilters: [FieldFilterInput!]
  filterGroups: [FilterGroupInput!]
  sort: [SortFieldInput!]
  expandShipmentDetails: Boolean = false
  status: String
  activityWindowStart: Int
  activityWindowEnd: Int
}

input ShipmentEventsInput {
  shipmentId: ID
  types: [ShipmentEventType!]
  limit: Int
  before: Int
}

input ShipmentAnalyticsInput {
  startDate: Int
  endDate: Int
  limit: Int
  offset: Int
  timezone: String
  windowDays: Int
  include: String
}

extend type Query {
  shipments(input: ShipmentsInput!): ShipmentConnection!
  shipment(id: ID!, expandShipmentDetails: Boolean = false, status: String): Shipment
  unassignedShipments(first: Int = 20, after: String): ShipmentConnection!
  shipmentComments(shipmentId: ID!, first: Int = 20, after: String, filter: ShipmentCommentsFilterInput): ShipmentCommentConnection!
  shipmentCommentReplies(shipmentId: ID!, commentId: ID!, first: Int = 20, after: String): ShipmentCommentConnection!
  shipmentCommentCount(shipmentId: ID!): ShipmentCommentCountResponse!
  shipmentUIPolicy: ShipmentUIPolicy!
  shipmentBillingReadiness(shipmentId: ID!): ShipmentBillingReadiness!
  shipmentEvents(input: ShipmentEventsInput!): [ShipmentEvent!]!
  shipmentAnalytics(input: ShipmentAnalyticsInput!): ShipmentAnalytics!
  shipmentPreviousRates(input: ShipmentPreviousRatesInput!): ShipmentPreviousRatesResponse!
}

extend type Mutation {
  createShipment(input: ShipmentInput!): Shipment!
  updateShipment(id: ID!, input: ShipmentInput!): Shipment!
  cancelShipment(id: ID!, input: ShipmentCancelInput): Shipment!
  uncancelShipment(id: ID!): Shipment!
  duplicateShipment(input: ShipmentDuplicateInput!): ShipmentDuplicateResponse!
  transferShipmentOwnership(id: ID!, input: ShipmentTransferOwnershipInput!): Shipment!
  transferShipmentToBilling(input: ShipmentTransferToBillingInput!): BillingQueueItem!
  bulkTransferShipmentsToBilling(input: ShipmentBulkTransferToBillingInput!): ShipmentBulkTransferToBillingResponse!
  calculateShipmentTotals(input: ShipmentInput!): ShipmentTotalsResponse!
  """
  Asks the rate agreements what they would charge for a shipment, without
  writing anything. This is what the billing panel offers before anyone commits
  to a contract rate.
  """
  previewShipmentContractRate(input: ShipmentInput!): ShipmentContractRate!
  """
  Prices a saved shipment from its contract again, overwriting its rating
  method, base rate and contract accessorials.
  """
  autoRateShipment(id: ID!): ShipmentAutoRateResponse!
  calculateShipmentDistance(input: ShipmentInput!): ShipmentDistanceResponse!
  recalculateShipmentDistance(shipmentId: ID!): ShipmentDistanceResponse!
  checkShipmentDuplicateBol(input: ShipmentDuplicateBolInput!): ShipmentValidationResponse!
  checkShipmentHazmatSegregation(input: ShipmentHazmatInput!): ShipmentValidationResponse!
  calculateShipmentLoadingOptimization(input: ShipmentLoadingOptimizationInput!): ShipmentLoadingOptimizationResponse!
  createShipmentComment(shipmentId: ID!, input: ShipmentCommentInput!): ShipmentComment!
  updateShipmentComment(shipmentId: ID!, commentId: ID!, input: ShipmentCommentUpdateInput!): ShipmentComment!
  deleteShipmentComment(shipmentId: ID!, commentId: ID!): Boolean!
  pinShipmentComment(shipmentId: ID!, commentId: ID!): ShipmentComment!
  unpinShipmentComment(shipmentId: ID!, commentId: ID!): ShipmentComment!
  resolveShipmentComment(shipmentId: ID!, commentId: ID!): ShipmentComment!
  unresolveShipmentComment(shipmentId: ID!, commentId: ID!): ShipmentComment!
  acknowledgeShipmentComment(shipmentId: ID!, commentId: ID!): ShipmentComment!
}
