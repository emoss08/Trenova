enum JournalReversalStatus {
  Requested
  PendingApproval
  Approved
  Rejected
  Cancelled
  Posted
}

type JournalReversal {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  originalJournalEntryId: ID!
  "The entry this reversal undoes."
  originalJournalEntry: JournalEntry!
  reversalJournalEntryId: ID
  "The entry that posted this reversal; null until it posts."
  reversalJournalEntry: JournalEntry
  postedBatchId: ID
  status: JournalReversalStatus!
  requestedAccountingDate: Timestamp!
  resolvedFiscalYearId: ID!
  resolvedFiscalPeriodId: ID!
  reasonCode: String!
  reasonText: String!
  requestedById: ID!
  approvedById: ID
  approvedAt: Timestamp
  rejectedById: ID
  rejectedAt: Timestamp
  rejectionReason: String
  cancelledById: ID
  cancelledAt: Timestamp
  cancelReason: String
  postedById: ID
  postedAt: Timestamp
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type JournalReversalEdge {
  node: JournalReversal!
  cursor: String!
}

type JournalReversalConnection {
  edges: [JournalReversalEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  journalReversals(input: DataTableConnectionInput!): JournalReversalConnection!
  journalReversal(id: ID!): JournalReversal
}

input CreateJournalReversalInput {
  originalJournalEntryId: ID!
  "The day the reversal should post; the fiscal period is resolved from it."
  requestedAccountingDate: Timestamp!
  reasonCode: String!
  reasonText: String!
}

extend type Mutation {
  "Asks for a posted journal entry to be reversed."
  createJournalReversal(input: CreateJournalReversalInput!): JournalReversal!
  "The second person's sign-off on a reversal."
  approveJournalReversal(id: ID!): JournalReversal!
  "Posts an approved reversal to the ledger."
  postJournalReversal(id: ID!): JournalReversal!
  "Turns a reversal down, recording why."
  rejectJournalReversal(id: ID!, reason: String!): JournalReversal!
  "Withdraws a reversal that has not posted, recording why."
  cancelJournalReversal(id: ID!, reason: String!): JournalReversal!
}
