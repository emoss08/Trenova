enum FieldType {
  text
  number
  date
  boolean
  select
  multiSelect
}

"""
One choice offered by a select or multi-select custom field.
"""
type CustomFieldSelectOption {
  value: String!
  label: String!
  color: String!
  description: String!
}

"""
Optional bounds applied when a value is written to the field. Null bounds are
not enforced.
"""
type CustomFieldValidationRules {
  minLength: Int
  maxLength: Int
  min: Int
  max: Int
  pattern: String
}

"""
Presentation hints for the field's input control.
"""
type CustomFieldUIAttributes {
  placeholder: String!
  helpText: String!
  width: String!
}

type CustomFieldDefinition {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  resourceType: String!
  name: String!
  label: String!
  description: String
  fieldType: FieldType!
  isRequired: Boolean!
  isActive: Boolean!
  displayOrder: Int!
  color: String
  """
  Choices for select and multi-select fields; empty for every other type.
  """
  options: [CustomFieldSelectOption!]!
  validationRules: CustomFieldValidationRules
  """
  Value pre-filled when a record is created; its shape follows fieldType.
  """
  defaultValue: Any
  uiAttributes: CustomFieldUIAttributes
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type CustomFieldDefinitionEdge {
  node: CustomFieldDefinition!
  cursor: String!
}

type CustomFieldDefinitionConnection {
  edges: [CustomFieldDefinitionEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

extend type Query {
  customFieldDefinitions(
    input: DataTableConnectionInput!
  ): CustomFieldDefinitionConnection!
  customFieldDefinition(id: ID!): CustomFieldDefinition
}
