enum CustomerPaymentTerm {
  Net10
  Net15
  Net30
  Net45
  Net60
  Net90
  DueOnReceipt
}

enum CustomerCreditStatus {
  Active
  Warning
  Hold
  Suspended
  Review
}

"""How many invoices a customer's freight turns into."""
enum CustomerInvoiceDelivery {
  """One invoice per shipment."""
  PerShipment
  """One invoice per order, covering every billable leg."""
  PerOrder
  """One or more invoices per billing period, covering the period's shipments."""
  Consolidated
}

"""How often a statement-billed customer is billed."""
enum CustomerBillingCycle {
  Immediate
  Daily
  Weekly
  BiWeekly
  SemiMonthly
  Monthly
  Quarterly
}

"""
How many invoices a billing period yields. Customer means one; every other
member means one per distinct value of that key.
"""
enum InvoiceSplitKey {
  Customer
  CustomerAndPONumber
  CustomerAndShipmentBOL
  CustomerAndOrder
  CustomerAndOrigin
  CustomerAndDestination
  CustomerAndServiceType
}

"""How the lines inside one invoice are organised. Never changes how many there are."""
enum InvoiceSectionKey {
  Shipment
  PONumber
  Origin
  Destination
}

"""How verbose each section of a consolidated invoice is."""
enum InvoiceDetail {
  Detailed
  Summary
}

enum CustomerInvoiceNumberFormat {
  Default
  CustomPrefix
  POBased
}

enum CustomerFuelSurchargeMode {
  None
  Program
  FuelIncluded
}

type CustomerBillingProfile {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  customerId: ID!
  invoiceDelivery: CustomerInvoiceDelivery!
  billingCycle: CustomerBillingCycle!
  """Weekday 0-6 for weekly cycles, day of month 1-28 for monthly and longer."""
  billingCycleAnchorDay: Int!
  """IANA zone the period boundaries are evaluated in."""
  billingCycleTimezone: String!
  """End of the last period billed, so a missed cycle catches up rather than skipping."""
  lastBilledPeriodEnd: Timestamp
  splitBy: InvoiceSplitKey!
  sectionBy: InvoiceSectionKey!
  invoiceDetail: InvoiceDetail!
  """Below this, a group defers to the next period instead of billing."""
  minConsolidatedAmount: Decimal
  """Zero means unbounded."""
  maxShipmentsPerInvoice: Int!
  paymentTerm: CustomerPaymentTerm!
  hasBillingControlOverrides: Boolean!
  creditLimit: Decimal
  """Open receivables, net of unapplied cash and credits, as of creditReviewedAt. Kept by the credit review, not entered."""
  creditBalance: Decimal!
  creditStatus: CustomerCreditStatus!
  enforceCreditLimit: Boolean!
  autoCreditHold: Boolean!
  creditHoldReason: String!
  """True when the credit review placed the current Hold or Warning; only the review lifts it."""
  creditHoldAutomatic: Boolean!
  """When creditBalance was last recomputed from the receivables ledger."""
  creditReviewedAt: Timestamp
  autoSendInvoiceOnGeneration: Boolean!
  "Whether the organization's payment reminders may email this customer about overdue invoices."
  sendPaymentReminders: Boolean!
  "Whether the organization's monthly statements may be emailed to this customer."
  sendStatements: Boolean!
  "Whether invoices may be emailed to this customer."
  emailInvoiceEnabled: Boolean!
  "Whether invoices are sent to this customer's EDI partner as an 210."
  ediInvoiceEnabled: Boolean!
  invoiceNumberFormat: CustomerInvoiceNumberFormat!
  customerInvoicePrefix: String!
  invoiceCopies: Int!
  revenueAccountId: ID
  arAccountId: ID
  applyLateCharges: Boolean!
  lateChargeRate: Decimal
  gracePeriodDays: Int!
  taxExempt: Boolean!
  taxExemptNumber: String!
  enforceCustomerBillingReq: Boolean!
  validateCustomerRates: Boolean!
  autoTransfer: Boolean!
  autoMarkReadyToBill: Boolean!
  """
  Lets freight that passes every billing requirement clear the billing queue
  without a biller approving it, leaving the queue holding only what needs a
  human. Reachable only when the organization has enabled automatic queue
  transfer, and never for a shipment with a requirement or rate issue.
  """
  autoApprove: Boolean!
  autoBill: Boolean!
  countLateOnlyOnAppointmentStops: Boolean!
  autoApplyAccessorials: Boolean!
  billingCurrency: String!
  requirePONumber: Boolean!
  requireBOLNumber: Boolean!
  requireDeliveryNumber: Boolean!
  defaultBillerId: ID
  billingNotes: String!
  fuelSurchargeMode: CustomerFuelSurchargeMode!
  fuelSurchargeProgramId: ID
  "The factor this customer's invoices are assigned to; null when they are not factored."
  factoringCompanyId: ID
  documentTypes: [DocumentType!]
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type CustomerEmailProfile {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  customerId: ID!
  subject: String!
  comment: String!
  toRecipients: String!
  ccRecipients: String!
  bccRecipients: String!
  attachmentName: String!
  readReceipt: Boolean!
  includeShipmentDetail: Boolean!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

"""
What a customer asked to be told as their freight moves.
"""
enum CustomerStatusUpdatePreference {
  None
  Arrivals
  Departures
  ArrivalsAndDepartures
}

type Customer {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  stateId: ID!
  status: EntityStatus!
  code: String!
  name: String!
  addressLine1: String
  addressLine2: String
  city: String
  postalCode: String!
  isGeocoded: Boolean!
  longitude: Float
  latitude: Float
  placeId: String
  externalId: String
  "How often a check call is due on this customer's freight; null uses the organization's interval."
  checkCallIntervalHours: Int
  "How late an ETA may run before this customer's freight is flagged at risk; null uses the organization's threshold."
  etaRiskThresholdMinutes: Int
  allowConsolidation: Boolean!
  exclusiveConsolidation: Boolean!
  consolidationPriority: Int!
  """
  What this customer asked to be told as their freight moves. None is the
  default: a customer who never opted in is not emailed about a stop.
  """
  statusUpdatePreference: CustomerStatusUpdatePreference!
  """
  Who receives those updates, comma separated. Empty falls back to the
  notice profile's own recipients.
  """
  statusUpdateRecipients: String
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  businessUnit: BusinessUnit
  organization: Organization
  state: UsState
  billingProfile: CustomerBillingProfile
  emailProfile: CustomerEmailProfile
}

type CustomerEdge {
  node: Customer!
  cursor: String!
}

type CustomerConnection {
  edges: [CustomerEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

"""
What a shipment form shows about a customer it bills: whether the shipment needs a BOL number
and the customer's credit standing. It carries nothing else from the billing profile, so anyone
who reads shipments reads it without reading customers.
"""
type ShipmentCustomerBillingRules {
  customerId: ID!
  "The customer enforces its billing requirements and one of them is a BOL number."
  bolRequired: Boolean!
  creditStatus: CustomerCreditStatus!
  creditHoldReason: String!
  enforceCreditLimit: Boolean!
  "The credit review placed the current hold or warning, rather than a person."
  creditHoldAutomatic: Boolean!
}

input CustomerBillingProfileInput {
  invoiceDelivery: CustomerInvoiceDelivery!
  billingCycle: CustomerBillingCycle!
  """Weekday 0-6 for weekly cycles, day of month 1-28 for monthly and longer."""
  billingCycleAnchorDay: Int!
  """IANA zone the period boundaries are evaluated in."""
  billingCycleTimezone: String!
  splitBy: InvoiceSplitKey!
  sectionBy: InvoiceSectionKey!
  invoiceDetail: InvoiceDetail!
  minConsolidatedAmount: Decimal
  """Zero means unbounded."""
  maxShipmentsPerInvoice: Int!
  paymentTerm: CustomerPaymentTerm!
  hasBillingControlOverrides: Boolean!
  creditLimit: Decimal
  creditStatus: CustomerCreditStatus!
  enforceCreditLimit: Boolean!
  autoCreditHold: Boolean!
  creditHoldReason: String
  autoSendInvoiceOnGeneration: Boolean!
  sendPaymentReminders: Boolean!
  sendStatements: Boolean!
  emailInvoiceEnabled: Boolean!
  ediInvoiceEnabled: Boolean!
  invoiceNumberFormat: CustomerInvoiceNumberFormat!
  customerInvoicePrefix: String
  invoiceCopies: Int!
  revenueAccountId: ID
  arAccountId: ID
  applyLateCharges: Boolean!
  lateChargeRate: Decimal
  gracePeriodDays: Int!
  taxExempt: Boolean!
  taxExemptNumber: String
  enforceCustomerBillingReq: Boolean!
  validateCustomerRates: Boolean!
  autoTransfer: Boolean!
  autoMarkReadyToBill: Boolean!
  autoApprove: Boolean!
  autoBill: Boolean!
  countLateOnlyOnAppointmentStops: Boolean!
  autoApplyAccessorials: Boolean!
  billingCurrency: String!
  requirePONumber: Boolean!
  requireBOLNumber: Boolean!
  requireDeliveryNumber: Boolean!
  defaultBillerId: ID
  billingNotes: String
  fuelSurchargeMode: CustomerFuelSurchargeMode!
  fuelSurchargeProgramId: ID
  "The factor this customer's invoices are assigned to; null when they are not factored."
  factoringCompanyId: ID
  "The document types an invoice for this customer cannot be generated without."
  documentTypeIds: [ID!]!
}

input CustomerEmailProfileInput {
  subject: String
  comment: String
  toRecipients: String
  ccRecipients: String
  bccRecipients: String
  attachmentName: String
  readReceipt: Boolean!
  includeShipmentDetail: Boolean!
}

input CustomerInput {
  status: EntityStatus!
  code: String!
  name: String!
  addressLine1: String!
  addressLine2: String
  city: String!
  stateId: ID!
  postalCode: String!
  longitude: Float
  latitude: Float
  placeId: String
  externalId: String
  dotNumber: String
  mcNumber: String
  brokerVettingEnabled: Boolean!
  checkCallIntervalHours: Int
  etaRiskThresholdMinutes: Int
  allowConsolidation: Boolean!
  exclusiveConsolidation: Boolean!
  consolidationPriority: Int!
  statusUpdatePreference: CustomerStatusUpdatePreference!
  statusUpdateRecipients: String
  "Omit to leave the billing profile as it is; a new customer then gets the default profile."
  billingProfile: CustomerBillingProfileInput
  "Omit to leave the email profile as it is."
  emailProfile: CustomerEmailProfileInput
  version: Int
}

input CustomerPatchInput {
  "Omit to leave unchanged; null is rejected."
  status: EntityStatus @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  code: String @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  name: String @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  addressLine1: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  addressLine2: String @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  city: String @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  stateId: ID @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  postalCode: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  longitude: Float @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  latitude: Float @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  placeId: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  externalId: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  dotNumber: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  mcNumber: String @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  brokerVettingEnabled: Boolean @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  checkCallIntervalHours: Int @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  etaRiskThresholdMinutes: Int @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  allowConsolidation: Boolean @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  exclusiveConsolidation: Boolean @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  consolidationPriority: Int @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  statusUpdatePreference: CustomerStatusUpdatePreference @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  statusUpdateRecipients: String @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  version: Int @goField(omittable: true)
}

input BulkUpdateCustomerStatusInput {
  customerIds: [ID!]!
  status: EntityStatus!
}

extend type Mutation {
  createCustomer(input: CustomerInput!): Customer!
  updateCustomer(id: ID!, input: CustomerInput!): Customer!
  patchCustomer(id: ID!, input: CustomerPatchInput!): Customer!
  bulkUpdateCustomerStatus(input: BulkUpdateCustomerStatusInput!): [Customer!]!
}

extend type Query {
  customers(input: DataTableConnectionInput!): CustomerConnection!
  customer(id: ID!): Customer
  """
  The billing rules of the customers a shipment bills, at most 50 at once. A customer without a
  billing profile is left out.
  """
  shipmentCustomerBillingRules(customerIds: [ID!]!): [ShipmentCustomerBillingRules!]!
}
