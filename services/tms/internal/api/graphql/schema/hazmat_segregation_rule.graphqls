enum SegregationType {
  Prohibited
  Separated
  Distance
  Barrier
}

type HazmatSegregationRule {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  status: EntityStatus!
  name: String!
  description: String!
  exceptionNotes: String!
  referenceCode: String!
  regulationSource: String!
  distanceUnit: String!
  classA: HazardousClass!
  classB: HazardousClass!
  segregationType: SegregationType!
  hasExceptions: Boolean!
  hazmatAId: ID
  hazmatBId: ID
  minimumDistance: Float
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  businessUnit: BusinessUnit
  organization: Organization
}

type HazmatSegregationRuleEdge {
  node: HazmatSegregationRule!
  cursor: String!
}

type HazmatSegregationRuleConnection {
  edges: [HazmatSegregationRuleEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  hazmatSegregationRules(input: DataTableConnectionInput!): HazmatSegregationRuleConnection!
  hazmatSegregationRule(id: ID!): HazmatSegregationRule
}

input HazmatSegregationRuleInput {
  status: EntityStatus!
  name: String!
  description: String
  classA: HazardousClass!
  classB: HazardousClass!
  hazmatAId: ID
  hazmatBId: ID
  segregationType: SegregationType!
  "Required when the segregation type is Distance."
  minimumDistance: Float
  "Required when the segregation type is Distance."
  distanceUnit: String
  hasExceptions: Boolean!
  "Required when the rule has exceptions."
  exceptionNotes: String
  referenceCode: String
  regulationSource: String
  version: Int
}

extend type Mutation {
  createHazmatSegregationRule(input: HazmatSegregationRuleInput!): HazmatSegregationRule!
  updateHazmatSegregationRule(
    id: ID!
    input: HazmatSegregationRuleInput!
  ): HazmatSegregationRule!
}
