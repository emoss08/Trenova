# --- Reporting catalog -------------------------------------------------------

type ReportCatalogEnumValue {
  value: String!
  label: String!
}

type ReportCatalogField {
  key: String!
  label: String!
  description: String
  type: String!
  format: String
  nullable: Boolean!
  enumValues: [ReportCatalogEnumValue!]!
  aggregations: [String!]!
  filterable: Boolean!
  groupable: Boolean!
  "Whether the caller may use the field in a report and, when not, what they lack."
  access: ReportFieldAccess!
  """
  Whether the field is in its kind's reference view, so a report can show it
  through a join from a record the caller reads without the kind's own read.
  """
  inReferenceView: Boolean!
  "The protected field group the field belongs to, and whether the caller holds it."
  protection: ReportFieldProtection
  sensitivity: String!
}

"""
Whether a caller may use a catalog field or edge in a report, decided by the
rule the report compiler applies, so a field marked Available compiles and
any other is refused.
"""
enum ReportFieldAccess {
  "The caller may use it."
  Available
  """
  It is outside its kind's reference view, and the caller cannot read the
  kind. Through a join, only the kind's reference-view fields can be used.
  """
  NeedsKindRead
  "It is ranked above the caller's sensitivity ceiling."
  WithheldByCeiling
  "It is in a protected field group the caller's role does not grant."
  NeedsFieldGroup
}

type ReportFieldProtection {
  group: ProtectedFieldGroup!
  "Whether the caller's role grants the group."
  held: Boolean!
}

type ReportCatalogEdge {
  name: String!
  label: String!
  target: String!
  cardinality: String!
  traversable: Boolean!
  "Whether the caller may follow the edge in a report and, when not, what they lack."
  access: ReportFieldAccess!
  "Whether the edge is in its source kind's reference view."
  inReferenceView: Boolean!
  """
  The kind whose read the caller lacks to follow the edge, when access is
  NeedsKindRead.
  """
  needsReadOf: ReportCatalogKind
}

"A kind of record, as the report catalog names it."
type ReportCatalogKind {
  resource: String!
  "The kind's plural label, such as Customers."
  label: String!
}

type ReportCatalogEntity {
  key: String!
  resource: String!
  label: String!
  pluralLabel: String!
  description: String
  category: String!
  ownScopeSupported: Boolean!
  """
  Whether the caller may read the kind. A report starts only from a kind the
  caller reads; one they cannot read is reached through a join, and only its
  reference-view fields are available.
  """
  readable: Boolean!
  "Whether a run may export the kind's own fields."
  exportable: Boolean!
  fields: [ReportCatalogField!]!
  edges: [ReportCatalogEdge!]!
}

"""
The report catalog as the caller may use it: every kind they can read, and
every kind they cannot read that they can still reach through a join, with
only its reference-view fields available.
"""
type ReportCatalog {
  version: String!
  entities: [ReportCatalogEntity!]!
}

# --- Canned reports ----------------------------------------------------------

type CannedReport {
  key: String!
  version: String!
  name: String!
  description: String!
  category: String!
  tags: [String!]!
  defaultFormat: String!
  definition: JSON!
}

# --- Report definitions ------------------------------------------------------

type ReportDefinition {
  id: ID!
  name: String!
  description: String!
  category: String!
  tags: [String!]!
  kind: String!
  cannedKey: String
  cannedVersion: String
  ownerId: ID!
  visibility: String!
  status: String!
  diagnostics: [String!]!
  catalogVersion: String!
  definition: JSON!
  defaultFormat: String!
  currentRevision: Int!
  lastRunAt: Timestamp
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type ReportDefinitionEdge {
  node: ReportDefinition!
  cursor: String!
}

type ReportDefinitionConnection {
  edges: [ReportDefinitionEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type ReportDefinitionRevision {
  id: ID!
  definitionId: ID!
  revisionNumber: Int!
  catalogVersion: String!
  definition: JSON!
  createdById: ID!
  createdAt: Timestamp!
}

# --- Report runs -------------------------------------------------------------

type ReportRunError {
  code: String!
  message: String!
  detail: String
}

type ReportRun {
  id: ID!
  definitionId: ID
  revisionId: ID
  cannedKey: String
  cannedVersion: String
  requestedById: ID!
  trigger: String!
  params: JSON
  format: String!
  status: String!
  rowCount: Int!
  byteSize: Int!
  durationMs: Int!
  truncated: Boolean!
  error: ReportRunError
  artifactExpiresAt: Timestamp
  cacheHit: Boolean!
  queuedAt: Timestamp
  startedAt: Timestamp
  completedAt: Timestamp
  version: Int!
  createdAt: Timestamp!
}

type ReportRunEdge {
  node: ReportRun!
  cursor: String!
}

type ReportRunConnection {
  edges: [ReportRunEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

# --- Report schedules --------------------------------------------------------

# A schedule carrying an alert delivers only when the run's row count satisfies
# the condition, which turns a recurring report into an exception alert.
type ReportScheduleAlert {
  operator: String!
  threshold: Int!
  # columnId switches the alert from counting rows to reading one measure's
  # grand total; value is that measure's threshold.
  columnId: String
  value: Float
  suppressWhileFiring: Boolean!
}

type ReportSchedule {
  id: ID!
  definitionId: ID!
  cronExpression: String!
  timezone: String!
  formats: [String!]!
  emailRecipients: [String!]!
  emailAttach: Boolean!
  emailInline: Boolean!
  notifyUserIds: [ID!]!
  alert: ReportScheduleAlert
  alertFiring: Boolean!
  enabled: Boolean!
  runAsId: ID!
  lastRunId: ID
  nextRunAt: Timestamp
  consecutiveFailures: Int!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

# A saved view is a named set of parameter values for one report — the same
# question asked for a different region or period, without retyping it.
type ReportView {
  id: ID!
  definitionId: ID!
  ownerId: ID!
  name: String!
  description: String
  params: JSON
  shared: Boolean!
  pinned: Boolean!
  format: String
  lastRunAt: Timestamp
  runCount: Int!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

# --- Preview -----------------------------------------------------------------

type ReportDisplayRule {
  op: String!
  value: Float!
  upper: Float!
  tone: String!
}

type ReportBand {
  width: Float!
  edges: [Float!]!
}

type ReportColumnDisplay {
  style: String!
  decimals: Int!
  grouping: Boolean!
  currency: String!
  negative: String!
  notation: String!
  prefix: String!
  suffix: String!
  dateStyle: String!
  boolStyle: String!
  durationUnit: String!
  durationStyle: String!
  nullText: String!
  rules: [ReportDisplayRule!]!
  band: ReportBand
}

type ReportPreviewColumn {
  id: String!
  label: String!
  type: String!
  format: String
  display: ReportColumnDisplay!
}

type ReportPreview {
  columns: [ReportPreviewColumn!]!
  rows: Any!
  totals: Any
  truncated: Boolean!
}

# --- IR inputs ---------------------------------------------------------------

input ReportFieldRefInput {
  path: [String!]
  field: String!
}

input ReportComputedInput {
  op: String!
  leftId: String
  rightId: String
  leftValue: Float
  rightValue: Float
  format: String
}

input ReportTransformInput {
  op: String!
  precision: Int
  factor: Float
}

input ReportDisplayRuleInput {
  op: String!
  value: Float!
  upper: Float
  tone: String!
}

input ReportDisplayInput {
  style: String
  decimals: Int
  grouping: Boolean
  currency: String
  negative: String
  notation: String
  prefix: String
  suffix: String
  dateStyle: String
  boolStyle: String
  durationUnit: String
  durationStyle: String
  nullText: String
  rules: [ReportDisplayRuleInput!]
}

input ReportBandInput {
  width: Float
  edges: [Float!]
}

input ReportColumnInput {
  id: String!
  ref: ReportFieldRefInput
  kind: String!
  agg: String
  bucket: String
  band: ReportBandInput
  label: String
  computed: ReportComputedInput
  transform: ReportTransformInput
  display: ReportDisplayInput
  filter: ReportFilterGroupInput
}

input ReportChartGoalInput {
  value: Float
  columnId: String
  label: String
}

input ReportChartInput {
  id: String!
  type: String!
  title: String
  xColumnId: String
  seriesIds: [String!]
  stacked: Boolean
  hideLegend: Boolean
  showValues: Boolean
  curved: Boolean
  limit: Int
  compareId: String
  goal: ReportChartGoalInput
  latColumnId: String
  lngColumnId: String
  labelColumnId: String
}

input ReportFilterInput {
  ref: ReportFieldRefInput!
  operator: String!
  value: Any
  param: String
  agg: String
  transform: ReportTransformInput
}

input ReportFilterGroupInput {
  op: String!
  filters: [ReportFilterInput!]
  groups: [ReportFilterGroupInput!]
}

input ReportSortInput {
  columnId: String!
  direction: String!
}

input ReportPivotInput {
  ref: ReportFieldRefInput!
  values: [String!]!
  labels: [String!]
  measureIds: [String!]!
  includeOther: Boolean
}

input ReportParameterDefInput {
  name: String!
  label: String
  type: String!
  required: Boolean
  default: Any
  multi: Boolean
  allowedValues: [String!]
  refEntity: String
}

input ReportIRInput {
  entity: String!
  columns: [ReportColumnInput!]!
  filters: ReportFilterGroupInput
  having: ReportFilterGroupInput
  sort: [ReportSortInput!]
  limit: Int
  pivot: ReportPivotInput
  parameters: [ReportParameterDefInput!]
  totals: Boolean
  charts: [ReportChartInput!]
}

input ReportDrillValueInput {
  columnId: String!
  value: Any
}

input ReportDrillInput {
  definition: ReportIRInput!
  params: JSON
  dimensions: [ReportDrillValueInput!]!
  columnId: String
  limit: Int
}

input SaveReportDefinitionInput {
  name: String!
  description: String
  category: String
  tags: [String!]
  visibility: String
  status: String
  defaultFormat: String
  definition: ReportIRInput!
}

input UpdateReportDefinitionInput {
  id: ID!
  version: Int!
  name: String!
  description: String
  category: String
  tags: [String!]
  visibility: String
  status: String
  defaultFormat: String
  definition: ReportIRInput!
}

input RunReportInput {
  definitionId: ID
  cannedKey: String
  format: String!
  params: JSON
  # Running from a saved view resolves its report, parameters, and format on
  # the server, so the run is guaranteed to be the view rather than whatever
  # the caller claimed it was. Explicit params or a format still win.
  viewId: ID
}

input ForkCannedReportInput {
  cannedKey: String!
  name: String
}

input ReportRunsFilterInput {
  definitionId: ID
  statuses: [String!]
}

input ReportScheduleAlertInput {
  operator: String!
  threshold: Int!
  columnId: String
  value: Float
  suppressWhileFiring: Boolean
}

input CreateReportScheduleInput {
  definitionId: ID!
  cronExpression: String!
  timezone: String
  formats: [String!]!
  emailRecipients: [String!]
  emailAttach: Boolean
  emailInline: Boolean
  notifyUserIds: [ID!]
  alert: ReportScheduleAlertInput
  enabled: Boolean!
}

input UpdateReportScheduleInput {
  id: ID!
  version: Int!
  definitionId: ID!
  cronExpression: String!
  timezone: String
  formats: [String!]!
  emailRecipients: [String!]
  emailAttach: Boolean
  emailInline: Boolean
  notifyUserIds: [ID!]
  alert: ReportScheduleAlertInput
  enabled: Boolean!
}

input CreateReportViewInput {
  definitionId: ID!
  name: String!
  description: String
  params: JSON
  shared: Boolean
  pinned: Boolean
  format: String
}

# The report a view answers is fixed at creation, so it is absent here: a view
# that could be repointed would keep its name and silently change its meaning.
input UpdateReportViewInput {
  id: ID!
  version: Int!
  name: String!
  description: String
  params: JSON
  shared: Boolean
  pinned: Boolean
  format: String
}

# --- Dashboards --------------------------------------------------------------

type ReportDashboard {
  id: ID!
  name: String!
  description: String!
  category: String!
  tags: [String!]!
  ownerId: ID!
  visibility: String!
  layout: JSON!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

input ReportDashboardTileInput {
  id: String!
  kind: String!
  title: String
  definitionId: ID
  cannedKey: String
  chartId: String
  columnId: String
  text: String
  x: Int!
  y: Int!
  w: Int!
  h: Int!
  limit: Int
  paramBindings: JSON
}

input ReportDashboardFilterInput {
  id: String!
  label: String
  entity: String!
  ref: ReportFieldRefInput!
  operator: String!
  default: Any
}

input ReportDashboardLayoutInput {
  tiles: [ReportDashboardTileInput!]!
  parameters: [ReportParameterDefInput!]
  filters: [ReportDashboardFilterInput!]
}

input SaveReportDashboardInput {
  name: String!
  description: String
  category: String
  tags: [String!]
  visibility: String
  layout: ReportDashboardLayoutInput!
}

input UpdateReportDashboardInput {
  id: ID!
  version: Int!
  name: String!
  description: String
  category: String
  tags: [String!]
  visibility: String
  layout: ReportDashboardLayoutInput!
}

# --- Operations --------------------------------------------------------------

extend type Query {
  reportCatalog: ReportCatalog!
  cannedReports: [CannedReport!]!
  reportDefinition(id: ID!): ReportDefinition!
  reportDefinitions(input: DataTableConnectionInput!): ReportDefinitionConnection!
  reportDefinitionRevisions(definitionId: ID!, limit: Int): [ReportDefinitionRevision!]!
  reportRun(id: ID!): ReportRun!
  reportRuns(
    input: DataTableConnectionInput!
    filter: ReportRunsFilterInput
  ): ReportRunConnection!
  previewReport(
    definition: ReportIRInput!
    params: JSON
    supersede: Boolean
  ): ReportPreview!
  drillThroughReport(input: ReportDrillInput!): ReportPreview!
  reportSchedules(definitionId: ID): [ReportSchedule!]!
  reportViews(definitionId: ID): [ReportView!]!
  reportView(id: ID!): ReportView!
  reportDashboards: [ReportDashboard!]!
  reportDashboard(id: ID!): ReportDashboard!
}

input TableExportColumnInput {
  "The field the column shows, as the table filters and sorts by it."
  field: String!
  label: String!
}

"What a data table is showing, to export or schedule as a report."
input TableExportViewInput {
  resource: String!
  columns: [TableExportColumnInput!]!
  filter: DataTableConnectionInput
}

input ExportTableViewInput {
  name: String!
  view: TableExportViewInput!
  "csv, xlsx or pdf."
  format: String!
}

input ScheduleTableViewInput {
  name: String!
  view: TableExportViewInput!
  cronExpression: String!
  timezone: String
  formats: [String!]!
  emailRecipients: [String!]
  emailAttach: Boolean
  emailInline: Boolean
}

type TableExportResult {
  "The report the view was saved as; it lives in the person's reports."
  definitionId: ID!
  run: ReportRun
  schedule: ReportSchedule
  "Columns the report could not show, by label."
  skippedColumns: [String!]!
}

extend type Mutation {
  createReportDefinition(input: SaveReportDefinitionInput!): ReportDefinition!
  "Saves a table's view as a report and runs it in the background, with no row limit beyond the report's own."
  exportTableView(input: ExportTableViewInput!): TableExportResult!
  "Saves a table's view as a report and sends it on a schedule."
  scheduleTableView(input: ScheduleTableViewInput!): TableExportResult!
  updateReportDefinition(input: UpdateReportDefinitionInput!): ReportDefinition!
  deleteReportDefinition(id: ID!): Boolean!
  forkCannedReport(input: ForkCannedReportInput!): ReportDefinition!
  resetCannedFork(id: ID!): ReportDefinition!
  runReport(input: RunReportInput!): ReportRun!
  cancelReportRun(id: ID!): ReportRun!
  createReportSchedule(input: CreateReportScheduleInput!): ReportSchedule!
  updateReportSchedule(input: UpdateReportScheduleInput!): ReportSchedule!
  deleteReportSchedule(id: ID!): Boolean!
  createReportView(input: CreateReportViewInput!): ReportView!
  updateReportView(input: UpdateReportViewInput!): ReportView!
  deleteReportView(id: ID!): Boolean!
  createReportDashboard(input: SaveReportDashboardInput!): ReportDashboard!
  updateReportDashboard(input: UpdateReportDashboardInput!): ReportDashboard!
  deleteReportDashboard(id: ID!): Boolean!
}
