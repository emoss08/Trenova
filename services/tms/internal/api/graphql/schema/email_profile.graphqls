enum EmailProvider {
  Resend
  Postmark
}

enum EmailProfileStatus {
  Active
  Inactive
}

type EmailProfile {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  name: String!
  description: String!
  senderName: String!
  senderEmail: String!
  replyToEmail: String!
  provider: EmailProvider!
  status: EmailProfileStatus!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  businessUnit: BusinessUnit
  organization: Organization
}

type EmailProfileEdge {
  node: EmailProfile!
  cursor: String!
}

type EmailProfileConnection {
  edges: [EmailProfileEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  emailProfiles(input: DataTableConnectionInput!): EmailProfileConnection!
  emailProfile(id: ID!): EmailProfile
}
