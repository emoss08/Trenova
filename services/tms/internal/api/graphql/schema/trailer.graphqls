enum EquipmentStatus {
  Available
  OutOfService
  AtMaintenance
  Sold
}

type TrailerEdge {
  node: Trailer!
  cursor: String!
}

type TrailerConnection {
  edges: [TrailerEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type Trailer {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  equipmentTypeId: ID!
  equipmentManufacturerId: ID!
  registrationStateId: ID
  fleetCodeId: ID
  status: EquipmentStatus!
  equipmentStatus: EquipmentStatus!
  code: String!
  model: String!
  make: String!
  year: Int
  licensePlateNumber: String!
  vin: String!
  externalId: String!
  registrationNumber: String!
  maxLoadWeight: Int
  lastInspectionDate: Timestamp
  registrationExpiry: Timestamp
  lastKnownLocationId: ID
  lastKnownLocationName: String!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  customFields: JSON
  businessUnit: BusinessUnit
  organization: Organization
  equipmentType: EquipmentType
  equipmentManufacturer: EquipmentManufacturer
  fleetCode: FleetCode
  registrationState: UsState
  lastKnownLocation: LocationReference
}

input TrailerInput {
  equipmentTypeId: ID!
  equipmentManufacturerId: ID!
  registrationStateId: ID
  fleetCodeId: ID
  status: EquipmentStatus = Available
  code: String!
  model: String
  make: String
  year: Int
  licensePlateNumber: String
  vin: String
  externalId: String
  registrationNumber: String
  maxLoadWeight: Int
  lastInspectionDate: Timestamp
  registrationExpiry: Timestamp
  version: Int
  customFields: JSON
}

input TrailerPatchInput {
  "Omit to leave unchanged; null is rejected."
  equipmentTypeId: ID @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  equipmentManufacturerId: ID @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  registrationStateId: ID @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  fleetCodeId: ID @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  status: EquipmentStatus @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  code: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  model: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  make: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  year: Int @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  licensePlateNumber: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  vin: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  externalId: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  registrationNumber: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  maxLoadWeight: Int @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  lastInspectionDate: Timestamp @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  registrationExpiry: Timestamp @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  version: Int @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  customFields: JSON @goField(omittable: true)
}

input BulkUpdateTrailerStatusInput {
  trailerIds: [ID!]!
  status: EquipmentStatus!
}

input LocateTrailerInput {
  trailerId: ID!
  newLocationId: ID!
}

type Query {
  trailers(
    input: DataTableConnectionInput!
    status: EquipmentStatus
    includeEquipmentDetails: Boolean = false
    includeFleetDetails: Boolean = false
  ): TrailerConnection!
  trailer(id: ID!): Trailer
}

type Mutation {
  createTrailer(input: TrailerInput!): Trailer!
  updateTrailer(id: ID!, input: TrailerInput!): Trailer!
  patchTrailer(id: ID!, input: TrailerPatchInput!): Trailer!
  bulkUpdateTrailerStatus(input: BulkUpdateTrailerStatusInput!): [Trailer!]!
  locateTrailer(input: LocateTrailerInput!): EquipmentContinuity!
}
