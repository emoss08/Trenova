"""
A board an agent laid out in a conversation, read now with the reader's own
access: its words as the agent wrote them, and each block's figures, rows,
checks and points read live from the records, analyses and metrics it names.
"""
type DeskBoardCard {
  artifactId: ID!
  threadId: ID!
  title: String!
  "The agent the board is credited to."
  author: String!
  "The question of the turn that showed the board."
  question: String!
  answeredAt: Timestamp!
  readAt: Timestamp!
  """
  Where the board is drawn: conversation (in the conversation, as the reply of
  the turn that showed it) or beside (a page beside the conversation).
  """
  place: String!
  """
  The answer in a sentence or two, split where it cites a block and where it
  places a reading.
  """
  verdict: [DeskBoardSegment!]!
  "The figures the board's words place, each read now and kept as answered."
  readings: [DeskBoardReading!]!
  blocks: [DeskBoardBlock!]!
  "The board as it reads now, in markdown: what Copy as text copies."
  markdown: String!
}

"""
A run of words, and the block it cites when it cites one: the block's numeral,
whether the block holds something to act on (warn) or not (info), and whether
it could not be read. A segment that places a reading names its key, and its
text is the reading's value as answered, empty when it could not be read.
"""
type DeskBoardSegment {
  text: String!
  numeral: Int!
  tone: String!
  struck: Boolean!
  "The key of the reading the segment places; empty when it places none."
  reading: String!
  """
  The id of an artifact this turn made that the words link to, drawn as a link
  to it; empty when the segment links none.
  """
  artifact: String!
}

"""
A figure the board's words place as {key}: what it reads, its value now, the
value it had when the board was shown when it has moved since, and where it was
read from.
"""
type DeskBoardReading {
  key: String!
  label: String!
  "Absent when the reader may not read it or it could not be read."
  value: DeskBoardValue
  "What it was when the board was shown, when it has moved since."
  was: DeskBoardValue
  source: DeskBoardSource!
  "The records' measure it adds up; empty for a metric or an analysis figure."
  measure: String!
  "count, sum or max over the records; empty for a metric or an analysis figure."
  aggregate: String!
}

"""
A value the server read: count, money, percent (a fraction), duration (an
elapsed time in seconds, written in days from three days), hours (a quantity of
work hours in seconds, never written in days), days (whole days, negative once
past), number or text.
"""
type DeskBoardValue {
  kind: String!
  number: Decimal!
  currency: String!
  text: String!
}

"""
Where a block was read from: records (with how many it names and how many the
reader may read), an analysis or a table by title, the organization's metrics,
a record's history, the checks above, or several.
"""
type DeskBoardSource {
  kind: String!
  "The kind of record a records source names: shipment, worker_credential, …; empty otherwise."
  recordKind: String!
  count: Int!
  readable: Int!
  title: String!
}

"""
A record's measure, read by the record's owner: its value, the words it stands
at, a second fact, and the bar the board laid out for it against the block's
other rows.
"""
type DeskBoardRowMeasure {
  measure: String!
  "The value readings add up; absent when the reader may not read it."
  value: DeskBoardValue
  "What the row says it stands at, right of the label."
  standing: DeskBoardWords!
  "The second fact, after the subtitle; absent when the measure has none."
  fact: DeskBoardWords
  tone: String!
  "Absent for a measure drawn as a figure only."
  bar: DeskBoardBar
}

"""
Words the server wrote in the reader's language. {0} in text is where value
goes, or the moment at (written as a day when day is true); place is where it
was measured, drawn after the moment and the first to give way.
"""
type DeskBoardWords {
  text: String!
  value: DeskBoardValue
  at: Timestamp
  day: Boolean!
  place: String!
}

"""
A row's bar, laid out on one scale for every row of its block. centred bars
hold their bound at the middle; bound is the mark through the track, a
fraction of it.
"""
type DeskBoardBar {
  centred: Boolean!
  segments: [DeskBoardBarSegment!]!
  bound: Float
}

"kind: used, beyond, ghost, projected, tail, credit or held; start and width are fractions of the track."
type DeskBoardBarSegment {
  kind: String!
  start: Float!
  width: Float!
  tone: String!
}

"A record a row opens in place of itself."
type DeskBoardRef {
  kind: String!
  id: ID!
}

"""
A record a block names. A record the reader may not read, or that no longer
exists, has readable false and nothing else.
"""
type DeskBoardRow {
  "The kind of record: shipment, worker_credential, detention_occurrence, …"
  kind: String!
  id: ID!
  readable: Boolean!
  label: String!
  subtitle: String!
  "The status as the product words it."
  status: String!
  "The status's tone, chosen by its owner: bad, warn, info, ok, or empty for none."
  statusTone: String!
  "The record the row opens when its own kind has no card (a credential opens its worker)."
  opens: DeskBoardRef
  measure: DeskBoardRowMeasure
}

"One thing open about a record on a work block, as Needs you holds it."
type DeskBoardWorkSignal {
  lens: DeskLens!
  title: String!
  "bad, warn or info, from the item's severity."
  tone: String!
  dueAt: Timestamp
}

"A record on a work block with everything open about it, soonest deadline first."
type DeskBoardWorkRow {
  row: DeskBoardRow!
  signals: [DeskBoardWorkSignal!]!
  tone: String!
  dueAt: Timestamp
}

"""
A button an actions block offers. It sends its request as the person's own message
into the board's conversation and changes nothing itself.
"""
type DeskBoardAction {
  label: String!
  ask: String!
  records: [DeskBoardRow!]!
}

type DeskBoardFigure {
  label: String!
  "Absent when its source cannot be read."
  value: DeskBoardValue
  "What it was when the board was shown, when it has moved since."
  was: DeskBoardValue
  tone: String!
}

type DeskBoardCompareLine {
  label: String!
  "higher or lower, when the row has a winner."
  better: String!
  "One value per column, absent where the column's record has none."
  cells: [DeskBoardValue]!
  wins: [Boolean!]!
}

type DeskBoardCompare {
  columns: [DeskBoardRow!]!
  lines: [DeskBoardCompareLine!]!
  "How many rows each column won."
  wins: [Int!]!
}

type DeskBoardTable {
  "The first rows of the table, as an analysis keeps a table."
  table: JSON!
  total: Int!
  "The analysis or table artifact the whole table opens as."
  artifactId: ID
}

type DeskBoardEvent {
  at: Timestamp!
  operation: String!
  actor: String!
  principalType: String!
  comment: String!
  changes: JSON
}

type DeskBoardCheck {
  title: String!
  tone: String!
  detail: String!
  "How many of the records it names the reader may read, or its metric."
  count: DeskBoardValue
  was: DeskBoardValue
  records: [DeskBoardRow!]!
  "How many of its records the reader may not read."
  hidden: Int!
}

type DeskBoardMeter {
  clear: Int!
  total: Int!
  "One tone per check, clear first."
  tones: [String!]!
  percent: DeskBoardValue
}

"A named figure a metric read, with the label the catalog gives it."
type DeskBoardMetricFigure {
  name: String!
  label: String!
  "Absent when it could not be read or the plan leaves it out."
  value: DeskBoardValue
  "What it read earlier, when the metric compares it (was 34.9 on Oct 23); absent otherwise."
  was: DeskBoardValue
  "When it read was."
  wasAt: Timestamp
  "bad, warn, info, ok, or empty: how the metric's owner rates the figure."
  tone: String!
}

"A point along a chart's axis: a moment or a label; marked when the chart draws attention to it."
type DeskBoardTick {
  at: Timestamp
  label: String!
  marked: Boolean!
}

"One series of a chart: now, was (the period before, drawn light) or stack. A null point is a gap."
type DeskBoardSeries {
  name: String!
  role: String!
  points: [Decimal]!
}

"A band across a chart: between two points along the axis, or between two values."
type DeskBoardBand {
  from: Int
  to: Int
  low: Decimal
  high: Decimal
}

"A line across a chart: a target or a reference."
type DeskBoardLine {
  value: Decimal!
  label: String!
}

"A span along a row of a spans chart, between two moments: cover or gap."
type DeskBoardSpan {
  from: Timestamp!
  to: Timestamp!
  kind: String!
}

"A dot on a row of a dots or spans chart: at a moment or a value."
type DeskBoardChartMark {
  at: Timestamp
  value: Decimal
  marked: Boolean!
  "A unit with too little data to place: drawn hollow, never warned."
  ghost: Boolean!
  label: String!
}

"A row of a ranked bars, dots or spans chart, and the record it opens."
type DeskBoardChartRow {
  label: String!
  record: DeskBoardRow
  value: DeskBoardValue
  marked: Boolean!
  "The row that stands for the rest (3 other customers), drawn lighter than a named row."
  rest: Boolean!
  spans: [DeskBoardSpan!]!
  dots: [DeskBoardChartMark!]!
}

"""
A chart the server shaped for a board: ticks along the axis, series of points
in unit, the points it marks, a band, a target and a reference, a ghost last
point still running, and rows for ranked bars, dots and spans.
"""
type DeskBoardChart {
  unit: String!
  currency: String!
  ticks: [DeskBoardTick!]!
  series: [DeskBoardSeries!]!
  marked: [Int!]!
  band: DeskBoardBand
  target: DeskBoardLine
  ref: DeskBoardLine
  ghost: Boolean!
  rows: [DeskBoardChartRow!]!
}

"One part of a whole: used, over or credit."
type DeskBoardSplitPart {
  label: String!
  value: DeskBoardValue!
  kind: String!
}

type DeskBoardSplit {
  total: DeskBoardValue!
  parts: [DeskBoardSplitPart!]!
}

type DeskBoardGridColumn {
  label: String!
  sublabel: String!
}

"have against need, with the high end of need; state covered, short, deep or maybe."
type DeskBoardGridCell {
  have: Int!
  need: Int!
  needHigh: Int!
  state: String!
}

type DeskBoardGridRow {
  label: String!
  cells: [DeskBoardGridCell!]!
}

type DeskBoardGrid {
  columns: [DeskBoardGridColumn!]!
  rows: [DeskBoardGridRow!]!
}

"One line of a log: when, what became of it, and the records it names."
type DeskBoardLogEntry {
  at: Timestamp!
  tone: String!
  text: String!
  detail: String!
  records: [DeskBoardRow!]!
}

"A column of a metric's table: text or value."
type DeskBoardMetricColumn {
  label: String!
  kind: String!
}

"A cell of a metric's table; mark is hot, off, w or empty."
type DeskBoardCell {
  value: DeskBoardValue
  text: String!
  mark: String!
}

type DeskBoardMetricTable {
  columns: [DeskBoardMetricColumn!]!
  rows: [[DeskBoardCell!]!]!
}

"""
A metric a board reads, drawn in its form: trend, bars, columns, split, grid,
dots, spans, log, checks, table or figures. The fields its form names are
filled; figures holds every figure the catalog declares for it.
"""
type DeskBoardMetric {
  "The metric's name; empty for an analysis chart."
  name: String!
  form: String!
  title: String!
  "Where it was read from, for the source line."
  source: String!
  figures: [DeskBoardMetricFigure!]!
  chart: DeskBoardChart
  split: DeskBoardSplit
  grid: DeskBoardGrid
  log: [DeskBoardLogEntry!]!
  checks: [DeskBoardCheck!]!
  table: DeskBoardMetricTable
}

"""
One block of a board. type says which of the other fields it fills: figures,
records (rows), compare, table, chart and metric (metric), timeline (events,
with the record in rows), checks, meter, prose (text) or note (text, noteTone
and chips).
"""
type DeskBoardBlock {
  type: String!
  title: String!
  half: Boolean!
  "The block's exhibit numeral; 0 for prose and notes."
  numeral: Int!
  "ready, empty or unreadable."
  state: String!
  tone: String!
  source: DeskBoardSource!
  figures: [DeskBoardFigure!]!
  measure: String!
  rows: [DeskBoardRow!]!
  compare: DeskBoardCompare
  table: DeskBoardTable
  "A chart or metric block, drawn in its form."
  metric: DeskBoardMetric
  events: [DeskBoardEvent!]!
  checks: [DeskBoardCheck!]!
  meter: DeskBoardMeter
  text: [DeskBoardSegment!]!
  "One plain line under the exhibit's tab, with readings placed in it; empty when the block has none."
  caption: [DeskBoardSegment!]!
  noteTone: String!
  chips: [DeskBoardRow!]!
  work: [DeskBoardWorkRow!]!
  actions: [DeskBoardAction!]!
}

extend type Query {
  "A board in one of the person's conversations, read now with their access."
  deskBoardCard(threadId: ID!, artifactId: ID!): DeskBoardCard!
}
