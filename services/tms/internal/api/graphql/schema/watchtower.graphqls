"""
The record an item stands in for. The source stays authoritative: an item
is a projection of it, keyed by kind and id, and resolves when the source
does.
"""
enum WatchtowerSourceKind {
  Insight
  AgentProposal
  AgentPlan
  AgentRunFailed
  AgentException
  ServiceFailure
  CarrierIntelEvent
  HOSViolation
  EDIInboundQuarantined
  BillingException
  DetentionOccurrence
  InboundMessage
  WorkerCredential
  MoveCoverage
  TelematicsStopVisit
  AgentQualityRegression
  AccountingSync
  NoCheckCall
  EtaAtRisk
  MissedPickup
  MissedDelivery
  PodMissing
  TenderExhausted
  Factoring
}

"Where an exception is in its owner's hands."
enum WatchtowerItemStatus {
  Open
  Acknowledged
  InProgress
  Snoozed
  Resolved
}

"""
Why an exception was closed. Cleared is the system's own code for a source
that stopped reporting the problem; a person picks one of the others, and
Other needs a note.
"""
enum WatchtowerResolutionCode {
  Fixed
  CarrierDelay
  ShipperDelay
  ReceiverDelay
  CustomerChange
  Rescheduled
  Weather
  Equipment
  DriverIssue
  DocumentReceived
  DataCorrected
  Duplicate
  NoActionNeeded
  Other
  Cleared
}

"What happened to an exception, one line of its history."
enum WatchtowerItemEventKind {
  Created
  Assigned
  Unassigned
  Acknowledged
  Started
  Snoozed
  Woke
  DueChanged
  Commented
  Escalated
  Resolved
  Reopened
  SourceResolved
  SourceReopened
  "The item was handed to an agent, which is now working it."
  HandedOff
}

"Where an item's due time came from."
enum WatchtowerDueSource {
  "The organization's due time for the item's severity."
  Policy
  "A deadline the record itself reports, such as a dock closing or a certificate lapsing."
  Source
  "A person set or cleared it."
  Person
}

"How an agent handed an item is getting on."
enum WatchtowerAgentStatus {
  Working
  "Waiting on a person: a change to approve, or a run that stopped."
  NeedsYou
  Done
}

"The phases an agent's work on an item goes through, in order."
enum WatchtowerAgentStep {
  "Reading the record the item is about."
  Read
  "Working out what to do and drafting it."
  Decide
  "Asking a person to approve what it drafted."
  Approve
}

"Which view an item's panel is drawn with."
enum WatchtowerPanelKind {
  "A stop and its window: missed, projected late, or at risk."
  Stop
  "A detention clock: free time, then billable time."
  Clock
  "Paperwork a record is waiting on."
  Paper
  "A message that arrived and waits on a person."
  Message
  "Credentials coming due for one person."
  Expiry
  "A move with nobody on it, or a tender every carrier passed on."
  Coverage
  "A carrier that has stopped checking in."
  Contact
  "An agent run that could not finish."
  Run
  "The accounting system: documents waiting, or the connection itself."
  Books
  "Money waiting on someone: an advance, a chargeback, an invoice that cannot go out."
  Money
  "Something on a record changed from one value to another."
  Change
  "An agent stopped and needs a person."
  Ask
  "A finding with advice."
  Finding
  "A file that could not be processed."
  File
  "A truck seen at a place with no arrival or departure recorded."
  Sighting
}

enum WatchtowerStopRole {
  Pickup
  Delivery
}

enum WatchtowerStopVerdict {
  "The window closed with no arrival recorded."
  Missed
  "Projected to arrive after the window closes."
  Late
  "Projected to arrive with little to spare."
  AtRisk
  "Arrived after the window closed."
  ArrivedLate
}

"A stop and its window. A time of 0 is not known."
type WatchtowerStopPanel {
  role: WatchtowerStopRole!
  verdict: WatchtowerStopVerdict!
  place: String!
  windowEnd: Timestamp!
  "The projected arrival."
  estimatedAt: Timestamp!
  "When it arrived, for a stop that arrived late."
  arrivedAt: Timestamp!
  "The last position or check call the projection worked from."
  lastHeardAt: Timestamp!
  milesRemaining: Int!
  "The projection is working from old information."
  stale: Boolean!
}

"A detention clock. A time of 0 has not happened."
type WatchtowerClockPanel {
  place: String!
  customer: String!
  arrivedAt: Timestamp!
  freeEndsAt: Timestamp!
  departedAt: Timestamp!
  freeMinutes: Int!
  billableMinutes: Int!
  "What has accrued, as money in words; empty while nothing has."
  accrued: String!
}

type WatchtowerPaper {
  name: String!
  onFile: Boolean!
}

"Paperwork a delivered load is waiting on."
type WatchtowerPaperPanel {
  customer: String!
  deliveredAt: Timestamp!
  papers: [WatchtowerPaper!]!
  "What the missing paper holds up, in words; empty when nothing is known to wait on it."
  holds: String!
}

"A message that waits on a person."
type WatchtowerMessagePanel {
  fromName: String!
  fromAddress: String!
  subject: String!
  "What Nova read the message as; empty when it could not say."
  readAs: String!
  "Why it waits on a person, in the source's words."
  why: String!
  receivedAt: Timestamp!
  "Held back as unsafe."
  held: Boolean!
}

type WatchtowerExpiringPaper {
  name: String!
  expiresAt: Timestamp!
  "Whole days until it expires; negative once it has."
  daysLeft: Int!
}

"One person's credentials coming due."
type WatchtowerExpiryPanel {
  who: String!
  papers: [WatchtowerExpiringPaper!]!
}

"A move with nobody on it."
type WatchtowerCoveragePanel {
  startsAt: Timestamp!
  reason: String!
  "Every carrier in the routing guide passed or let the offer lapse."
  exhausted: Boolean!
  endedAt: Timestamp!
}

"A carrier that has gone quiet."
type WatchtowerContactPanel {
  who: String!
  lastHeardAt: Timestamp!
  "How often a check call is expected, in hours."
  everyHours: Int!
  "When the next check call was due."
  dueAt: Timestamp!
}

"An agent run that could not finish."
type WatchtowerRunPanel {
  agent: String!
  reason: String!
  failedAt: Timestamp!
}

"The accounting system and what waits in it."
type WatchtowerBooksPanel {
  system: String!
  "How many documents or payments wait; 0 when it is the connection itself."
  count: Int!
  since: Timestamp!
  "When the authorization or certificate expires."
  expiresAt: Timestamp!
  "The connection is failing or was revoked."
  down: Boolean!
}

enum WatchtowerMoneyStake {
  "Advances a factor has not funded."
  Advance
  "What the organization would owe if a factor charges an invoice back."
  Chargeback
  "An invoice that cannot go out as it stands."
  Invoice
}

"Money waiting on someone."
type WatchtowerMoneyPanel {
  stake: WatchtowerMoneyStake!
  "Who it waits on: the factor, the customer."
  party: String!
  "The amount as money in words; empty when none is known."
  amount: String!
  "How many invoices it covers."
  count: Int!
  dueAt: Timestamp!
  reason: String!
}

"Something that changed, from one value to another."
type WatchtowerChangePanel {
  who: String!
  what: String!
  from: String!
  to: String!
  "What identifies who: a DOT number."
  ref: String!
  at: Timestamp!
}

"An agent that stopped and needs a person."
type WatchtowerAskPanel {
  category: String!
  "What it tried before it stopped."
  tried: String!
}

"A finding and what to do about it."
type WatchtowerFindingPanel {
  advice: String!
  detail: String!
}

"A file that could not be processed."
type WatchtowerFilePanel {
  name: String!
  reason: String!
  receivedAt: Timestamp!
}

"A truck seen at a place with nothing recorded."
type WatchtowerSightingPanel {
  "A departure was seen; otherwise an arrival."
  departure: Boolean!
  place: String!
  seenAt: Timestamp!
  why: String!
}

"""
What is happening on an item, in the shape made for it. Exactly one of the
fields named by `kind` is set.
"""
type WatchtowerPanel {
  kind: WatchtowerPanelKind!
  stop: WatchtowerStopPanel
  clock: WatchtowerClockPanel
  paper: WatchtowerPaperPanel
  message: WatchtowerMessagePanel
  expiry: WatchtowerExpiryPanel
  coverage: WatchtowerCoveragePanel
  contact: WatchtowerContactPanel
  run: WatchtowerRunPanel
  books: WatchtowerBooksPanel
  money: WatchtowerMoneyPanel
  change: WatchtowerChangePanel
  ask: WatchtowerAskPanel
  finding: WatchtowerFindingPanel
  file: WatchtowerFilePanel
  sighting: WatchtowerSightingPanel
}

"One fact about the record behind an item, as the source reports it."
type WatchtowerFact {
  label: String!
  "The value in words; absent when the fact is an instant."
  value: String
  "The instant the fact names, for the reader's own clock."
  at: Timestamp
}

"One of the events that led to an item, oldest first."
type WatchtowerTrailEvent {
  "When it happened; absent when the source does not know."
  at: Timestamp
  text: String!
}

"The record an item is about, for the button that opens it."
type WatchtowerRecord {
  "The kind of record, as the permission registry names it."
  kind: String!
  "The kind in the reader's words."
  noun: String!
  "The record's name or number; blank when the source has none."
  label: String!
}

"An agent working an item: who, how far along, and what it last said."
type WatchtowerAgentWork {
  agentId: ID!
  agent: AgentDefinition
  runId: ID!
  status: WatchtowerAgentStatus!
  "How many of the steps are behind it; equal to the step count once it is done."
  step: Int!
  steps: [WatchtowerAgentStep!]!
  "What the run last said: its summary, or why it stopped."
  note: String!
  "The run stopped before it finished."
  failed: Boolean!
  handedAt: Timestamp!
  handedById: ID
  handedBy: User
}

"How loudly an item asks to be looked at."
enum WatchtowerSeverity {
  Info
  Warning
  Critical
}

"""
One thing worth a person's attention, drawn from the record that raised it.
Every item a reader is shown is one whose source they could open themselves.
"""
type WatchtowerItem {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  sourceKind: WatchtowerSourceKind!
  "The id of the record this stands for, in that source's own terms."
  sourceId: String!
  severity: WatchtowerSeverity!
  title: String!
  summary: String!
  "The record an agent would work on if this item were handed to one."
  subjectType: AgentSubjectType
  subjectId: ID
  "The event a hand-off publishes; absent when no agent can take this kind."
  eventKind: String
  "An application path that opens the source record; blank when the source has no page of its own."
  path: String!
  occurredAt: Timestamp!
  "When the source closed; absent while the item is still open."
  resolvedAt: Timestamp
  "Whether this reader had already been shown the item, from their own cursor."
  seen: Boolean!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  "The kind in the reader's words, for a filter chip."
  kindLabel: String!
  status: WatchtowerItemStatus!
  "Who owns the exception; absent while nobody does."
  assigneeId: ID
  assignee: User
  "When the owner is expected to have dealt with it; absent when no due time applies."
  dueAt: Timestamp
  "Open, not snoozed, and past its due time."
  overdue: Boolean!
  snoozedUntil: Timestamp
  acknowledgedAt: Timestamp
  "Why it was closed; absent while open."
  resolutionCode: WatchtowerResolutionCode
  resolutionNote: String
  "Who closed it; absent when the source cleared it."
  resolvedById: ID
  resolvedBy: User
  "When the source stopped reporting a problem a person had already resolved."
  sourceClearedAt: Timestamp
  "How many times it has escalated for being overdue."
  escalationLevel: Int!
  lastEscalatedAt: Timestamp
  "What happens at the due time, when the record reports its own deadline."
  dueLabel: String
  "Where the due time came from; absent while there is none."
  dueSource: WatchtowerDueSource
  "The record the item is about; absent when it is about no one record."
  record: WatchtowerRecord
  "The facts about the record that matter here, at most six."
  facts: [WatchtowerFact!]!
  "What is at stake: loads, money, a customer, a clause."
  impact: [String!]!
  "The events that led here, oldest first."
  trail: [WatchtowerTrailEvent!]!
  "What is happening, typed for the view made for it; absent when the item is read from its facts."
  panel: WatchtowerPanel
  "The agent best placed to take the item: one that subscribes to its event."
  suggestedAgentId: ID
  suggestedAgent: AgentDefinition
  "The agent the item was handed to and how far along it is; absent until it is handed off."
  agentWork: WatchtowerAgentWork
}

"One line of an exception's history. The history is never edited."
type WatchtowerItemEvent {
  id: ID!
  itemId: ID!
  kind: WatchtowerItemEventKind!
  "The person behind the change; absent for the system."
  actorId: ID
  actor: User
  fromValue: String!
  toValue: String!
  note: String!
  createdAt: Timestamp!
}

"A resolution a person may pick, in their words."
type WatchtowerResolutionCodeOption {
  code: WatchtowerResolutionCode!
  label: String!
  requiresNote: Boolean!
}

type WatchtowerItemEdge {
  node: WatchtowerItem!
  cursor: String!
}

type WatchtowerItemConnection {
  edges: [WatchtowerItemEdge!]!
  pageInfo: PageInfo!
  "Where this reader's eye last was, so a client can draw the unseen line."
  seenAt: Timestamp!
}

input WatchtowerItemsInput {
  first: Int = 25
  after: String
  "Only these kinds; empty is every kind the reader may see."
  kinds: [WatchtowerSourceKind!]
  "Only these severities; empty is all three."
  severities: [WatchtowerSeverity!]
  "Leave out what has already resolved."
  unresolvedOnly: Boolean = true
  "Only what occurred at or after this instant."
  since: Timestamp
  "Only these statuses; empty is all of them."
  statuses: [WatchtowerItemStatus!]
  "Only what this reader owns."
  assignedToMe: Boolean = false
  "Only what these people own."
  assigneeIds: [ID!]
  "Only what nobody owns; with assigneeIds, what nobody or one of them owns."
  unassigned: Boolean = false
  "Only what is open, not snoozed and past its due time."
  overdueOnly: Boolean = false
  "Only items about this record."
  subjectId: ID
  "Soonest due first, items without a due time last, instead of newest first."
  orderByDue: Boolean = false
}

type WatchtowerKindSummary {
  kind: WatchtowerSourceKind!
  label: String!
  count: Int!
}

"The feed in numbers, for a badge and a set of filter chips."
type WatchtowerCounts {
  unresolved: Int!
  critical: Int!
  "Open and not snoozed: what the queue shows."
  active: Int!
  "Critical, open and not snoozed."
  activeCritical: Int!
  unseen: Int!
  unseenCritical: Int!
  "Open, not snoozed and past their due time."
  overdue: Int!
  "Open with nobody owning them."
  unassigned: Int!
  "Open and owned by this reader."
  mine: Int!
  "Owned by this reader and overdue."
  mineOverdue: Int!
  "Open and in an agent's hands: handed to an agent that has not given it back."
  withAgents: Int!
  byKind: [WatchtowerKindSummary!]!
  seenAt: Timestamp!
}

"""
What a hand-off did. With a run, an agent is already working on the item;
with subscribers, the event went to them; with neither, the candidates are
the agents that could take it, for the person to choose from.
"""
type WatchtowerHandOffResult {
  item: WatchtowerItem!
  run: AgentRun
  subscribers: [AgentDefinition!]!
  candidates: [AgentDefinition!]!
  "Templates that handle this item's event, for an organization with no such agent yet."
  templates: [String!]!
}

input AssignWatchtowerItemInput {
  "The new owner; omit to leave the exception with nobody."
  assigneeId: ID
  note: String
  "The version the person was looking at; a newer one refuses the change."
  expectedVersion: Int
}

input SnoozeWatchtowerItemInput {
  until: Timestamp!
  note: String
  expectedVersion: Int
}

input SetWatchtowerItemDueInput {
  "The new due time; omit to clear it."
  dueAt: Timestamp
  note: String
  expectedVersion: Int
}

input ResolveWatchtowerItemInput {
  code: WatchtowerResolutionCode!
  "Required when the code is Other."
  note: String
  expectedVersion: Int
}

input ReopenWatchtowerItemInput {
  note: String
  expectedVersion: Int
}

input HandOffWatchtowerItemInput {
  "Start this agent on the item's subject; omit to publish the item's event to whoever subscribes."
  agentDefinitionId: ID
}

extend type Query {
  "What needs attention, newest first, filtered to what this reader may see."
  watchtowerItems(input: WatchtowerItemsInput!): WatchtowerItemConnection!
  watchtowerCounts: WatchtowerCounts!
  "One item, if this reader may see it."
  watchtowerItem(id: ID!): WatchtowerItem!
  "What happened to an item, oldest first."
  watchtowerItemHistory(id: ID!, limit: Int = 100): [WatchtowerItemEvent!]!
  "The resolutions a person may pick."
  watchtowerResolutionCodes: [WatchtowerResolutionCodeOption!]!
  "How many items this reader resolved or snoozed since an instant, of the kinds they may see."
  watchtowerCleared(since: Timestamp!): Int!
  "The agents an item can be handed to: every enabled agent that runs on its own."
  watchtowerHandOffAgents: [AgentDefinition!]!
}

extend type Mutation {
  "Moves this reader's cursor, so what is already read stops counting as unseen."
  markWatchtowerSeen(seenAt: Timestamp): WatchtowerCounts!
  "Takes an item off the feed without touching the record behind it."
  dismissWatchtowerItem(id: ID!): WatchtowerItem!
  "Hands an item to an agent, or to whoever subscribes to its event."
  handOffWatchtowerItem(id: ID!, input: HandOffWatchtowerItemInput!): WatchtowerHandOffResult!
  "Gives an exception to someone who can see it, or to nobody."
  assignWatchtowerItem(id: ID!, input: AssignWatchtowerItemInput!): WatchtowerItem!
  "Says someone has seen an open exception; an unowned one becomes the reader's."
  acknowledgeWatchtowerItem(id: ID!, expectedVersion: Int): WatchtowerItem!
  "Says someone is working on an exception; an unowned one becomes the reader's."
  startWatchtowerItem(id: ID!, expectedVersion: Int): WatchtowerItem!
  "Puts an exception aside until a time; it wakes on its own."
  snoozeWatchtowerItem(id: ID!, input: SnoozeWatchtowerItemInput!): WatchtowerItem!
  "Moves or clears an exception's due time."
  setWatchtowerItemDue(id: ID!, input: SetWatchtowerItemDueInput!): WatchtowerItem!
  "Adds a comment to an exception's history."
  commentOnWatchtowerItem(id: ID!, body: String!): WatchtowerItemEvent!
  "Closes an exception with a reason."
  resolveWatchtowerItem(id: ID!, input: ResolveWatchtowerItemInput!): WatchtowerItem!
  "Opens a resolved exception again."
  reopenWatchtowerItem(id: ID!, input: ReopenWatchtowerItemInput!): WatchtowerItem!
  "Records that this reader opened an item, so it stops showing as new to them."
  markWatchtowerItemSeen(id: ID!): WatchtowerItem!
  "Brings a snoozed exception back before its time."
  wakeWatchtowerItem(id: ID!, expectedVersion: Int): WatchtowerItem!
}
