type ApiKey {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  name: String!
  description: String!
  keyPrefix: String!
  status: String!
  expiresAt: Timestamp!
  lastUsedAt: Timestamp!
  lastUsedIp: String!
  lastUsedUserAgent: String!
  createdById: ID!
  revokedById: ID!
  revokedAt: Timestamp!
  permissionScope: String!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type ApiKeyEdge {
  node: ApiKey!
  cursor: String!
}

type ApiKeyConnection {
  edges: [ApiKeyEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  apiKeys(input: DataTableConnectionInput!): ApiKeyConnection!
  apiKey(id: ID!): ApiKey
}

"One grant of an API key."
type ApiKeyPermission {
  resource: String!
  operations: [String!]!
  dataScope: String!
}

"An API key with its grants. The secret is never readable after it is issued."
type ApiKeyDetail {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  name: String!
  description: String!
  keyPrefix: String!
  status: String!
  expiresAt: Timestamp!
  lastUsedAt: Timestamp!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  permissionScope: String!
  permissions: [ApiKeyPermission!]!
}

"An API key with its secret, shown this once."
type IssuedApiKey {
  apiKey: ApiKeyDetail!
  token: String!
}

input ApiKeyPermissionInput {
  resource: String!
  operations: [String!]!
  dataScope: String!
}

input ApiKeyInput {
  name: String!
  description: String
  "Zero or omitted for a key that never expires."
  expiresAt: Timestamp
  permissions: [ApiKeyPermissionInput!]!
}

extend type Query {
  "An API key with its grants."
  apiKeyDetail(id: ID!): ApiKeyDetail!
}

extend type Mutation {
  "Issues an API key. Its secret is returned this once; every grant is checked against the caller's own access."
  createApiKey(input: ApiKeyInput!): IssuedApiKey!
  updateApiKey(id: ID!, input: ApiKeyInput!): ApiKeyDetail!
  "Replaces an API key's secret. The new secret is returned this once and the old one stops working."
  rotateApiKey(id: ID!): IssuedApiKey!
  revokeApiKey(id: ID!): ApiKeyDetail!
}
