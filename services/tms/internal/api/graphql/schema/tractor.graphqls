"Who owns a piece of equipment."
enum EquipmentOwnershipType {
  CompanyOwned
  Leased
  OwnerOperator
}

type TractorEdge {
  node: Tractor!
  cursor: String!
}

type TractorConnection {
  edges: [TractorEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

type Tractor {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  primaryWorkerId: ID!
  equipmentTypeId: ID!
  equipmentManufacturerId: ID!
  stateId: ID
  fleetCodeId: ID
  secondaryWorkerId: ID
  status: EquipmentStatus!
  equipmentStatus: EquipmentStatus!
  code: String!
  model: String!
  make: String!
  year: Int
  licensePlateNumber: String!
  registrationNumber: String!
  registrationExpiry: Timestamp
  vin: String!
  externalId: String!
  lastKnownLocationId: ID
  lastKnownLocationName: String!
  """
  The move this tractor is on that is in progress now, when it is on one. A stop on
  another move cannot be started with it until that move is done, though a later
  move may be booked with it.
  """
  inProgressMoveId: ID
  "The PRO number of the shipment whose move this tractor is on now."
  inProgressProNumber: String!
  "When the move this tractor is on now is due at its last stop."
  inProgressDueAt: Timestamp
  """
  The fuel the tractor burns. Its miles land on this fuel type's lines of an
  IFTA return.
  """
  fuelType: IFTAFuelType!
  """
  Whether the tractor's miles and fuel enter the IFTA return.
  """
  iftaQualified: Boolean!
  "Who owns the tractor: the company, a lessor, or the owner-operator who drives it."
  ownershipType: EquipmentOwnershipType!
  "The owner-operator who owns the tractor, when it is theirs."
  ownerWorkerId: ID
  "The lessor a leased tractor is leased from."
  lessorName: String!
  "The lessor's reference for the lease."
  leaseReference: String!
  "When the lease on a leased tractor ends."
  leaseEndDate: Timestamp
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  customFields: JSON
  businessUnit: BusinessUnit
  organization: Organization
  equipmentType: EquipmentType
  equipmentManufacturer: EquipmentManufacturer
  fleetCode: FleetCode
  state: UsState
  primaryWorker: Worker
  secondaryWorker: Worker
  ownerWorker: Worker
  lastKnownLocation: LocationReference
}

input TractorInput {
  primaryWorkerId: ID!
  equipmentTypeId: ID!
  equipmentManufacturerId: ID!
  stateId: ID
  fleetCodeId: ID
  secondaryWorkerId: ID
  status: EquipmentStatus = Available
  code: String!
  model: String
  make: String
  year: Int
  licensePlateNumber: String
  registrationNumber: String
  registrationExpiry: Timestamp
  vin: String
  externalId: String
  fuelType: IFTAFuelType = Diesel
  iftaQualified: Boolean = true
  version: Int
  customFields: JSON
}

input TractorPatchInput {
  "Omit to leave unchanged; null is rejected."
  primaryWorkerId: ID @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  equipmentTypeId: ID @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  equipmentManufacturerId: ID @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  stateId: ID @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  fleetCodeId: ID @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  secondaryWorkerId: ID @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  status: EquipmentStatus @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  code: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  model: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  make: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  year: Int @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  licensePlateNumber: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  registrationNumber: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  registrationExpiry: Timestamp @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  vin: String @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  externalId: String @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  fuelType: IFTAFuelType @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  iftaQualified: Boolean @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  version: Int @goField(omittable: true)
  "Omit to leave unchanged; pass null to clear."
  customFields: JSON @goField(omittable: true)
}

input BulkUpdateTractorStatusInput {
  tractorIds: [ID!]!
  status: EquipmentStatus!
}

input LocateTractorInput {
  tractorId: ID!
  newLocationId: ID!
}

extend type Query {
  tractors(
    input: DataTableConnectionInput!
    status: EquipmentStatus
    includeEquipmentDetails: Boolean = false
    includeFleetDetails: Boolean = false
    includeWorkerDetails: Boolean = false
  ): TractorConnection!
  tractor(id: ID!): Tractor
}

extend type Mutation {
  createTractor(input: TractorInput!): Tractor!
  updateTractor(id: ID!, input: TractorInput!): Tractor!
  patchTractor(id: ID!, input: TractorPatchInput!): Tractor!
  bulkUpdateTractorStatus(input: BulkUpdateTractorStatusInput!): [Tractor!]!
  locateTractor(input: LocateTractorInput!): EquipmentContinuity!
}
