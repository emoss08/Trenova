enum CarrierStatus {
  Active
  Inactive
  DoNotUse
}

enum CarrierType {
  Common
  Contract
  Broker
  Exempt
}

enum CarrierComplianceStatus {
  Pending
  Qualified
  Disqualified
  Expired
}

enum CarrierSafetyRating {
  Satisfactory
  Conditional
  Unsatisfactory
  NotRated
}

enum CarrierTaxIDType {
  EIN
  SSN
}

enum CarrierPaymentMethod {
  Check
  ACHManual
}

enum CarrierInsurancePolicyType {
  AutoLiability
  CargoLiability
  GeneralLiability
  WorkersComp
  Umbrella
}

type CarrierContact {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  carrierId: ID!
  name: String!
  title: String
  email: String
  phone: String
  isPrimary: Boolean!
  receivesRateConfirmations: Boolean!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type CarrierInsurancePolicy {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  carrierId: ID!
  policyType: CarrierInsurancePolicyType!
  policyNumber: String!
  providerName: String!
  coverageAmount: Decimal!
  effectiveDate: Timestamp!
  expirationDate: Timestamp!
  isVerified: Boolean!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type Carrier {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  stateId: ID
  remitStateId: ID
  status: CarrierStatus!
  code: String!
  name: String!
  dbaName: String
  carrierType: CarrierType!
  dotNumber: String
  mcNumber: String
  scac: String
  complianceStatus: CarrierComplianceStatus!
  safetyRating: CarrierSafetyRating!
  qualifiedAt: Timestamp
  disqualifiedReason: String
  taxId: String
  taxIdType: CarrierTaxIDType
  w9OnFile: Boolean!
  is1099Eligible: Boolean!
  paymentMethod: CarrierPaymentMethod
  paymentTermDays: Int
  remitToName: String
  remitAddressLine1: String
  remitAddressLine2: String
  remitCity: String
  remitPostalCode: String
  addressLine1: String
  addressLine2: String
  city: String
  postalCode: String
  phone: String
  email: String
  externalId: String
  notes: String
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  businessUnit: BusinessUnit
  organization: Organization
  state: UsState
  remitState: UsState
  contacts: [CarrierContact!]
  insurancePolicies: [CarrierInsurancePolicy!]
}

type CarrierEdge {
  node: Carrier!
  cursor: String!
}

type CarrierConnection {
  edges: [CarrierEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

"An active carrier whose required insurance ends soon or has lapsed: the required policy that ends first and the loads it holds for us now."
type CarrierCoverEnding @kind(resource: "carrier") {
  "The carrier's id."
  id: ID!
  name: String!
  code: String!
  complianceStatus: CarrierComplianceStatus!
  "The required policy that ends first."
  policyType: CarrierInsurancePolicyType!
  policyNumber: String!
  "When that policy ends; before now once it has lapsed."
  endsAt: Timestamp!
  "Required policy types the carrier has no policy on file for."
  missingPolicyTypes: [CarrierInsurancePolicyType!]!
  "Its loads not yet delivered or canceled; null when you may not read shipments or some of them are not yours to read."
  openLoads: Int
}

extend type Query {
  carriers(input: DataTableConnectionInput!): CarrierConnection!
  carrier(id: ID!): Carrier
  "Active carriers whose required insurance ends within a number of days, or lapsed in the last 90 days, the soonest first."
  carrierCoverEnding(
    "From 1 to 90; 30 when left out."
    withinDays: Int
    "At most this many carriers, from 1 to 100; 25 when left out."
    limit: Int
  ): [CarrierCoverEnding!]!
}
