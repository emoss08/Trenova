type SCIMGroupRoleMapping {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  directoryId: ID!
  externalGroupId: String!
  displayName: String!
  roleId: ID!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  role: Role
}

type SCIMGroupRoleMappingEdge {
  node: SCIMGroupRoleMapping!
  cursor: String!
}

type SCIMGroupRoleMappingConnection {
  edges: [SCIMGroupRoleMappingEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  scimGroupRoleMappings(
    input: DataTableConnectionInput!
    directoryId: ID!
  ): SCIMGroupRoleMappingConnection!
}
