enum FormulaReviewDecision {
  Submitted
  Approved
  Rejected
  ChangesRequested
  Expired
}

"An organization library of Tariff functions, constants and types that formula templates import as org.<name>."
type FormulaLibrary {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  "The module name: templates import the library as org.<name>."
  name: String!
  "The module path templates import: org.<name>."
  path: String!
  description: String!
  "The library's Tariff source."
  source: String!
  "The other organization libraries this one imports."
  imports: [FormulaLibraryImport!]!
  "How many test blocks the source holds."
  testCount: Int!
  status: FormulaTemplateStatus!
  submittedById: ID
  submittedAt: Timestamp
  approvedById: ID
  approvedAt: Timestamp
  reviewComment: String!
  version: Int!
  sourceLibraryId: ID
  sourceVersionNumber: Int
  currentVersionNumber: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type FormulaLibraryEdge {
  node: FormulaLibrary!
  cursor: String!
}

type FormulaLibraryConnection {
  edges: [FormulaLibraryEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

"A snapshot of a library. An Active version is approved, and is what templates pin."
type FormulaLibraryVersion {
  id: ID!
  libraryId: ID!
  versionNumber: Int!
  name: String!
  path: String!
  description: String!
  source: String!
  imports: [FormulaLibraryImport!]!
  testCount: Int!
  status: FormulaTemplateStatus!
  changeMessage: String!
  "The fields that changed from the previous version, by field path."
  changeSummary: JSON
  createdById: ID!
  createdBy: User
  createdAt: Timestamp!
}

"One step of a library's review: who did what, in which round, against which approved version."
type FormulaLibraryReview {
  id: ID!
  libraryId: ID!
  round: Int!
  decision: FormulaReviewDecision!
  actorId: ID
  actor: User
  comment: String!
  baseVersionNumber: Int!
  requestedReviewerId: ID
  requestedReviewer: User
  reviewerNote: String!
  createdAt: Timestamp!
}

"A template version that imports a library, and the library version it pinned."
type FormulaLibraryUsage {
  templateId: ID!
  templateName: String!
  templateStatus: FormulaTemplateStatus!
  templateVersion: Int!
  versionStatus: FormulaTemplateStatus!
  libraryVersionNumber: Int!
}

input CreateFormulaLibraryInput {
  "The module name: templates import the library as org.<name>. It must match the source's header."
  name: String!
  description: String
  source: String!
}

input UpdateFormulaLibraryInput {
  name: String!
  description: String
  source: String!
  version: Int!
}

extend type Query {
  formulaLibraries(input: DataTableConnectionInput!): FormulaLibraryConnection!
  formulaLibrary(id: ID!): FormulaLibrary
  "A library's versions, newest first."
  formulaLibraryVersions(libraryId: ID!, first: Int): [FormulaLibraryVersion!]!
  "A library's review history, newest first."
  formulaLibraryReviews(libraryId: ID!): [FormulaLibraryReview!]!
  formulaLibraryVersionDiff(libraryId: ID!, fromVersion: Int!, toVersion: Int!): FormulaVersionDiff!
  formulaLibraryReadiness(libraryId: ID!): FormulaReadiness!
  formulaLibraryReviewDiff(libraryId: ID!): FormulaReviewDiff!
  formulaLibraryReviewers(libraryId: ID!): [FormulaReviewer!]!
  "The template versions that import the library; with versionNumber, those pinning that version."
  formulaLibraryUsages(libraryId: ID!, versionNumber: Int): [FormulaLibraryUsage!]!
}

extend type Mutation {
  createFormulaLibrary(input: CreateFormulaLibraryInput!): FormulaLibrary!
  "A change to the source or the name saves a new version and returns the library to draft."
  updateFormulaLibrary(id: ID!, input: UpdateFormulaLibraryInput!): FormulaLibrary!
  "Copies each library as a draft under a free name; returns the copies."
  duplicateFormulaLibraries(libraryIds: [ID!]!): [FormulaLibrary!]!
  rollbackFormulaLibrary(id: ID!, input: RollbackFormulaVersionInput!): FormulaLibrary!
  "Archiving a library templates import needs confirmInUse."
  archiveFormulaLibrary(id: ID!, confirmInUse: Boolean!): FormulaLibrary!
  submitFormulaLibrary(id: ID!, input: SubmitFormulaReviewInput!): FormulaLibrary!
  approveFormulaLibrary(id: ID!, comment: String): FormulaLibrary!
  rejectFormulaLibrary(id: ID!, comment: String): FormulaLibrary!
  requestFormulaLibraryChanges(id: ID!, comment: String): FormulaLibrary!
  """
  Opens the person's conversation with the formula assistant about a saved library,
  or a fresh one while the library is unsaved (libraryId null).
  """
  openFormulaLibraryAssistantThread(libraryId: ID): PageAssistantThread!
}
