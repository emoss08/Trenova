type DocumentPacketRule {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  resourceType: String!
  documentTypeId: ID!
  required: Boolean!
  allowMultiple: Boolean!
  displayOrder: Int!
  expirationRequired: Boolean!
  expirationWarningDays: Int!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type DocumentPacketRuleEdge {
  node: DocumentPacketRule!
  cursor: String!
}

type DocumentPacketRuleConnection {
  edges: [DocumentPacketRuleEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  documentPacketRules(input: DataTableConnectionInput!): DocumentPacketRuleConnection!
  documentPacketRule(id: ID!): DocumentPacketRule
}
