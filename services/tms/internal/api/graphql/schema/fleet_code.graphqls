type FleetCode {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  managerId: ID!
  status: EntityStatus!
  code: String!
  description: String!
  revenueGoal: Float
  deadheadGoal: Float
  mileageGoal: Float
  color: String!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  businessUnit: BusinessUnit
  organization: Organization
  manager: User
}

type FleetCodeEdge {
  node: FleetCode!
  cursor: String!
}

type FleetCodeConnection {
  edges: [FleetCodeEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

extend type Query {
  fleetCodes(input: DataTableConnectionInput!): FleetCodeConnection!
  fleetCode(id: ID!): FleetCode
}
