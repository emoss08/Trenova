"A factor an organization sells its receivables to. Customers assigned to it are invoiced with its remit-to and notice of assignment."
type FactoringCompany {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  status: EntityStatus!
  code: String!
  name: String!
  addressLine1: String!
  addressLine2: String
  city: String!
  stateId: ID!
  postalCode: String!
  email: String
  phoneNumber: String
  "How the factor is paid: bank, lockbox or ACH details printed under its address."
  remittanceInstructions: String
  "The notice printed on assigned invoices. Blank prints the standard notice."
  noticeOfAssignment: String
  notes: String
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  state: UsState
}

type FactoringCompanyEdge {
  node: FactoringCompany!
  cursor: String!
}

type FactoringCompanyConnection {
  edges: [FactoringCompanyEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

extend type Query {
  factoringCompanies(input: DataTableConnectionInput!): FactoringCompanyConnection!
  factoringCompany(id: ID!): FactoringCompany
}
