"A factor an organization sells its receivables to. Customers assigned to it are invoiced with its remit-to and notice of assignment."
type FactoringCompany {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  status: EntityStatus!
  code: String!
  name: String!
  addressLine1: String!
  addressLine2: String
  city: String!
  stateId: ID!
  postalCode: String!
  email: String
  phoneNumber: String
  "How the factor is paid: bank, lockbox or ACH details printed under its address."
  remittanceInstructions: String
  "The notice printed on assigned invoices. Blank prints the standard notice."
  noticeOfAssignment: String
  "True when the factor buys invoices without recourse and carries the credit risk. Its invoices leave collections and stop counting toward credit exposure."
  nonRecourse: Boolean!
  notes: String
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  state: UsState
}

type FactoringCompanyEdge {
  node: FactoringCompany!
  cursor: String!
}

type FactoringCompanyConnection {
  edges: [FactoringCompanyEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  factoringCompanies(input: DataTableConnectionInput!): FactoringCompanyConnection!
  factoringCompany(id: ID!): FactoringCompany
}

input FactoringCompanyInput {
  status: EntityStatus!
  code: String!
  name: String!
  addressLine1: String!
  addressLine2: String
  city: String!
  stateId: ID!
  postalCode: String!
  email: String
  phoneNumber: String
  remittanceInstructions: String
  noticeOfAssignment: String
  "Kept in step with the agreement in force once the factor has one."
  nonRecourse: Boolean = false
  notes: String
}

input UpdateFactoringCompanyInput {
  id: ID!
  version: Int!
  factoringCompany: FactoringCompanyInput!
}

extend type Mutation {
  createFactoringCompany(input: FactoringCompanyInput!): FactoringCompany!
  updateFactoringCompany(input: UpdateFactoringCompanyInput!): FactoringCompany!
}
