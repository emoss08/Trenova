enum EdiPartnerKind {
  Internal
  External
}

enum EdiConnectionMethod {
  Internal
  AS2
  SFTP
  VAN
}

enum EdiConnectionStatus {
  PendingAcceptance
  Active
  Suspended
  Rejected
  Revoked
}

enum EdiTransferStatus {
  Submitted
  MappingRequired
  PendingApproval
  Processing
  Approved
  Rejected
  Expired
  Canceled
  Failed
}

enum EdiDocumentDirection {
  Inbound
  Outbound
}

enum EdiMessageStatus {
  Generated
  Failed
}

enum EdiMessageDeliveryStatus {
  Queued
  Sending
  Sent
  Failed
  DeadLettered
}

enum EdiMessageAckStatus {
  NotExpected
  Pending
  Accepted
  AcceptedWithErrors
  Rejected
  Failed
}

enum EdiInboundFileStatus {
  Received
  Parsed
  Processed
  PartiallyProcessed
  Quarantined
  Duplicate
}

enum EdiTransferDirection {
  Inbound
  Outbound
}

enum EdiMappingEntityType {
  Customer
  ServiceType
  ShipmentType
  FormulaTemplate
  Location
  Commodity
  AccessorialCharge
  ServiceFailureReasonCode
}

type EdiConnectionCapabilities {
  loadTenderOutbound: Boolean!
  loadTenderInbound: Boolean!
  shipmentStatus: Boolean!
  invoice: Boolean!
}

type EdiConnection {
  id: ID!
  method: EdiConnectionMethod!
  status: EdiConnectionStatus!
  capabilities: EdiConnectionCapabilities!
  requestedAt: Timestamp!
  acceptedAt: Timestamp
  rejectedAt: Timestamp
  rejectionReason: String
  suspendedAt: Timestamp
  revokedAt: Timestamp
}

type EdiPartner @kind(resource: "edi") {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  kind: EdiPartnerKind!
  status: EntityStatus!
  code: String!
  name: String!
  description: String
  internalOrganizationId: ID
  customerId: ID
  defaultTransportId: ID
  defaultMappingProfileId: ID
  country: String!
  timezone: String
  contactName: String
  contactEmail: String
  contactPhone: String
  enabledForInbound: Boolean!
  enabledForOutbound: Boolean!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  internalOrganization: Organization
  connection: EdiConnection
  defaultTransport: EdiCommunicationProfile
}

type EdiCommunicationProfileSecretState {
  key: String!
}

type EdiCommunicationProfile @kind(resource: "edi") {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  ediPartnerId: ID
  ediConnectionId: ID
  method: EdiConnectionMethod!
  status: EntityStatus!
  name: String!
  description: String
  """
  Transport settings for the connection method (AS2, SFTP, VAN, HTTP...). Secret
  values are never included; see secretState for which ones are set.
  """
  config: JSON!
  secretState: [EdiCommunicationProfileSecretState!]
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  partner: EdiPartner
}

type EdiTransfer @kind(resource: "edi") {
  id: ID!
  sourceOrganizationId: ID!
  sourceBusinessUnitId: ID!
  targetOrganizationId: ID!
  targetBusinessUnitId: ID!
  sourcePartnerId: ID!
  targetPartnerId: ID!
  sourceShipmentId: ID
  targetShipmentId: ID
  inboundMessageId: ID
  status: EdiTransferStatus!
  tenderPayload: Any!
  mappingSnapshot: Any!
  rejectionReason: String
  failureReason: String
  submittedAt: Timestamp!
  processedAt: Timestamp
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  sourcePartner: EdiPartner
  targetPartner: EdiPartner
  "Inbound when this organization received the tender, Outbound when it sent it."
  direction: EdiTransferDirection!
  "The other side of the tender: the partner who sent it in, or the one it was sent to."
  counterparty: EdiPartner
  "The tender's bill of lading number."
  bol: String
  "The customer the tender names, as the sender labels it."
  customerLabel: String
  "The service type the tender asks for, as the sender labels it."
  serviceTypeLabel: String
  "The shipment type the tender names, as the sender labels it."
  shipmentTypeLabel: String
  pieces: Int
  weight: Int
  temperatureMin: Int
  temperatureMax: Int
  "How many stops the tender's moves carry."
  stopCount: Int!
  "Each stop of the tender's moves, in order."
  stops: [EdiTenderStop!]!
  commodities: [EdiTenderCommodity!]!
  "What the tender offers to pay."
  charges: EdiTenderCharges
  "Whether the tender can still be accepted or declined."
  canDecide: Boolean!
}

type EdiTenderStop {
  sequence: Int!
  type: String!
  "The stop's location: its name, label or code."
  location: String
  address: String
  city: String
  state: String
  postalCode: String
  windowOpens: Timestamp
  windowCloses: Timestamp
  pieces: Int
  weight: Int
}

type EdiTenderCommodity {
  commodity: String!
  weight: Int!
  pieces: Int!
}

type EdiTenderCharge {
  charge: String!
  method: String
  amount: Decimal!
}

type EdiTenderCharges {
  freight: Decimal
  other: Decimal
  total: Decimal
  additional: [EdiTenderCharge!]!
}

"A partner's code a tender carries that this organization has not mapped to its own record."
type EdiTransferMappingNeed {
  entityType: EdiMappingEntityType!
  "The partner's code or label for it."
  source: String!
}

"One load tender as its card reads it, with what accepting it still waits on."
type EdiTransferDetail @kind(resource: "edi") {
  transfer: EdiTransfer!
  "The partner's codes not yet mapped, read only for an inbound tender that can still be decided; accepting it waits on them."
  unresolvedMappings: [EdiTransferMappingNeed!]!
  "Whether the tender can be accepted now: inbound, still open, and every code mapped."
  canAccept: Boolean!
}

type EdiMessage @kind(resource: "edi") {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  ediPartnerId: ID!
  documentTypeId: ID!
  "The version of the partner's Lading project that read or wrote the message."
  ladingVersionId: ID
  "The flow conversation the message belongs to."
  flowInstanceId: ID
  shipmentId: ID
  transferId: ID
  inboundFileId: ID
  direction: EdiDocumentDirection!
  transactionSet: String!
  x12Version: String!
  status: EdiMessageStatus!
  interchangeControlNumber: String!
  groupControlNumber: String!
  transactionControlNumber: String!
  segmentCount: Int!
  deliveryStatus: EdiMessageDeliveryStatus
  deliveryRemotePath: String
  deliveryAttempts: Int!
  deliveryLastAttemptAt: Timestamp
  deliverySentAt: Timestamp
  deliveryLastError: String
  ackStatus: EdiMessageAckStatus
  ackMessageId: ID
  ackReceivedAt: Timestamp
  ackLastError: String
  generatedAt: Timestamp!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  partner: EdiPartner
  "The invoice the message bills, for a 210."
  invoiceId: ID
  "When the raw X12 was purged under the retention policy."
  rawPurgedAt: Timestamp
}

"The raw X12 of a message or file, cut to its first 16 KB."
type EdiRawText {
  text: String!
  "Whether the X12 is longer than the text shown."
  truncated: Boolean!
  sizeBytes: Int!
}

"One validation finding on an EDI message, naming the segment and element it is about."
type EdiMessageDiagnostic {
  severity: String!
  code: String!
  segmentId: String
  elementPosition: Int
  path: String
  message: String!
  suggestedFix: String
}

"One EDI message as its detail reads it: the document it decoded to and every finding."
type EdiMessageDetail @kind(resource: "edi") {
  message: EdiMessage!
  "What the document says, decoded from its X12."
  decoded: Any
  diagnosticCount: Int!
  "The validation findings, the first 50."
  diagnostics: [EdiMessageDiagnostic!]!
  "The raw X12 as it was sent or received, its first 16 KB; null once purged under the retention policy."
  raw: EdiRawText
}

type EdiInboundFile @kind(resource: "edi") {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  communicationProfileId: ID!
  ediPartnerId: ID
  method: EdiConnectionMethod!
  remotePath: String!
  fileName: String!
  checksum: String!
  sizeBytes: Int!
  interchangeControlNumber: String
  isaSenderQualifier: String
  isaSenderId: String
  isaReceiverQualifier: String
  isaReceiverId: String
  status: EdiInboundFileStatus!
  failureReason: String
  transactionCount: Int!
  receivedAt: Timestamp!
  processedAt: Timestamp
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  partner: EdiPartner
  "When the raw file was purged under the retention policy."
  rawPurgedAt: Timestamp
}

"One inbound EDI file as its detail reads it, with the transaction sets parsed from it."
type EdiInboundFileDetail @kind(resource: "edi") {
  file: EdiInboundFile!
  "The communication profile the file was picked up through."
  communicationProfileName: String
  messageCount: Int!
  "The transaction sets parsed from the file, the first 50."
  messages: [EdiMessage!]!
  "The raw file as it was received, its first 16 KB; null once purged under the retention policy."
  raw: EdiRawText
}

type EdiMappingProfileItem {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  ediPartnerId: ID!
  mappingProfileId: ID!
  entityType: EdiMappingEntityType!
  sourceId: ID!
  sourceLabel: String
  targetId: ID!
  targetLabel: String
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type EdiMappingProfile {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  ediPartnerId: ID!
  name: String!
  description: String
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  partner: EdiPartner
  entries: [EdiMappingProfileItem!]
}

type EdiPartnerEdge {
  node: EdiPartner!
  cursor: String!
}

type EdiPartnerConnection {
  edges: [EdiPartnerEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

