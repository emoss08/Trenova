type DistanceOverrideStop {
  locationId: ID!
  stopOrder: Int!
  location: Location
}

type DistanceOverride {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  originLocationId: ID!
  destinationLocationId: ID!
  customerId: ID
  distance: Float!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  originLocation: Location
  destinationLocation: Location
  customer: Customer
  intermediateStops: [DistanceOverrideStop!]
  businessUnit: BusinessUnit
  organization: Organization
}

type DistanceOverrideEdge {
  node: DistanceOverride!
  cursor: String!
}

type DistanceOverrideConnection {
  edges: [DistanceOverrideEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  distanceOverrides(input: DataTableConnectionInput!): DistanceOverrideConnection!
  distanceOverride(id: ID!): DistanceOverride
}

input DistanceOverrideStopInput {
  locationId: ID!
}

input DistanceOverrideInput {
  originLocationId: ID!
  destinationLocationId: ID!
  "Set to apply the override only to this customer's shipments."
  customerId: ID
  distance: Float!
  "The stops between origin and destination, in the order the route visits them."
  intermediateStops: [DistanceOverrideStopInput!]
  version: Int
}

extend type Mutation {
  createDistanceOverride(input: DistanceOverrideInput!): DistanceOverride!
  updateDistanceOverride(id: ID!, input: DistanceOverrideInput!): DistanceOverride!
  deleteDistanceOverride(id: ID!): Boolean!
}
