enum CostCategoryType {
  DriverWages
  DriverBenefits
  Fuel
  EquipmentPayments
  Maintenance
  Insurance
  Tires
  Tolls
  PermitsLicenses
  Overhead
  Custom
}

enum CostBehavior {
  Fixed
  Variable
}

enum CostRateSource {
  Benchmark
  Override
  GLActual
}

enum EffectiveRateSource {
  Benchmark
  Override
  GLActual
  LiveIndex
}

type CostingControl {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  fuelIndexId: ID
  fuelIndex: FuelIndex
  useLiveFuelPrice: Boolean!
  milesPerGallon: Decimal!
  includeDeadheadMiles: Boolean!
  glActualsEnabled: Boolean!
  glRollingMonths: Int!
  plannedMonthlyMiles: Int
  targetMarginPercent: Decimal
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  categories: [CostCategory!]!
}

type CostCategory {
  id: ID!
  category: CostCategoryType!
  name: String!
  costBehavior: CostBehavior!
  rateSource: CostRateSource!
  benchmarkRatePerMile: Decimal!
  overrideRatePerMile: Decimal
  isActive: Boolean!
  sortOrder: Int!
  version: Int!
  glAccounts: [CostCategoryGLAccountLink!]!
}

type CostCategoryGLAccountLink {
  id: ID!
  glAccountId: ID!
  accountCode: String!
  accountName: String!
}

type FuelCostResolution {
  pricePerGallon: Decimal
  priceDate: String!
  fuelIndexId: ID
  milesPerGallon: Decimal!
  source: EffectiveRateSource!
}

type ResolvedCategoryRate {
  category: CostCategoryType!
  name: String!
  costBehavior: CostBehavior!
  ratePerMile: Decimal!
  effectiveSource: EffectiveRateSource!
}

type GLActualsWindow {
  fromDate: Timestamp!
  toDate: Timestamp!
  fleetMiles: Float!
  hasPostings: Boolean!
}

type ResolvedCostProfile {
  totalCpm: Decimal!
  variableCpm: Decimal!
  fixedCpm: Decimal!
  targetMarginPercent: Decimal
  includeDeadheadMiles: Boolean!
  asOfDate: String!
  fuel: FuelCostResolution
  categories: [ResolvedCategoryRate!]!
  glWindow: GLActualsWindow
}

type CategoryCostLine {
  category: CostCategoryType!
  name: String!
  costBehavior: CostBehavior!
  ratePerMile: Decimal!
  amount: Decimal!
  effectiveSource: EffectiveRateSource!
}

type ShipmentProfitability {
  shipmentId: ID!
  loadedMiles: Float!
  deadheadMiles: Float!
  totalMiles: Float!
  revenue: Decimal!
  estimatedCost: Decimal!
  profit: Decimal!
  marginPercent: Decimal
  revenuePerLoadedMile: Decimal
  breakEvenRpm: Decimal
  missingDistance: Boolean!
  breakdown: [CategoryCostLine!]!
  profile: ResolvedCostProfile!
}

type ShipmentProfitabilityEstimate {
  shipmentId: ID!
  loadedMiles: Float!
  deadheadMiles: Float!
  totalMiles: Float!
  costPerMile: Decimal!
  estimatedCost: Decimal!
  profit: Decimal!
  marginPercent: Decimal
  breakEvenRpm: Decimal
  targetMarginPercent: Decimal
  missingDistance: Boolean!
}

type FleetCostSummary {
  avgCpm: Decimal!
  avgMarginPercent: Decimal
  shipmentCount: Int!
  unprofitableCount: Int!
  totalRevenue: Decimal!
  totalEstimatedCost: Decimal!
  totalMiles: Float!
  emptyMiles: Float!
}

input CostingControlInput {
  fuelIndexId: ID
  useLiveFuelPrice: Boolean!
  milesPerGallon: Decimal!
  includeDeadheadMiles: Boolean!
  glActualsEnabled: Boolean!
  glRollingMonths: Int!
  plannedMonthlyMiles: Int
  targetMarginPercent: Decimal
  version: Int!
}

input CostCategoryUpdateInput {
  id: ID!
  rateSource: CostRateSource!
  overrideRatePerMile: Decimal
  isActive: Boolean!
  glAccountIds: [ID!]!
  version: Int!
}

extend type Query {
  costingControl: CostingControl!
  resolvedCostProfile(asOfDate: String): ResolvedCostProfile!
  shipmentProfitability(shipmentId: ID!): ShipmentProfitability!
  fleetCostSummary(startDate: Timestamp, endDate: Timestamp): FleetCostSummary!
}

extend type Mutation {
  updateCostingControl(input: CostingControlInput!): CostingControl!
  updateCostCategory(input: CostCategoryUpdateInput!): CostCategory!
}
