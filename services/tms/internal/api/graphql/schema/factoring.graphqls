enum FactoringAgreementStatus {
  Draft
  Active
  Ended
}

"Who carries the loss when a customer does not pay a factored invoice."
enum FactoringRecourse {
  "The factor can charge an unpaid invoice back after the chargeback window."
  Recourse
  "The factor buys the invoice and carries the credit risk."
  NonRecourse
}

"How factored invoices are booked."
enum FactoringAccountingTreatment {
  "Each funded invoice leaves receivables, with the fee as an expense."
  Sale
  "Receivables stay on the books and the advance is a liability to the factor."
  SecuredBorrowing
}

enum FactoringNoaStatus {
  Draft
  Sent
  Acknowledged
  Released
}

enum FactoringVerdict {
  Ready
  NotReady
  "On a schedule sent, being sent, or that failed to send to the factor."
  Submitted
  "Not something to factor: unposted, voided, paid, a credit memo, kept out, charged back, or not factored."
  Excluded
  "Funded by the factor; its reserve comes back when the customer pays the factor."
  Funded
}

enum FactoringCheckCode {
  Eligible
  Factored
  Agreement
  Noa
  Dispute
  BillingDocument
  BillingValidation
  AgreementDocument
  ShipmentUnavailable
  "The factor charged the invoice back, so it is collected as the organization's own."
  ChargedBack
}

enum FactoringFixAction {
  SetUpAgreement
  SendNoa
  RecordNoaAcknowledgement
  ResolveDispute
  RequestDocument
  ReviewShipment
}

enum FactoringSubmissionStatus {
  "Being built and delivered; retried automatically before it fails."
  Sending
  Sent
  "Could not be delivered after every retry; retry it or cancel it."
  Failed
  "Cancelled after a failed send; its invoices were released."
  Cancelled
  "Some invoices are funded or rejected and some still wait on the factor."
  PartiallyFunded
  "Every invoice is decided and at least one was funded."
  Funded
  "The factor rejected every invoice on it."
  Rejected
}

enum FactoringSubmissionItemStatus {
  Pending
  "Released when its schedule was cancelled."
  Released
  "The factor advanced it; its reserve is held until the customer pays the factor."
  Funded
  "The factor would not buy it; it goes back to the queue."
  Rejected
  "The factor released its reserve; the factor's part is done."
  Settled
  "The factor charged it back; the organization collects it again."
  ChargedBack
}

enum FactoringFundingOutcome {
  Funded
  Rejected
}

"What a factoring reserve entry records."
enum FactoringReserveEntryKind {
  Funding
  ReserveRelease
  Chargeback
  ChargebackReversal
}

"The account a factoring journal line books to."
enum FactoringAccountRole {
  AccountsReceivable
  Cash
  DueFromFactor
  FeeExpense
  Liability
}

"What a factoring entry does to the invoice."
enum FactoringInvoiceEffect {
  "Leaves the invoice as it is."
  None
  "Settles the invoice's open balance."
  Settle
  "Puts the invoice's balance back open."
  Reopen
}

"How schedules reach a factor."
enum FactoringTransportMethod {
  Email
  Sftp
}

enum FactoringSftpAuthMethod {
  Password
  PrivateKey
}

enum InvoiceFactoringOverride {
  "The invoice follows its customer's factoring."
  Default
  "The invoice stays on the organization's own receivables."
  Exclude
}

"One band of the factor's fee by how long the invoice stays open."
type FactoringFeeTier {
  id: ID!
  "First day of the band, counted from funding."
  daysFrom: Int!
  "Day the band ends, exclusive. Null for the last, open-ended band."
  daysTo: Int
  "Fee as basis points of the invoice amount."
  rateBp: Int!
  "Flat fee for the band, in minor units."
  flatMinor: Int!
}

"The terms an organization agreed with a factor."
type FactoringAgreement {
  id: ID!
  organizationId: ID!
  businessUnitId: ID!
  factoringCompanyId: ID!
  status: FactoringAgreementStatus!
  effectiveFrom: Timestamp!
  effectiveTo: Timestamp
  "Share of the invoice advanced at funding, in basis points."
  advanceRateBp: Int!
  "Share of the invoice held back until the customer pays, in basis points."
  reserveRateBp: Int!
  minimumFeeMinor: Int!
  "Days after the due date before a recourse factor can charge an unpaid invoice back."
  chargebackWindowDays: Int!
  recourse: FactoringRecourse!
  accountingTreatment: FactoringAccountingTreatment!
  "Business days from submission to funding."
  fundingDays: Int!
  "Minutes after midnight, in the organization's time zone, when the day's schedule is proposed."
  submissionTime: Int!
  notes: String
  activatedAt: Timestamp
  endedAt: Timestamp
  "Where the reserve the factor holds is booked, for a sale."
  dueFromFactorAccountId: ID
  "Where the factor's fee is expensed."
  feeExpenseAccountId: ID
  "What is owed the factor, for secured borrowing."
  liabilityAccountId: ID
  "Where the factor's payments land; the organization's cash account when empty."
  cashAccountId: ID
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  feeTiers: [FactoringFeeTier!]!
  "Documents the factor needs with every invoice, beyond what billing already requires."
  documentTypes: [DocumentType!]!
  factoringCompany: FactoringCompany
}

"A notice telling a customer to pay a factor instead of the organization."
type FactoringNoa {
  id: ID!
  organizationId: ID!
  businessUnitId: ID!
  customerId: ID!
  factoringCompanyId: ID!
  status: FactoringNoaStatus!
  sentAt: Timestamp
  sentTo: String
  acknowledgedAt: Timestamp
  "The customer's signed copy, a document on this notice."
  signedDocumentId: ID
  expiresAt: Timestamp
  releasedAt: Timestamp
  releaseReason: String
  notes: String
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  customer: Customer
  factoringCompany: FactoringCompany
}

type FactoringNoaEdge {
  node: FactoringNoa!
  cursor: String!
}

type FactoringNoaConnection {
  edges: [FactoringNoaEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

"One readiness check on an invoice."
type FactoringCheck {
  code: FactoringCheckCode!
  passed: Boolean!
  message: String!
  "What clears the check, when something can."
  fix: FactoringFixAction
  documentTypeId: ID
  documentTypeName: String
  shipmentId: ID
  shipmentPro: String
  detail: String
}

"Whether an invoice is ready to factor, and why not."
type FactoringInvoiceState {
  invoiceId: ID!
  factoringCompanyId: ID
  customerId: ID!
  verdict: FactoringVerdict!
  checks: [FactoringCheck!]!
  failedChecks: Int!
  openBalanceMinor: Int!
  "When the invoice became ready; null while it is not."
  readySince: Timestamp
  evaluatedAt: Timestamp!
  invoice: Invoice
  customer: Customer
  factoringCompany: FactoringCompany
}

type FactoringInvoiceStateEdge {
  node: FactoringInvoiceState!
  cursor: String!
}

type FactoringInvoiceStateConnection {
  edges: [FactoringInvoiceStateEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type FactoringVerdictTotals {
  count: Int!
  amountMinor: Int!
}

type FactoringSummary {
  ready: FactoringVerdictTotals!
  notReady: FactoringVerdictTotals!
  "On a schedule with the factor or being sent to it."
  submitted: FactoringVerdictTotals!
  "Ready for more than a day without being submitted."
  readyUnsubmitted: FactoringVerdictTotals!
  "Funded by the factor, by face value, until the reserve is released or charged back."
  funded: FactoringVerdictTotals!
  "Funded invoices whose reserve the factor still holds, by the reserve held."
  reserveHeld: FactoringVerdictTotals!
  "Funded recourse invoices whose chargeback window closes within a week, by what the organization would repay."
  chargebacksDue: FactoringVerdictTotals!
}

type FactoringDocumentRequestResult {
  recipient: String!
  "Who was asked: Specified, Driver, Carrier or Customer."
  recipientKind: String!
  documentTypes: [String!]!
  shipmentIds: [ID!]!
  sent: Boolean!
}

"What the agreement in force says one invoice should bring in."
type FactoringFunding {
  faceMinor: Int!
  advanceMinor: Int!
  feeMinor: Int!
  reserveMinor: Int!
  "What is left after the advance and the fee, paid when the customer pays."
  restOnReleaseMinor: Int!
  "Days of terms left when submitted, which picks the fee tier."
  days: Int!
  feeRateBp: Int!
}

"One invoice on a schedule of accounts."
type FactoringSubmissionItem {
  id: ID!
  submissionId: ID!
  invoiceId: ID!
  invoiceNumber: String!
  customerId: ID!
  position: Int!
  faceMinor: Int!
  expectedAdvanceMinor: Int!
  expectedFeeMinor: Int!
  expectedReserveMinor: Int!
  expectedDays: Int!
  "The invoice and its supporting documents merged into one PDF."
  packetDocumentId: ID
  status: FactoringSubmissionItemStatus!
  releasedAt: Timestamp
  fundedOn: Timestamp
  "What the factor advanced; null until funded."
  advanceMinor: Int
  "What the factor kept as its fee; null until funded."
  feeMinor: Int
  "What the factor holds back until the customer pays it; null until funded."
  reserveMinor: Int
  rejectionReason: String
  settledOn: Timestamp
  chargedBackOn: Timestamp
  chargebackReason: String
  "When the organization was warned that the chargeback window was closing."
  chargebackWarnedAt: Timestamp
  invoice: Invoice
  customer: Customer
}

"A schedule of accounts: invoices sold to a factor in one delivery."
type FactoringSubmission {
  id: ID!
  organizationId: ID!
  businessUnitId: ID!
  number: String!
  factoringCompanyId: ID!
  agreementId: ID!
  status: FactoringSubmissionStatus!
  currencyCode: String!
  invoiceCount: Int!
  faceMinor: Int!
  expectedAdvanceMinor: Int!
  expectedFeeMinor: Int!
  expectedReserveMinor: Int!
  schedulePdfDocumentId: ID
  scheduleCsvDocumentId: ID
  transportMethod: FactoringTransportMethod!
  "Where the schedule was sent: the recipients, or user@host:directory."
  transportTarget: String!
  "The sent message ids, or the remote directory."
  transportReference: String
  "Counts each send started by a person; a retry starts the next."
  sendAttemptGroup: Int!
  attempts: Int!
  lastError: String
  sentAt: Timestamp
  failedAt: Timestamp
  cancelledAt: Timestamp
  cancelReason: String
  "When the factor's funding was first recorded."
  fundedAt: Timestamp
  submittedById: ID
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  items: [FactoringSubmissionItem!]!
  factoringCompany: FactoringCompany
}

type FactoringSubmissionEdge {
  node: FactoringSubmission!
  cursor: String!
}

type FactoringSubmissionConnection {
  edges: [FactoringSubmissionEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type FactoringSubmissionPlanItem {
  invoiceId: ID!
  invoiceNumber: String!
  customerId: ID!
  customerName: String!
  invoiceDate: Timestamp!
  dueDate: Timestamp
  funding: FactoringFunding!
}

"The schedule that submitting these invoices would send, before anything is sent."
type FactoringSubmissionPlan {
  factoringCompanyId: ID!
  factoringCompanyName: String!
  agreementId: ID!
  transportMethod: FactoringTransportMethod!
  transportTarget: String!
  "Whether each invoice's packet goes with the schedule."
  attachPackets: Boolean!
  currencyCode: String!
  items: [FactoringSubmissionPlanItem!]!
  invoiceCount: Int!
  faceMinor: Int!
  expectedAdvanceMinor: Int!
  expectedFeeMinor: Int!
  expectedReserveMinor: Int!
}

"The schedule an invoice is on while it is with the factor."
type FactoringLiveSubmission {
  submissionId: ID!
  submissionNumber: String!
  submissionStatus: FactoringSubmissionStatus!
  itemId: ID!
  itemStatus: FactoringSubmissionItemStatus!
}

"One movement between the organization and a factor, booked to the ledger. Entries are never edited; a chargeback is undone by a reversal entry."
type FactoringReserveEntry {
  id: ID!
  organizationId: ID!
  businessUnitId: ID!
  factoringCompanyId: ID!
  agreementId: ID!
  submissionId: ID!
  submissionItemId: ID!
  invoiceId: ID!
  customerId: ID!
  kind: FactoringReserveEntryKind!
  treatment: FactoringAccountingTreatment!
  currencyCode: String!
  "Cash in from the factor (positive) or paid back to it (negative)."
  cashMinor: Int!
  "Fee expense booked (positive) or rebated (negative)."
  feeMinor: Int!
  "Change in the reserve the factor holds."
  reserveMinor: Int!
  "Change in what is owed the factor, for secured borrowing."
  liabilityMinor: Int!
  "Change in receivables: negative settles the invoice, positive reopens it."
  arMinor: Int!
  journalEntryId: ID!
  journalBatchId: ID!
  accountingDate: Timestamp!
  occurredOn: Timestamp!
  reversesEntryId: ID
  memo: String
  createdById: ID
  createdAt: Timestamp!
  factoringCompany: FactoringCompany
  invoice: Invoice
  customer: Customer
  submission: FactoringSubmission
}

type FactoringReserveEntryEdge {
  node: FactoringReserveEntry!
  cursor: String!
}

type FactoringReserveEntryConnection {
  edges: [FactoringReserveEntryEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

"What a factor holds and has paid, from its reserve entries."
type FactoringReserveBalance {
  factoringCompanyId: ID!
  "Reserve the factor holds and has not released or charged back."
  reserveMinor: Int!
  "What is owed the factor under secured borrowing."
  liabilityMinor: Int!
  "Cash advanced at funding."
  advancedMinor: Int!
  "Cash released from the reserve."
  releasedMinor: Int!
  "Cash paid back for chargebacks, net of reversals."
  chargedBackMinor: Int!
  "Fees booked to date."
  feeMinor: Int!
  entryCount: Int!
  lastOccurredOn: Timestamp
}

"One line of the journal a factoring action would book."
type FactoringPlannedLine {
  role: FactoringAccountRole!
  accountId: ID!
  account: JournalEntryLineAccount
  debit: Int!
  credit: Int!
}

"The amounts one factoring movement moves, by what they touch."
type FactoringMovement {
  kind: FactoringReserveEntryKind!
  treatment: FactoringAccountingTreatment!
  "Cash in from the factor (positive) or paid back to it (negative)."
  cashMinor: Int!
  "Fee expense booked (positive) or rebated (negative); it balances the entry."
  feeMinor: Int!
  reserveMinor: Int!
  liabilityMinor: Int!
  arMinor: Int!
  invoiceEffect: FactoringInvoiceEffect!
  "What is settled on or reopened on the invoice."
  invoiceMinor: Int!
}

"What one factoring action books, before anything is booked."
type FactoringPlannedMovement {
  itemId: ID!
  invoiceId: ID!
  invoiceNumber: String!
  customerId: ID!
  movement: FactoringMovement!
  "Empty when nothing is booked, such as releasing an empty reserve."
  lines: [FactoringPlannedLine!]!
  "The day asked for."
  requestedDate: Timestamp!
  "The day it books on: the first open day when the asked day falls in a closed period."
  accountingDate: Timestamp!
  fiscalPeriodId: ID
  fiscalPeriodName: String
  "Whether the entry waits for approval before it posts."
  requiresApproval: Boolean!
}

"What recording a factor's funding would do."
type FactoringFundingPlan {
  submissionId: ID!
  "The schedule's status once the funding is recorded."
  status: FactoringSubmissionStatus!
  movements: [FactoringPlannedMovement!]!
  fundedCount: Int!
  rejectCount: Int!
  advanceMinor: Int!
  feeMinor: Int!
  reserveMinor: Int!
}

"What releasing a reserve, or recording or reversing a chargeback, would do."
type FactoringReserveMovementPlan {
  submissionId: ID!
  itemId: ID!
  "The invoice's status on the schedule afterwards."
  itemStatus: FactoringSubmissionItemStatus!
  "Null when nothing is booked."
  movement: FactoringPlannedMovement
  "The chargeback a reversal undoes."
  reverses: FactoringReserveEntry
}

"How schedules reach a factor. The SFTP secret is never returned."
type FactoringTransport {
  id: ID!
  factoringCompanyId: ID!
  method: FactoringTransportMethod!
  emailRecipients: [String!]!
  "Whether invoice packets are emailed with the schedule. SFTP always uploads them."
  attachPackets: Boolean!
  sftpHost: String
  sftpPort: Int
  sftpUsername: String
  sftpAuthMethod: FactoringSftpAuthMethod
  sftpSecretSet: Boolean!
  sftpKnownHostKey: String
  sftpDirectory: String
  lastTestedAt: Timestamp
  lastTestError: String
  version: Int!
}

type FactoringTransportTestResult {
  transport: FactoringTransport!
  passed: Boolean!
  message: String!
}

input FactoringReserveEntryListInput {
  table: DataTableConnectionInput!
  factoringCompanyId: ID
  submissionId: ID
  invoiceId: ID
  kinds: [FactoringReserveEntryKind!]
}

input FactoringFundingItemInput {
  itemId: ID!
  outcome: FactoringFundingOutcome!
  "What the factor advanced. Defaults to the expected advance."
  advanceMinor: Int
  "What the factor kept as its fee. Defaults to the expected fee."
  feeMinor: Int
  "Why the factor rejected the invoice."
  reason: String
}

input RecordFactoringFundingInput {
  submissionId: ID!
  version: Int!
  "The day the factor funded."
  fundedOn: Timestamp!
  items: [FactoringFundingItemInput!]!
  memo: String
}

input FactoringReserveMovementInput {
  submissionId: ID!
  itemId: ID!
  "The schedule's version."
  version: Int!
  "The day it happened."
  occurredOn: Timestamp!
  "The cash that moved. A release defaults to the reserve held; a chargeback to the advance and fee. A reversal takes none."
  cashMinor: Int
  "A memo for a release; why for a chargeback or its reversal."
  reason: String
}

input FactoringSubmissionListInput {
  table: DataTableConnectionInput!
  factoringCompanyId: ID
  statuses: [FactoringSubmissionStatus!]
}

input FactoringSubmissionPlanInput {
  factoringCompanyId: ID!
  invoiceIds: [ID!]!
}

input RetryFactoringSubmissionInput {
  id: ID!
  version: Int!
}

input CancelFactoringSubmissionInput {
  id: ID!
  version: Int!
  reason: String!
}

input SaveFactoringTransportInput {
  factoringCompanyId: ID!
  "Required when the factor already has delivery settings."
  version: Int
  method: FactoringTransportMethod!
  emailRecipients: [String!]
  attachPackets: Boolean = true
  sftpHost: String
  sftpPort: Int
  sftpUsername: String
  sftpAuthMethod: FactoringSftpAuthMethod
  "Leave empty to keep the stored password or key."
  sftpSecret: String
  sftpKnownHostKey: String
  sftpDirectory: String
}

input FactoringFeeTierInput {
  daysFrom: Int!
  daysTo: Int
  rateBp: Int!
  flatMinor: Int = 0
}

input FactoringAgreementInput {
  factoringCompanyId: ID!
  effectiveFrom: Timestamp!
  effectiveTo: Timestamp
  advanceRateBp: Int!
  reserveRateBp: Int!
  minimumFeeMinor: Int = 0
  chargebackWindowDays: Int!
  recourse: FactoringRecourse!
  accountingTreatment: FactoringAccountingTreatment!
  fundingDays: Int!
  submissionTime: Int!
  notes: String
  feeTiers: [FactoringFeeTierInput!]!
  documentTypeIds: [ID!]
  dueFromFactorAccountId: ID
  feeExpenseAccountId: ID
  liabilityAccountId: ID
  cashAccountId: ID
}

input UpdateFactoringAgreementInput {
  id: ID!
  version: Int!
  agreement: FactoringAgreementInput!
}

input ChangeFactoringAgreementStatusInput {
  id: ID!
  version: Int!
  "When the agreement stops covering invoices. Defaults to now."
  endAt: Timestamp
}

input FactoringNoaListInput {
  table: DataTableConnectionInput!
  customerId: ID
  factoringCompanyId: ID
  statuses: [FactoringNoaStatus!]
}

input DraftFactoringNoaInput {
  customerId: ID!
  factoringCompanyId: ID!
  notes: String
}

input SendFactoringNoaInput {
  id: ID!
  version: Int!
  "Addresses to send to. Defaults to the customer's invoice email recipients."
  recipient: String
}

input AcknowledgeFactoringNoaInput {
  id: ID!
  version: Int!
  acknowledgedAt: Timestamp!
  "The signed copy, uploaded as a document on this notice."
  signedDocumentId: ID!
  expiresAt: Timestamp
}

input ReleaseFactoringNoaInput {
  id: ID!
  version: Int!
  reason: String!
}

input FactoringInvoiceStateListInput {
  table: DataTableConnectionInput!
  verdicts: [FactoringVerdict!]
  factoringCompanyId: ID
  customerId: ID
}

input SetInvoiceFactoringOverrideInput {
  invoiceId: ID!
  override: InvoiceFactoringOverride!
  "Required when keeping the invoice out of factoring."
  reason: String
}

input RequestMissingFactoringDocumentsInput {
  invoiceId: ID!
  "Ask for these only. Defaults to every document the invoice is missing."
  documentTypeIds: [ID!]
  "Defaults to the driver, then the carrier, then the customer's invoice email recipients."
  recipient: String
  message: String
}

enum FactoringRemittanceStatus {
  Pending
  NeedsMapping
  Parsed
  Failed
  PartiallyApplied
  Applied
  Discarded
}

enum FactoringRemittanceSource {
  Upload
  Email
}

enum FactoringRemittanceFormat {
  Csv
  Xlsx
  Pdf
}

"What a remittance line records."
enum FactoringRemittanceLineKind {
  Funding
  Rejection
  ReserveRelease
  Chargeback
  "A fee, adjustment or anything not tied to one invoice; it is not booked from the remittance."
  Other
}

enum FactoringRemittanceMatchStatus {
  Matched
  Suggested
  Unmatched
  Ignored
  Error
  Applied
}

enum FactoringRemittanceMatchedBy {
  Auto
  Person
}

"Why a line was matched or suggested, or why nothing was."
enum FactoringRemittanceMatchReason {
  InvoiceAmountDate
  InvoiceAmount
  InvoiceNearAmount
  PartialInvoiceAmount
  InvoiceOnly
  PartialInvoiceNearAmount
  AmountOnly
  NearAmountOnly
  ClaimedByAnotherLine
  ChosenByPerson
  NoOpenItem
  NotBookedFromRemittance
}

"What a remittance file's column holds."
enum FactoringRemittanceField {
  InvoiceNumber
  FactorReference
  Debtor
  Kind
  Face
  Advance
  Fee
  Reserve
  Cash
  Date
}

enum FactoringRemittanceLineAction {
  Match
  Unmatch
  Ignore
  Restore
  SetKind
}

"Which column of the file holds a field."
type FactoringRemittanceColumn {
  field: FactoringRemittanceField!
  "The column's position, counting from zero."
  column: Int!
}

"A factor's funding or reserve report, read and matched to schedule items before it is booked."
type FactoringRemittance {
  id: ID!
  organizationId: ID!
  businessUnitId: ID!
  factoringCompanyId: ID!
  documentId: ID
  fileName: String
  source: FactoringRemittanceSource!
  "The message it came in on, when it was emailed."
  inboundMessageId: ID
  sourceFormat: FactoringRemittanceFormat
  status: FactoringRemittanceStatus!
  "What a line records when the file has no column saying so."
  defaultKind: FactoringRemittanceLineKind!
  remittedOn: Timestamp
  currencyCode: String!
  mapping: [FactoringRemittanceColumn!]!
  headers: [String!]!
  "Columns of the file no field reads."
  unmappedHeaders: [String!]!
  lineCount: Int!
  matchedCount: Int!
  "Lines suggested, unmatched or unreadable."
  exceptionCount: Int!
  appliedCount: Int!
  "Cash on the lines that are not ignored or unreadable."
  totalCashMinor: Int!
  error: String
  stagedAt: Timestamp
  appliedAt: Timestamp
  appliedById: ID
  discardedAt: Timestamp
  discardReason: String
  createdById: ID
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  factoringCompany: FactoringCompany
}

type FactoringRemittanceEdge {
  node: FactoringRemittance!
  cursor: String!
}

type FactoringRemittanceConnection {
  edges: [FactoringRemittanceEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

"A schedule item a line could pay, ranked."
type FactoringRemittanceSuggestion {
  itemId: ID!
  submissionId: ID!
  invoiceNumber: String!
  score: Int!
  reason: FactoringRemittanceMatchReason!
}

"One row of a factor's remittance."
type FactoringRemittanceLine {
  id: ID!
  remittanceId: ID!
  "The row in the factor's file, counting from the top."
  rowNumber: Int!
  cells: [String!]!
  kind: FactoringRemittanceLineKind!
  invoiceNumber: String
  factorReference: String
  debtorName: String
  faceMinor: Int
  advanceMinor: Int
  feeMinor: Int
  reserveMinor: Int
  cashMinor: Int
  occurredOn: Timestamp
  matchStatus: FactoringRemittanceMatchStatus!
  matchedBy: FactoringRemittanceMatchedBy
  submissionItemId: ID
  "The invoice number of the schedule item the line is matched to."
  matchedInvoiceNumber: String
  matchedSubmissionId: ID
  score: Int!
  reason: FactoringRemittanceMatchReason
  suggestions: [FactoringRemittanceSuggestion!]!
  error: String
  ignoredReason: String
  reserveEntryId: ID
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type FactoringRemittanceLineEdge {
  node: FactoringRemittanceLine!
  cursor: String!
}

type FactoringRemittanceLineConnection {
  edges: [FactoringRemittanceLineEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

"What applying one matched line would book."
type FactoringRemittancePlanLine {
  lineId: ID!
  rowNumber: Int!
  kind: FactoringRemittanceLineKind!
  invoiceNumber: String!
  submissionId: ID!
  itemId: ID!
  cashMinor: Int!
  "Null for a rejection, which books nothing."
  movement: FactoringPlannedMovement
}

"What applying a remittance's matched lines would book, before anything is booked."
type FactoringRemittancePlan {
  remittanceId: ID!
  lines: [FactoringRemittancePlanLine!]!
  fundedCount: Int!
  rejectedCount: Int!
  releasedCount: Int!
  chargebackCount: Int!
  "Lines still to resolve; they stay open after the apply."
  leftOpenCount: Int!
  advanceMinor: Int!
  feeMinor: Int!
  releasedMinor: Int!
  chargebackMinor: Int!
}

input FactoringRemittanceListInput {
  table: DataTableConnectionInput!
  factoringCompanyId: ID
  inboundMessageId: ID
  statuses: [FactoringRemittanceStatus!]
}

input FactoringRemittanceLineListInput {
  table: DataTableConnectionInput!
  remittanceId: ID!
  matchStatuses: [FactoringRemittanceMatchStatus!]
}

input CreateFactoringRemittanceInput {
  factoringCompanyId: ID!
  "Funding unless the report is of reserve releases, rejections or chargebacks."
  defaultKind: FactoringRemittanceLineKind
  "The day the factor sent the report."
  remittedOn: Timestamp
}

input FactoringRemittanceColumnInput {
  field: FactoringRemittanceField!
  column: Int!
}

input StageFactoringRemittanceInput {
  id: ID!
  version: Int!
  "The file, uploaded with resource type factoring_remittance and this remittance's id."
  documentId: ID!
  "Which column holds each field; omitted to use the factor's saved layout or the standard headers. A mapping that reads is saved for the factor."
  mapping: [FactoringRemittanceColumnInput!]
  defaultKind: FactoringRemittanceLineKind
  remittedOn: Timestamp
}

input FactoringRemittanceVersionInput {
  id: ID!
  version: Int!
}

input UpdateFactoringRemittanceLineInput {
  remittanceId: ID!
  "The remittance's version."
  version: Int!
  lineId: ID!
  action: FactoringRemittanceLineAction!
  "The schedule item, for Match."
  itemId: ID
  "What the line records, for SetKind."
  kind: FactoringRemittanceLineKind
  "Why the line is not booked, for Ignore."
  reason: String
}

input DiscardFactoringRemittanceInput {
  id: ID!
  version: Int!
  reason: String!
}

extend type Invoice {
  factoringOverride: InvoiceFactoringOverride!
  "Why the invoice stays out of factoring; null unless it is excluded."
  factoringOverrideReason: String
  "The agreement in force when the invoice posted."
  factoringAgreementId: ID
  "The factor the invoice was assigned to when it posted."
  factoringCompany: FactoringCompany
  "Whether the invoice is ready to factor. Null until it is first evaluated."
  factoringState: FactoringInvoiceState
}

extend type FactoringInvoiceState {
  "The schedule the invoice is on, while it is with the factor."
  submission: FactoringLiveSubmission
}

extend type CustomerBillingProfile {
  factoringCompany: FactoringCompany
}

extend type FactoringCompany {
  agreements: [FactoringAgreement!]!
}

extend type Query {
  factoringAgreements(factoringCompanyId: ID!): [FactoringAgreement!]!
  factoringAgreement(id: ID!): FactoringAgreement!
  factoringNoas(input: FactoringNoaListInput!): FactoringNoaConnection!
  factoringNoa(id: ID!): FactoringNoa!
  "Evaluates the invoice now and returns its readiness."
  factoringReadiness(invoiceId: ID!): FactoringInvoiceState!
  factoringInvoiceStates(input: FactoringInvoiceStateListInput!): FactoringInvoiceStateConnection!
  factoringSummary: FactoringSummary!
  factoringSubmissions(input: FactoringSubmissionListInput!): FactoringSubmissionConnection!
  factoringSubmission(id: ID!): FactoringSubmission!
  "The schedule these invoices would make, with expected funding, without sending anything."
  factoringSubmissionPlan(input: FactoringSubmissionPlanInput!): FactoringSubmissionPlan!
  "Null until the factor's delivery is set up."
  factoringTransport(factoringCompanyId: ID!): FactoringTransport
  factoringReserveEntries(input: FactoringReserveEntryListInput!): FactoringReserveEntryConnection!
  factoringReserveBalance(factoringCompanyId: ID!): FactoringReserveBalance!
  "What recording this funding would book, without booking it."
  factoringFundingPlan(input: RecordFactoringFundingInput!): FactoringFundingPlan!
  "What releasing this reserve would book, without booking it."
  factoringReleasePlan(input: FactoringReserveMovementInput!): FactoringReserveMovementPlan!
  "What recording this chargeback would book, without booking it."
  factoringChargebackPlan(input: FactoringReserveMovementInput!): FactoringReserveMovementPlan!
  "What reversing the invoice's chargeback would book, without booking it."
  factoringChargebackReversalPlan(input: FactoringReserveMovementInput!): FactoringReserveMovementPlan!
  factoringRemittances(input: FactoringRemittanceListInput!): FactoringRemittanceConnection!
  factoringRemittance(id: ID!): FactoringRemittance!
  factoringRemittanceLines(input: FactoringRemittanceLineListInput!): FactoringRemittanceLineConnection!
  "What applying the remittance's matched lines would book, without booking it."
  factoringRemittancePlan(input: FactoringRemittanceVersionInput!): FactoringRemittancePlan!
}

extend type Mutation {
  createFactoringAgreement(input: FactoringAgreementInput!): FactoringAgreement!
  updateFactoringAgreement(input: UpdateFactoringAgreementInput!): FactoringAgreement!
  activateFactoringAgreement(input: ChangeFactoringAgreementStatusInput!): FactoringAgreement!
  endFactoringAgreement(input: ChangeFactoringAgreementStatusInput!): FactoringAgreement!
  draftFactoringNoa(input: DraftFactoringNoaInput!): FactoringNoa!
  "Emails the customer the notice letter. Sending the same version again does not send twice."
  sendFactoringNoa(input: SendFactoringNoaInput!): FactoringNoa!
  acknowledgeFactoringNoa(input: AcknowledgeFactoringNoaInput!): FactoringNoa!
  releaseFactoringNoa(input: ReleaseFactoringNoaInput!): FactoringNoa!
  setInvoiceFactoringOverride(input: SetInvoiceFactoringOverrideInput!): FactoringInvoiceState!
  requestMissingFactoringDocuments(input: RequestMissingFactoringDocumentsInput!): FactoringDocumentRequestResult!
  "Builds the schedule and its packets and sends them to the factor. Submitting the same Ready invoices again returns the first schedule."
  submitInvoicesToFactor(input: FactoringSubmissionPlanInput!): FactoringSubmission!
  "Sends a failed schedule again with the factor's current delivery settings."
  retryFactoringSubmission(input: RetryFactoringSubmissionInput!): FactoringSubmission!
  "Cancels a failed schedule and releases its invoices for another."
  cancelFactoringSubmission(input: CancelFactoringSubmissionInput!): FactoringSubmission!
  saveFactoringTransport(input: SaveFactoringTransportInput!): FactoringTransport!
  "Connects with the saved settings without sending anything, and records the result."
  testFactoringTransport(factoringCompanyId: ID!): FactoringTransportTestResult!
  "Records what the factor funded or rejected on a schedule and books each funded invoice."
  recordFactoringFunding(input: RecordFactoringFundingInput!): FactoringSubmission!
  "Books the factor's release of an invoice's reserve; the factor's part is then done."
  releaseFactoringReserve(input: FactoringReserveMovementInput!): FactoringSubmission!
  "Books a recourse factor's chargeback; the invoice is the organization's to collect again."
  recordFactoringChargeback(input: FactoringReserveMovementInput!): FactoringSubmission!
  "Undoes the invoice's last chargeback with the opposite entry."
  reverseFactoringChargeback(input: FactoringReserveMovementInput!): FactoringSubmission!
  "Opens a remittance for a factor; upload its file next, then read it."
  createFactoringRemittance(input: CreateFactoringRemittanceInput!): FactoringRemittance!
  "Reads the uploaded file and matches its lines to the factor's schedule items."
  stageFactoringRemittance(input: StageFactoringRemittanceInput!): FactoringRemittance!
  "Matches the remittance's open lines again against the schedules as they are now."
  rematchFactoringRemittance(input: FactoringRemittanceVersionInput!): FactoringRemittance!
  "Matches, unmatches, ignores, restores or re-kinds one line."
  updateFactoringRemittanceLine(input: UpdateFactoringRemittanceLineInput!): FactoringRemittance!
  "Books every matched line through the factoring ledger in one transaction."
  applyFactoringRemittance(input: FactoringRemittanceVersionInput!): FactoringRemittance!
  discardFactoringRemittance(input: DiscardFactoringRemittanceInput!): FactoringRemittance!
}
