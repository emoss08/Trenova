"""
A single eligibility observation about pairing a driver with a move. Block findings
disqualify the pairing; Warn findings are advisory; Info findings describe gaps in the
telematics feed rather than problems with the driver.
"""
type DispatchFinding {
  code: String!
  severity: String!
  field: String!
  message: String!
  regulation: String
}

"""
One part of what a pairing costs, in cents. A negative line is a credit, such as a move that
leaves the driver where drivers are worth more.
"""
type DispatchCostLine {
  "emptyMiles, lateness, idleWait, rest, homeTime, fairness, customerExperience, onTimeHistory, safety, acceptance, trailerContinuity, haulFit, timeOffBuffer or endMarket."
  component: String!
  cents: Int!
  "True for a preference that chooses between drivers without deciding whether a move is worth covering."
  soft: Boolean!
}

"""
A driver-and-equipment pairing judged against one move.
"""
type DispatchCandidate {
  workerId: ID!
  workerName: String!
  tractorId: ID
  trailerId: ID
  moveId: ID!
  "What this driver taking the move costs, in cents: the sum of its cost lines."
  costCents: Int!
  costLines: [DispatchCostLine!]!
  verdict: String!
  blocked: Boolean!
  "Empty miles to the pickup; null when where the driver is is unknown."
  deadheadMiles: Float
  "Where the empty miles start: commitment (the end of the driver's last load), positioning (the area the driver was sent toward from the freight outlook), position (live GPS) or lastDrop (where the tractor was last left). Empty when unknown."
  originSource: String!
  loadedMiles: Float!
  estimatedDriveMs: Int!
  "Rest the driver needs on the way, from the hours-of-service projection."
  restMs: Int!
  projectedArrival: Timestamp!
  projectedDelivery: Timestamp!
  projectedFreeAt: Timestamp!
  minutesOfSlack: Int!
  "False when the move has no pickup appointment still ahead to measure margin against."
  slackKnown: Boolean!
  deliveryLateMinutes: Int!
  "False when the driver's hours of service are not known or are too old to trust."
  hosKnown: Boolean!
  driveRemainingMs: Int!
  shiftRemainingMs: Int!
  cycleRemainingMs: Int!
  projectedTimeAvailable: Int!
  """
  Rest strategy that makes this trip legal: currentClocks, splitSleeper,
  tenHourReset, or restart34. Empty when no projection ran.
  """
  hosStrategy: String!
  "Latest unix time the required pre-departure rest must start; 0 when none is needed."
  hosRestStartDeadline: Timestamp!
  hosProjectedDriveMs: Int!
  hosProjectedShiftMs: Int!
  hosProjectedCycleMs: Int!
  findings: [DispatchFinding!]!
  "Why the endMarket cost line is what it is; null when the move leaves the driver nowhere the plan values."
  endMarket: DispatchEndMarket
}

"""
Where the endMarket credit comes from. Forecast: freight the organization's own history says is
likely to appear near the drop, net of what is booked and of the other drivers expected there.
History: what drivers free there have been worth to past plans.
"""
enum DispatchEndMarketSource {
  Forecast
  History
}

"One customer behind a freight forecast, with the loads it usually brings in the window."
type DispatchForecastCustomer {
  customerId: ID!
  name: String!
  expectedLoads: Float!
}

"""
The reason behind a candidate's endMarket credit. The forecast fields are set only when the
source is Forecast.
"""
type DispatchEndMarket {
  source: DispatchEndMarketSource!
  "The credit, in cents: the negative of the endMarket cost line. Negative when the move takes the driver from somewhere worth more than where it leaves them."
  valueCents: Int!
  "What the driver is worth where the move leaves them, in cents."
  dropValueCents: Int!
  "What the driver was worth staying where they are, in cents; the credit is the drop value less this."
  stayValueCents: Int!
  "The area the driver would leave, when the forecast values it."
  stayAreaLabel: String
  "The area the drop is in, named for its busiest origin, such as Dallas, TX."
  areaLabel: String
  "The twelve hours after the driver is free in which the forecast looks for freight."
  windowStart: Timestamp
  windowEnd: Timestamp
  "The usual range of loads in the window (10th to 90th percentile)."
  typicalLow: Int
  typicalHigh: Int
  "Loads already booked for the window."
  booked: Int
  "Other drivers expected to be free in the area by the end of the window."
  driversExpected: Int
  customers: [DispatchForecastCustomer!]!
}

"""
The live tender riding on a move, condensed to what a board card chip needs: where the
waterfall stands and which carrier is currently holding the offer.
"""
type DispatchBoardTenderSummary {
  id: ID!
  status: TenderStatus!
  mode: TenderMode!
  currentRank: Int!
  offerCount: Int!
  currentCarrierName: String!
  currentOfferExpiresAt: Timestamp
}

type DispatchBoardMove {
  moveId: ID!
  shipmentId: ID!
  proNumber: String!
  bol: String!
  moveStatus: String!
  shipmentStatus: String!
  sequence: Int!
  moveCount: Int!
  loaded: Boolean!
  distance: Float
  revenue: Float
  customerId: ID
  customerName: String!
  serviceTypeId: ID
  serviceTypeCode: String!
  requiredTractorTypeId: ID
  requiredTrailerTypeId: ID
  temperatureMin: Int
  temperatureMax: Int
  hasHazmat: Boolean!
  hasActiveHold: Boolean!

  urgency: String!
  minutesToPickup: Int!
  isCovered: Boolean!

  originStopId: ID
  originLocationId: ID
  originName: String!
  originCity: String!
  originState: String!
  originLatitude: Float
  originLongitude: Float
  originWindowStart: Timestamp!
  originWindowEnd: Timestamp
  originActualArrival: Timestamp

  destinationStopId: ID
  destinationLocationId: ID
  destinationName: String!
  destinationCity: String!
  destinationState: String!
  destinationLatitude: Float
  destinationLongitude: Float
  destinationWindowStart: Timestamp!
  destinationWindowEnd: Timestamp

  assignmentId: ID
  assignedWorkerId: ID
  assignedWorkerName: String!
  assignedTractorId: ID
  assignedTractorCode: String!
  assignedTrailerId: ID
  assignedTrailerCode: String!
  assignmentAckStatus: String!
  previousMoveTrailerId: ID

  coverageType: String!
  carrierAssignmentId: ID
  assignedCarrierId: ID
  assignedCarrierName: String!
  carrierTotalCost: Float

  liveTender: DispatchBoardTenderSummary
  """
  The coverage the dispatch agent proposed for this move and is waiting on a decision.
  Present on dispatchBoard and dispatchMove for a caller who may see agent proposals;
  absent everywhere else, and when nothing is waiting.
  """
  pendingProposal: DispatchMoveProposal
  failedProposal: DispatchMoveFailedProposal
  """
  What the last plan said this move is worth and who should take it. Absent on a covered
  move and on one no plan has priced yet.
  """
  planPrice: DispatchMovePlanPrice
}

"""
The price the last plan put on an uncovered move. The coverage price is what leaving it
uncovered costs; the plan covers it when a driver costs less. Plan again to refresh it.
"""
type DispatchMovePlanPrice {
  "The driver the plan put on the move; absent when the plan left it uncovered."
  workerId: ID
  "The planned driver, or for an uncovered move the cheapest driver the plan considered."
  workerName: String!
  "What the named driver costs the plan on this move, in cents."
  costCents: Int!
  """
  What the best driver for this move pays in preferences, in cents. A candidate costs the
  plan its own cost less this, which is what the plan weighed against the coverage price.
  """
  preferenceFloorCents: Int!
  coveragePriceCents: Int!
  "How much more the plan costs without the planned driver, in cents."
  driverValueCents: Int!
  "Why the plan left the move uncovered; absent when it is covered."
  uncoveredReason: DispatchUncoveredReason
  alternatives: [DispatchPlanAlternative!]!
  generatedAt: Timestamp!
}

"The move the last plan put a driver on, and what the driver is worth to it."
type DispatchDriverPlannedMove {
  moveId: ID!
  proNumber: String!
  costCents: Int!
  "How much more the plan costs without this driver, in cents."
  valueCents: Int!
  generatedAt: Timestamp!
}

"""
A coverage proposal waiting on a move: the driver, tractor and trailer the dispatch agent
would put on it, how sure it is and why. Decide it with decideAgentProposals.
"""
type DispatchMoveProposal {
  id: ID!
  workerId: ID!
  workerName: String!
  tractorId: ID!
  trailerId: ID
  "The agent's confidence, from 0 to 1."
  confidence: Float!
  rationale: String!
  createdAt: Timestamp!
  "When the proposal stops being decidable; absent when it does not expire."
  expiresAt: Timestamp
  """
  The move changed after the proposal was planned, so approving it would be refused.
  The next plan replaces it.
  """
  stale: Boolean!
}

"""
A coverage proposal someone approved whose assignment was refused. It stays on its move
until the move changes or a newer proposal replaces it, so the board says why the move is
still uncovered instead of showing it as never proposed.
"""
type DispatchMoveFailedProposal {
  id: ID!
  workerId: ID!
  workerName: String!
  "Why the assignment was refused, worded for the dispatcher, with the stop it is about."
  reason: String!
  failedAt: Timestamp!
}

"""
An assignment a driver already holds inside the planning horizon. The console draws these
as committed blocks on the timeline.
"""
type DispatchCommitment {
  moveId: ID!
  shipmentId: ID!
  proNumber: String!
  moveStatus: String!
  windowStart: Timestamp!
  windowEnd: Timestamp!
  destinationCity: String!
  destinationState: String!
  destinationLatitude: Float
  destinationLongitude: Float
  trailerId: ID
}

type DispatchTimeOff {
  startDate: Timestamp!
  endDate: Timestamp!
  type: String!
}

type DispatchBoardDriver {
  workerId: ID!
  firstName: String!
  lastName: String!
  workerType: String!
  driverType: String!
  fleetCodeId: ID
  fleetCodeName: String!
  city: String!
  stateAbbreviation: String!
  postalCode: String!
  profilePicUrl: String!
  assignmentBlocked: String!
  availableForDispatch: Boolean!

  tractorId: ID
  tractorCode: String!
  tractorTypeId: ID
  tractorAvailable: Boolean!
  openAssignments: Int!

  availability: String!
  dutyStatus: String!
  driveRemainingMs: Int!
  shiftRemainingMs: Int!
  cycleRemainingMs: Int!
  breakRemainingMs: Int!
  hosRecordedAt: Timestamp!
  hosIsStale: Boolean!

  latitude: Float
  longitude: Float
  formattedLocation: String!
  positionRecordedAt: Timestamp!

  projectedTimeAvailable: Int!
  committedMiles: Float!
  committedRevenue: Float!
  commitments: [DispatchCommitment!]!
  timeOff: [DispatchTimeOff!]!
  findings: [DispatchFinding!]!
  plannedMove: DispatchDriverPlannedMove
  """
  When the driver was last home: recorded on the worker, seen by telematics near home, or the
  end of approved time off. Absent when nothing says.
  """
  lastHomeAt: Timestamp
}

"""
The metrics strip at the top of the console: the numbers a dispatcher is measured on.
"""
type DispatchBoardSummary {
  uncoveredMoves: Int!
  coveredMoves: Int!
  "Uncovered moves whose window closed unvisited: the board's Late group."
  lateMoves: Int!
  "Uncovered moves whose window is open or opens within four hours: the board's Due now group."
  atRiskMoves: Int!
  unseatedDrivers: Int!
  availableDrivers: Int!
  assignedToday: Int!
  averageDeadheadMiles: Float!
  utilizationPercent: Float!
}

type DispatchBoard {
  moves: [DispatchBoardMove!]!
  drivers: [DispatchBoardDriver!]!
  "True when more drivers match than the board lists; drivers available for dispatch come first."
  driversTruncated: Boolean!
  summary: DispatchBoardSummary!
  windowStart: Timestamp!
  windowEnd: Timestamp!
  generatedAt: Timestamp!
}

type DispatchDriverMoveMatch {
  move: DispatchBoardMove!
  candidate: DispatchCandidate!
}

"""
The pre-flight a dispatcher sees before a drag-and-drop assignment commits.
requiresOverride is true when the pairing trips a rule the organization enforces as a
hard block, so the confirm action can be labelled honestly.
"""
type DispatchAssignmentPreview {
  moveId: ID!
  workerId: ID!
  tractorId: ID
  trailerId: ID
  blocked: Boolean!
  requiresOverride: Boolean!
  candidate: DispatchCandidate!
}

"""
Per-move outcome of a bulk assignment. Failures carry their reason rather than aborting
the batch: covering nine of ten moves and saying which one failed beats covering none.
"""
type DispatchAssignResult {
  moveId: ID!
  success: Boolean!
  assignmentId: ID
  error: String
  findings: [DispatchFinding!]!
}

type DispatchBulkAssignResult {
  succeeded: Int!
  failed: Int!
  results: [DispatchAssignResult!]!
}

input DispatchBoardInput {
  windowStart: Timestamp
  windowEnd: Timestamp
  fleetCodeIds: [ID!]
  customerIds: [ID!]
  serviceTypeIds: [ID!]
  workerIds: [ID!]
  query: String
  includeCovered: Boolean
  limit: Int
}

input DispatchMoveCandidatesInput {
  moveId: ID!
  fleetCodeIds: [ID!]
  limit: Int
  includeBlocked: Boolean
}

input DispatchDriverMovesInput {
  workerId: ID!
  windowStart: Timestamp
  windowEnd: Timestamp
  limit: Int
}

input DispatchAssignmentPreviewInput {
  moveId: ID!
  workerId: ID!
  tractorId: ID
  trailerId: ID
}

input DispatchAssignMoveInput {
  moveId: ID!
  primaryWorkerId: ID!
  tractorId: ID!
  trailerId: ID
  secondaryWorkerId: ID
  """
  Replace an existing assignment rather than creating one. The console sets this when a
  dispatcher drags a driver onto a move that is already covered.
  """
  reassign: Boolean
}

input DispatchCarrierAccessorialInput {
  accessorialChargeId: ID
  description: String!
  amount: Decimal!
}

input DispatchAssignMoveToCarrierInput {
  moveId: ID!
  carrierId: ID!
  rateMethod: CarrierRateMethod!
  baseRate: Decimal!
  fuelSurcharge: Decimal
  accessorials: [DispatchCarrierAccessorialInput!]
  proNumber: String
  externalDriverName: String
  externalDriverPhone: String
  externalTractorNumber: String
  externalTrailerNumber: String
  """
  Replace an existing carrier assignment rather than rejecting the request. The console
  sets this when a dispatcher re-covers a move that already has carrier coverage.
  """
  replace: Boolean
  """
  Proceed despite insurance policies that expire inside the warning window. Hard blockers
  (inactive, unqualified, or expired coverage) can never be overridden.
  """
  overrideInsuranceWarning: Boolean
}

input DispatchCarrierAssignmentPreviewInput {
  carrierId: ID!
}

type DispatchCarrierEligibility {
  blockers: [String!]!
  warnings: [String!]!
}

extend type Query {
  dispatchBoard(input: DispatchBoardInput!): DispatchBoard!
  """
  One move as the board draws it, whatever window it falls in, so a selection that points
  outside the window on screen still opens. Carries its pending proposal like the board.
  """
  dispatchMove(moveId: ID!): DispatchBoardMove!
  dispatchMoveCandidates(input: DispatchMoveCandidatesInput!): [DispatchCandidate!]!
  dispatchDriverMoves(input: DispatchDriverMovesInput!): [DispatchDriverMoveMatch!]!
  dispatchAssignmentPreview(
    input: DispatchAssignmentPreviewInput!
  ): DispatchAssignmentPreview!
}

extend type Mutation {
  dispatchAssignMoves(input: [DispatchAssignMoveInput!]!): DispatchBulkAssignResult!
  dispatchUnassignMoves(moveIds: [ID!]!): DispatchBulkAssignResult!
  dispatchAssignMoveToCarrier(input: DispatchAssignMoveToCarrierInput!): CarrierAssignment!
  dispatchCancelCarrierAssignment(moveId: ID!, reason: String!): Boolean!
}

extend type Query {
  dispatchCarrierAssignmentPreview(
    input: DispatchCarrierAssignmentPreviewInput!
  ): DispatchCarrierEligibility!
}

"""
One move-to-driver pairing the optimizer chose, carrying the same explainable score a
dispatcher sees when they pick a driver by hand.
"""
type DispatchPlannedAssignment {
  moveId: ID!
  proNumber: String!
  workerId: ID!
  workerName: String!
  tractorId: ID
  trailerId: ID
  confidence: Float!
  rationale: String!
  """
  True only when the organization allows unattended execution and this pairing cleared
  its confidence threshold with no blocking findings.
  """
  autoExecutable: Boolean!
  proposalId: ID
  candidate: DispatchCandidate!
  """
  What this driver costs the plan on the move, in cents: the candidate's cost less what the
  best driver for the move pays in preferences too. This is what was weighed against the
  coverage price.
  """
  planCostCents: Int!
  "What leaving the move uncovered would cost, in cents: its share of revenue plus any urgency premium."
  coveragePriceCents: Int!
  "What this driver is worth to the plan, in cents: how much more the plan costs without them."
  driverValueCents: Int!
  "The next cheapest drivers and exactly how much more the whole plan costs if each takes the move instead."
  alternatives: [DispatchPlanAlternative!]!
  """
  Set only under Horizon planning: the tour this move belongs to and its position
  within that tour. Immediate planning leaves both empty.
  """
  tourId: ID
  sequenceIndex: Int!
  """
  When the driver is projected to start and finish this move, and the drive time left
  on their clock afterwards. These are projections from the plan, not commitments.
  """
  projectedStartAt: Timestamp!
  projectedCompleteAt: Timestamp!
}

type DispatchPlanAlternative {
  workerId: ID!
  workerName: String!
  "How much more the whole plan costs, in cents, when this driver takes the move and the rest re-plan around it."
  extraCents: Int!
}

"""
A sequence of moves horizon planning chained onto one driver. Each move's empty miles
are measured from where the previous move ends, which is what makes the chain worth
more than the same moves assigned independently.
"""
type DispatchTour {
  tourId: ID!
  workerId: ID!
  workerName: String!
  moveIds: [ID!]!
  startsAt: Timestamp!
  endsAt: Timestamp!
  costCents: Int!
  emptyMiles: Float!
}

"""
A move the optimizer could not cover. Reporting these matters more than the successes: a
move that silently vanishes from a plan is a load nobody is watching.
"""
enum DispatchUncoveredReason {
  NoCandidate
  Disqualified
  BeyondDeadhead
  LocationUnknown
  "Every driver costs more than leaving the move."
  NotWorthIt
  "Its drivers are worth more on other moves."
  Outbid
}

type DispatchUncoveredMove {
  moveId: ID!
  proNumber: String!
  reason: DispatchUncoveredReason!
  "The reason in a sentence, with the driver it is about."
  explanation: String!
  "What the cheapest driver would have cost the plan, in cents; zero when none could take it."
  planCostCents: Int!
  coveragePriceCents: Int!
  "The nearest driver who could not take it, or the cheapest who was outbid."
  bestCandidate: DispatchCandidate
}

type DispatchPlan {
  runId: ID
  assignments: [DispatchPlannedAssignment!]!
  uncovered: [DispatchUncoveredMove!]!
  """
  Populated under Horizon planning only; empty when the organization plans a single
  period at a time.
  """
  tours: [DispatchTour!]!
  planningMode: String!
  """
  True when the organization is watching what the agent would do without letting it act;
  nothing was written.
  """
  shadowMode: Boolean!
  autonomyTier: String!
  "What the covered moves cost, in cents."
  costCents: Int!
  "What the uncovered moves cost by being left, in cents."
  uncoveredCents: Int!
  generatedAt: Timestamp!
}

input DispatchPlanInput {
  windowStart: Timestamp
  windowEnd: Timestamp
  fleetCodeIds: [ID!]
  moveIds: [ID!]
}

extend type Mutation {
  dispatchPlanAutoAssign(input: DispatchPlanInput!): DispatchPlan!
}

"""
Whether the organization's freight forecast has proven itself on its own history. Plans use the
forecast only when it is Ready.
"""
enum DispatchForecastStatus {
  "Fewer than 8 weeks or 200 loads of history."
  InsufficientHistory
  "Tested, but not clearly better than repeating last week."
  NoSkill
  Ready
}

"""
How the freight forecast did when it was tested on the last weeks of the organization's own
history: each week forecast from the weeks before it, then compared with what came.
"""
type DispatchForecastQuality {
  status: DispatchForecastStatus!
  "Weeks of history the forecast learns from."
  historyWeeks: Int!
  historyLoads: Int!
  weeksTested: Int!
  loadsTested: Int!
  "Share of the tested days whose load total fell inside the forecast's 80% range."
  intervalCoverage: Float!
  "Average miss per active area and four-hour slot, in loads: the forecast's ranked probability score."
  meanAbsoluteError: Float!
  "The same average miss for repeating the same slot of the week before."
  naiveMeanAbsoluteError: Float!
  "How much better than repeating last week the forecast is: 0.3 is 30% smaller misses."
  skill: Float!
  "When it was last fitted; null before the first fit."
  fittedAt: Timestamp
  """
  True while the history is being read again: a forecast that is not Ready and was fitted more
  than an hour ago is refitted when it is read. The figures are still those from fittedAt.
  """
  refitting: Boolean!
}

"""
One area's four-hour window in the freight outlook: the loads likely to start there against the
drivers expected, served in order, so a driver used in one window is not counted again.
"""
type DispatchFreightSlot {
  start: Timestamp!
  "When the window ends: four hours on, three or five on the two nights the clocks change."
  end: Timestamp!
  "Loads likely to start in the window, booked included (10th to 90th percentile)."
  likelyLow: Int!
  likelyHigh: Int!
  booked: Int!
  "Loads expected to need a driver: booked but not yet covered, plus still to be booked."
  need: Float!
  "Drivers free in the area by the end of the window."
  drivers: Int!
  "Loads likely to have no truck nearby."
  short: Float!
  "Drivers likely to have nothing nearby once the window's loads are served."
  spare: Float!
}

type DispatchFreightAreaCustomer {
  customerId: ID!
  name: String!
  "Share of the freight expected in the area over the outlook."
  share: Float!
}

"A forecast area (a map tile about 50 miles across) over the next 48 hours."
type DispatchFreightArea {
  cell: Int!
  label: String!
  latitude: Float!
  longitude: Float!
  "What one more driver ending there is worth to the plan at its worst window, in cents."
  valueCents: Int!
  slots: [DispatchFreightSlot!]!
  customers: [DispatchFreightAreaCustomer!]!
}

"""
The whole network's four-hour window: loads likely against every driver, as if drivers could be
anywhere. The gap between short here and uncovered (summed over areas) is placement.
"""
type DispatchFreightNetworkSlot {
  start: Timestamp!
  "When the window ends: four hours on, three or five on the two nights the clocks change."
  end: Timestamp!
  "Every load likely in the window, booked or not, the 10th to 90th percentile."
  likelyLow: Int!
  likelyHigh: Int!
  "Loads likely that still need a driver: open booked loads plus those still to be booked."
  need: Float!
  "The 10th to 90th percentile of need, the range drivers are measured against."
  needLow: Int!
  needHigh: Int!
  "Drivers free by the end of the window and not yet used by earlier windows."
  drivers: Float!
  short: Float!
  "Loads with no truck nearby, summed over areas."
  uncovered: Float!
  "Drivers with nothing nearby, summed over areas."
  idle: Float!
}

enum DispatchFreightMoveKind {
  "Send an empty driver toward a short area."
  Send
  "Give a driver a load that ends in a short area instead of running empty."
  Book
  "Keep a driver whose next load would carry them out of an area that is about to run short; partner takes the load."
  Keep
  "Ask a customer behind its usual booking pace for its freight."
  Call
}

"One ranked suggestion of the freight outlook. Money is in cents."
type DispatchFreightMove {
  kind: DispatchFreightMoveKind!
  workerId: ID
  workerName: String!
  fromCell: Int!
  fromLabel: String!
  toCell: Int!
  toLabel: String!
  "The window the move is for."
  slotStart: Timestamp!
  slotEnd: Timestamp!
  "Loads with no truck nearby in that window."
  short: Float!
  freeAt: Timestamp
  arriveAt: Timestamp
  miles: Float!
  emptyCostCents: Int!
  "What the driver is worth at the target."
  dropCents: Int!
  "What the driver is worth where they are."
  stayCents: Int!
  netCents: Int!
  "Book only: the empty-mile cost a load saves against running empty."
  savedCents: Int!
  "Book: the load to give; Keep: the load to hand to partner."
  moveId: ID
  proNumber: String!
  "Book only: every open load that would do, nearest first."
  laneMoveIds: [ID!]!
  partnerId: ID
  partnerName: String!
  "Keep only: the forecast area the partner frees up in."
  partnerCell: Int!
  partnerLabel: String!
  partnerFreeAt: Timestamp
  partnerMiles: Float!
  customerId: ID
  customerName: String!
  "Call only: loads the customer usually sends in the next 24 hours, usually in by now, and in so far."
  usual: Float!
  byNow: Float!
  tendered: Int!
  "Call only: loads still expected from the customer."
  loads: Float!
}

type DispatchFreightPaceSlot {
  start: Timestamp!
  usual: Float!
  byNow: Float!
  tendered: Int!
}

"One customer's freight in one area against its own booking curve."
type DispatchFreightPace {
  customerId: ID!
  customerName: String!
  cell: Int!
  label: String!
  slots: [DispatchFreightPaceSlot!]!
}

"One day of the forecast's track record: the network range forecast out of sample, and what came."
type DispatchForecastDay {
  dayStart: Timestamp!
  low: Int!
  high: Int!
  mean: Float!
  actual: Int!
}

enum DispatchPositioningStatus {
  Active
  Canceled
  Replaced
}

"An empty driver sent toward an area from the freight outlook."
type DispatchPositioning {
  id: ID!
  workerId: ID!
  workerName: String!
  fromLabel: String!
  toCell: Int!
  toLabel: String!
  slotStart: Timestamp!
  freeAt: Timestamp!
  arriveAt: Timestamp!
  miles: Float!
  valueCents: Int!
  status: DispatchPositioningStatus!
  createdAt: Timestamp!
}

type DispatchFreightOutlook {
  quality: DispatchForecastQuality!
  generatedAt: Timestamp!
  "The twelve four-hour windows the outlook covers, from the one under way."
  slotStarts: [Timestamp!]!
  network: [DispatchFreightNetworkSlot!]!
  "The areas most short or most spare, at most 40."
  areas: [DispatchFreightArea!]!
  "Every forecast area, before the cut to 40."
  areaCount: Int!
  moves: [DispatchFreightMove!]!
  pace: [DispatchFreightPace!]!
  record: [DispatchForecastDay!]!
  positionings: [DispatchPositioning!]!
}

enum DispatchFreightReachKind {
  Here
  OnTime
  NotWorth
  TooLate
  TooFar
}

"A driver measured against one area's window: whether they can get there in time and what it would net."
type DispatchFreightReach {
  workerId: ID!
  workerName: String!
  label: String!
  latitude: Float!
  longitude: Float!
  freeAt: Timestamp!
  arriveAt: Timestamp!
  miles: Float!
  netCents: Int!
  reach: DispatchFreightReachKind!
}

"The map tile an area counts its loads and drivers in, in degrees."
type DispatchFreightAreaBounds {
  south: Float!
  west: Float!
  north: Float!
  east: Float!
}

type DispatchFreightAreaDetail {
  quality: DispatchForecastQuality!
  generatedAt: Timestamp!
  area: DispatchFreightArea!
  bounds: DispatchFreightAreaBounds!
  "The window the sheet reads: the one asked for, or the area's worst."
  slotStart: Timestamp!
  slotEnd: Timestamp!
  reach: [DispatchFreightReach!]!
  moves: [DispatchFreightMove!]!
  pace: [DispatchFreightPace!]!
  "Loads in this area and window of the week in each of the last eight weeks, oldest first."
  recent: [Int!]!
  "The usual range for this area and window of the week (10th to 90th percentile)."
  recentLow: Int!
  recentHigh: Int!
  positionings: [DispatchPositioning!]!
  "The area's active locations (up to 100), to read the loads delivering into it."
  deliveryLocationIds: [ID!]!
}

input DispatchPositionDriverInput {
  workerId: ID!
  toCell: Int!
  slotStart: Timestamp!
}

extend type Query {
  "Where trucks will be short or idle over the next 48 hours, the moves that fix it and how far to trust the forecast."
  dispatchFreightOutlook: DispatchFreightOutlook!
  "One area of the freight outlook: its windows, who books there, who can reach it and its track record."
  dispatchFreightArea(cell: Int!, slotStart: Timestamp): DispatchFreightAreaDetail!
  dispatchForecastQuality: DispatchForecastQuality!
}

extend type Mutation {
  "Send an empty driver toward an area and tell them in Dash. Replaces the driver's earlier positioning."
  dispatchPositionDriver(input: DispatchPositionDriverInput!): DispatchPositioning!
  "Call off a positioning and tell the driver."
  dispatchCallOffPositioning(id: ID!): DispatchPositioning!
}
