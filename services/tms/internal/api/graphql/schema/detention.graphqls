enum DetentionPolicyStatus {
  Active
  Inactive
  Draft
}

enum DetentionClockStartBasis {
  Arrival
  Appointment
  LaterOfArrivalOrAppointment
  EarlierOfArrivalOrAppointment
}

enum DetentionLateArrivalRule {
  NoEffect
  Forfeit
  ClockFromAppointment
  ReduceFreeTime
}

enum DetentionRoundingMode {
  Up
  Down
  Nearest
  Exact
}

enum DetentionRateSource {
  Accessorial
  Tiers
}

enum DetentionTierRateUnit {
  Hour
  Day
  Flat
}

enum DetentionNotificationRequirement {
  None
  Advisory
  Required
}

enum DetentionUnnotifiedBehavior {
  Bill
  Flag
  Suppress
}

enum DetentionCapScope {
  PerStop
  PerDay
  PerShipment
}

enum DetentionOccurrenceStatus {
  Accruing
  Pending
  Approved
  Billed
  Waived
  Disputed
  NotBillable
}

enum DetentionNotificationStatus {
  NotRequired
  Pending
  Sent
  Late
  Missed
  Failed
}

enum DetentionCapKind {
  None
  MaxBillableMinutes
  MaxChargePerStop
  MaxChargePerDay
  MaxChargePerShipment
  LayoverBoundary
}

enum DetentionWaiverReason {
  Weather
  FacilityClosure
  CarrierFault
  EquipmentIssue
  CustomerGoodwill
  DataCorrection
  ForceMajeure
  Other
}

enum DetentionScoreBand {
  Strong
  Adequate
  Weak
  AtRisk
}

enum DetentionDeskUrgency {
  Lost
  NoticeOverdue
  NoticeDueSoon
  Accruing
  FreeTimeEnding
  Normal
  "A stopped charge waiting on approval; its shipment cannot be invoiced until it is approved or waived."
  AwaitingApproval
}

enum DetentionNoticeKind {
  Warning
  Started
  Update
  Final
}

enum DetentionNoticeChannel {
  Email
  EDI
  Portal
  Manual
}

enum DetentionNoticeDeliveryStatus {
  Queued
  Sent
  Delivered
  Opened
  Bounced
  Failed
}

enum DetentionEvidenceKind {
  Arrival
  Departure
  Appointment
  Notice
  Document
  StatusChange
  Recalculated
  Waiver
  Dispute
}

enum DetentionEvidenceSource {
  Telematics
  Geofence
  DriverApp
  EDI
  Document
  Manual
  System
}

type DetentionPolicyTier {
  id: ID
  fromMinute: Int!
  toMinute: Int
  rate: Decimal!
  rateUnit: DetentionTierRateUnit!
  label: String!
  sortOrder: Int!
}

type DetentionPolicy {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  name: String!
  code: String!
  description: String!
  status: DetentionPolicyStatus!
  isOrgDefault: Boolean!
  priority: Int!
  specificityScore: Int!
  customerId: ID
  locationId: ID
  shipmentTypeIds: [ID!]!
  serviceTypeIds: [ID!]!
  commodityIds: [ID!]!
  stopTypes: [StopType!]!
  appointmentStopsOnly: Boolean!
  effectiveStartDate: Timestamp
  effectiveEndDate: Timestamp
  clockStartBasis: DetentionClockStartBasis!
  lateArrivalRule: DetentionLateArrivalRule!
  lateArrivalGraceMinutes: Int!
  billingFreeMinutes: Int!
  pickupFreeMinutes: Int
  deliveryFreeMinutes: Int
  payFreeMinutes: Int
  minimumBillableMinutes: Int!
  billingIncrementMinutes: Int!
  roundingMode: DetentionRoundingMode!
  rateSource: DetentionRateSource!
  accessorialChargeId: ID!
  tiers: [DetentionPolicyTier!]!
  maxBillableMinutesPerStop: Int
  maxChargePerStop: Decimal
  maxChargePerDay: Decimal
  maxChargePerShipment: Decimal
  dayBoundaryMode: DetentionCapScope!
  convertToLayoverAtMinutes: Int
  layoverAccessorialChargeId: ID
  notificationRequirement: DetentionNotificationRequirement!
  notificationLeadMinutes: Int!
  notificationDeadlineMinutes: Int!
  unnotifiedBehavior: DetentionUnnotifiedBehavior!
  autoSendNotice: Boolean!
  attachNoticePdf: Boolean!
  sendDepartureSummary: Boolean!
  requireApprovalOverAmount: Decimal
  autoApproveUnderAmount: Decimal
  currency: String!
  comments: String!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type DetentionPolicyEdge {
  node: DetentionPolicy!
  cursor: String!
}

type DetentionPolicyConnection {
  edges: [DetentionPolicyEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

input DetentionTierInput {
  fromMinute: Int!
  toMinute: Int
  rate: Decimal!
  rateUnit: DetentionTierRateUnit = Hour
  label: String
  sortOrder: Int
}

input DetentionPolicyInput {
  name: String!
  code: String!
  description: String
  status: DetentionPolicyStatus = Draft
  isOrgDefault: Boolean = false
  priority: Int = 0
  customerId: ID
  locationId: ID
  shipmentTypeIds: [ID!]
  serviceTypeIds: [ID!]
  commodityIds: [ID!]
  stopTypes: [StopType!]
  appointmentStopsOnly: Boolean = false
  effectiveStartDate: Timestamp
  effectiveEndDate: Timestamp
  clockStartBasis: DetentionClockStartBasis = LaterOfArrivalOrAppointment
  lateArrivalRule: DetentionLateArrivalRule = NoEffect
  lateArrivalGraceMinutes: Int = 0
  billingFreeMinutes: Int = 120
  pickupFreeMinutes: Int
  deliveryFreeMinutes: Int
  payFreeMinutes: Int
  minimumBillableMinutes: Int = 0
  billingIncrementMinutes: Int = 15
  roundingMode: DetentionRoundingMode = Up
  rateSource: DetentionRateSource = Accessorial
  accessorialChargeId: ID!
  tiers: [DetentionTierInput!]
  maxBillableMinutesPerStop: Int
  maxChargePerStop: Decimal
  maxChargePerDay: Decimal
  maxChargePerShipment: Decimal
  dayBoundaryMode: DetentionCapScope = PerStop
  convertToLayoverAtMinutes: Int
  layoverAccessorialChargeId: ID
  notificationRequirement: DetentionNotificationRequirement = None
  notificationLeadMinutes: Int = 30
  notificationDeadlineMinutes: Int = 0
  unnotifiedBehavior: DetentionUnnotifiedBehavior = Bill
  autoSendNotice: Boolean = false
  attachNoticePdf: Boolean = false
  sendDepartureSummary: Boolean = false
  requireApprovalOverAmount: Decimal
  autoApproveUnderAmount: Decimal
  currency: String = "USD"
  comments: String
  version: Int
}

type DetentionOccurrence @kind(resource: "detention") {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  shipmentId: ID!
  shipmentMoveId: ID!
  stopId: ID!
  customerId: ID!
  locationId: ID!
  "The stop's location, null to someone who may not read locations or when it has been removed."
  location: Location
  detentionPolicyId: ID
  policySnapshot: JSON
  calculationTrace: JSON
  stopType: String!
  scheduleType: String!
  appointmentStart: Timestamp
  appointmentEnd: Timestamp
  arrivedAt: Timestamp
  departedAt: Timestamp
  clockStartAt: Timestamp!
  clockStopAt: Timestamp
  freeTimeExpiresAt: Timestamp!
  noticeDueAt: Timestamp
  noticeDeadlineAt: Timestamp
  isOpen: Boolean!
  arrivedLate: Boolean!
  lateByMinutes: Int!
  freeMinutesGranted: Int!
  rawDwellMinutes: Int!
  billableMinutes: Int!
  roundedMinutes: Int!
  billableUnits: Decimal!
  grossAmount: Decimal!
  billableAmount: Decimal!
  driverPayMinutes: Int!
  "What the driver is paid for the wait. Null to a reader without the margins field group, since beside the billed amount it gives the margin."
  driverPayAmount: Decimal @protected(group: Margins)
  "Null to a reader without the margins field group."
  netMargin: Decimal @protected(group: Margins)
  capApplied: DetentionCapKind!
  convertedToLayover: Boolean!
  currency: String!
  status: DetentionOccurrenceStatus!
  notificationStatus: DetentionNotificationStatus!
  noticeSentAt: Timestamp
  suppressedByGate: Boolean!
  requiresApproval: Boolean!
  approvedById: ID
  approvedAt: Timestamp
  "Who approved the charge to bill, null until it is approved or when it was approved automatically."
  approvedBy: User
  waiverReason: DetentionWaiverReason
  waiverNote: String!
  waivedAt: Timestamp
  waivedById: ID
  "Who waived the charge, null unless it was waived."
  waivedBy: User
  waivedAmount: Decimal!
  disputeNote: String!
  disputedAt: Timestamp
  collectabilityScore: Int!
  evidenceHead: String!
  additionalChargeId: ID
  locationName: String!
  customerName: String!
  shipmentProNumber: String!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type DetentionEvidence {
  id: ID!
  detentionOccurrenceId: ID!
  sequence: Int!
  kind: DetentionEvidenceKind!
  source: DetentionEvidenceSource!
  summary: String!
  observedAt: Timestamp!
  recordedAt: Timestamp!
  recordedById: ID
  documentId: ID
  payload: JSON
  prevHash: String!
  hash: String!
  createdAt: Timestamp!
}

type DetentionNotice {
  id: ID!
  detentionOccurrenceId: ID!
  threadKey: String!
  kind: DetentionNoticeKind!
  channel: DetentionNoticeChannel!
  deliveryStatus: DetentionNoticeDeliveryStatus!
  recipients: [String!]
  subject: String!
  body: String!
  scheduledFor: Timestamp!
  sentAt: Timestamp
  deliveredAt: Timestamp
  openedAt: Timestamp
  failedAt: Timestamp
  failureReason: String!
  sentById: ID
  wasAutomatic: Boolean!
  satisfiesRequirement: Boolean!
  quotedFreeMinutes: Int!
  quotedRate: Decimal
  quotedAmount: Decimal
  createdAt: Timestamp!
}

type DetentionScoreFactor {
  key: String!
  label: String!
  earned: Int!
  possible: Int!
  detail: String!
  remedy: String!
}

type DetentionCollectability {
  score: Int!
  band: DetentionScoreBand!
  factors: [DetentionScoreFactor!]!
  chainValid: Boolean!
  summary: String!
}

"A clock still running, priced as of now; the occurrence's own amounts date from its last recalculation."
type DetentionClockPrice {
  billableMinutes: Int!
  billableAmount: Decimal!
  asOf: Timestamp!
}

type DetentionOccurrenceDetail @kind(resource: "detention") {
  occurrence: DetentionOccurrence!
  evidence: [DetentionEvidence!]
  notices: [DetentionNotice!]
  collectability: DetentionCollectability!
  receipt: String!
  "Null once the clock has stopped."
  currentlyBillable: DetentionClockPrice
}

type DetentionDeskEntry @kind(resource: "detention") {
  occurrence: DetentionOccurrence!
  minutesUntilFreeEnds: Int!
  minutesUntilNoticeDue: Int
  noticeWindowOpen: Boolean!
  amountAtRisk: Decimal!
  "The minutes it bills: a running clock's as of now, a stopped charge's as recorded."
  billableMinutes: Int!
  urgency: DetentionDeskUrgency!
}

type DetentionDisputePacket @kind(resource: "detention") {
  occurrence: DetentionOccurrence!
  policySnapshot: JSON
  receipt: String!
  evidence: [DetentionEvidence!]
  notices: [DetentionNotice!]
  collectability: DetentionCollectability!
  chainVerified: Boolean!
  generatedAt: Timestamp!
}

type FacilityDetentionStat {
  locationId: ID!
  locationName: String!
  stopCount: Int!
  breachCount: Int!
  avgDwellMinutes: Int!
  medianDwellMinutes: Float!
  p90DwellMinutes: Float!
  billedAmount: Decimal!
  "What the driver is paid for the wait. Null to a reader without the margins field group, since beside the billed amount it gives the margin."
  driverPayAmount: Decimal @protected(group: Margins)
  "Null to a reader without the margins field group."
  netMargin: Decimal @protected(group: Margins)
  waivedAmount: Decimal!
  disputeCount: Int!
  suppressedCount: Int!
}

"""
Minutes past free time are measured from the dwell: how long the truck waited beyond the free
time it was granted, whether or not it was billed. Each stop's wait is put down to one cause, the
first of: arrived late, no appointment (an open dock), arrived before its appointment, or on time
with the dock slow.
"""
type DetentionIntelligenceTotals {
  stopCount: Int!
  detainedCount: Int!
  pastFreeMinutes: Int!
  dockMinutes: Int!
  openMinutes: Int!
  earlyMinutes: Int!
  lateMinutes: Int!
  billedAmount: Decimal!
  "What drivers were paid for the wait. Null to a reader without the margins field group."
  driverPayAmount: Decimal @protected(group: Margins)
  "Null to a reader without the margins field group."
  netMargin: Decimal @protected(group: Margins)
  waivedAmount: Decimal!
  disputeCount: Int!
  suppressedCount: Int!
  "Charges whose notice had a deadline."
  noticeDueCount: Int!
  "Of those, the ones whose notice went out by the deadline."
  noticeOnTimeCount: Int!
}

type DetentionFacilityIntelligence {
  locationId: ID!
  locationName: String!
  "The facility's city, or empty when the location has none."
  locationCity: String!
  "The two-letter abbreviation of the facility's state, or empty when it has none."
  locationState: String!
  stopCount: Int!
  detainedCount: Int!
  pastFreeMinutes: Int!
  "Minutes past free time in the window before. Null when the facility did not rank there."
  previousPastFreeMinutes: Int
  dockMinutes: Int!
  openMinutes: Int!
  earlyMinutes: Int!
  lateMinutes: Int!
  avgDwellMinutes: Int!
  medianDwellMinutes: Float!
  p90DwellMinutes: Float!
  "The free time a typical stop here is granted."
  medianFreeMinutes: Float!
  billedAmount: Decimal!
  "Null to a reader without the margins field group."
  driverPayAmount: Decimal @protected(group: Margins)
  "Null to a reader without the margins field group."
  netMargin: Decimal @protected(group: Margins)
  waivedAmount: Decimal!
  disputeCount: Int!
  suppressedCount: Int!
  noticeDueCount: Int!
  noticeOnTimeCount: Int!
}

type DetentionCustomerIntelligence {
  customerId: ID!
  customerName: String!
  stopCount: Int!
  detainedCount: Int!
  pastFreeMinutes: Int!
  billedAmount: Decimal!
  "Null to a reader without the margins field group."
  driverPayAmount: Decimal @protected(group: Margins)
  "Null to a reader without the margins field group."
  netMargin: Decimal @protected(group: Margins)
  waivedAmount: Decimal!
  disputeCount: Int!
  noticeDueCount: Int!
  noticeOnTimeCount: Int!
}

"Where accrued money ended up."
enum DetentionRecoveryBucket {
  "The truck arrived late, so the free time was forfeited and the charge was not billable."
  Late
  "Held because notice missed its deadline."
  Notice
  "Forgiven at someone's discretion."
  Waived
  "The customer disputed it."
  Disputed
  "Accruing, pending or approved, not yet billed."
  Pending
  "Not billable for another reason."
  Other
  "What billed charges lost to caps, minimums and rounding."
  Capped
}

type DetentionRecoveryStep {
  bucket: DetentionRecoveryBucket!
  occurrenceCount: Int!
  amount: Decimal!
}

"From what the clock accrued to what was billed, invoiced on a posted invoice and collected on a paid one."
type DetentionRecovery {
  accrued: Decimal!
  steps: [DetentionRecoveryStep!]!
  billed: Decimal!
  invoiced: Decimal!
  collected: Decimal!
}

"Stops by the ISO weekday (1 is Monday) and hour the truck arrived, in the request's time zone."
type DetentionArrivalCell {
  weekday: Int!
  hour: Int!
  stopCount: Int!
  detainedCount: Int!
}

type DetentionSplitFigure {
  stopCount: Int!
  detainedCount: Int!
  pastFreeMinutes: Int!
}

type DetentionStopSplits {
  pickup: DetentionSplitFigure!
  delivery: DetentionSplitFigure!
  appointment: DetentionSplitFigure!
  open: DetentionSplitFigure!
  live: DetentionSplitFigure!
  drop: DetentionSplitFigure!
}

"One week of the window. weekStart is the local Monday at midnight written as if it were UTC."
type DetentionWeek {
  weekStart: Timestamp!
  stopCount: Int!
  detainedCount: Int!
  pastFreeMinutes: Int!
}

"A facility moving to another detention policy partway through the window."
type DetentionPolicyChange {
  locationId: ID!
  locationName: String!
  policyId: ID!
  policyName: String!
  changedAt: Timestamp!
}

enum DetentionSegmentTarget {
  Facility
  Customer
  Section
}

"One run of a sentence: plain, strong, or a reference that opens what it names."
type DetentionNarrativeSegment {
  text: String!
  strong: Boolean!
  "danger for a loss or a leak, good for an improvement."
  tone: String
  target: DetentionSegmentTarget
  "A location or customer ID, or a section of the page: focus, paid or customers."
  targetId: String
}

enum DetentionNextStepKind {
  ShipperReview
  FreeTime
  Notice
  CustomerTerms
  LateArrivals
  EarlyArrivals
}

"One paragraph of the briefing."
type DetentionNarrativeParagraph {
  segments: [DetentionNarrativeSegment!]!
}

"One move the figures point to, sized by what it would recover."
type DetentionNextStep {
  kind: DetentionNextStepKind!
  title: [DetentionNarrativeSegment!]!
  detail: String!
  impactMinutes: Int
  impactAmount: Decimal
  impactCaption: String!
  locationId: ID
  customerId: ID
}

type DetentionIntelligence {
  "How many whole days the window covers."
  days: Int!
  "The window's last day, YYYY-MM-DD in the organization's time zone: a read of one facility passes it to cover the same days."
  through: String!
  "The first instant of the window's first day."
  from: Timestamp!
  to: Timestamp!
  previousFrom: Timestamp!
  previousTo: Timestamp!
  "The organization's IANA time zone, which the days, weekdays, arrival hours and weeks are counted in."
  timezone: String!
  totals: DetentionIntelligenceTotals!
  "The same figures over the window before."
  previous: DetentionIntelligenceTotals!
  "Facilities, most hours past free time first."
  facilities: [DetentionFacilityIntelligence!]!
  "Customers, most hours past free time first."
  customers: [DetentionCustomerIntelligence!]!
  waivers: [DetentionWaiverLeakageStat!]!
  recovery: DetentionRecovery!
  arrivals: [DetentionArrivalCell!]!
  splits: DetentionStopSplits!
  weeks: [DetentionWeek!]!
  policyChanges: [DetentionPolicyChange!]!
  """
  Nova's briefing on the window, in the reader's language: how long trucks waited and whose wait
  it was; where the schedule guarantees detention and when trucks wait; where the money went; and
  what moved against the window before. A paragraph with nothing to say is left out.
  """
  summary: [DetentionNarrativeParagraph!]!
  "At most four moves, ranked by what each would recover."
  nextSteps: [DetentionNextStep!]!
  "More facilities had detention than the list holds."
  truncated: Boolean!
}

type DetentionWaiverLeakageStat {
  reason: String!
  waiverCount: Int!
  approverCount: Int!
  waivedAmount: Decimal!
}

input DetentionPreviewScenarioInput {
  arrivedAt: Timestamp!
  departedAt: Timestamp
  appointmentStart: Timestamp
  appointmentEnd: Timestamp
  stopType: StopType!
  scheduleType: StopScheduleType!
  noticeSentAt: Timestamp
  driverPayRate: Decimal
}

type DetentionPreviewResult {
  policySnapshot: JSON!
  rawDwellMinutes: Int!
  freeMinutesGranted: Int!
  billableMinutes: Int!
  roundedMinutes: Int!
  billableAmount: Decimal!
  grossAmount: Decimal!
  "What the driver is paid for the wait. Null to a reader without the margins field group, since beside the billed amount it gives the margin."
  driverPayAmount: Decimal @protected(group: Margins)
  "Null to a reader without the margins field group."
  netMargin: Decimal @protected(group: Margins)
  arrivedLate: Boolean!
  capApplied: DetentionCapKind!
  status: DetentionOccurrenceStatus!
  notificationStatus: DetentionNotificationStatus!
  suppressedByGate: Boolean!
  calculationTrace: JSON
  receipt: String!
}

input DetentionBacktestInput {
  policy: DetentionPolicyInput!
  from: Timestamp!
  to: Timestamp!
  limit: Int
  driverPayRate: Decimal
  assumeNoticeCompliance: Boolean
}

type DetentionBacktestBucket {
  key: String!
  label: String!
  stopCount: Int!
  billableCount: Int!
  proposedAmount: Decimal!
  baselineAmount: Decimal!
  "proposedAmount minus baselineAmount."
  delta: Decimal!
  "What the driver is paid for the wait. Null to a reader without the margins field group, since beside the billed amount it gives the margin."
  driverPayAmount: Decimal @protected(group: Margins)
  "Null to a reader without the margins field group."
  netMargin: Decimal @protected(group: Margins)
}

type DetentionBacktestResult {
  stopsEvaluated: Int!
  stopsMatched: Int!
  stopsBillable: Int!
  stopsForfeited: Int!
  stopsSuppressed: Int!
  proposedRevenue: Decimal!
  baselineRevenue: Decimal!
  revenueDelta: Decimal!
  "Null to a reader without the margins field group."
  proposedDriverPay: Decimal @protected(group: Margins)
  "Null to a reader without the margins field group."
  proposedNetMargin: Decimal @protected(group: Margins)
  "Null to a reader without the margins field group."
  negativeMarginStops: Int @protected(group: Margins)
  byCustomer: [DetentionBacktestBucket!]!
  byFacility: [DetentionBacktestBucket!]!
  from: Timestamp!
  to: Timestamp!
  truncated: Boolean!
}

input DetentionWaiveInput {
  occurrenceId: ID!
  reason: DetentionWaiverReason!
  note: String!
}

input DetentionDisputeInput {
  occurrenceId: ID!
  note: String!
}

input DetentionIntelligenceInput {
  "How many whole days the window covers, in the organization's time zone: 1 to 366."
  days: Int!
  "The window's last day, YYYY-MM-DD in the organization's time zone, no later than today. Defaults to today."
  through: String
  "Only the stops made at this location, for its scorecard."
  locationId: ID
}

input DetentionStatsInput {
  from: Timestamp!
  to: Timestamp!
  limit: Int
  "Only the stops made at this location."
  locationId: ID
}

extend type Query {
  detentionPolicies(input: DataTableConnectionInput!): DetentionPolicyConnection!
  detentionPolicy(id: ID!): DetentionPolicy
  detentionDesk(
    "Also list the stopped charges waiting on approval, whose shipments cannot be invoiced until someone approves or waives them."
    includeAwaitingApproval: Boolean = false
    "How soon someone has to act, as the board ranks it."
    urgency: DetentionDeskUrgency
    "Only this shipment's occurrences."
    shipmentId: ID
    "A shipment's PRO number, or part of it, ignoring case."
    proNumber: String
  ): [DetentionDeskEntry!]!
  detentionOccurrence(id: ID!): DetentionOccurrenceDetail!
  shipmentDetention(shipmentId: ID!): [DetentionOccurrence!]!
  detentionDisputePacket(occurrenceId: ID!): DetentionDisputePacket!
  detentionFacilityStats(input: DetentionStatsInput!): [FacilityDetentionStat!]!
  "What an organization needs to lower detention, over a window, compared with the window before it."
  detentionIntelligence(input: DetentionIntelligenceInput!): DetentionIntelligence!
  detentionPolicyPreview(
    policy: DetentionPolicyInput!
    scenario: DetentionPreviewScenarioInput!
  ): DetentionPreviewResult!
}

extend type Mutation {
  createDetentionPolicy(input: DetentionPolicyInput!): DetentionPolicy!
  updateDetentionPolicy(id: ID!, input: DetentionPolicyInput!): DetentionPolicy!
  deleteDetentionPolicy(id: ID!): Boolean!
  detentionBacktest(input: DetentionBacktestInput!): DetentionBacktestResult!
  waiveDetentionOccurrence(input: DetentionWaiveInput!): DetentionOccurrence!
  approveDetentionOccurrence(occurrenceId: ID!): DetentionOccurrence!
  disputeDetentionOccurrence(input: DetentionDisputeInput!): DetentionOccurrence!
  sendDetentionNotice(occurrenceId: ID!): DetentionOccurrence!
}
