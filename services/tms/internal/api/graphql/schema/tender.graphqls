enum TenderMode {
  Waterfall
  SpotBroadcast
  SpotSequential
}

enum TenderStatus {
  Active
  Accepted
  Exhausted
  Canceled
  NeedsReview
}

enum TenderOfferStatus {
  Pending
  Sent
  Accepted
  Declined
  Expired
  Withdrawn
  Superseded
  Skipped
  DeliveryFailed
  "A carrier's answer with a rate of its own, waiting on a decision."
  Countered
  "A counter-offer somebody refused."
  CounterRejected
  "An acceptance the carrier walked back."
  Revoked
}

enum TenderChannel {
  Email
  EDI
}

enum TenderResponseSource {
  Email
  EDI
  Manual
}

type TenderOffer {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  tenderId: ID!
  carrierId: ID!
  rank: Int!
  rateMethod: CarrierRateMethod!
  rate: Decimal!
  offerTtlSeconds: Int!
  channel: TenderChannel!
  status: TenderOfferStatus!
  recipientEmail: String!
  sentAt: Timestamp
  expiresAt: Timestamp
  respondedAt: Timestamp
  responseSource: TenderResponseSource
  declineReason: String!
  deliveryError: String!
  ediPartnerId: ID
  ediMessageId: ID
  lateResponseAction: String!
  lateResponseAt: Timestamp
  "The rate the carrier countered with, when it made one."
  counterRate: Decimal
  counterNote: String!
  counteredAt: Timestamp
  """
  The margin the counter leaves, as a percentage of the sell price. Null when the
  load has no sell price, or to a reader without the margins field group.
  """
  counterMarginPercent: Decimal @protected(group: Margins)
  "True when the counter is below the margin floor, so taking it needs the tender approve permission."
  counterNeedsApproval: Boolean!
  counterDecidedAt: Timestamp
  counterDecidedById: ID
  "The rate the carrier is held to: its counter when one stands or was taken, the offered rate otherwise."
  agreedRate: Decimal!
  revokedAt: Timestamp
  revokeReason: String!
  revokedById: ID
  "The offer this one asks again after a carrier backed out."
  reofferedFromId: ID
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  carrier: Carrier
}

type Tender {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  shipmentId: ID!
  shipmentMoveId: ID!
  routingGuideId: ID
  mode: TenderMode!
  status: TenderStatus!
  currentRank: Int!
  createdById: ID
  canceledById: ID
  cancellationReason: String!
  acceptedOfferId: ID
  acceptedAt: Timestamp
  exhaustedAt: Timestamp
  canceledAt: Timestamp
  "How many times a carrier has backed out of an acceptance on this tender."
  bounceCount: Int!
  lastBouncedAt: Timestamp
  "The exhausted tender this one escalated from."
  escalatedFromId: ID
  "Zero for a tender a person or the routing guide started; the escalation round otherwise."
  escalationRound: Int!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  routingGuide: RoutingGuide
  offers: [TenderOffer!]
}

extend type Query {
  tender(id: ID!): Tender
  tendersByShipment(
    shipmentId: ID!
    "Only the tenders of this move of the shipment."
    shipmentMoveId: ID
  ): [Tender!]!
  liveTenderByMove(moveId: ID!): Tender
}

enum TenderResponseAction {
  Accept
  Decline
  Counter
}

input CreateWaterfallTenderInput {
  shipmentMoveId: ID!
  "The routing guide to tender down; the best match for the move when left out."
  routingGuideId: ID
}

input SpotTenderLineInput {
  carrierId: ID!
  rateMethod: CarrierRateMethod!
  rate: Decimal!
  offerTtlSeconds: Int!
  channel: TenderChannel!
  "Where an Email offer goes; the carrier's dispatch contact when left out."
  email: String
}

input CreateSpotTenderInput {
  shipmentMoveId: ID!
  "SpotBroadcast or SpotSequential."
  mode: TenderMode!
  lines: [SpotTenderLineInput!]!
  "Offer carriers whose insurance expires inside the warning window."
  overrideInsuranceWarnings: Boolean
}

"A routing guide entry that never became an offer, or became one despite a warning."
type TenderGuideEntryScreening {
  carrierName: String!
  rank: Int!
  reasons: [String!]!
}

type TenderGuideScreening {
  skipped: [TenderGuideEntryScreening!]!
  warned: [TenderGuideEntryScreening!]!
}

type CreateWaterfallTenderResult {
  tender: Tender!
  "Empty when every routing guide entry was offered."
  screening: TenderGuideScreening
}

input RespondToTenderOfferInput {
  action: TenderResponseAction!
  "Required to decline."
  declineReason: String
  "Required to counter."
  counterRate: Decimal
  counterNote: String
}

extend type Mutation {
  createWaterfallTender(input: CreateWaterfallTenderInput!): CreateWaterfallTenderResult!
  createSpotTender(input: CreateSpotTenderInput!): Tender!
  cancelTender(id: ID!, reason: String!): Boolean!
  "Records a carrier's answer to an offer that a dispatcher took outside Trenova."
  respondToTenderOffer(offerId: ID!, input: RespondToTenderOfferInput!): Boolean!
  "Records a carrier backing out of an accepted tender; the tender moves to the next carrier."
  bounceTender(id: ID!, reason: String!): Tender!
}
