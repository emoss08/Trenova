type DistanceProfile {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  name: String!
  description: String!
  status: String!
  isDefault: Boolean!
  provider: String!
  dataVersion: String!
  region: String!
  routingType: String!
  distanceUnits: String!
  locationGranularity: String!
  profileName: String!
  """
  Routing preferences passed through to the mileage provider.
  """
  highwayOnly: Boolean!
  tollRoads: Boolean!
  bordersOpen: Boolean!
  includeTollData: Boolean!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  businessUnit: BusinessUnit
  organization: Organization
}

type DistanceProfileEdge {
  node: DistanceProfile!
  cursor: String!
}

type DistanceProfileConnection {
  edges: [DistanceProfileEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  distanceProfiles(input: DataTableConnectionInput!): DistanceProfileConnection!
  distanceProfile(id: ID!): DistanceProfile
}

input DistanceProfileInput {
  name: String!
  description: String
  status: String!
  isDefault: Boolean!
  provider: String!
  "Blank takes the provider's current data."
  dataVersion: String
  region: String!
  "Blank takes Practical."
  routingType: String
  "Blank takes Miles."
  distanceUnits: String
  locationGranularity: String!
  profileName: String
  highwayOnly: Boolean!
  tollRoads: Boolean!
  bordersOpen: Boolean!
  includeTollData: Boolean!
  version: Int
}

extend type Mutation {
  createDistanceProfile(input: DistanceProfileInput!): DistanceProfile!
  updateDistanceProfile(id: ID!, input: DistanceProfileInput!): DistanceProfile!
  "Deletes a profile; the default profile is refused."
  deleteDistanceProfile(id: ID!): Boolean!
  "Makes the profile the organization's default, clearing the flag on the previous one."
  setDefaultDistanceProfile(id: ID!): DistanceProfile!
}
