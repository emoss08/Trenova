enum AuditCategory {
  System
  User
}

type AuditEntry {
  id: ID!
  userId: ID
  principalType: String!
  principalId: ID!
  apiKeyId: ID
  businessUnitId: ID!
  organizationId: ID!
  timestamp: Timestamp!
  changes: JSON
  previousState: JSON
  currentState: JSON
  metadata: JSON
  resource: String!
  operation: String!
  resourceId: String!
  correlationId: String
  userAgent: String
  comment: String
  ipAddress: String
  category: AuditCategory!
  sensitiveData: Boolean!
  critical: Boolean!
  entityRef: String
  user: User
}

type AuditEntryEdge {
  node: AuditEntry!
  cursor: String!
}

type AuditEntryConnection {
  edges: [AuditEntryEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  auditEntries(input: DataTableConnectionInput!): AuditEntryConnection!
  auditEntriesByResourceId(
    input: DataTableConnectionInput!
    resourceId: ID!
  ): AuditEntryConnection!
  auditEntry(id: ID!): AuditEntry
}
