enum PeriodType {
  Month
  Quarter
  Week
  Adjusting
}

enum FiscalPeriodStatus {
  Inactive
  Open
  Locked
  Closed
  PermanentlyClosed
}

type FiscalPeriod {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  fiscalYearId: ID!
  periodNumber: Int!
  periodType: PeriodType
  status: FiscalPeriodStatus!
  name: String!
  startDate: Timestamp!
  endDate: Timestamp!
  isAdjusting: Boolean!
  allowAdjustingEntries: Boolean!
  adjustmentDeadline: Timestamp
  lockedAt: Timestamp
  closedAt: Timestamp
  reopenedAt: Timestamp
  "Why the period was last reopened; empty when it never was."
  reopenReason: String
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
}

type FiscalPeriodEdge {
  node: FiscalPeriod!
  cursor: String!
}

type FiscalPeriodConnection {
  edges: [FiscalPeriodEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
  "Whether totalCount was counted; false when it is the planner's estimate of a list too large to count."
  totalCountExact: Boolean!
}

extend type Query {
  "Every fiscal period of every fiscal year, latest start first."
  fiscalPeriods(input: DataTableConnectionInput!): FiscalPeriodConnection!
}
