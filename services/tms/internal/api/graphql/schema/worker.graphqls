enum WorkerType {
  Employee
  Contractor
}

enum DriverType {
  Local
  Regional
  OTR
  Team
}

enum WorkerGender {
  Male
  Female
}

enum CDLClass {
  A
  B
  C
}

enum EndorsementType {
  O
  N
  H
  X
  P
  T
}

enum WorkerLeaveType {
  FMLA
  Medical
  Military
  Parental
  Personal
  Other
}

enum ComplianceStatus {
  Compliant
  NonCompliant
  Pending
}

enum PTOStatus {
  Requested
  Approved
  Rejected
  Cancelled
}

enum PTOType {
  Personal
  Vacation
  Sick
  Holiday
  Bereavement
  Maternity
  Paternity
}

type WorkerProfile {
  id: ID!
  workerId: ID!
  businessUnitId: ID!
  organizationId: ID!
  licenseStateId: ID
  dob: Timestamp!
  licenseNumber: String!
  cdlClass: CDLClass!
  cdlRestrictions: String!
  endorsement: EndorsementType!
  hazmatExpiry: Timestamp
  licenseExpiry: Timestamp!
  medicalCardExpiry: Timestamp
  medicalExaminerName: String!
  medicalExaminerNpi: String!
  twicCardNumber: String!
  twicExpiry: Timestamp
  hireDate: Timestamp!
  terminationDate: Timestamp
  physicalDueDate: Timestamp
  mvrDueDate: Timestamp
  complianceStatus: ComplianceStatus!
  """
  Roster roll-ups: the worker's training and safety standing denormalised onto
  the profile so the workers list can filter and sort on them. They are a cache
  of the training records and safety events, refreshed when those change and
  re-checked by the nightly compliance sweep. Read the worker overview or the
  per-area summaries for the live answer.
  """
  trainingHealth: WorkerTrainingHealth!
  safetyRating: SafetyRating!
  safetyScore: Int!
  """
  When the worker's soonest required credential expires, and when their soonest
  required course falls due. Null when nothing does.
  """
  nextCredentialExpiry: Timestamp
  nextTrainingDue: Timestamp
  """
  The worker's drug and alcohol testing standing, denormalised from the testing
  ledgers so the roster can filter and sort on it. Only Prohibited blocks
  dispatch; Unknown and Pending warn.
  """
  drugAlcoholStatus: DrugAlcoholStatus!
  isQualified: Boolean!
  disqualificationReason: String!
  lastComplianceCheck: Timestamp!
  lastMvrCheck: Timestamp!
  lastDrugTest: Timestamp!
  eldExempt: Boolean!
  shortHaulExempt: Boolean!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  licenseState: UsState
}

type Worker {
  id: ID!
  businessUnitId: ID!
  organizationId: ID!
  stateId: ID!
  fleetCodeId: ID
  managerId: ID
  status: EntityStatus!
  type: WorkerType!
  driverType: DriverType!
  """
  Set while a leave of absence is open on the timeline.
  """
  leaveType: WorkerLeaveType
  profilePicUrl: String!
  firstName: String!
  lastName: String!
  wholeName: String!
  addressLine1: String!
  addressLine2: String!
  city: String!
  postalCode: String!
  email: String!
  phoneNumber: String!
  emergencyContactName: String!
  emergencyContactPhone: String!
  externalId: String!
  assignmentBlocked: String!
  gender: WorkerGender!
  canBeAssigned: Boolean!
  availableForDispatch: Boolean!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  customFields: JSON
  businessUnit: BusinessUnit
  organization: Organization
  state: UsState
  fleetCode: FleetCode
  manager: User
  profile: WorkerProfile
  pto: [WorkerPTO!]
}

type WorkerEdge {
  node: Worker!
  cursor: String!
}

type WorkerConnection {
  edges: [WorkerEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type WorkerPTO {
  id: ID!
  workerId: ID!
  organizationId: ID!
  businessUnitId: ID!
  approverId: ID
  rejectorId: ID
  cancelledById: ID
  status: PTOStatus!
  type: PTOType!
  startDate: Timestamp!
  endDate: Timestamp!
  reason: String!
  rejectionReason: String
  cancellationReason: String
  days: Decimal!
  balanceAfterDays: Decimal
  autoApproved: Boolean!
  version: Int!
  createdAt: Timestamp!
  updatedAt: Timestamp!
  worker: Worker
  approver: User
  rejector: User
  cancelledBy: User
}

enum WorkerPTOBulkAction {
  Approve
  Reject
  Cancel
}

type BulkWorkerPTOActionResult {
  ptoId: ID!
  success: Boolean!
  error: String!
}

type BulkWorkerPTOActionPayload {
  results: [BulkWorkerPTOActionResult!]!
  successCount: Int!
  failureCount: Int!
}

type WorkerPTOEdge {
  node: WorkerPTO!
  cursor: String!
}

type WorkerPTOConnection {
  edges: [WorkerPTOEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type PTOChartDataPoint {
  date: String!
  vacation: Int!
  sick: Int!
  holiday: Int!
  bereavement: Int!
  maternity: Int!
  paternity: Int!
  personal: Int!
  workers: JSON!
}

input WorkerPatchInput {
  "Omit to leave unchanged; null is rejected."
  status: EntityStatus @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  type: WorkerType @goField(omittable: true)
  "Omit to leave unchanged; null is rejected."
  driverType: DriverType @goField(omittable: true)
}

input WorkerPTOEntriesInput {
  first: Int = 20
  after: String
  query: String
  fieldFilters: [FieldFilterInput!]
  filterGroups: [FilterGroupInput!]
  sort: [SortFieldInput!]
  status: PTOStatus
  type: PTOType
  startDateFrom: Timestamp
  startDateTo: Timestamp
  workerId: ID
  includeWorker: Boolean = false
}

input UpcomingWorkerPTOInput {
  first: Int = 20
  after: String
  status: PTOStatus
  type: PTOType
  startDate: Timestamp
  endDate: Timestamp
  workerId: ID
  fleetCodeId: ID
  timezone: String
}

input CreateWorkerPTOInput {
  workerId: ID!
  type: PTOType!
  startDate: Timestamp!
  endDate: Timestamp!
  reason: String!
}

input UpdateWorkerPTOInput {
  id: ID!
  version: Int!
  type: PTOType!
  startDate: Timestamp!
  endDate: Timestamp!
  reason: String!
}

input BulkWorkerPTOActionInput {
  ptoIds: [ID!]!
  action: WorkerPTOBulkAction!
  reason: String
}

input WorkerPTOChartInput {
  startDateFrom: Timestamp!
  startDateTo: Timestamp!
  type: PTOType
  workerId: ID
  timezone: String
}

extend type Query {
  workers(input: DataTableConnectionInput!): WorkerConnection!
  workerPTOEntries(input: WorkerPTOEntriesInput!): WorkerPTOConnection!
  upcomingWorkerPTO(input: UpcomingWorkerPTOInput!): WorkerPTOConnection!
  workerPTOChartData(input: WorkerPTOChartInput!): [PTOChartDataPoint!]!
}

extend type Mutation {
  patchWorker(id: ID!, input: WorkerPatchInput!): Worker!
  createWorkerPTO(input: CreateWorkerPTOInput!): WorkerPTO!
  updateWorkerPTO(input: UpdateWorkerPTOInput!): WorkerPTO!
  approveWorkerPTO(id: ID!): WorkerPTO!
  rejectWorkerPTO(id: ID!, reason: String!): WorkerPTO!
  cancelWorkerPTO(id: ID!, reason: String): WorkerPTO!
  bulkWorkerPTOAction(input: BulkWorkerPTOActionInput!): BulkWorkerPTOActionPayload!
}
