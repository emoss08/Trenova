{{ reserveImport "context" }}
{{ reserveImport "sync" }}
{{ reserveImport "github.com/vektah/gqlparser/v2/ast" }}
{{ reserveImport "github.com/99designs/gqlgen/graphql" }}
{{ reserveImport $.Runtime }}
{{ reserveImport $.SchemaSource }}
{{- range $s := $.Shards }}
{{ reserveImport $s.ImportPath }}
{{- end }}

type Config = graphql.Config[ResolverRoot, DirectiveRoot, ComplexityRoot]

type ResolverRoot interface {
	Roots() map[string]any
}

type DirectiveRoot struct{}

type ComplexityRoot struct{}

var registry = sync.OnceValues(func() (*gqlexec.Registry, error) {
	return gqlexec.Compile([]*gqlexec.Shard{
		{{- range $s := $.Shards }}
		{{ lookupImport $s.ImportPath }}.Shard,
		{{- end }}
	})
})

func NewExecutableSchema(cfg Config) graphql.ExecutableSchema {
	reg, err := registry()
	if err != nil {
		panic(err)
	}

	var resolvers map[string]any
	if r := cfg.Resolvers; r != nil {
		resolvers = r.Roots()
	}

	return gqlexec.NewSchema(gqlexec.SchemaConfig{
		Registry:    reg,
		Parsed:      parsedSchema,
		Override:    cfg.Schema,
		Resolvers:   resolvers,
		WorkerLimit: {{ $.WorkerLimit }},
	})
}

var parsedSchema = schemasource.Parsed
