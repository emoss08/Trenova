{{- range $d := $.Domains }}
{{ reserveImport $d.ImportPath }}
{{ reserveImport $d.ExecImport }}
{{- end }}

type Resolver struct {
	*Services
	roots map[string]any
}

func New(p Params) *Resolver {
	return FromServices(newServices(&p))
}

func FromServices(s *Services) *Resolver {
	{{- range $d := $.Domains }}
	{{ $d.Shard }}Deps := &{{ lookupImport $d.ImportPath }}.Deps{
		Core: s.Core,
		{{- range $f := $d.DepsFields }}
		{{ $f.Name }}: s.{{ $f.Name }},
		{{- end }}
	}
	{{- end }}
	{{- range $p := $.Parts }}
	{{ $p.Alias }} := &{{ lookupImport $p.Domain.ImportPath }}.{{ $p.Type }}{Deps: {{ $p.Domain.Shard }}Deps}
	{{- end }}

	return &Resolver{
		Services: s,
		roots: map[string]any{
			{{- range $p := $.Parts }}
			{{ quote $p.Key }}: {{ $p.Alias }},
			{{- end }}
		},
	}
}

func (r *Resolver) Roots() map[string]any {
	return r.roots
}

var (
	{{- range $p := $.Parts }}
	_ {{ lookupImport $p.Domain.ExecImport }}.{{ $p.Iface }} = (*{{ lookupImport $p.Domain.ImportPath }}.{{ $p.Type }})(nil)
	{{- end }}
)
