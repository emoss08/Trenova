{{ reserveImport $.BaseImport }}
{{ reserveImport $.ExecImport }}
{{- range $d := $.Domains }}
{{ reserveImport $d.ImportPath }}
{{- end }}

type Resolver struct {
	*{{ lookupImport $.BaseImport }}.Resolver
	{{- range $e := $.Entries }}
	{{- if $e.Composite }}
	{{ $e.Field }} *{{ $e.Field }}Resolver
	{{- else }}
	{{ $e.Field }} *{{ lookupImport (index $e.Parts 0).Domain.ImportPath }}.{{ $e.Type }}
	{{- end }}
	{{- end }}
}

func New(p {{ lookupImport $.BaseImport }}.Params) *Resolver {
	return FromBase({{ lookupImport $.BaseImport }}.New(p))
}

func FromBase(b *{{ lookupImport $.BaseImport }}.Resolver) *Resolver {
	return &Resolver{
		Resolver: b,
		{{- range $e := $.Entries }}
		{{- if $e.Composite }}
		{{ $e.Field }}: &{{ $e.Field }}Resolver{
			{{- range $p := $e.Parts }}
			{{ $p.Alias }}: &{{ $p.Alias }}{Resolver: b},
			{{- end }}
		},
		{{- else }}
		{{ $e.Field }}: &{{ lookupImport (index $e.Parts 0).Domain.ImportPath }}.{{ $e.Type }}{Resolver: b},
		{{- end }}
		{{- end }}
	}
}

{{- range $e := $.Entries }}

func (r *Resolver) {{ $e.Accessor }}() {{ lookupImport $.ExecImport }}.{{ $e.Iface }} {
	return r.{{ $e.Field }}
}
{{- if $e.Composite }}

type {{ $e.Field }}Resolver struct {
	{{- range $p := $e.Parts }}
	*{{ $p.Alias }}
	{{- end }}
}
{{- end }}
{{- end }}

type (
	{{- range $e := $.Entries }}
	{{- if $e.Composite }}
	{{- range $p := $e.Parts }}
	{{ $p.Alias }} = {{ lookupImport $p.Domain.ImportPath }}.{{ $e.Type }}
	{{- end }}
	{{- end }}
	{{- end }}
)
