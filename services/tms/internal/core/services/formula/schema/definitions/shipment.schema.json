{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://trenova.com/schemas/formula/shipment.schema.json",
    "title": "Shipment",
    "description": "A shipment entity with all fields available for formula calculations",
    "type": "object",
    "version": "1.0.0",
    "x-formula-context": {
        "category": "shipment",
        "entities": [
            "Shipment"
        ],
        "permissions": [
            "formula:read:shipment"
        ]
    },
    "x-data-source": {
        "table": "shipments",
        "entity": "github.com/emoss08/trenova/internal/core/domain/shipment.Shipment",
        "preloads": [
            "Customer",
            "TractorType",
            "TrailerType",
            "ServiceType",
            "ShipmentType",
            "Moves.Stops",
            "Moves.Stops.Location",
            "Moves.Stops.Location.State",
            "AdditionalCharges.AccessorialCharge",
