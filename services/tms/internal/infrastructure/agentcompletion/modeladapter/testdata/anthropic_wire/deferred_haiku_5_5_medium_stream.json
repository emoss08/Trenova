{
  "method": "POST",
  "path": "/v1/messages",
  "query": "beta=true",
  "headers": {
    "Anthropic-Version": "2023-06-01",
    "Content-Type": "application/json",
    "X-Api-Key": "sk-test"
  },
  "body": {
    "max_tokens": 10240,
    "messages": [
      {
        "content": [
          {
            "text": "Which trailers are due?",
            "type": "text"
          }
        ],
        "role": "user"
      },
      {
        "content": [
          {
            "id": "call_find",
            "input": {
              "need": "trailers due inspection"
            },
            "name": "find_tools",
            "type": "tool_use"
          }
        ],
        "role": "assistant"
      },
      {
        "content": [
          {
            "cache_control": {
              "type": "ephemeral"
            },
            "content": [
              {
                "text": "These tools are now callable:\n- list_trailers: List trailers",
                "type": "text"
              },
              {
                "tool_name": "list_trailers",
                "type": "tool_reference"
              }
            ],
            "tool_use_id": "call_find",
            "type": "tool_result"
          }
        ],
        "role": "user"
      }
    ],
    "model": "claude-haiku-5-5",
    "output_config": {
      "effort": "medium"
    },
    "stream": true,
    "system": [
      {
        "cache_control": {
          "type": "ephemeral"
        },
        "text": "Rules that never change.",
        "type": "text"
      },
      {
        "text": "\n\nToday is Friday.",
        "type": "text"
      }
    ],
    "thinking": {
      "display": "summarized",
      "type": "adaptive"
    },
    "tools": [
      {
        "description": "Look up a shipment by its number",
        "input_schema": {
          "additionalProperties": false,
          "properties": {
            "include": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "number": {
              "description": "Pro number",
              "maxLength": 20,
              "type": "string"
            }
          },
          "required": [
            "number"
          ],
          "type": "object"
        },
        "name": "get_shipment"
      },
      {
        "defer_loading": true,
        "description": "List workers",
        "input_schema": {
          "properties": {},
          "type": "object"
        },
        "name": "list_workers"
      },
      {
        "cache_control": {
          "type": "ephemeral"
        },
        "description": "Load more tools.",
        "input_schema": {
          "properties": {
            "need": {
              "type": "string"
            }
          },
          "required": [
            "need"
          ],
          "type": "object"
        },
        "name": "find_tools"
      },
      {
        "defer_loading": true,
        "description": "List trailers",
        "input_schema": {
          "properties": {},
          "type": "object"
        },
        "name": "list_trailers"
      }
    ]
  }
}
