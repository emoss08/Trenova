map invoiceOut
  from freightInvoice
  to   meadowridge.210
  use  common

B3 {
  02 <- number
  03 <- key
  04 <- payment via payments ?? "PP"
  06 <- date
  07 <- total
  09 <- deliveryDate
  10 <- if exists deliveryDate then "035" else none
  11 <- org.scac
}
N9 when exists bol { 01 <- "BM", 02 <- bol }
N9 when exists refs["PO"] { 01 <- "PO", 02 <- refs["PO"] }

when exists billTo {
  0100 {
    N1 { 01 <- "BT", 02 <- billTo.name.truncate(60) }
    N3 when exists billTo.address { 01 <- billTo.address.line1.truncate(55), 02 <- billTo.address.line2.truncate(55) }
    N4 when exists billTo.address {
      01 <- billTo.address.city.truncate(30)
      02 <- billTo.address.state
      03 <- billTo.address.postal
      04 <- billTo.address.country
    }
  }
}

0400 <- each lines as line {
  LX { 01 <- line.sequence }
  L5 when exists line.description { 01 <- line.sequence, 02 <- line.description.truncate(50) }
  L1 {
    01 <- line.sequence
    02 <- line.rate
    03 <- if exists line.rate then "PM" else none
    04 <- line.amount
    08 <- if (line.code ?? "") in chargeCodes then line.code else none
  }
}

L3 { 01 <- weight.value(lb), 02 <- if exists weight then "G" else none, 05 <- total, 12 <- if exists weight then "L" else none }

test "an invoice writes a line for each stop-off and the lumper" {
  given freightInvoice {
    number: "INV-4001"
    date: @2026-06-12
    key: "MF1000008"
    bol: "5861735303"
    total: $6_301.86
    billTo: { name: "Meadowridge Fresh Markets Transportation" }
    lines: [
      { sequence: 1, description: "Linehaul", rate: 3.31, amount: $5_906.86 },
      { sequence: 2, code: "SOC", description: "Stop-off charges", amount: $325.00 },
      { sequence: 3, code: "LUM", description: "Lumper", amount: $70.00 }
    ]
  }
  expect x12 contains "L1*2***32500****SOC~"
  expect x12 contains "L1*3***7000****LUM~"
  expect x12 contains "L3*****630186~"
}

test "Trenova's linehaul goes out with no charge code" {
  given freightInvoice {
    number: "INV-4002"
    date: @2026-06-12
    key: "MF1000008"
    bol: "5861735303"
    payment: Prepaid
    total: $5_906.86
    billTo: { name: "Meadowridge Fresh Markets Transportation" }
    lines: [{ sequence: 1, code: "400", description: "Linehaul", amount: $5_906.86 }]
  }
  expect x12 contains "B3**INV-4002*MF1000008*PP**"
  expect x12 contains "L1*1***590686~"
}
