rules statusChecks for statusOut
  use common

/// Meadowridge matches a status by the BOL and the drop it is about.
rule "a status quotes the BOL and the drop" {
  require exists bol else hold "Meadowridge needs the BOL on every status: add it before sending"
  for event in events {
    require exists event.stop else hold "Meadowridge needs the drop on every status"
  }
}

test "a drop's delivery goes out" {
  given shipmentStatus { key: "MF1000008", bol: "5861735303", events: [{ kind: Delivered, at: @2026-06-09T14:50Z, stop: 2 }] }
  expect no holds
  expect no rejects
}

test "a status without its drop is held" {
  given shipmentStatus { key: "MF1000008", bol: "5861735303", events: [{ kind: Delivered, at: @2026-06-09T14:50Z }] }
  expect held "Meadowridge needs the drop on every status"
}

test "a delay is never sent" {
  given shipmentStatus { key: "MF1000008", bol: "5861735303", events: [{ kind: Delayed, at: @2026-06-09T14:50Z, stop: 2 }] }
  expect no sent
}
