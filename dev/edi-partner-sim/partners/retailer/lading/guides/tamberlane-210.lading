guide tamberlane.210 from x12.004010.210 "Tamberlane Stores Freight Invoice 4010 rev 7"

/// Tamberlane pays an invoice only when it quotes the shipment ID, the BOL and the store PO.
B3 { 02 required; 03 required length 10..10; 04 codes "PP"; 06 required; 07 required; 11 required }
C3 required { 01 codes "USD" }
N9 max 2 { 01 codes "BM", "PO" }
ITD unused
loop 0100 required max 1
0100.N1 { 01 codes "BT"; 02 required }
loop 0200 unused
loop 0300 unused
loop 0400 required
0400.L1 required max 1 { 01 required; 04 required }
L3 { 05 required }
