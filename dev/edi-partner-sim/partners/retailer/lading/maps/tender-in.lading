map tenderIn
  from tamberlane.204
  to   loadTender
  use  common

key      <- B204 else reject "The tender has no Tamberlane shipment ID"
purpose  <- B2A01 via purposes else reject "Tamberlane sent purpose {B2A01}, which its guide does not define"
payment  <- B206 via payments
bol      <- reference(L11, "BM")
poNumber <- reference(L11, "PO")
refs     <- refs(L11)
notes    <- if exists NTE.02 then [NTE.02 ?? ""] else []

let billTo = 0100[N101 == "BT"]
customer <- lookup Customer(billTo.N104) learn party(billTo)

let trailer = 0200.N7
equipment <- trailer.11 via equipment
  else hold "Tamberlane asked for equipment we don't run: {trailer.11}"

weight        <- weight(L301, L312 ?? "L") else warn "Tamberlane sent no total weight"
pieces        <- L311
total         <- money(L305, partner.currency)
freightCharge <- total

// Tamberlane ships from its DCs (SF) to its stores (ST); each store delivery carries the store's
// receiving appointment in L11 AO.
stops <- each 0300 as stop {
  let party = stop.0310
  sequence <- stop.S501
  type     <- stop.S502 via stopTypes else reject "Stop {stop.S501} has no type"
  location <- lookup Location(party.N104) learn address(party)
  code     <- party.N104
  name     <- party.N102.titleCase()
  address  <- address(party)
  window   <- window(stop.G62, location.zone ?? partner.zone)
    else reject "Stop {stop.S501} has no appointment"
  weight <- weight(stop.S503, stop.S504)
  pieces <- int(stop.S505)
  refs   <- refs(stop.L11)
  notes  <- if exists stop.NTE.02 then [stop.NTE.02 ?? ""] else []
}

commodities <- each 0300.map(s => s.0320).flatten as line {
  commodity   <- lookup Commodity(line.L503)
  description <- line.L502.titleCase()
  weight      <- weight(line.AT8.03, line.AT8.02)
  pieces      <- line.AT8.04
  hazmat      <- exists line.0325.LH1
}

test "Tamberlane's standard tender becomes a three-stop load" {
  given file "samples/tender-original.x12"
  given lookup Customer("TS-FRTPAY") = "Tamberlane Stores"
  expect key == "TS10000004"
  expect purpose == Original
  expect payment == Prepaid
  expect bol == "0719744701"
  expect poNumber == "8978300638"
  expect stops.count == 3
  expect stops.first.type == Pickup
  expect stops.first.code == "TS-DC6012"
  expect stops.last.code == "TSS-0225"
  expect stops.last.refs["AO"] == "58928392"
  expect stops.first.window.start == @2026-06-02T08:00[America/Chicago]
  expect stops.first.window.end == @2026-06-02T09:00[America/Chicago]
  expect total == $3_713.35
  expect weight == 27_290 lb
  expect equipment == "VAN"
  expect commodities.count == 2
  expect commodities.count(c => c.hazmat) == 1
  expect no rejects
}

test "every tender of a batch reads" {
  given file "samples/tender-batch.x12"
  expect key.startsWith("TS100000")
  expect stops.count >= 2
  expect no rejects
}

test "one tender of a batch is picked by its place" {
  given file "samples/tender-batch.x12"
  given transaction 3
  expect key == "TS10000015"
}

test "a tender with only what the guide requires reads" {
  given file "samples/tender-sparse.x12"
  expect poNumber == none
  expect notes.isEmpty
  expect no rejects
}

property "everything Tamberlane has tendered still reads" {
  vary file in samples "samples/tender-*.x12"
  expect no rejects
}
