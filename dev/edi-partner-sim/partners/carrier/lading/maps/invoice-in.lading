map invoiceIn
  from quarrystone.210
  to   freightInvoice
  use  common

number       <- B302
date         <- B306
key          <- B303
deliveryDate <- B309
total        <- money(B307, C301 ?? partner.currency)
proNumber    <- N9[01 == "CN"].02
bol          <- N9[01 == "BM"].02
refs         <- refs(N9)
weight       <- weight(L301, "L")

lines <- each 0400 as line {
  sequence    <- line.LX01
  code        <- line.L1.first.08
  rate        <- line.L1.first.02
  amount      <- money(line.L1.first.04, C301 ?? partner.currency) else reject "Line {line.LX01} has no charge"
  description <- line.L5.first.02.titleCase()
}

test "an invoice for the tendered rate bills linehaul and fuel" {
  given file "samples/invoice-matching.x12"
  expect key == "S26036847599"
  expect total == $1_180.00
  expect lines.count == 4
  expect proNumber == "QY13923586"
  expect deliveryDate == @2026-04-04
  expect lines.sum(l => l.amount) == total
  expect lines.first.code == "400"
}

test "an invoice over the tendered rate adds detention" {
  given file "samples/invoice-over.x12"
  expect lines.last.code == "DET"
  expect lines.last.amount == $175.00
  expect total == $1_355.00
  expect lines.sum(l => l.amount) == total
}
