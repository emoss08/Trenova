test "an invoice over the tendered rate is held for a person" {
  event TenderOffered {
    key: "S26036847599"
    bol: "BOL-734378"
    equipment: "VAN"
    weight: 38_870 lb
    pieces: 15
    total: $1_180.00
    stops: [
      {
        sequence: 1, type: Pickup, name: "Rio Grande Fasteners", code: "RGF-1"
        address: { line1: "3301 Princeton Dr NE", city: "Albuquerque", state: "NM", postal: "87107" }
        window: { start: @2026-03-16T07:00[America/Denver], end: @2026-03-16T09:00[America/Denver] }
        weight: 38_870 lb, pieces: 15
      },
      {
        sequence: 2, type: Delivery, name: "Big Muddy Distribution", code: "BMD-7"
        address: { line1: "4800 Gateway Dr", city: "Omaha", state: "NE", postal: "68110" }
        window: { start: @2026-03-19T13:00[America/Chicago], end: @2026-03-19T15:00[America/Chicago] }
        weight: 38_870 lb, pieces: 15
      }
    ]
  }
  receive file "samples/invoice-over.x12"
  expect held "Quarrystone invoice QYF1620362 bills $1,355.00; the tender offered $1,180.00"
  expect no applied
}

test "an invoice for a load Trenova never tendered is rejected" {
  receive file "samples/invoice-matching.x12"
  expect rejected "Quarrystone invoice QYF1620362 is for S26036847599, which is not a load Trenova tendered to it"
}

