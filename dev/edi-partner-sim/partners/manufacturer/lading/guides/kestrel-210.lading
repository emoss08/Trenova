guide kestrel.210 from x12.004010.210 "Kestrel Valve Works Freight Invoice Guide 2.1"

/// Kestrel pays an invoice only when it quotes the load number and the BOL.
B3 { 02 required; 03 required length 10..10; 04 codes "PP", "TP"; 06 required; 07 required; 11 required }
N9 max 4 { 01 codes "BM", "PO" }
C3 unused
ITD unused
loop 0100 required max 1
0100.N1 { 01 codes "BT"; 02 required }
loop 0200 unused
loop 0300 unused
loop 0400 required
0400.L1 required max 1 { 01 required; 04 required }
L3 { 05 required }
