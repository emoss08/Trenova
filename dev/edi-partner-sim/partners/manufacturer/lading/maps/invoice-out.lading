map invoiceOut
  from freightInvoice
  to   kestrel.210
  use  common

B3 {
  02 <- number
  03 <- key
  04 <- payment via payments ?? "PP"
  06 <- date
  07 <- total
  09 <- deliveryDate
  10 <- if exists deliveryDate then "035" else none
  11 <- org.scac
}
N9 when exists bol { 01 <- "BM", 02 <- bol }
N9 when exists refs["PO"] { 01 <- "PO", 02 <- refs["PO"] }

when exists billTo {
  0100 {
    N1 { 01 <- "BT", 02 <- billTo.name.truncate(60) }
    N3 when exists billTo.address { 01 <- billTo.address.line1.truncate(55), 02 <- billTo.address.line2.truncate(55) }
    N4 when exists billTo.address {
      01 <- billTo.address.city.truncate(30)
      02 <- billTo.address.state
      03 <- billTo.address.postal
      04 <- billTo.address.country
    }
  }
}

0400 <- each lines as line {
  LX { 01 <- line.sequence }
  L5 when exists line.description { 01 <- line.sequence, 02 <- line.description.truncate(50) }
  L1 {
    01 <- line.sequence
    02 <- line.rate
    03 <- if exists line.rate then "PM" else none
    04 <- line.amount
    08 <- line.code
  }
}

L3 { 01 <- weight.value(lb), 02 <- if exists weight then "G" else none, 05 <- total, 12 <- if exists weight then "L" else none }

test "an invoice writes its lines, BOL and total" {
  given freightInvoice {
    number: "INV-2001"
    date: @2026-04-28
    key: "KVW-100037"
    bol: "8100798987"
    deliveryDate: @2026-04-26
    total: $1_179.41
    billTo: { name: "Kestrel Valve Works Accounts Payable", address: { line1: "500 E State St", city: "Rockford", state: "IL", postal: "61104", country: "US" } }
    lines: [
      { sequence: 1, description: "Linehaul", rate: 3.11, amount: $1_029.41 },
      { sequence: 2, code: "FUE", description: "Fuel surcharge", amount: $150.00 }
    ]
    refs: ["PO": "4589684109"]
  }
  expect x12 contains "B3**INV-2001*KVW-100037*PP**20260428*117941**20260426*035*TRNV~"
  expect x12 contains "N9*BM*8100798987~N9*PO*4589684109~"
  expect x12 contains "N1*BT*Kestrel Valve Works Accounts Payable~"
  expect x12 contains "L1*2***15000****FUE~"
  expect x12 contains "L3*****117941~"
}

test "an invoice says who pays, as Kestrel's tender did" {
  given freightInvoice {
    number: "INV-2002"
    date: @2026-04-28
    key: "KVW-100038"
    payment: ThirdParty
    total: $900.00
    billTo: { name: "Kestrel Valve Works Accounts Payable" }
    lines: [{ sequence: 1, description: "Linehaul", amount: $900.00 }]
  }
  expect x12 contains "B3**INV-2002*KVW-100038*TP**20260428*90000"
}
