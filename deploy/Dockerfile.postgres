FROM postgis/postgis:18-3.7-alpine@sha256:e1a18d273904ee86646d6d1379f318f74864a017b5aad710ed14a692212651cb

# A tag can move, so each clone is checked against the commit it was pinned at.
ARG PG_CRON_VERSION=v1.6.7
ARG PG_CRON_COMMIT=465b38c737f584d520229f5a1d69d1d44649e4e5
ARG PGVECTOR_VERSION=v0.8.1
ARG PGVECTOR_COMMIT=778dacf20c07caf904557a88705142631818d8cb

RUN apk add --no-cache --virtual .build-deps \
        build-base git && \
    git clone --branch ${PG_CRON_VERSION} --depth 1 https://github.com/citusdata/pg_cron.git /tmp/pg_cron && \
    cd /tmp/pg_cron && test "$(git rev-parse HEAD)" = "${PG_CRON_COMMIT}" && \
    make with_llvm=no && make with_llvm=no install && \
    cd / && rm -rf /tmp/pg_cron && \
    apk del .build-deps

# pgvector defaults to -march=native, which ties the image to the CPU that built
# it; OPTFLAGS="" keeps it portable across CI runners and production hosts.
RUN apk add --no-cache --virtual .build-deps \
        build-base git && \
    git clone --branch ${PGVECTOR_VERSION} --depth 1 https://github.com/pgvector/pgvector.git /tmp/pgvector && \
    cd /tmp/pgvector && test "$(git rev-parse HEAD)" = "${PGVECTOR_COMMIT}" && \
    make with_llvm=no OPTFLAGS="" && make with_llvm=no OPTFLAGS="" install && \
    cd / && rm -rf /tmp/pgvector && \
    apk del .build-deps
