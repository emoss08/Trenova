# The bundle is static files, the same on every platform: build it once on the
# runner's own architecture instead of again under QEMU for each target.
# Keep NODE_VERSION in step with client/.nvmrc.
ARG NODE_VERSION=26
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine AS builder

# Node 25+ no longer bundles corepack, so install it before activating pnpm.
RUN npm install -g corepack@0.36.0 && corepack enable && corepack prepare pnpm@12.3.4 --activate

WORKDIR /build

COPY client/package.json client/pnpm-lock.yaml client/pnpm-workspace.yaml client/.npmrc ./
COPY client/apps/web/package.json ./apps/web/
COPY client/apps/dash/package.json ./apps/dash/
COPY client/packages/config/package.json ./packages/config/
COPY client/packages/edition/package.json ./packages/edition/
COPY client/packages/graphql/package.json ./packages/graphql/
COPY client/packages/shared/package.json ./packages/shared/

RUN pnpm install --frozen-lockfile

COPY client/ ./

# This image is the self-hosted edition. An edition overlay in packages/cloud is
# built by its own pipeline (docs/engineering/editions.md), never into this image.
RUN rm -rf packages/cloud

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
ENV BROWSER=none
ENV CI=true

RUN pnpm --filter @trenova/web exec vite build
RUN pnpm --filter @trenova/dash exec vite build

# The site Caddy serves: the web app at the root and Dash under /dash, which is
# its Vite base. Dash emits its bundle to apps/dash/dist/dash.
RUN set -eu; \
    test -f apps/web/dist/index.html; \
    test -f apps/dash/dist/dash/index.html; \
    mkdir -p /site; \
    cp -R apps/web/dist/. /site/; \
    rm -rf /site/dash; \
    cp -R apps/dash/dist/dash /site/dash

FROM caddy:2-alpine

COPY --from=builder /site /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443 443/udp
