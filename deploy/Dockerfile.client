# The bundle is static files, the same on every platform: build it once on the
# runner's own architecture instead of again under QEMU for each target.
# Keep BUN_VERSION, and the digest that pins it, in step with packageManager in
# client/package.json.
ARG BUN_VERSION=1.4.5
FROM --platform=$BUILDPLATFORM oven/bun:${BUN_VERSION}-alpine@sha256:da816670775f4c2b4e990b6b1847cf5540dcdc721a42033dd331ce7a88ba6a3b AS builder

WORKDIR /build

COPY client/package.json client/bun.lock client/bunfig.toml ./
COPY client/apps/web/package.json client/apps/web/bunfig.toml ./apps/web/
COPY client/apps/dash/package.json client/apps/dash/bunfig.toml ./apps/dash/
COPY client/packages/config/package.json ./packages/config/
COPY client/packages/edition/package.json client/packages/edition/bunfig.toml ./packages/edition/
COPY client/packages/graphql/package.json client/packages/graphql/bunfig.toml ./packages/graphql/
COPY client/packages/shared/package.json client/packages/shared/bunfig.toml ./packages/shared/
COPY client/patches ./patches/

RUN bun install --frozen-lockfile

COPY client/ ./

# This image is the self-hosted edition. An edition overlay in packages/cloud is
# built by its own pipeline (docs/engineering/editions.md), never into this image.
RUN rm -rf packages/cloud

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
ENV BROWSER=none
ENV CI=true

RUN bun run --filter @trenova/web build
RUN bun run --filter @trenova/dash build

# The site Caddy serves: the web app at the root and Dash under /dash, which is
# its Vite base. Dash emits its bundle to apps/dash/dist/dash.
RUN set -eu; \
    test -f apps/web/dist/index.html; \
    test -f apps/dash/dist/dash/index.html; \
    mkdir -p /site; \
    cp -R apps/web/dist/. /site/; \
    rm -rf /site/dash; \
    cp -R apps/dash/dist/dash /site/dash

FROM caddy:2-alpine@sha256:f6228111e5fafa1a5238258d0858e103f10599b8d1659a146e7726681a002bb9

COPY --from=builder /site /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443 443/udp
