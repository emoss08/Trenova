FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@12.3.4 --activate

WORKDIR /build

COPY client/package.json client/pnpm-lock.yaml client/pnpm-workspace.yaml client/.npmrc ./
COPY client/apps/web/package.json ./apps/web/
COPY client/apps/dash/package.json ./apps/dash/
COPY client/packages/config/package.json ./packages/config/
COPY client/packages/graphql/package.json ./packages/graphql/
COPY client/packages/shared/package.json ./packages/shared/

RUN pnpm install --frozen-lockfile

COPY client/ ./

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
ENV BROWSER=none
ENV CI=true

RUN pnpm --filter @trenova/web exec vite build

FROM caddy:2-alpine

COPY --from=builder /build/apps/web/dist/client /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443
