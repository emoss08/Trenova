FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@12.3.4 --activate

WORKDIR /build

COPY client/package.json client/pnpm-lock.yaml client/pnpm-workspace.yaml client/.npmrc ./
COPY client/apps/web/package.json ./apps/web/
COPY client/apps/dash/package.json ./apps/dash/
COPY client/packages/config/package.json ./packages/config/
COPY client/packages/graphql/package.json ./packages/graphql/
COPY client/packages/shared/package.json ./packages/shared/

RUN pnpm install --frozen-lockfile

COPY client/ ./

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
ENV BROWSER=none
ENV CI=true

RUN pnpm --filter @trenova/web exec vite build
RUN pnpm --filter @trenova/dash exec vite build

# The site Caddy serves: the web app at the root and Dash under /dash, which is
# its Vite base. Dash emits its bundle to apps/dash/dist/dash; the copy of its
# index.html at apps/dash/dist exists only for static hosts and is not used.
#
# The web build lands in apps/web/dist. While the Cloudflare Vite plugin is
# still configured it lands in apps/web/dist/client instead (next to the
# worker bundle, which is not served here), so that layout is accepted too.
RUN set -eu; \
    web=apps/web/dist; \
    if [ -f apps/web/dist/client/index.html ]; then web=apps/web/dist/client; fi; \
    test -f "$web/index.html"; \
    test -f apps/dash/dist/dash/index.html; \
    mkdir -p /site; \
    cp -R "$web"/. /site/; \
    rm -rf /site/dash /site/_headers /site/.assetsignore /site/wrangler.json; \
    cp -R apps/dash/dist/dash /site/dash

FROM caddy:2-alpine

COPY --from=builder /site /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443 443/udp
