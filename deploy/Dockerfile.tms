FROM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS source

WORKDIR /build

COPY shared/go.mod shared/go.sum ./shared/
COPY services/tms/go.mod services/tms/go.sum ./services/tms/

WORKDIR /build/services/tms
ENV GOWORK=off
RUN go mod download

WORKDIR /build
COPY shared/ ./shared/
COPY services/tms/ ./services/tms/

WORKDIR /build/services/tms
# Release builds compile everything here and never read the shared build cache
# (docs/engineering/go-build-cache.md): whoever can write it could put code
# into the image. An empty GOCACHEPROG keeps it off whatever the base sets.
ENV CGO_ENABLED=0 GOCACHEPROG=

FROM source AS build-tms
RUN go build -tags nomsgpack -ldflags="-s -w" -o /build/trenova ./cmd/cli

# trenova-db links the migrations; the server binary above links only the
# schema version it requires (schema/version_gen.go).
FROM source AS build-db
RUN go build -tags nomsgpack -ldflags="-s -w" -o /build/trenova-db ./cmd/db

FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS runtime

# The same uid as the imaging worker, which issues the client certificate in
# deploy/selfhost/compose.yml: its key is readable by its owner only.
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S -g 65532 trenova && adduser -S -u 65532 -G trenova trenova

# An unset APP_ENV means development, which relaxes production's checks.
ENV APP_ENV=production

WORKDIR /app

# The deploy step: applies migrations and reference seeds before the API and
# worker start (`docker build --target trenova-db`). Seed data is embedded.
FROM runtime AS trenova-db

COPY --from=build-db /build/trenova-db /usr/local/bin/trenova-db

USER trenova

ENTRYPOINT ["trenova-db"]
CMD ["up", "-env", "production"]

FROM runtime AS tms

COPY --from=build-tms /build/trenova /usr/local/bin/trenova


USER trenova

ENTRYPOINT ["trenova"]
