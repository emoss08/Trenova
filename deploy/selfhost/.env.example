# Settings for the self-hosted stack (compose.yml). ./scripts/init-env.sh
# copies this file to .env and fills in every value marked [generated]; to do
# it by hand, copy it and set each with: openssl rand -hex 32
#
# .env holds every secret of the install. Keep it out of version control,
# readable only by the operator (chmod 600), and backed up apart from the
# database: TRENOVA_SECURITY_ENCRYPTION_KEY in particular cannot be recovered,
# and without it encrypted data cannot be read.

# Keeps Docker volume names stable (trenova_postgres_data, ...). Changing it
# makes Compose create new, empty volumes.
COMPOSE_PROJECT_NAME=trenova

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------

# The Trenova release to run: the tms and client images
# (ghcr.io/emoss08/trenova/{tms,client}). Upgrading is changing this and
# running docker compose pull && docker compose up -d.
TRENOVA_VERSION=0.9.17
# The postgres image is published only when it changes, so its version lags
# TRENOVA_VERSION. Use the newest tag at or below TRENOVA_VERSION listed at
# https://github.com/emoss08/trenova/pkgs/container/trenova%2Fpostgres
TRENOVA_POSTGRES_VERSION=0.9.0
# Change data capture (github.com/emoss08/gtc).
GTC_VERSION=0.9.1

# ---------------------------------------------------------------------------
# Addresses
# ---------------------------------------------------------------------------

# The hostname people open Trenova at, without a scheme. For a public name,
# point its DNS A/AAAA record at this host and open ports 80 and 443; Caddy
# gets a Let's Encrypt certificate on first start. "localhost" serves a trial
# on this machine with a certificate from Caddy's own CA.
DOMAIN=localhost

# The hostname of the bundled object storage (MinIO). It needs its own name
# because presigned upload and download URLs are signed for a host; give it
# a DNS record pointing here too. storage.localhost works for a local trial.
STORAGE_DOMAIN=storage.localhost

# Optional: one Caddy global option. "local_certs" issues every certificate
# from Caddy's local CA, for an install on a private network that Let's
# Encrypt cannot reach; "email ops@example.com" registers an ACME contact.
CADDY_GLOBAL_OPTIONS=

# Optional: host ports Caddy publishes.
# HTTP_PORT=80
# HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# PostgreSQL. This role owns Trenova's database and Temporal's two.
TRENOVA_DATABASE_NAME=trenova
TRENOVA_DATABASE_USER=trenova
TRENOVA_DATABASE_PASSWORD=change-me                                  # [generated]

# Redis password, shared by the TMS and GTC.
TRENOVA_REDIS_PASSWORD=change-me                                     # [generated]

# Meilisearch master key (at least 16 bytes), shared by the TMS and GTC.
TRENOVA_MEILI_MASTER_KEY=change-me                                   # [generated]

# MinIO root credentials, which the TMS also uses for its bucket.
TRENOVA_STORAGE_ACCESSKEY=trenova
TRENOVA_STORAGE_SECRETKEY=change-me                                  # [generated]
TRENOVA_STORAGE_BUCKET=trenova

# Signs session cookies. At least 32 characters.
TRENOVA_SECURITY_SESSION_SECRET=change-me                            # [generated]

# Encrypts sensitive fields at rest. At least 32 characters. BACK IT UP.
TRENOVA_SECURITY_ENCRYPTION_KEY=change-me                            # [generated]

# Password of the internal system account background work runs as.
TRENOVA_SYSTEM_SYSTEMUSERPASSWORD=change-me                          # [generated]

# Signs the AI audit trail (id:secret). Keep every key that ever signed rows:
# to rotate, append a new id:secret, comma-separated, and make it active.
TRENOVA_AI_AUDIT_CHAIN_KEYS=                                         # [generated]
TRENOVA_AI_AUDIT_CHAIN_ACTIVE_KEY_ID=                                # [generated]

# ---------------------------------------------------------------------------
# First start
# ---------------------------------------------------------------------------

# Base seeds: reference data, roles and permissions, and the first
# administrator (see "First sign-in" in docs/self-hosting/README.md). Seeds
# already applied are skipped, and a release can add new ones, so leave this
# true.
TRENOVA_RUN_SEEDS=true

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

# Web push for the driver portal. Generate a VAPID key pair (for example with
# npx web-push generate-vapid-keys); empty keys turn push off.
TRENOVA_PUSH_VAPIDPUBLICKEY=
TRENOVA_PUSH_VAPIDPRIVATEKEY=
TRENOVA_PUSH_SUBJECT=

# An instance-wide QuickBooks or Xero app, so organizations connect with one
# click. Without one, each organization enters its own app's keys.
TRENOVA_QUICKBOOKS_CLIENT_ID=
TRENOVA_QUICKBOOKS_CLIENT_SECRET=
TRENOVA_QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=
TRENOVA_QUICKBOOKS_ENVIRONMENT=
TRENOVA_XERO_CLIENT_ID=
TRENOVA_XERO_CLIENT_SECRET=
TRENOVA_XERO_WEBHOOK_KEY=

# External S3-compatible storage instead of the bundled MinIO: its endpoint
# (host:port), TLS, region, and the origin browsers reach it at. Also set
# STORAGE_ORIGIN to that origin so the Content-Security-Policy allows it.
# TRENOVA_STORAGE_ENDPOINT=s3.us-east-1.amazonaws.com
# TRENOVA_STORAGE_USESSL=true
# TRENOVA_STORAGE_REGION=us-east-1
# TRENOVA_STORAGE_PUBLICENDPOINT=https://s3.us-east-1.amazonaws.com
# STORAGE_ORIGIN=https://s3.us-east-1.amazonaws.com
