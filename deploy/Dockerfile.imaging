# syntax=docker/dockerfile:1.7
#
# The imaging worker (services/imaging). Build context: services/.
#
#   docker build -f deploy/Dockerfile.imaging -t trenova-imaging services
#   docker build -f deploy/Dockerfile.imaging --target test services     # the worker's tests,
#                                                                          against the image's libraries
#
# Native libraries, each pinned and verified:
#
#   PDFium     bblanchon/pdfium-binaries chromium/7881 (the build pdfium-render 0.9.4 binds),
#              BSD-3-Clause (PDFium) and MIT (the build scripts); the tarball's SHA-256 is
#              checked below, per architecture.
#   libheif    Debian trixie 1.23.4-1~deb13u1, LGPL-3.0, linked dynamically (the worker opens
#              it at run time, so the library can be replaced); its HEVC plugin and libde265
#              1.0.15-1+deb13u2 (LGPL-3.0). apt checks each package's SHA-256 against the
#              signed Release files.
#   libwebp    compiled into the binary by libwebp-sys 0.14.4 from the upstream sources that
#              crate vendors (BSD-3-Clause); Cargo.lock pins the crate's checksum.
#   fonts      Liberation 2.1.5 (SIL OFL 1.1), metric-compatible stand-ins for the base fonts
#              a PDF names without embedding.

ARG RUST_VERSION=1.94
ARG DEBIAN_RELEASE=trixie

FROM rust:${RUST_VERSION}-slim-${DEBIAN_RELEASE} AS chef
RUN cargo install cargo-chef --locked --version 0.1.78
WORKDIR /src

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM debian:${DEBIAN_RELEASE}-slim AS natives
ARG TARGETARCH
ARG PDFIUM_BUILD=7881
ARG PDFIUM_SHA256_AMD64=1470e21b8b4a3b4ad7f85684e2da11d94f3b69a86d81dee11b9b6709d927ac1d
ARG PDFIUM_SHA256_ARM64=ee7f7b7d5468958336a818c1cd580bdd20972846b7377b13f9a923d92d1d4674
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    case "${TARGETARCH:-amd64}" in \
      amd64) arch=x64; sum="${PDFIUM_SHA256_AMD64}" ;; \
      arm64) arch=arm64; sum="${PDFIUM_SHA256_ARM64}" ;; \
      *) echo "no PDFium build for ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/pdfium.tgz \
      "https://github.com/bblanchon/pdfium-binaries/releases/download/chromium%2F${PDFIUM_BUILD}/pdfium-linux-${arch}.tgz"; \
    echo "${sum}  /tmp/pdfium.tgz" | sha256sum -c -; \
    mkdir -p /out/usr/lib/trenova /out/usr/share/licenses/pdfium /tmp/pdfium; \
    tar -xzf /tmp/pdfium.tgz -C /tmp/pdfium; \
    install -m 0644 /tmp/pdfium/lib/libpdfium.so /out/usr/lib/trenova/libpdfium.so; \
    cp -r /tmp/pdfium/LICENSE /tmp/pdfium/licenses /out/usr/share/licenses/pdfium/ 2>/dev/null || cp /tmp/pdfium/LICENSE /out/usr/share/licenses/pdfium/; \
    rm -rf /tmp/pdfium /tmp/pdfium.tgz /var/lib/apt/lists/*

FROM debian:${DEBIAN_RELEASE}-slim AS runtime-base
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      libheif1=1.23.4-1~deb13u1 \
      libheif-plugin-libde265=1.23.4-1~deb13u1 \
      libde265-0=1.0.15-1+deb13u2 \
      fonts-liberation2=1:2.1.5-3; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/*
COPY --from=natives /out/ /

FROM chef AS builder
ARG CARGO_BUILD_JOBS=4
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
COPY --from=planner /src/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo chef cook --release --locked -p trenova-imaging --recipe-path recipe.json
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo build --release --locked -p trenova-imaging \
    && install -m 0755 target/release/trenova-imaging /usr/local/bin/trenova-imaging

# The worker's and the sandbox's tests, with the runtime's PDFium and libheif. Debug
# profile: the tests exercise behaviour, not speed.
FROM chef AS test
ARG CARGO_BUILD_JOBS=4
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      libheif1=1.23.4-1~deb13u1 libheif-plugin-libde265=1.23.4-1~deb13u1 libde265-0=1.0.15-1+deb13u2 \
      fonts-liberation2=1:2.1.5-3; \
    rm -rf /var/lib/apt/lists/*
COPY --from=natives /out/ /
COPY . .
ENV TRENOVA_PDFIUM_LIBRARY=/usr/lib/trenova/libpdfium.so \
    TRENOVA_HEIF_LIBRARY=libheif.so.1
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo test --locked -p trenova-imaging -p trenova-sandbox -p trenova-imaging-core -p trenova-service-kit

FROM runtime-base AS runtime
COPY --from=builder /usr/local/bin/trenova-imaging /usr/local/bin/trenova-imaging
# Mount points for `certs`, owned by the worker's user so a fresh named volume mounted at
# one of them is writable by it.
RUN mkdir -p /certs/server /certs/client /certs/ca && chown -R 65532:65532 /certs
# Defaults are production: the worker refuses to start without mutual TLS and without the
# sandbox's protections. A development compose file relaxes TLS explicitly.
ENV TRENOVA_IMAGING__ENVIRONMENT=production \
    TRENOVA_IMAGING__GRPC__LISTEN=0.0.0.0:50051 \
    TRENOVA_IMAGING__METRICS__LISTEN=0.0.0.0:9464 \
    TRENOVA_IMAGING__NATIVE__PDFIUM_LIBRARY=/usr/lib/trenova/libpdfium.so \
    TRENOVA_IMAGING__NATIVE__HEIF_LIBRARY=libheif.so.1
USER 65532:65532
EXPOSE 50051 9464
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
    CMD ["/usr/local/bin/trenova-imaging", "health"]
ENTRYPOINT ["/usr/local/bin/trenova-imaging"]
CMD ["serve"]
